+    step = state.body ? 'step_sending' : 'step_no_body';
+    tone = state.body ? 'ok' : 'warn';
+    args = [Math.round(state.sending || 0)];
+  } else if (camera === 'error') {
+    step = 'step_camera_error'; tone = 'error'; args = [state.cameraError || ''];
+  } else {
+    step = camera === 'needs_tap' ? 'step_tap' : 'step_start'; tone = 'ok';
+  }
+  // The camera can be started while the console is still waiting (the pose model loads meanwhile).
+  const cameraUsable = ['paired', 'waiting_game', 'waiting_setting', 'lost', 'connecting'].includes(pairing);
+  show.start = cameraUsable && !cameraOn;
+  show.stop = cameraOn;
+  show.focus = camera === 'on';
+  show.recenter = camera === 'on';
+  show.disconnect = ['paired', 'waiting_game', 'waiting_setting', 'lost', 'connecting'].includes(pairing);
+  return {step, tone, args, show};
+}
+)PAIRINGJS";
+}  // namespace xbox360ps5::phone_camera
