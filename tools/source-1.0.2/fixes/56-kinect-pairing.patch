     ",\"packets\":" + std::to_string(packets) + ",\"sequence\":" + std::to_string(latest.sequence) +
     ",\"age_ms\":" + std::to_string(age) + ",\"guest_sensor_ready\":false,\"guest_camera_open\":" + (guest_camera_open.load() ? "true" : "false") +
