+// SPDX-License-Identifier: MIT
+// Fix 56 (tools/source-1.0.2/fixes/56-kinect-pairing.patch): the phone camera page the console
+// serves over HTTPS (port/phone_camera_tls.cpp), in place of the official package's
+// assets/kinect/index.html, and its pairing state (pairing.mjs). Based on PS5X360 1.0.2's page
+// (MIT, Xbox360PS5 contributors): its pose tracking, drawing and frame code are unchanged; the
+// pairing is one state (pairing.mjs: afterStatus, afterFrame, shouldPoll, shouldAutoStart,
+// afterCameraError, view) shown in one banner with the buttons that fit it, the page connects by
+// itself from the TV's QR code, waits for the Kinect game, pairs when the game turns the camera on,
+// opens the camera (or asks for one tap) and reconnects by itself; the layout fits a phone in
+// portrait and landscape; Polish is added to English, Portuguese and Spanish.
+// pose.mjs, kinect_tracker.mjs and demo_body.mjs still come from the package's assets/kinect/.
+#pragma once
+
+namespace xbox360ps5::phone_camera {
+inline constexpr char kCameraPage[] = R"KINECTPAGE(<!doctype html>
