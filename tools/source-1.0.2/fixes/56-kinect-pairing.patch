diff --git a/include/xbox360ps5/kinect_page_patch.hpp b/include/xbox360ps5/kinect_page_patch.hpp
new file mode 100644
--- /dev/null
+++ b/include/xbox360ps5/kinect_page_patch.hpp
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: MIT
+// Fix 56 (tools/source-1.0.2/fixes/56-kinect-pairing.patch): the phone camera page says why it
+// cannot pair yet, and pairs by itself when it can.
+//
+// The page is the official package's /app0/assets/kinect/index.html, served by the console over
+// HTTPS (port/phone_camera_tls.cpp). Its connect() read /api/motion/status and, when "enabled"
+// was false, showed "Turn on Camera motion in the Kinect game's settings on the PS5 first." and
+// stopped. Before the Kinect game runs, enabled is false whatever the game's setting is (the
+// per-game "Camera motion" applies when the game starts), so a phone scanned from the library got
+// that message with the setting already on (Dragon Ball Z for Kinect, 1.0.4_candidate_18).
+// The status now says game_running and waiting_for ("game", "setting" or ""), and Patch rewrites
+// the page as it is served: it names the reason (the game not started yet, or its setting off),
+// in each language the page has (English, Portuguese, Spanish), and keeps asking every two
+// seconds, as it already does after a lost connection, so it pairs as soon as the game turns
+// the camera on. A page that does not have the expected lines is served as it is.
+#pragma once
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace xbox360ps5::kinect_page {
+
+struct Edit {
+  const char* find;
+  const char* replace;
+};
+
+inline const std::vector<Edit>& Edits() {
+  static const std::vector<Edit> edits = {
+      // connect(): the reason, and keep asking (no throw: the retry stays quiet).
+      {"    if (!result.enabled) throw Error(T('enable_motion'));",
+       "    if (!result.enabled) {\n"
+       "      // PS5X360Reloaded fix 56: say why, and keep asking every two seconds.\n"
+       "      paired = false; pairing = 'waiting';\n"
+       "      relay.textContent = result.waiting_for === 'game' ? T('wait_game') :\n"
+       "        result.waiting_for === 'setting' ? T('wait_setting') : T('enable_motion');\n"
+       "      return;\n"
+       "    }"},
+      // The retry every two seconds also while waiting for the game or its setting.
+      {"  if (onConsole && !paired && (pairing === 'lost' || pairing === 'expired') && $('key').value.trim()) connect(true);",
+       "  if (onConsole && !paired && (pairing === 'lost' || pairing === 'expired' || pairing === 'waiting') && "
+       "$('key').value.trim()) connect(true);"},
+      // A quiet retry while waiting (the console restarting into the game) keeps the reason shown.
+      {"    if (!quiet || pairing !== 'lost') relay.textContent = e.message;",
+       "    if (!quiet || (pairing !== 'lost' && pairing !== 'waiting')) relay.textContent = e.message;"},
+      // The texts.
+      {"motion_off:'Camera motion is off for this game on the PS5.',",
+       "motion_off:'Camera motion is off for this game on the PS5.', "
+       "wait_game:'Key accepted. Start the Kinect game on the PS5: this page connects by itself when it runs.', "
+       "wait_setting:'The game on the PS5 has Camera motion off. Turn it on in the guide or the game\\'s settings: this page connects by itself.',"},
+      {"motion_off:'O Movimento por câmera está desligado neste jogo no PS5.',",
+       "motion_off:'O Movimento por câmera está desligado neste jogo no PS5.', "
+       "wait_game:'Chave aceita. Inicie o jogo de Kinect no PS5: esta página conecta sozinha quando ele abrir.', "
+       "wait_setting:'O jogo no PS5 está com o Movimento por câmera desligado. Ligue no guia ou nas configurações do jogo: esta página conecta sozinha.',"},
+      {"motion_off:'El Movimiento por cámara está desactivado en este juego en la PS5.',",
+       "motion_off:'El Movimiento por cámara está desactivado en este juego en la PS5.', "
+       "wait_game:'Clave aceptada. Inicia el juego de Kinect en la PS5: esta página se conecta sola cuando arranque.', "
+       "wait_setting:'El juego de la PS5 tiene el Movimiento por cámara desactivado. Actívalo en la guía o en los ajustes del juego: esta página se conecta sola.',"},
+  };
+  return edits;
+}
+
+struct Patched {
+  std::string page;
+  size_t applied = 0;  // edits made; all or none
+};
+// Every edit's text must be in the page exactly once; otherwise (another version of the page)
+// the page is returned unchanged.
+inline Patched Patch(std::string page) {
+  for (const Edit& edit : Edits()) {
+    const std::string find = edit.find;
+    const size_t at = page.find(find);
+    if (at == std::string::npos || page.find(find, at + 1) != std::string::npos) return {std::move(page), 0};
+  }
+  for (const Edit& edit : Edits()) {
+    const std::string find = edit.find;
+    page.replace(page.find(find), find.size(), edit.replace);
+  }
+  return {std::move(page), Edits().size()};
+}
+
+}  // namespace xbox360ps5::kinect_page
