+// Fix 58: where the GPU thread's "other" waits come from. The source line of the call that
+// waited (VulkanCommandProcessor's CheckSubmissionCompletionAndDeviceLoss and
+// AwaitAllQueueOperationsCompletion take their caller's line, __builtin_LINE()); MW2 on
+// 1.0.4_candidate_18 waited 91-141 ms/s for the GPU there with no name. The GPU thread is the
+// only writer; up to kPlaces lines, the rest under line -1.
+inline thread_local int wait_line = 0;
+class LineScope {
+ public:
+  explicit LineScope(int line) : previous_(wait_line) { wait_line = line; }
+  ~LineScope() { wait_line = previous_; }
+  LineScope(const LineScope&) = delete;
+  LineScope& operator=(const LineScope&) = delete;
+
+ private:
+  int previous_;
+};
+inline constexpr size_t kPlaces = 12;
+struct Place {
+  std::atomic<int> line{0};
+  std::atomic<uint64_t> ns{0}, waits{0};
+};
+inline std::array<Place, kPlaces> places;
+inline void AddPlace(int line, uint64_t ns) {
+  Place* slot = nullptr;
+  for (Place& place : places) {
+    const int at = place.line.load(std::memory_order_relaxed);
+    if (at == line) { slot = &place; break; }
+    if (!at) { place.line.store(line, std::memory_order_relaxed); slot = &place; break; }
+  }
+  if (!slot) slot = &places[kPlaces - 1];  // full: the last one holds the rest
+  slot->ns.store(slot->ns.load(std::memory_order_relaxed) + ns, std::memory_order_relaxed);
+  slot->waits.store(slot->waits.load(std::memory_order_relaxed) + 1, std::memory_order_relaxed);
+}
