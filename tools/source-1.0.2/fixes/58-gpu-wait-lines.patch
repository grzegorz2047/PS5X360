+// Fix 58: the "other" waits by the line that waited, largest first, since the last line.
+class PlaceReporter {
+ public:
+  std::string Line(double seconds) {
+    const double s = seconds > 0 ? seconds : 1;
+    struct Row { int line; uint64_t ns, waits; };
+    std::array<Row, kPlaces> rows{};
+    size_t count = 0;
+    for (size_t n = 0; n < kPlaces; ++n) {
+      const int line = places[n].line.load(std::memory_order_relaxed);
+      if (!line) continue;
+      const uint64_t ns = places[n].ns.load(std::memory_order_relaxed), waits = places[n].waits.load(std::memory_order_relaxed);
+      if (ns - last_ns_[n] || waits - last_waits_[n]) rows[count++] = {line, ns - last_ns_[n], waits - last_waits_[n]};
+      last_ns_[n] = ns;
+      last_waits_[n] = waits;
+    }
+    std::sort(rows.begin(), rows.begin() + count, [](const Row& a, const Row& b) { return a.ns > b.ns; });
+    std::string parts;
+    for (size_t n = 0; n < count; ++n) {
+      char item[96];
+      if (rows[n].line > 0)
+        std::snprintf(item, sizeof(item), "%sline %d %.1f ms/s in %.1f/s", parts.empty() ? "" : ", ", rows[n].line,
+                      double(rows[n].ns) / 1e6 / s, double(rows[n].waits) / s);
+      else
+        std::snprintf(item, sizeof(item), "%s%s %.1f ms/s in %.1f/s", parts.empty() ? "" : ", ",
+                      rows[n].line == -2 ? "no line" : "more lines", double(rows[n].ns) / 1e6 / s, double(rows[n].waits) / s);
+      parts += item;
+    }
+    return "Frame time other waits (GPU thread) by the line of vulkan_command_processor.cc that waited: " +
+           (parts.empty() ? std::string("none") : parts);
+  }
+
+ private:
+  std::array<uint64_t, kPlaces> last_ns_{}, last_waits_{};
+};
