 }
+// Fix 60: a saved list (game_paths.txt) gains kTitleRoms once, right after /app0/assets/roms (or
+// first); nothing is removed or reordered. Returns whether it was added.
+inline bool AddTitleRoms(std::vector<std::string>& paths) {
+  for (const auto& path : paths)
+    if (NormalizeGamePath(path) == kTitleRoms) return false;
+  auto at = paths.begin();
+  for (auto it = paths.begin(); it != paths.end(); ++it)
+    if (NormalizeGamePath(*it) == "/app0/assets/roms") { at = it + 1; break; }
+  paths.insert(at, kTitleRoms);
+  return true;
+}
+// Fix 60: two roots that are one directory (/app0/assets/roms and the title's assets/roms in a
+// folder install) are scanned once. stat only (the sandbox refuses lstat); the device number is left
+// out because /app0 is a null mount of the title's folder there and reports a device of its own.
+inline std::optional<std::string> DirectoryIdentity(const std::filesystem::path& path) {
+  struct stat info {};
+  if (::stat(path.c_str(), &info) != 0 || !S_ISDIR(info.st_mode)) return std::nullopt;
+  return std::to_string(static_cast<unsigned long long>(info.st_ino)) + ":" +
+         std::to_string(static_cast<long long>(info.st_mtime)) + ":" +
+         std::to_string(static_cast<unsigned long long>(info.st_nlink)) + ":" +
+         std::to_string(static_cast<long long>(info.st_size));
+}
