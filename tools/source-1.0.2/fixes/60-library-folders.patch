+// Fix 60 (issue #12): the title's own data folder's assets/roms. In a folder install it is /app0
+// itself (the same directory as /app0/assets/roms, scanned once: DirectoryIdentity); in an image
+// install (.ffpkg / .ffpfsc) /app0 is the read-only image and this is where games copied by FTP to
+// the title's folder are, which the library did not look at ("0 games"). Never the official
+// app's folder: the library moves DLC and update packages out of its game folders.
+inline constexpr char kTitleRoms[] = XBOX360PS5_DATA_ROOT "/assets/roms";
 inline std::string NormalizeGamePath(std::string path) {
