+void UseSignalStack() {
+  if (!signal_stack_ready.load(std::memory_order_acquire)) return;
+  void* memory = std::malloc(kSignalStackBytes);
+  if (!memory) { StackFailure("malloc"); return; }
+  stack_t stack{};
+  stack.ss_sp = memory;
+  stack.ss_size = kSignalStackBytes;
+  if (sigaltstack(&stack, nullptr)) { std::free(memory); StackFailure("sigaltstack"); return; }
+  pthread_setspecific(signal_stack_key, memory);
+  char here = 0;
+  const uintptr_t self = reinterpret_cast<uintptr_t>(pthread_self());
+  for (StackSlot& slot : stack_slots) {
+    uintptr_t empty = 0;
+    if (slot.thread.load(std::memory_order_relaxed) != 0) continue;
+    if (!slot.thread.compare_exchange_strong(empty, self, std::memory_order_acq_rel)) continue;
