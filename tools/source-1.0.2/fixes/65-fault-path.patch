+// Fix 65: what the emulator holds for the kernel page of a faulting address, for the fault lines
+// of platform/ps5/exception_handler.cpp. Called from the fault handler: the lock is only tried
+// (the faulting thread may hold it), and the text is made by hand.
+bool DescribeHostPage(const void* address, char* out, size_t size) {
+  if (!out || !size) return false;
+  size_t used = 0;
+  const auto put = [&](const char* part) { for (; *part && used + 1 < size; ++part) out[used++] = *part; };
+  const auto hex = [&](uint64_t value) {
+    char digits[16]; int count = 0;
+    do { digits[count++] = "0123456789abcdef"[value & 15]; value >>= 4; } while (value);
+    while (count && used + 1 < size) out[used++] = digits[--count];
+  };
+  out[0] = 0;
+  std::unique_lock lock(guard, std::try_to_lock);
+  if (!lock.owns_lock()) { put("page state unknown (the memory lock is held)"); out[used] = 0; return false; }
+  const uintptr_t at = reinterpret_cast<uintptr_t>(address);
+  auto i = Containing(at, 1);
+  if (i == views.end()) { put("not in a view of the emulator's memory"); out[used] = 0; return false; }
+  const View& view = i->second;
+  const size_t page = (at - i->first) / kPage, guest = (at - i->first) / kGuestPage;
+  put("view 0x"); hex(i->first); put("+0x"); hex(at - i->first);
+  put(": its 4 KiB pages in this kernel page ");
+  for (size_t g = 0; g < kPerPage; ++g) hex(view.access[page * kPerPage + g]);
+  put(" (this one "); hex(view.access[guest]); put("), kernel page "); hex(view.host[page]);
+  put(", hold ");
+  if (view.hold[page] == kNoHold) put("none"); else hex(view.hold[page]);
+  out[used] = 0;
+  return true;
+}
