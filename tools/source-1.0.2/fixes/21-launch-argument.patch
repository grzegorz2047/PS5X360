+// SPDX-License-Identifier: MIT
+// Starting one game straight from a home screen forwarder (docs/FORWARDER.md).
+// Ported from upstream BrinooTk/PS5X360#62 (MartinPham) to the 1.0.2 source
+// build (tools/source-1.0.2/fixes/21-launch-argument.patch).
+//
+// A forwarder is a small app with its own home screen tile. Opened, it asks a
+// resident launcher to start PPSA50011 through sceSystemServiceLaunchApp with
+// the arguments in its forwarder.json (PS5 Forwarder Format,
+// heydemoura/ps5-forwarder-format). PS5X360 takes:
+//
+//   --rom <game>        the game: a full path, a path inside the library's game
+//                       folders, or a title ID (8 hex digits) of a game the
+//                       library lists; a folder stands for the game in it
+//   --exit-after-game   "Close the game" in the guide closes PS5X360 instead of
+//                       opening the library
+//   <path>              a bare full path (what Forwarder Manager's PS5X360
+//                       tiles pass, and what the title always took)
+//
+// Header only, no emulator types: tools/check-forward.cpp (run-fix-checks.sh)
+// checks it on a PC.
+#pragma once
+#include <algorithm>
+#include <cctype>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <string>
+#include <string_view>
+#include <system_error>
+#include <vector>
+
+namespace xbox360ps5::forward {
+
+struct Args {
+  std::string rom;               // --rom <game> or --rom=<game>, else a bare path
+  bool exit_after_game = false;  // --exit-after-game
+};
+
+inline std::string Trim(std::string_view text) {
+  while (!text.empty() && std::isspace(static_cast<unsigned char>(text.front()))) text.remove_prefix(1);
+  while (!text.empty() && std::isspace(static_cast<unsigned char>(text.back()))) text.remove_suffix(1);
+  return std::string(text);
+}
+
+// argv[0] is normally the title's own executable; a launcher that passes the
+// arguments without it puts the game there, so argv[0] counts as a bare path
+// only when it is a full path that is not the title's own. Unknown options
+// are ignored.
+inline Args Parse(int argc, char** argv) {
+  Args result;
+  if (argc <= 0 || argv == nullptr) return result;
+  constexpr std::string_view rom_flag = "--rom", rom_prefix = "--rom=";
+  std::string bare;
+  for (int i = 0; i < argc; ++i) {
+    if (argv[i] == nullptr) break;
+    const std::string_view arg{argv[i]};
+    if (arg == "--exit-after-game") {
+      result.exit_after_game = true;
+    } else if (arg == rom_flag) {
+      // "--rom" with no value, or another option after it: no game.
+      if (i + 1 < argc && argv[i + 1] != nullptr && std::string_view(argv[i + 1]).substr(0, 2) != "--")
+        result.rom = Trim(argv[++i]);
+    } else if (arg.substr(0, rom_prefix.size()) == rom_prefix) {
+      result.rom = Trim(arg.substr(rom_prefix.size()));
+    } else if (arg.substr(0, 2) == "--" || !bare.empty()) {
+      continue;
+    } else if (i > 0) {
+      bare = Trim(arg);
+    } else if (!arg.empty() && arg.front() == '/' && arg.substr(0, 6) != "/app0/" &&
+               (arg.size() < 9 || arg.substr(arg.size() - 9) != "eboot.bin")) {
+      bare = Trim(arg);
+    }
+  }
+  if (result.rom.empty()) result.rom = bare;
+  return result;
+}
+
+// "4D5307E6": a title ID, as the library keeps them (upper case on compare).
+inline bool IsTitleId(std::string_view text) {
+  return text.size() == 8 && std::all_of(text.begin(), text.end(),
+                                         [](char c) { return std::isxdigit(static_cast<unsigned char>(c)) != 0; });
+}
+
+inline std::string Upper(std::string text) {
+  for (char& c : text) c = char(std::toupper(static_cast<unsigned char>(c)));
+  return text;
+}
+inline std::string Lower(std::string text) {
+  for (char& c : text) c = char(std::tolower(static_cast<unsigned char>(c)));
+  return text;
+}
+
+// A path as the library compares them: lexically normal, '/' separated, no
+// trailing '/'.
+inline std::string Key(const std::filesystem::path& path) {
+  std::string text = path.lexically_normal().generic_string();
+  while (text.size() > 1 && text.back() == '/') text.pop_back();
+  return text;
+}
+
+// Where to look for the game: a full path as it is; a relative one inside each
+// of the game folders, in their order, never above them (nothing for a path
+// with a ".." part).
+inline std::vector<std::filesystem::path> Candidates(std::string_view rom, const std::vector<std::string>& folders) {
+  std::string text = Trim(rom);
+  while (text.size() > 1 && text.back() == '/') text.pop_back();  // "Halo 3/"
+  if (text.empty()) return {};
+  if (text.front() == '/') return {std::filesystem::path(text)};
+  for (std::string_view rest = text; !rest.empty();) {
+    const size_t slash = rest.find('/');
+    if (rest.substr(0, slash) == "..") return {};
+    if (slash == std::string_view::npos) break;
+    rest.remove_prefix(slash + 1);
+  }
+  std::vector<std::filesystem::path> out;
+  for (const auto& folder : folders) {
+    if (folder.empty()) continue;
+    const auto path = std::filesystem::path(folder) / text;
+    if (std::find(out.begin(), out.end(), path) == out.end()) out.push_back(path);
+  }
+  return out;
+}
+
+// An STFS/SVOD package of a kind the library lists as a game (ReadPackage in
+// src/launcher.cpp): a LIVE, PIRS or "CON " header whose content type is
+// something to run. Saves, DLC and title updates are not.
+inline bool GamePackage(const std::filesystem::path& path) {
+  std::FILE* file = std::fopen(path.string().c_str(), "rb");
+  if (!file) return false;
+  unsigned char header[0x348];
+  const size_t got = std::fread(header, 1, sizeof(header), file);
+  std::fclose(file);
+  if (got < sizeof(header)) return false;
+  if (std::memcmp(header, "LIVE", 4) && std::memcmp(header, "PIRS", 4) && std::memcmp(header, "CON ", 4)) return false;
+  const uint32_t type = uint32_t(header[0x344]) << 24 | uint32_t(header[0x345]) << 16 | uint32_t(header[0x346]) << 8 | header[0x347];
+  for (const uint32_t game : {0x000D0000u, 0x00080000u, 0x00007000u, 0x00004000u, 0x00005000u, 0x02000000u, 0x00060000u, 0x000C0000u})
+    if (type == game) return true;
+  return false;
+}
+
+// The file the emulator starts for a path that is not in the library (outside
+// the game folders): the path itself when it is a file; for a folder, as the
+// library would list it: its default.xex, else its only .xex, else the one game
+// package below it (six levels down, not in a package's .data folder). Empty
+// when there is none or several; why says which.
+inline std::filesystem::path LaunchFile(const std::filesystem::path& path, std::string* why = nullptr) {
+  std::error_code error;
+  if (std::filesystem::is_regular_file(path, error)) return path;
+  if (!std::filesystem::is_directory(path, error)) {
+    if (why) *why = "not a file or folder";
+    return {};
+  }
+  std::filesystem::path executable;
+  int executables = 0;
+  for (std::filesystem::directory_iterator at(path, error), end; !error && at != end; at.increment(error)) {
+    std::error_code kind_error;
+    if (Lower(at->path().extension().string()) != ".xex" || at->is_directory(kind_error)) continue;
+    ++executables;
+    if (Lower(at->path().filename().string()) == "default.xex") return at->path();
+    executable = at->path();
+  }
+  if (executables == 1) return executable;
+  std::vector<std::filesystem::path> packages;
+  const auto walk = [&packages](const auto& self, const std::filesystem::path& folder, int depth) -> void {
+    std::error_code walk_error;
+    std::vector<std::filesystem::path> folders;
+    for (std::filesystem::directory_iterator at(folder, walk_error), end; !walk_error && at != end; at.increment(walk_error)) {
+      std::error_code kind_error;
+      const std::string extension = Lower(at->path().extension().string());
+      if (at->is_directory(kind_error)) {
+        if (depth < 6 && extension != ".data") folders.push_back(at->path());
+      } else if ((extension.empty() || extension == ".xbla" || extension == ".god") && GamePackage(at->path())) {
+        packages.push_back(at->path());
+      }
+    }
+    std::sort(folders.begin(), folders.end());
+    for (const auto& below : folders) self(self, below, depth + 1);
+  };
+  walk(walk, path, 0);
+  if (executables == 0 && packages.size() == 1) return packages.front();
+  if (why) {
+    if (executables > 1)
+      *why = "no default.xex and " + std::to_string(executables) + " .xex files in this folder; give the one to start";
+    else if (packages.size() > 1)
+      *why = std::to_string(packages.size()) + " game packages below this folder; give the one to start";
+    else
+      *why = "no default.xex, single .xex or game package in this folder";
+  }
+  return {};
+}
+
+// A game the library lists (Launcher::Entries): what it starts, the folder it
+// was found in, and its title ID.
+struct LibraryGame {
+  std::filesystem::path path;
+  std::filesystem::path folder;
+  std::string title_id;
+};
+
+struct Choice {
+  int entry = -1;              // index into the library's games, when it is one of them
+  std::filesystem::path file;  // what to start (empty: nothing found, see error)
+  std::string error;
+};
+
+// The game a forwarder asks for, looked for the way the library lists games so
+// that it starts with its own name, title ID and options:
+//  1. a path (full, or inside a game folder, first match in their order) that
+//     is a library game's file, or its folder (an extracted game, a multi-disc
+//     set), or a folder with exactly one library game below it (an XBLA or
+//     Games on Demand title's folder);
+//  2. a path that exists but is not in the library: LaunchFile;
+//  3. a title ID: the library's game with that ID, the most recently played
+//     first (the library's order) when there are several copies.
+inline Choice Pick(std::string_view rom, const std::vector<std::string>& folders, const std::vector<LibraryGame>& games) {
+  Choice choice;
+  const std::string text = Trim(rom);
+  if (text.empty()) {
+    choice.error = "no game given";
+    return choice;
+  }
+  const auto candidates = Candidates(text, folders);
+  for (const auto& candidate : candidates) {
+    std::error_code exists_error;
+    if (!std::filesystem::exists(candidate, exists_error)) continue;
+    const std::string key = Key(candidate), below = key + "/";
+    std::vector<int> found_in, inside;
+    for (int n = 0; n < int(games.size()); ++n) {
+      const std::string path = Key(games[size_t(n)].path);
+      if (path == key) {
+        choice.entry = n;
+        choice.file = games[size_t(n)].path;
+        return choice;
+      }
+      if (Key(games[size_t(n)].folder) == key) found_in.push_back(n);
+      if (path.compare(0, below.size(), below) == 0) inside.push_back(n);
+    }
+    for (const auto* list : {&found_in, &inside}) {
+      if (list->size() != 1) continue;
+      choice.entry = list->front();
+      choice.file = games[size_t(list->front())].path;
+      return choice;
+    }
+    if (inside.size() > 1) {
+      choice.error = candidate.string() + ": " + std::to_string(inside.size()) +
+                     " games below this folder; give the one to start";
+      return choice;
+    }
+    std::string why;
+    choice.file = LaunchFile(candidate, &why);
+    if (choice.file.empty()) choice.error = candidate.string() + ": " + why;
+    return choice;
+  }
+  if (IsTitleId(text)) {
+    const std::string id = Upper(text);
+    for (int n = 0; n < int(games.size()); ++n) {
+      if (Upper(games[size_t(n)].title_id) != id) continue;
+      choice.entry = n;
+      choice.file = games[size_t(n)].path;
+      return choice;
+    }
+    choice.error = text + ": no game with this title ID in the library";
+    return choice;
+  }
+  if (candidates.empty())
+    choice.error = text + ": not a path inside the game folders (no \"..\")";
+  else
+    choice.error = text + ": not found" + (text.front() == '/' ? "" : " in the game folders");
+  return choice;
+}
+
+// launch-once.txt's third line: a forwarded game that restarts into itself
+// (its own start options, its render-target mode) stays forwarded.
+inline std::string OnceFlags(bool exit_after_game) { return exit_after_game ? "forwarded exit-after-game" : "forwarded"; }
+inline bool OnceForwarded(std::string_view flags) { return flags.substr(0, 9) == "forwarded"; }
+inline bool OnceExitAfterGame(std::string_view flags) {
+  return OnceForwarded(flags) && flags.find("exit-after-game") != std::string_view::npos;
+}
+
+// launch-once.txt: a start straight into one game, read once at the next
+// start. Line 1 the game, line 2 its title ID (its own options), line 3 the
+// forwarder flags, only for a forwarded game (other writers leave it out).
+struct Once {
+  std::string game, title, flags;
+};
+inline std::string OnceText(const std::string& game, const std::string& title, bool forwarded, bool exit_after_game) {
+  return game + "\n" + title + "\n" + (forwarded ? OnceFlags(exit_after_game) + "\n" : std::string());
+}
+inline Once ParseOnce(std::string_view text) {
+  Once once;
+  std::string* lines[] = {&once.game, &once.title, &once.flags};
+  for (std::string* line : lines) {
+    if (text.empty()) break;
+    const size_t end = text.find('\n');
+    *line = std::string(text.substr(0, end));
+    if (!line->empty() && line->back() == '\r') line->pop_back();
+    text.remove_prefix(end == std::string_view::npos ? text.size() : end + 1);
+  }
+  if (once.game.empty()) once = {};
+  return once;
+}
+
+// What this start runs, before the library is scanned (canary_game_main.cpp):
+//  - a forwarder's request (--rom or a bare path): looked for later with Pick;
+//    game.txt and launch-once.txt are not used;
+//  - else game.txt's game (game_txt), as before;
+//  - else launch-once.txt's game, still forwarded when its flags say so (a
+//    restart into the forwarder's game for its start options or FSI mode);
+//  - else, when all are empty, /app0/assets/game.txt, then the library.
+struct Start {
+  std::string request;  // the forwarder's game, to find with Pick
+  std::string game;     // a game to start as it is
+  bool forwarded = false, exit_after_game = false, from_once = false;
+  bool read_packaged_game_txt() const { return request.empty() && game.empty(); }
+};
+inline Start Decide(const Args& args, const std::string& game_txt, const Once& once) {
+  Start start;
+  if (!args.rom.empty()) {
+    start.request = args.rom;
+    start.forwarded = true;
+    start.exit_after_game = args.exit_after_game;
+    return start;
+  }
+  start.game = game_txt;
+  if (start.game.empty() && !once.game.empty()) {
+    start.game = once.game;
+    start.from_once = true;
+    start.forwarded = OnceForwarded(once.flags);
+    start.exit_after_game = OnceExitAfterGame(once.flags);
+  }
+  return start;
+}
+
+// A forwarded game that the core refused to start (no library dialog on the
+// screen): restart into the library with the reason, rather than close.
+inline bool RestartIntoLibraryOnFailure(bool library_shown, bool forwarded) { return !library_shown && forwarded; }
+// "Close the game" in the guide: with --exit-after-game it closes the title.
+inline bool CloseTitleOnShelf(bool exit_after_game) { return exit_after_game; }
+
+}  // namespace xbox360ps5::forward
