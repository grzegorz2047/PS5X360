@@ -1008,6 +1008,17 @@ void KernelState::RegisterThread(XThread* thread) {
   threads_by_id_[thread->thread_id()] = thread;
 }
 
+bool KernelState::IsRunningThreadObject(uint32_t guest_object) {
+  auto global_lock = global_critical_region_.Acquire();
+  for (const auto& [thread_id, thread] : threads_by_id_) {
+    if (thread && thread->guest_object() == guest_object &&
+        thread->is_running()) {
+      return true;
+    }
+  }
+  return false;
+}
