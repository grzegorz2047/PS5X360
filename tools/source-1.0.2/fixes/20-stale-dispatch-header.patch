diff --git a/.deps/xenia-canary/src/xenia/kernel/native_object_resolve.h b/.deps/xenia-canary/src/xenia/kernel/native_object_resolve.h
new file mode 100644
index 0000000..658eaa6
--- /dev/null
+++ b/.deps/xenia-canary/src/xenia/kernel/native_object_resolve.h
@@ -0,0 +1,105 @@
+// Xbox360PS5 (tools/source-1.0.2/fixes/20-stale-dispatch-header.patch): what
+// XObject::GetNativeObject does with a guest dispatch header, as a template over the kernel
+// operations it needs, so the host check tools/check-stale-dispatch-header.cpp drives the
+// same code with a fake kernel. No Xenia headers here.
+//
+// A header the emulator stamped (wait_list.flink_ptr == kXObjSignature) records the handle of
+// its object in wait_list.blink_ptr. That handle can since have been given to another object
+// (the object this header named was released, the header was not reset). The other object is
+// then left alone and the header gets a new object, as on its first use: answering "no
+// object" made the game's event or semaphore disappear, and Battlefield 3 (45410950) hung
+// loading the campaign. A stale thread header whose thread no longer runs names a thread that
+// has exited: it gets an event signalled for good, so waits on it end at once. A running
+// thread can also have lost its handle; that one is left alone.
+#ifndef XENIA_KERNEL_NATIVE_OBJECT_RESOLVE_H_
+#define XENIA_KERNEL_NATIVE_OBJECT_RESOLVE_H_
+
+#include <cstdint>
+
+namespace xbox360ps5 {
+namespace native_object {
+
+enum class Outcome : uint8_t {
+  kRecorded,      // the object the header's handle names
+  kCreated,       // a new event, mutant or semaphore (first use, or a stale header)
+  kExitedThread,  // a stale thread header of an exited thread: the signalled stand-in
+  kNone,          // no object: the handle is gone, the type has no object, or a running
+                  // thread's stale header
+};
+
+struct Report {
+  Outcome outcome = Outcome::kNone;
+  bool stale = false;           // the recorded handle belonged to another object
+  bool running_thread = false;  // a stale thread header whose thread still runs
+  uint32_t stale_handle = 0;
+};
+
+// Backend (B::Object is the kernel object type):
+//   bool Stamped();                     the header carries the emulator's signature
+//   uint32_t RecordedHandle();          its wait_list.blink_ptr
+//   Object* Lookup(uint32_t handle);    the table's object for the handle, retained, or null
+//   bool BelongsToHeader(Object*);      the object's guest object is this header
+//   void NoteStaleOwner(Object*);       remembers the other object (for the log line)
+//   void Release(Object*);              gives back one reference
+//   void SyncFromGuest(Object*);        takes the guest's direct writes to the header
+//   Object* Create();                   a new event, mutant or semaphore for the header's
+//                                       type, bound to the header (one reference), or null
+//   bool IsThreadType();                the header's type is ThreadObject
+//   bool ThreadRunning();               a running thread's guest object is this header
+//   Object* CreateExitedThread();       the signalled stand-in, bound to the header
+//   void Stamp(Object*);                records the object's handle in the header
+//   void NoteUnsupported(bool stale);   nothing could be made for the header's type
+// The returned object carries one reference for the caller.
+template <typename B>
+typename B::Object* Resolve(B& backend, Report& report) {
+  using Object = typename B::Object;
+  Object* result = nullptr;
+  bool create = !backend.Stamped();
+  if (!create) {
+    const uint32_t handle = backend.RecordedHandle();
+    result = backend.Lookup(handle);
+    if (result && !backend.BelongsToHeader(result)) {
+      report.stale = true;
+      report.stale_handle = handle;
+      backend.NoteStaleOwner(result);
+      // The reference the lookup took, given back once.
+      backend.Release(result);
+      result = nullptr;
+      create = true;
+    }
+    if (result) {
+      // The only place the guest hands us a raw dispatch header, so the only place a
+      // direct write to it can be picked up.
+      backend.SyncFromGuest(result);
+      report.outcome = Outcome::kRecorded;
+      return result;
+    }
+  }
+  if (!create) {
+    // A recorded handle no longer in the table: no object, as before.
+    report.outcome = Outcome::kNone;
+    return nullptr;
+  }
+  result = backend.Create();
+  if (result) {
+    report.outcome = Outcome::kCreated;
+  } else if (report.stale && backend.IsThreadType()) {
+    report.running_thread = backend.ThreadRunning();
+    if (!report.running_thread) {
+      result = backend.CreateExitedThread();
+      if (result) report.outcome = Outcome::kExitedThread;
+    }
+  }
+  if (!result) {
+    backend.NoteUnsupported(report.stale);
+    report.outcome = Outcome::kNone;
+    return nullptr;
+  }
+  backend.Stamp(result);
+  return result;
+}
+
+}  // namespace native_object
+}  // namespace xbox360ps5
+
+#endif  // XENIA_KERNEL_NATIVE_OBJECT_RESOLVE_H_
