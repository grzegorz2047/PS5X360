@@ -68,6 +68,18 @@ void XEvent::InitializeNative(void* native_ptr,
   SetNativePointer(memory()->HostToGuestVirtual(native_ptr), true);
 }
 
+void XEvent::InitializeNativeExitedThread(void* native_ptr) {
+  assert_false(event_);
+  manual_reset_ = true;
+  stays_signaled_ = true;
+  host_signaled_ = true;
+  event_ = xe::threading::Event::CreateManualResetEvent(true);
+  assert_not_null(event_);
+  // A terminated thread's dispatch header is signalled.
+  reinterpret_cast<X_DISPATCH_HEADER*>(native_ptr)->signal_state = 1;
+  SetNativePointer(memory()->HostToGuestVirtual(native_ptr), true);
+}
