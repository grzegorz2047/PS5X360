   return 0;
 }
 void NetworkSelfTest(const std::string& server) {
+  namespace nst = xbox360ps5::network_self_test;
+  net_self_test_start = nst::Clock::now();
   int ends[2] = {-1, -1};
   const int piped = pipe(ends);
   XELOGW("Network test: pipe {} (errno {})", piped == 0 ? "ok" : "refused", piped == 0 ? 0 : errno);
@@ -215,8 +226,21 @@ void NetworkSelfTest(const std::string& server) {
   const CURLcode result = curl_easy_perform(curl);
   long status = 0;
   curl_easy_getinfo(curl, CURLINFO_RESPONSE_CODE, &status);
-  XELOGW("Network test: {} -> {} ({}; {}), HTTP {}", url, int(result), curl_easy_strerror(result), error_text, status);
+  XELOGW("Network test: +{} ms {} -> {} ({}; {}), HTTP {}", NetSelfTestMs(), url, int(result),
+         curl_easy_strerror(result), error_text, status);
+  XELOGW("Network test: +{} ms closing the request", NetSelfTestMs());
   curl_easy_cleanup(curl);
+  XELOGW("Network test: +{} ms request closed", NetSelfTestMs());
+  // What the resolver did for the request (port/ps5_resolver.cpp), a line a lookup.
+  char lookups[nst::kResolverReportSize] = {};
+  ps5x_resolver_report(lookups, sizeof(lookups));
+  for (const std::string_view line : nst::ReportLines(lookups)) {
+    XELOGW("Network test: lookup {}", line);
+  }
+  // The server's address without libcurl, DNS or TLS: only whether a TCP connection opens.
+  const nst::TcpProbeResult tcp =
+      nst::ProbeTcp(nst::kTcpProbeAddress, nst::kTcpProbePort, nst::kTcpProbeTimeoutMs);
+  XELOGW("Network test: TCP 166.117.125.185:443 {} (errno {})", nst::TcpProbeText(tcp), tcp.error);
 }
