+// Xbox360PS5 (fix 24, candidate 21): the entry of a function in xenia/cpu/entry_probe.h (arg0:
+// the probe). Counts it, and logs it with the command buffer's flags once the title enabled
+// the lines. Guest memory is read only where the host can read it.
+void EntryProbeHandler(PPCContext* ppc_context, void* arg0, void* arg1) {
+  namespace ep = xbox360ps5::entry_probe;
+  const int probe = int(reinterpret_cast<uintptr_t>(arg0));
+  if (probe < 0 || probe >= ep::kProbes) return;
+  ep::Entry entry;
+  entry.thread = ppc_context->thread_id;
+  entry.lr = uint32_t(ppc_context->lr);
+  for (int n = 0; n < 4; ++n) entry.r[n] = uint32_t(ppc_context->r[3 + n]);
+  if (!ep::Global().Enter(probe, ep::NowMs(), entry.thread, entry.r[0],
+                          entry.r[1], entry.lr, &entry.number)) {
+    return;
+  }
+  auto read = [ppc_context](uint32_t address, uint32_t& value) {
+    if (address < 0x10000 || address > 0xFFFFFFFCu || (address & 3)) {
+      return false;
+    }
+    uint8_t* host = ppc_context->TranslateVirtual(address);
+    size_t length = 4;
+    xe::memory::PageAccess access;
+    if (!xe::memory::QueryProtect(host, length, access) ||
+        access == xe::memory::PageAccess::kNoAccess) {
+      return false;
+    }
+    value = xe::load_and_swap<uint32_t>(host);
+    return true;
+  };
+  const auto& p = ep::Probes()[probe];
+  if (p.object_reg >= 0) {
+    entry.object = uint32_t(ppc_context->r[p.object_reg]);
+    static const uint32_t kOffsets[4] = {0x08, 0x68, 0x7C, 0x80};
+    entry.object_read = true;
+    for (int n = 0; n < 4; ++n)
+      entry.object_read = entry.object_read &&
+                          read(entry.object + kOffsets[n], entry.object_words[n]);
+  }
+  if (p.context_reg >= 0) {
+    entry.context = uint32_t(ppc_context->r[p.context_reg]);
+    entry.context_read = true;
+    for (int n = 0; n < 3; ++n)
+      entry.context_read =
+          entry.context_read &&
+          read(entry.context + p.context_offset + 4 * n, entry.context_words[n]);
+  }
+  if (p.extra_reg >= 0) {
+    entry.extra = uint32_t(ppc_context->r[p.extra_reg]);
+    entry.extra_read = true;
+    for (int n = 0; n < 3; ++n)
+      entry.extra_read =
+          entry.extra_read &&
+          read(entry.extra + p.extra_offset + 4 * n, entry.extra_words[n]);
+  }
+  XELOGW("{}", ep::Line(p, entry));
+}
