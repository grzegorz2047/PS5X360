+// Samples of one place over time, keeping a sample only when it differs from the one before.
+struct ChangeLog {
+  struct Sample {
+    uint32_t ms = 0;
+    std::string text;
+  };
+  std::vector<Sample> samples;
+  uint32_t last_ms = 0;
+  void Add(uint32_t ms, const std::string& text) {
+    last_ms = ms;
+    if (samples.empty() || samples.back().text != text) samples.push_back({ms, text});
+  }
+  bool Changed() const { return samples.size() > 1; }
+};
