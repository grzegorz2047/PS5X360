diff --git a/.deps/xenia-canary/src/xenia/gpu/cp_trace.h b/.deps/xenia-canary/src/xenia/gpu/cp_trace.h
new file mode 100644
index 0000000..50de17e
--- /dev/null
+++ b/.deps/xenia-canary/src/xenia/gpu/cp_trace.h
@@ -0,0 +1,256 @@
+// Xbox360PS5 (tools/source-1.0.2/fixes/24-stall-code-words.patch): what the GPU command
+// processor writes to guest memory (fences, events, scratch write-back) and what it waits for,
+// for the STALL report of a game whose CPU waits for a fence the GPU never writes (Battlefield
+// 3's main thread after the campaign has loaded). Header-only and free of Xenia headers, so the
+// host check tools/check-stall-dump.cpp drives it.
+#ifndef XENIA_GPU_CP_TRACE_H_
+#define XENIA_GPU_CP_TRACE_H_
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace xbox360ps5 {
+namespace cp_trace {
+
+enum class Kind : uint8_t {
+  kMemWrite = 1,  // PM4 MEM_WRITE
+  kEventShd,      // PM4 EVENT_WRITE_SHD (value or counter)
+  kEventExt,      // PM4 EVENT_WRITE_EXT (screen extents)
+  kCondWrite,     // PM4 COND_WRITE to memory
+  kRegToMem,      // PM4 REG_TO_MEM
+  kScratch,       // SCRATCH_REGn write-back (SCRATCH_ADDR + 4n)
+  kCount,
+};
+inline const char* KindName(Kind kind) {
+  switch (kind) {
+    case Kind::kMemWrite: return "MEM_WRITE";
+    case Kind::kEventShd: return "EVENT_WRITE_SHD";
+    case Kind::kEventExt: return "EVENT_WRITE_EXT";
+    case Kind::kCondWrite: return "COND_WRITE";
+    case Kind::kRegToMem: return "REG_TO_MEM";
+    case Kind::kScratch: return "SCRATCH";
+    default: return "?";
+  }
+}
+
+inline uint32_t NowMs() {
+  static const auto start = std::chrono::steady_clock::now();
+  return uint32_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                      std::chrono::steady_clock::now() - start)
+                      .count());
+}
+
+struct Write {
+  uint32_t ms = 0, address = 0, value = 0;
+  Kind kind = Kind::kMemWrite;
+};
+
+// The latest value written at an address, how often and when (the fence a CPU polls shows as an
+// address written again and again with a rising value).
+struct Target {
+  uint32_t address = 0, value = 0, count = 0, first_ms = 0, last_ms = 0;
+  Kind kind = Kind::kMemWrite;
+};
+
+struct WaitState {
+  bool active = false;
+  bool memory = false;           // a memory address (else a register index)
+  uint32_t address = 0, ref = 0, mask = 0, function = 0;  // address: as in the packet
+  uint32_t since_ms = 0, polls = 0, value = 0;
+  uint32_t first_value = 0;      // the value when the wait began
+  uint32_t packet = 0;           // the WAIT_REG_MEM packet's physical address
+  bool reported = false;         // logged once it lasted 2 s
+};
+
+// A memory address in a packet: the dword's physical address and its endian swap (low 2 bits).
+inline uint32_t PacketAddress(uint32_t address) { return address & ~3u; }
+inline const char* EndianName(uint32_t address) {
+  switch (address & 3) {
+    case 0: return "none";
+    case 1: return "8in16";
+    case 2: return "8in32";
+    default: return "16in32";
+  }
+}
+
+// The guest virtual addresses of a physical address: 0xA0000000 (64 KiB pages), 0xC0000000
+// (16 MiB pages) and 0xE0000000 (4 KiB pages, 0x1000 below: physical = address - 0xE0000000
+// + 0x1000).
+struct Alias {
+  const char* view;
+  uint32_t address;
+};
+inline std::vector<Alias> Aliases(uint32_t physical) {
+  std::vector<Alias> aliases;
+  if (physical >= 0x20000000) return aliases;
+  aliases.push_back({"A0000000", 0xA0000000u + physical});
+  aliases.push_back({"C0000000", 0xC0000000u + physical});
+  if (physical >= 0x1000) aliases.push_back({"E0000000", 0xE0000000u + physical - 0x1000});
+  return aliases;
+}
+
+// The awaited dword as the GPU reads it (physical) and as the CPU sees it through each alias,
+// and the places within 8 KiB of it that hold the awaited value: a write that went through an
+// alias with a wrong offset shows there. Reader:
+//   bool Physical(uint32_t physical, uint32_t& value);   big-endian word, as the GPU reads it
+//   bool Virtual(uint32_t address, uint32_t& value);     through the CPU's view
+// Values are the stored words; the endian swap of the packet is applied by the caller.
+template <typename Reader>
+std::string AliasReport(Reader& reader, uint32_t physical, uint32_t ref, uint32_t mask) {
+  std::string text;
+  char item[96];
+  uint32_t value = 0;
+  if (reader.Physical(physical, value))
+    std::snprintf(item, sizeof(item), "physical %08X = %08X", physical, value);
+  else
+    std::snprintf(item, sizeof(item), "physical %08X unreadable", physical);
+  text += item;
+  bool differs = false;
+  const uint32_t at_physical = value;
+  for (const Alias& alias : Aliases(physical)) {
+    uint32_t seen = 0;
+    if (reader.Virtual(alias.address, seen)) {
+      std::snprintf(item, sizeof(item), "; %s view %08X = %08X", alias.view, alias.address, seen);
+      differs = differs || seen != at_physical;
+    } else {
+      std::snprintf(item, sizeof(item), "; %s view %08X unreadable", alias.view, alias.address);
+    }
+    text += item;
+  }
+  text += differs ? "; THE VIEWS DIFFER" : "; the views agree";
+  int found = 0;
+  std::string near;
+  const uint32_t first = physical >= 0x2000 ? physical - 0x2000 : 0;
+  for (uint32_t at = first; at <= physical + 0x2000 && found < 16; at += 4) {
+    uint32_t word = 0;
+    if (at == physical || !reader.Physical(at, word)) continue;
+    if ((word & mask) != (ref & mask)) continue;
+    std::snprintf(item, sizeof(item), " %08X(%+d)", at, int32_t(at - physical));
+    near += item;
+    ++found;
+  }
+  text += found ? "; the awaited value is near at" + near : "; the awaited value is nowhere within 8 KiB";
+  return text;
+}
+
+class Trace {
+ public:
+  static constexpr size_t kWrites = 64, kTargets = 32;
+
+  void Record(uint32_t now_ms, Kind kind, uint32_t address, uint32_t value) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    ++totals_[size_t(kind)];
+    writes_[head_] = Write{now_ms, address, value, kind};
+    head_ = (head_ + 1) % kWrites;
+    if (count_ < kWrites) ++count_;
+    // The address's entry, else a free one, else the one written longest ago.
+    size_t slot = kTargets;
+    for (size_t n = 0; n < targets_used_; ++n)
+      if (targets_[n].address == address) slot = n;
+    if (slot == kTargets) {
+      if (targets_used_ < kTargets) {
+        slot = targets_used_++;
+      } else {
+        slot = 0;
+        for (size_t n = 1; n < kTargets; ++n)
+          if (targets_[n].last_ms < targets_[slot].last_ms) slot = n;
+      }
+      targets_[slot] = Target{address, value, 0, now_ms, now_ms, kind};
+    }
+    Target& target = targets_[slot];
+    target.value = value;
+    target.kind = kind;
+    target.last_ms = now_ms;
+    ++target.count;
+  }
+
+  void BeginWait(uint32_t now_ms, bool memory, uint32_t address, uint32_t ref, uint32_t mask,
+                 uint32_t function, uint32_t packet = 0) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    wait_ = WaitState{true, memory, address, ref, mask, function, now_ms, 0, 0};
+    wait_.packet = packet;
+    ++waits_;
+  }
+  void Poll(uint32_t value) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!wait_.polls) wait_.first_value = value;
+    ++wait_.polls;
+    wait_.value = value;
+  }
+  // True once for a wait that has lasted `limit_ms` (then logged by the command processor).
+  bool DueReport(uint32_t now_ms, uint32_t limit_ms) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!wait_.active || wait_.reported || now_ms - wait_.since_ms < limit_ms) return false;
+    wait_.reported = true;
+    return true;
+  }
+  void EndWait() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    wait_.active = false;
+  }
+  void SetPointers(uint32_t read, uint32_t write) {
+    read_.store(read, std::memory_order_relaxed);
+    write_.store(write, std::memory_order_relaxed);
+  }
+
+  std::vector<Write> Writes() const {  // oldest first
+    std::lock_guard<std::mutex> lock(mutex_);
+    std::vector<Write> out;
+    for (size_t n = 0; n < count_; ++n) out.push_back(writes_[(head_ + kWrites - count_ + n) % kWrites]);
+    return out;
+  }
+  std::vector<Target> Targets() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return std::vector<Target>(targets_.begin(), targets_.begin() + targets_used_);
+  }
+  WaitState Wait() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return wait_;
+  }
+  uint64_t Total(Kind kind) const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return totals_[size_t(kind)];
+  }
+  uint64_t Waits() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return waits_;
+  }
+  uint32_t ReadPointer() const { return read_.load(std::memory_order_relaxed); }
+  uint32_t WritePointer() const { return write_.load(std::memory_order_relaxed); }
+
+  // The targets whose last value is `value` (the address a fence value came from).
+  std::vector<Target> TargetsWithValue(uint32_t value) const {
+    std::vector<Target> out;
+    for (const Target& target : Targets())
+      if (target.value == value) out.push_back(target);
+    return out;
+  }
+
+ private:
+  mutable std::mutex mutex_;
+  std::array<Write, kWrites> writes_{};
+  size_t head_ = 0, count_ = 0;
+  std::array<Target, kTargets> targets_{};
+  size_t targets_used_ = 0;
+  std::array<uint64_t, size_t(Kind::kCount)> totals_{};
+  WaitState wait_;
+  uint64_t waits_ = 0;
+  std::atomic<uint32_t> read_{0}, write_{0};
+};
+
+// The command processor's trace (one GPU per emulator).
+inline Trace& Global() {
+  static Trace trace;
+  return trace;
+}
+
+}  // namespace cp_trace
+}  // namespace xbox360ps5
+
+#endif  // XENIA_GPU_CP_TRACE_H_
