+  bool Readable(uint32_t address) {
+    size_t length = 4;
+    xe::memory::PageAccess access;
+    return xe::memory::QueryProtect(memory->TranslateVirtual(address), length, access) &&
+           access != xe::memory::PageAccess::kNoAccess;
+  }
+  uint32_t Word(uint32_t address) { return xe::load_and_swap<uint32_t>(memory->TranslateVirtual(address)); }
+  // For xbox360ps5::cp_trace::AliasReport: a physical address as the GPU reads it, and a virtual
+  // one through the CPU's view.
+  bool Physical(uint32_t physical, uint32_t& value) {
+    size_t length = 4;
+    xe::memory::PageAccess access;
+    uint8_t* host = memory->TranslatePhysical(physical);
+    if (!xe::memory::QueryProtect(host, length, access) || access == xe::memory::PageAccess::kNoAccess) return false;
+    value = xe::load_and_swap<uint32_t>(host);
+    return true;
+  }
+  bool Virtual(uint32_t address, uint32_t& value) {
+    if (!Readable(address)) return false;
+    value = Word(address);
+    return true;
+  }
+};
+// Physical memory as the GPU reads it, for stall_dump's Words (the packets around a GPU wait).
+struct PhysicalReader {
+  StallReader& reader;
+  bool Readable(uint32_t physical) {
+    uint32_t value;
+    return physical < 0x20000000 && reader.Physical(physical, value);
+  }
+  uint32_t Word(uint32_t physical) {
+    uint32_t value = 0;
+    reader.Physical(physical, value);
+    return value;
+  }
+};
+// Fix 24: the executable's import thunks by address ("xboxkrnl.exe!KeWaitForSingleObject"), and
+// each library's table logged once a process, to name the calls the STALL report shows.
+const std::map<uint32_t, std::string>& ImportThunks(xe::Emulator& emulator) {
+  static std::map<uint32_t, std::string> thunks;
+  static bool made = false;
+  if (made) return thunks;
+  made = true;
+  auto module = emulator.kernel_state()->GetExecutableModule();
+  if (!module || !module->xex_module()) return thunks;
+  for (const auto& library : *module->xex_module()->import_libraries()) {
+    std::string line;
+    for (const auto& import : library.imports) {
+      auto* exported = emulator.processor()->export_resolver()->GetExportByOrdinal(library.name, uint16_t(import.ordinal));
+      const std::string name = exported && exported->name && *exported->name
+                                   ? std::string(exported->name)
+                                   : fmt::format("ordinal {}", import.ordinal);
+      if (import.thunk_address) thunks[import.thunk_address] = library.name + "!" + name;
+      line += fmt::format(" {:08X}={}", import.thunk_address, name);
+      if (line.size() > 900) {
+        XELOGW("STALL imports {}:{}", library.name, line);
+        line.clear();
+      }
+    }
+    if (!line.empty()) XELOGW("STALL imports {}:{}", library.name, line);
+  }
+  return thunks;
+}
+// The import a call goes to: its thunk (16 bytes from the recorded address), or "".
+std::string ImportAt(const std::map<uint32_t, std::string>& thunks, uint32_t target) {
+  auto found = thunks.upper_bound(target);
+  if (found == thunks.begin()) return "";
+  --found;
+  return target - found->first < 16 ? found->second : "";
+}
