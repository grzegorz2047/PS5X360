+// Xbox360PS5 (tools/source-1.0.2/fixes/24-stall-code-words.patch, candidate 21): a log line when
+// the guest enters one of a few functions of Battlefield 3 (title 45410950), to tell whether its
+// render job ever runs (research/bf3/ANALYSIS.md). The JIT calls a builtin at the entry of a
+// function only when the function's address and its first 12 code words are one of the probes
+// below, so no other executable is touched; the lines are written only once the title has
+// enabled them (the launcher does for 45410950), the counts always. Header-only and free of
+// Xenia headers, so the host check tools/check-label-owner.cpp drives it.
+#ifndef XENIA_CPU_ENTRY_PROBE_H_
+#define XENIA_CPU_ENTRY_PROBE_H_
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+namespace xbox360ps5 {
+namespace entry_probe {
+
+constexpr int kWords = 12;    // code words that must match
+constexpr int kProbes = 8;
+constexpr int kLinesPerProbe = 24;  // the D3D and render-job probes
+// Candidate 31: the job manager's probes log more, and only once the render job has run (the
+// loading screen runs thousands of jobs before).
+constexpr int kJobLines = 400;
+
+struct Probe {
+  uint32_t address;
+  const char* name;
+  std::array<uint32_t, kWords> words;
+  int object_reg;           // the register holding the command buffer (-1: none)
+  int context_reg;          // a register whose words at context_offset are logged (-1: none)
+  uint32_t context_offset;  // 3 words
+  int extra_reg;            // candidate 31: 3 more words (-1: none)
+  uint32_t extra_offset;
+  int lines;                // lines logged
+  bool after_render_job;    // logged only once probe 0 (the render job) has been entered
+};
+
+// Battlefield 3 (BF.Main.xex, both discs, base 82D80000).
+inline const std::array<Probe, kProbes>& Probes() {
+  static const std::array<Probe, kProbes> probes = {{
+      {0x83D2C8A8u, "render job",
+       {0x7D8802A6u, 0x9181FFF8u, 0xFBC1FFE8u, 0xFBE1FFF0u, 0x9421FF90u, 0x7C7F1B78u,
+        0x7CBE2B78u, 0x4BFFFD75u, 0x7FC4F378u, 0x7FE3FB78u, 0x4BFF5381u, 0x38210070u},
+       -1, 5, 0x79C, -1, 0, kLinesPerProbe, false},
+      {0x82FD54A0u, "begin command buffer",
+       {0x7D8802A6u, 0x488DF97Du, 0x9421FF50u, 0x8164006Cu, 0x39400001u, 0x7D374B78u,
+        0x81240008u, 0x514B0F3Eu, 0x7C7F1B78u, 0x7C9E2378u, 0x9164006Cu, 0x7CB82B78u},
+       4, -1, 0, -1, 0, kLinesPerProbe, false},
+      {0x82FD7398u, "finish command buffer",
+       {0x7D8802A6u, 0x488DDA85u, 0x9421FF50u, 0x7C7D1B78u, 0x7C972378u, 0x7CBF2B78u,
+        0x7CD93378u, 0x7CFE3B78u, 0x48EF6C6Du, 0x2F030002u, 0x409A0010u, 0x3D6082D8u},
+       3, -1, 0, -1, 0, kLinesPerProbe, false},
+      {0x82FD6B78u, "release label",
+       {0x7D8802A6u, 0x488DE2B1u, 0x9421FF70u, 0x83A40008u, 0x7C7F1B78u, 0x7C9E2378u,
+        0x7CBA2B78u, 0x7CD93378u, 0x488FAC71u, 0x817F2B08u, 0x7F0B1840u, 0x409A0014u},
+       4, -1, 0, -1, 0, kLinesPerProbe, false},
+      {0x82FD6CF0u, "run command buffer",
+       {0x7D8802A6u, 0x488DE12Du, 0x9421FF50u, 0xE9640018u, 0x7C9C2378u, 0xE9430000u,
+        0x7CD93378u, 0xE9240038u, 0x3AE00000u, 0xE9040030u, 0x7D645038u, 0xE9430020u},
+       4, -1, 0, -1, 0, kLinesPerProbe, false},
+      // Candidate 31, the job manager (research/bf3/ANALYSIS.md 8-11): a render job's
+      // dependency on a sync job the GPU makes runnable (r3: the render job's handle
+      // {vtable, job, sequence}).
+      {0x8346ED68u, "add GPU-kicked dependency",
+       {0x7D8802A6u, 0x484460C5u, 0x9421FF40u, 0x39600000u, 0x81430004u, 0x7C7A1B78u,
+        0x99610060u, 0x7C9C2378u, 0x99610078u, 0x7CBB2B78u, 0x99610079u, 0x39000000u},
+       -1, 3, 0x0, -1, 0, kJobLines, true},
+      // A job into the queue (r3 the queue, r4 the job: +18 function, +1C, +20 pending
+      // dependencies; +50 sequence, priority, affinity).
+      {0x8346E3B0u, "push job",
+       {0x7D8802A6u, 0x9181FFF8u, 0xFBE1FFF0u, 0x9421FF90u, 0x89640052u, 0x39400000u,
+        0x89040053u, 0x7C691B78u, 0xA0C40050u, 0x38E00000u, 0x80A30010u, 0xF9410050u},
+       -1, 4, 0x18, 4, 0x50, kJobLines, true},
+      // A finished job's dependency links (r3 the first: +0 state/version, +4 next, +8
+      // callback; +C its argument, +10 pool).
+      {0x8346D590u, "run dependency links",
+       {0x7D8802A6u, 0x484478A1u, 0x9421FF70u, 0x7C7F1B78u, 0x7C9B2378u, 0x2B030000u,
+        0x419A00F0u, 0x3BA00000u, 0x3B80FFFFu, 0xE97F0000u, 0x557E003Eu, 0xE95F0000u},
+       -1, 3, 0x0, 3, 0xC, kJobLines, true},
+  }};
+  return probes;
+}
+
+// The probe for a function starting at `address`, or -1. `read(address)` gives a code word.
+template <typename Read>
+int Find(uint32_t address, Read read) {
+  const auto& probes = Probes();
+  for (int n = 0; n < kProbes; ++n) {
+    if (probes[n].address != address) continue;
+    for (int w = 0; w < kWords; ++w)
+      if (read(address + 4u * w) != probes[n].words[w]) return -1;
+    return n;
+  }
+  return -1;
+}
+
+inline uint32_t NowMs() {
+  static const auto start = std::chrono::steady_clock::now();
+  return uint32_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                      std::chrono::steady_clock::now() - start)
+                      .count());
+}
+
+struct Count {
+  uint64_t entered = 0;
+  uint32_t last_ms = 0, last_thread = 0, last_r3 = 0, last_r4 = 0, last_lr = 0;
+};
+
+class Counters {
+ public:
+  void Enable(bool on) { enabled_.store(on, std::memory_order_relaxed); }
+  bool Enabled() const { return enabled_.load(std::memory_order_relaxed); }
+  // Counts an entry; true when it should be logged (enabled, and the probe's first lines).
+  bool Enter(int probe, uint32_t now_ms, uint32_t thread, uint32_t r3, uint32_t r4, uint32_t lr,
+             uint64_t* number) {
+    Slot& slot = slots_[probe];
+    *number = slot.entered.fetch_add(1, std::memory_order_relaxed) + 1;
+    slot.last_ms.store(now_ms, std::memory_order_relaxed);
+    slot.last_thread.store(thread, std::memory_order_relaxed);
+    slot.last_r3.store(r3, std::memory_order_relaxed);
+    slot.last_r4.store(r4, std::memory_order_relaxed);
+    slot.last_lr.store(lr, std::memory_order_relaxed);
+    if (!Enabled()) return false;
+    const Probe& spec = Probes()[probe];
+    if (spec.after_render_job && !slots_[0].entered.load(std::memory_order_relaxed)) return false;
+    return slot.logged.fetch_add(1, std::memory_order_relaxed) < spec.lines;
+  }
+  Count Get(int probe) const {
+    const Slot& slot = slots_[probe];
+    Count count;
+    count.entered = slot.entered.load(std::memory_order_relaxed);
+    count.last_ms = slot.last_ms.load(std::memory_order_relaxed);
+    count.last_thread = slot.last_thread.load(std::memory_order_relaxed);
+    count.last_r3 = slot.last_r3.load(std::memory_order_relaxed);
+    count.last_r4 = slot.last_r4.load(std::memory_order_relaxed);
+    count.last_lr = slot.last_lr.load(std::memory_order_relaxed);
+    return count;
+  }
+  // The JIT inserted the probe into the function (its code matched).
+  void Installed(int probe) { slots_[probe].installed.store(true, std::memory_order_relaxed); }
+  bool IsInstalled(int probe) const { return slots_[probe].installed.load(std::memory_order_relaxed); }
+
+ private:
+  struct Slot {
+    std::atomic<uint64_t> entered{0};
+    std::atomic<uint32_t> last_ms{0}, last_thread{0}, last_r3{0}, last_r4{0}, last_lr{0};
+    std::atomic<int> logged{0};
+    std::atomic<bool> installed{false};
+  };
+  std::array<Slot, kProbes> slots_;
+  std::atomic<bool> enabled_{false};
+};
+
+inline Counters& Global() {
+  static Counters counters;
+  return counters;
+}
+
+// The command buffer flags at +0x68 by name (0x20 run, 0x40 finished by its recorder).
+inline std::string FlagNames(uint32_t flags) {
+  std::string text;
+  if (flags & 0x20) text += "run";
+  if (flags & 0x40) text += text.empty() ? "finished" : "+finished";
+  return text.empty() ? "neither run nor finished" : text;
+}
+
+// One entry. `object` holds +0x08 +0x68 +0x7C +0x80 of the command buffer (readable: false when
+// the host cannot read it), `context` the 3 words at the probe's context offset.
+struct Entry {
+  uint64_t number = 0;
+  uint32_t thread = 0, lr = 0;
+  std::array<uint32_t, 4> r{};  // r3..r6
+  bool object_read = false;
+  uint32_t object = 0;
+  std::array<uint32_t, 4> object_words{};
+  bool context_read = false;
+  uint32_t context = 0;
+  std::array<uint32_t, 3> context_words{};
+  bool extra_read = false;
+  uint32_t extra = 0;
+  std::array<uint32_t, 3> extra_words{};
+};
+
+inline std::string Line(const Probe& probe, const Entry& entry) {
+  char text[384];
+  int used = std::snprintf(text, sizeof(text),
+                           "PROBE %08X %s entered (#%llu) thread id %u lr %08X r3 %08X r4 %08X r5 %08X r6 %08X",
+                           probe.address, probe.name, static_cast<unsigned long long>(entry.number),
+                           entry.thread, entry.lr, entry.r[0], entry.r[1], entry.r[2], entry.r[3]);
+  std::string line(text, used <= 0 ? 0 : size_t(used) < sizeof(text) ? size_t(used) : sizeof(text) - 1);
+  if (probe.object_reg >= 0) {
+    if (entry.object_read)
+      std::snprintf(text, sizeof(text), "; command buffer r%d %08X: +08 %08X +68 %08X (%s) +7C %08X +80 %08X",
+                    probe.object_reg, entry.object, entry.object_words[0], entry.object_words[1],
+                    FlagNames(entry.object_words[1]).c_str(), entry.object_words[2], entry.object_words[3]);
+    else
+      std::snprintf(text, sizeof(text), "; command buffer r%d %08X unreadable", probe.object_reg, entry.object);
+    line += text;
+  }
+  if (probe.context_reg >= 0) {
+    if (entry.context_read)
+      std::snprintf(text, sizeof(text), "; r%d+%X: %08X %08X %08X", probe.context_reg, probe.context_offset,
+                    entry.context_words[0], entry.context_words[1], entry.context_words[2]);
+    else
+      std::snprintf(text, sizeof(text), "; r%d+%X unreadable", probe.context_reg, probe.context_offset);
+    line += text;
+  }
+  if (probe.extra_reg >= 0) {
+    if (entry.extra_read)
+      std::snprintf(text, sizeof(text), "; r%d+%X: %08X %08X %08X", probe.extra_reg, probe.extra_offset,
+                    entry.extra_words[0], entry.extra_words[1], entry.extra_words[2]);
+    else
+      std::snprintf(text, sizeof(text), "; r%d+%X unreadable", probe.extra_reg, probe.extra_offset);
+    line += text;
+  }
+  return line;
+}
+
+// The STALL report's summary of a probe.
+inline std::string Summary(const Probe& probe, bool installed, const Count& count, uint32_t now_ms) {
+  char text[256];
+  if (!installed)
+    std::snprintf(text, sizeof(text), "PROBE %08X %s: not compiled yet (never called, or the code differs)",
+                  probe.address, probe.name);
+  else if (!count.entered)
+    std::snprintf(text, sizeof(text), "PROBE %08X %s: compiled, never entered", probe.address, probe.name);
+  else
+    std::snprintf(text, sizeof(text),
+                  "PROBE %08X %s: entered %llu times, last -%u ms by thread id %u from lr %08X, r3 %08X r4 %08X",
+                  probe.address, probe.name, static_cast<unsigned long long>(count.entered),
+                  now_ms - count.last_ms, count.last_thread, count.last_lr, count.last_r3, count.last_r4);
+  return text;
+}
+
+}  // namespace entry_probe
+}  // namespace xbox360ps5
+
+#endif  // XENIA_CPU_ENTRY_PROBE_H_
