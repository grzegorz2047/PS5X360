+// Candidate 21: the word-aligned addresses in [first, last) that hold `value`, at most `limit`;
+// pages the host cannot read are skipped whole (Battlefield 3's render jobs, found by their
+// function pointer).
+template <typename Reader>
+std::vector<uint32_t> FindWord(Reader& reader, uint32_t first, uint32_t last, uint32_t value, size_t limit) {
+  std::vector<uint32_t> found;
+  first &= ~3u;
+  for (uint64_t page = first & ~0xFFFull; page < last && found.size() < limit; page += 0x1000) {
+    if (!reader.Readable(uint32_t(page))) continue;
+    for (uint64_t at = page < first ? first : page; at < page + 0x1000 && at < last; at += 4) {
+      if (reader.Word(uint32_t(at)) != value) continue;
+      found.push_back(uint32_t(at));
+      if (found.size() >= limit) break;
+    }
+  }
+  return found;
+}
