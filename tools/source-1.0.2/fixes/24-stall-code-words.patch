+// Fix 24: eight guest code words from `address` - 16 (when readable), for a loop a thread spins
+// in outside any wait (Battlefield 3's loaders at lr 838D4514), to disassemble from the log.
+std::string CodeText(xe::Memory* memory, uint32_t address) {
+  std::string text;
+  for (uint32_t at = (address & ~3u) - 16, n = 0; n < 8; ++n, at += 4) {
+    auto* heap = memory->LookupHeap(at);
+    uint32_t protection = 0;
+    if (!heap || !heap->QueryProtect(at, &protection) || !(protection & xe::kMemoryProtectRead)) {
+      text += " ????????";
+      continue;
+    }
+    char item[16];
+    std::snprintf(item, sizeof(item), " %08X", xe::load_and_swap<uint32_t>(memory->TranslateVirtual(at)));
+    text += item;
+  }
+  return text;
+}
