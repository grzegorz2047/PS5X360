new file mode 100644
index 0000000..d6101f3
--- /dev/null
+++ b/.deps/xenia-canary/src/xenia/kernel/object_history.h
@@ -0,0 +1,127 @@
+// Xbox360PS5 (tools/source-1.0.2/fixes/24-stall-code-words.patch): the last waits and releases
+// of a kernel object (event, semaphore, mutant, thread), for the STALL report of a game that
+// spins on one (Battlefield 3's JobManagers after the campaign has loaded). Header-only and free
+// of Xenia headers, so the host check tools/check-stall-dump.cpp drives it.
+//
+// Each object keeps its last kSize operations. An operation equal to the one before it (same
+// thread, kind, argument and result, such as a zero-timeout poll that keeps timing out) only
+// counts a repeat, so a spinning poll does not push the releases out.
+#ifndef XENIA_KERNEL_OBJECT_HISTORY_H_
+#define XENIA_KERNEL_OBJECT_HISTORY_H_
+
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace xbox360ps5 {
+namespace object_history {
+
+enum class Op : uint8_t {
+  kWait = 1,      // a wait on this object alone; arg: timeout in ms (-1: none)
+  kWaitAny,       // a wait on several, any of them; arg: timeout in ms
+  kWaitAll,       // a wait on several, all of them; arg: timeout in ms
+  kRelease,       // semaphore release; arg: count, result: previous count (-1: refused)
+  kSet,           // event set
+  kPulse,         // event pulse
+  kReset,         // event reset
+  kMutantRelease, // mutant release; result: status
+};
+
+inline const char* OperationName(Op op) {
+  switch (op) {
+    case Op::kWait: return "wait";
+    case Op::kWaitAny: return "wait-any";
+    case Op::kWaitAll: return "wait-all";
+    case Op::kRelease: return "release";
+    case Op::kSet: return "set";
+    case Op::kPulse: return "pulse";
+    case Op::kReset: return "reset";
+    case Op::kMutantRelease: return "mutant-release";
+  }
+  return "?";
+}
+
+struct Entry {
+  uint32_t first_ms = 0, last_ms = 0;  // first and last time (NowMs) it happened
+  uint32_t thread = 0;                 // the calling thread's handle (0: not a guest thread)
+  Op op = Op::kWait;
+  int32_t arg = 0;
+  uint32_t result = 0;
+  uint32_t repeats = 0;                // how many times in a row
+};
+
+// Milliseconds since the first use (the process's start, near enough).
+inline uint32_t NowMs() {
+  static const auto start = std::chrono::steady_clock::now();
+  return uint32_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                      std::chrono::steady_clock::now() - start)
+                      .count());
+}
+
+class Ring {
+ public:
+  static constexpr size_t kSize = 16;
+
+  void Record(uint32_t now_ms, uint32_t thread, Op op, int32_t arg, uint32_t result) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    ++total_;
+    if (count_) {
+      Entry& last = entries_[(head_ + kSize - 1) % kSize];
+      if (last.thread == thread && last.op == op && last.arg == arg && last.result == result) {
+        ++last.repeats;
+        last.last_ms = now_ms;
+        return;
+      }
+    }
+    Entry& entry = entries_[head_];
+    entry = Entry{now_ms, now_ms, thread, op, arg, result, 1};
+    head_ = (head_ + 1) % kSize;
+    if (count_ < kSize) ++count_;
+  }
+
+  // Oldest first.
+  std::vector<Entry> Entries() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    std::vector<Entry> out;
+    out.reserve(count_);
+    for (size_t n = 0; n < count_; ++n) out.push_back(entries_[(head_ + kSize - count_ + n) % kSize]);
+    return out;
+  }
+  uint64_t total() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return total_;
+  }
+
+ private:
+  mutable std::mutex mutex_;
+  std::array<Entry, kSize> entries_{};
+  size_t head_ = 0, count_ = 0;
+  uint64_t total_ = 0;
+};
+
+// " [-<ms ago>ms <thread> <op> <arg> -> <result> x<repeats> over <ms>ms]" per entry, oldest first.
+inline std::string Format(const std::vector<Entry>& entries, uint32_t now_ms) {
+  std::string text;
+  for (const Entry& entry : entries) {
+    char item[160];
+    const uint32_t ago = now_ms >= entry.last_ms ? now_ms - entry.last_ms : 0;
+    std::snprintf(item, sizeof(item), " [-%ums %08X %s %d -> %08X x%u", ago, entry.thread,
+                  OperationName(entry.op), entry.arg, entry.result, entry.repeats);
+    text += item;
+    if (entry.repeats > 1) {
+      std::snprintf(item, sizeof(item), " over %ums", entry.last_ms - entry.first_ms);
+      text += item;
+    }
+    text += "]";
+  }
+  return text;
+}
+
+}  // namespace object_history
+}  // namespace xbox360ps5
+
+#endif  // XENIA_KERNEL_OBJECT_HISTORY_H_
