+// The relative branch-and-link instructions (bl) among `count` words from `first`: where each
+// is and where it goes (PowerPC: primary opcode 18, AA 0, LK 1; a signed 24-bit word offset).
+struct Call {
+  uint32_t site = 0, target = 0;
+};
+template <typename Reader>
+std::vector<Call> Calls(Reader& reader, uint32_t first, uint32_t count) {
+  std::vector<Call> calls;
+  first &= ~3u;
+  for (uint32_t n = 0; n < count; ++n) {
+    const uint64_t at = uint64_t(first) + uint64_t(n) * 4;
+    if (at > 0xFFFFFFFCull || !reader.Readable(uint32_t(at))) continue;
+    const uint32_t word = reader.Word(uint32_t(at));
+    if ((word >> 26) != 18 || (word & 3) != 1) continue;
+    int32_t offset = int32_t(word & 0x03FFFFFC);
+    if (offset & 0x02000000) offset -= 0x04000000;
+    calls.push_back({uint32_t(at), uint32_t(int64_t(at) + offset)});
+  }
+  return calls;
+}
