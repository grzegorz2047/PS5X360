+  namespace ct = xbox360ps5::cp_trace;
+  struct Reader {
+    Memory* memory;
+    static bool HostReadable(const void* host) {
+      size_t length = 4;
+      xe::memory::PageAccess access;
+      return xe::memory::QueryProtect(const_cast<void*>(host), length, access) &&
+             access != xe::memory::PageAccess::kNoAccess;
+    }
+    bool Physical(uint32_t physical, uint32_t& value) {
+      const uint8_t* host = memory->TranslatePhysical(physical);
+      if (!HostReadable(host)) return false;
+      value = xe::load_and_swap<uint32_t>(host);
+      return true;
+    }
+    bool Virtual(uint32_t address, uint32_t& value) {
+      const uint8_t* host = memory->TranslateVirtual(address);
+      if (!HostReadable(host)) return false;
+      value = xe::load_and_swap<uint32_t>(host);
+      return true;
+    }
+  } reader{memory_};
+  static const char* const kFunctions[] = {"never", "<",  "<=", "==",
+                                           "!=",    ">=", ">",  "always"};
+  const auto wait = ct::Global().Wait();
+  const uint32_t physical = ct::PacketAddress(poll_address);
+  XELOGW(
+      "GPU: WAIT_REG_MEM on memory {:08X} (endian {}) has waited 2 s: (value & "
+      "{:08X}) {} {:08X}; value {:08X} when it began, {:08X} now; packet at "
+      "physical {:08X}; ring read {:08X} write {:08X}",
+      physical, ct::EndianName(poll_address), mask, kFunctions[function & 7],
+      ref, wait.first_value, wait.value, wait.packet,
+      ct::Global().ReadPointer(), ct::Global().WritePointer());
+  XELOGW("GPU: that dword: {}",
+         ct::AliasReport(reader, physical, ref, mask));
+}
