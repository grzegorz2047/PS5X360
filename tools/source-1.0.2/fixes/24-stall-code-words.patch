diff --git a/port/stall_dump.hpp b/port/stall_dump.hpp
new file mode 100644
index 0000000..de969ee
--- /dev/null
+++ b/port/stall_dump.hpp
@@ -0,0 +1,170 @@
+// SPDX-License-Identifier: MIT
+// Fix 24 of the source rebuild (tools/source-1.0.2/fixes/24-stall-code-words.patch): what the
+// STALL report reads from a guest thread that spins outside any wait, as templates over a
+// memory reader, so the host check tools/check-stall-dump.cpp drives them with fake memory.
+// No Xenia headers here.
+//
+// Reader:
+//   bool Readable(uint32_t address);   the 4 bytes at `address` can be read (host access)
+//   uint32_t Word(uint32_t address);   the big-endian word there
+#pragma once
+#include <cstdint>
+#include <cstdio>
+#include <string>
+#include <vector>
+
+namespace xbox360ps5 {
+namespace stall_dump {
+
+// `count` words from `first` (word-aligned), "????????" for each one that cannot be read.
+template <typename Reader>
+std::string Words(Reader& reader, uint32_t first, uint32_t count) {
+  std::string text;
+  first &= ~3u;
+  for (uint32_t n = 0; n < count; ++n) {
+    const uint64_t at = uint64_t(first) + uint64_t(n) * 4;
+    char item[16];
+    if (at > 0xFFFFFFFCull || !reader.Readable(uint32_t(at)))
+      std::snprintf(item, sizeof(item), " ????????");
+    else
+      std::snprintf(item, sizeof(item), " %08X", reader.Word(uint32_t(at)));
+    text += item;
+  }
+  return text;
+}
+
+// 64 bytes around a code address: 8 words before it and 8 from it (the address's own word is
+// the ninth), so the loop's branch and what it reads are in view.
+template <typename Reader>
+std::string CodeWindow(Reader& reader, uint32_t address) {
+  const uint32_t aligned = address & ~3u;
+  return Words(reader, aligned >= 32 ? aligned - 32 : 0, 16);
+}
+
+struct Frame {
+  uint32_t address = 0;   // the frame (r1 for the first)
+  uint32_t back = 0;      // its back chain: the caller's frame
+  uint32_t saved_lr = 0;  // the return address the caller's frame keeps (at back - 8)
+  bool lr_read = false;
+  std::string words;      // the frame's first 8 words
+};
+
+// The back chain from r1: each frame's first word is its caller's frame, which keeps the return
+// address 8 bytes below its start. Stops at an unreadable or misaligned frame, one that does
+// not move up the stack, a jump of more than 64 KiB, or after `limit` frames.
+template <typename Reader>
+std::vector<Frame> StackFrames(Reader& reader, uint32_t r1, int limit = 8) {
+  std::vector<Frame> frames;
+  uint32_t frame = r1;
+  for (int depth = 0; depth < limit; ++depth) {
+    if (!frame || (frame & 3) || !reader.Readable(frame)) break;
+    Frame item;
+    item.address = frame;
+    item.back = reader.Word(frame);
+    item.words = Words(reader, frame, 8);
+    const bool chained = item.back > frame && item.back - frame <= 0x10000;
+    if (chained && item.back >= 8 && reader.Readable(item.back - 8)) {
+      item.saved_lr = reader.Word(item.back - 8);
+      item.lr_read = true;
+    }
+    frames.push_back(item);
+    if (!chained) break;
+    frame = item.back;
+  }
+  return frames;
+}
+
+// A register value worth dumping memory at: a guest address (not a small number, not a handle,
+// not the address space's last page). Stack addresses count: Battlefield 3's main thread spins
+// on an object in its own frame (7018D5A0). So does physical memory above the handles: its job
+// objects are at FFC4xxxx.
+inline bool LooksLikeData(uint32_t value) {
+  if (value < 0x10000) return false;
+  if (value >= 0xF8000000 && value < 0xF9000000) return false;  // handles
+  return value < 0xFFFF0000;
+}
+
+// A stack address (the guest threads' stacks are at 0x70000000).
+inline bool IsStack(uint32_t value) { return value >= 0x70000000 && value < 0x80000000; }
+
+// The words among `count` from `first` that point at other guest data (not a stack, not the
+// window itself), at most `limit`: what an object the thread spins on refers to (Battlefield
+// 3's main thread: its stack object's first word, 40218A00, is the one the GPU thread uses).
+struct Pointer {
+  uint32_t index = 0, value = 0;
+};
+template <typename Reader>
+std::vector<Pointer> Pointers(Reader& reader, uint32_t first, uint32_t count, size_t limit) {
+  std::vector<Pointer> pointers;
+  first &= ~3u;
+  for (uint32_t n = 0; n < count && pointers.size() < limit; ++n) {
+    const uint64_t at = uint64_t(first) + uint64_t(n) * 4;
+    if (at > 0xFFFFFFFCull || !reader.Readable(uint32_t(at))) continue;
+    const uint32_t value = reader.Word(uint32_t(at));
+    if (!LooksLikeData(value) || IsStack(value) || (value & 3)) continue;
+    if (value >= first && value < first + count * 4) continue;
+    pointers.push_back({n, value});
+  }
+  return pointers;
+}
+
+// A register value that looks like a kernel object handle (0xF8000000 + 4n).
+inline bool LooksLikeHandle(uint32_t value) {
+  return value > 0xF8000000 && value < 0xF9000000 && (value & 3) == 0;
+}
+
+enum class ThreadState : uint8_t { kRunning, kExited, kNotStarted };
+inline const char* ThreadStateName(ThreadState state) {
+  switch (state) {
+    case ThreadState::kRunning: return "running";
+    case ThreadState::kExited: return "exited (object still referenced)";
+    case ThreadState::kNotStarted: return "not started";
+  }
+  return "?";
+}
+// A guest thread from its host state and its KTHREAD: ended once the guest object says so
+// (terminated, or its dispatch header signalled) and the host thread no longer runs.
+inline ThreadState Classify(bool running, bool terminated, bool signalled) {
+  if (running && !terminated) return ThreadState::kRunning;
+  if (terminated || signalled) return ThreadState::kExited;
+  return ThreadState::kNotStarted;
+}
+
+// The relative branch-and-link instructions (bl) among `count` words from `first`: where each
+// is and where it goes (PowerPC: primary opcode 18, AA 0, LK 1; a signed 24-bit word offset).
+struct Call {
+  uint32_t site = 0, target = 0;
+};
+template <typename Reader>
+std::vector<Call> Calls(Reader& reader, uint32_t first, uint32_t count) {
+  std::vector<Call> calls;
+  first &= ~3u;
+  for (uint32_t n = 0; n < count; ++n) {
+    const uint64_t at = uint64_t(first) + uint64_t(n) * 4;
+    if (at > 0xFFFFFFFCull || !reader.Readable(uint32_t(at))) continue;
+    const uint32_t word = reader.Word(uint32_t(at));
+    if ((word >> 26) != 18 || (word & 3) != 1) continue;
+    int32_t offset = int32_t(word & 0x03FFFFFC);
+    if (offset & 0x02000000) offset -= 0x04000000;
+    calls.push_back({uint32_t(at), uint32_t(int64_t(at) + offset)});
+  }
+  return calls;
+}
+
+// Samples of one place over time, keeping a sample only when it differs from the one before.
+struct ChangeLog {
+  struct Sample {
+    uint32_t ms = 0;
+    std::string text;
+  };
+  std::vector<Sample> samples;
+  uint32_t last_ms = 0;
+  void Add(uint32_t ms, const std::string& text) {
+    last_ms = ms;
+    if (samples.empty() || samples.back().text != text) samples.push_back({ms, text});
+  }
+  bool Changed() const { return samples.size() > 1; }
+};
+
+}  // namespace stall_dump
+}  // namespace xbox360ps5
