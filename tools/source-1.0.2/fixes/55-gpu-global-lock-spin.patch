diff --git a/include/xbox360ps5/global_lock_spin.hpp b/include/xbox360ps5/global_lock_spin.hpp
new file mode 100644
--- /dev/null
+++ b/include/xbox360ps5/global_lock_spin.hpp
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: MIT
+// Fix 55 (tools/source-1.0.2/fixes/55-gpu-global-lock-spin.patch): the GPU command thread waits
+// for the global critical region by spinning on its own core before it sleeps.
+//
+// The guide's profile of 1.0.4_candidate_6 (logs/v104-c6) put the GPU command thread, the one
+// thread these games wait for, in std::recursive_mutex::lock, the global critical region's
+// blocking mutex (the "Fast locks" option off, as by default), for 41% of its samples in
+// Battlefield 3, 18-24% in Black Ops and 12-15% in Modern Warfare 2: SharedMemory::RequestRange,
+// MakeRangeValid and UploadRanges and PhysicalHeap::EnableAccessCallbacks take it for every
+// buffer of a draw and every upload, and the guest's threads take it in their write faults and
+// kernel calls, briefly. A thread that finds it taken sleeps in the kernel and is woken later,
+// which costs far more than the holder's few microseconds. "Fast locks" spins, but replaces the
+// mutex for every thread and has a known cost (Fable II). This changes only how the GPU thread
+// waits for the same mutex: try_lock between pauses for about 37 us (2048 pauses on Zen 2),
+// then the normal lock. Every other thread, and the mutex, stay as they are.
+//
+// Stats (written by the GPU thread only, read by the 30-s summary): locks taken, the contended
+// ones, those won while spinning and those that slept, the time spent waiting (TSC ticks), and
+// the shared-memory requests answered without the lock (all pages valid, RequestRange).
+#pragma once
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+#include <pthread.h>
+#include <x86intrin.h>
+
+namespace xbox360ps5 {
+namespace global_lock {
+
+// The thread that spins: the GPU command thread names itself (CommandProcessor::WorkerThreadMain).
+// A pthread_self() comparison, not a thread_local: thread-local storage is emulated on this
+// target (a pthread key), and every guest thread's lock passes here.
+inline std::atomic<uint64_t> spin_thread{0};
+inline void SpinOnThisThread() { spin_thread.store(uint64_t(pthread_self()), std::memory_order_relaxed); }
+inline void SpinOnNoThread() { spin_thread.store(0, std::memory_order_relaxed); }
+inline bool SpinsHere() { return spin_thread.load(std::memory_order_relaxed) == uint64_t(pthread_self()); }
+inline constexpr uint32_t kSpinPauses = 2048;
+inline constexpr uint32_t kTryEvery = 16;  // pauses between two try_lock
+
+struct Stats {
+  std::atomic<uint64_t> taken{0}, contended{0}, won_spinning{0}, slept{0}, wait_ticks{0};
+  std::atomic<uint64_t> lock_free_requests{0};
+};
+inline Stats stats;
+// Single writer (the GPU thread): a relaxed load and store, no locked instruction.
+inline void Add(std::atomic<uint64_t>& counter, uint64_t value = 1) {
+  counter.store(counter.load(std::memory_order_relaxed) + value, std::memory_order_relaxed);
+}
+
+// Locks `mutex` (a std::recursive_mutex): plainly on every thread but the spinning one; that one
+// tries first, then between pauses, and sleeps only after kSpinPauses.
+template <class Mutex>
+inline void Lock(Mutex& mutex) {
+  if (!SpinsHere()) {
+    mutex.lock();
+    return;
+  }
+  Add(stats.taken);
+  if (mutex.try_lock()) return;
+  Add(stats.contended);
+  const uint64_t start = __rdtsc();
+  for (uint32_t pauses = 1; pauses <= kSpinPauses; ++pauses) {
+    _mm_pause();
+    if (pauses % kTryEvery == 0 && mutex.try_lock()) {
+      Add(stats.won_spinning);
+      Add(stats.wait_ticks, __rdtsc() - start);
+      return;
+    }
+  }
+  mutex.lock();
+  Add(stats.slept);
+  Add(stats.wait_ticks, __rdtsc() - start);
+}
+
+struct Snapshot {
+  uint64_t taken = 0, contended = 0, won_spinning = 0, slept = 0, wait_ticks = 0, lock_free_requests = 0;
+  uint64_t tsc = 0;
+};
+inline Snapshot Take() {
+  Snapshot s;
+  s.taken = stats.taken.load(std::memory_order_relaxed);
+  s.contended = stats.contended.load(std::memory_order_relaxed);
+  s.won_spinning = stats.won_spinning.load(std::memory_order_relaxed);
+  s.slept = stats.slept.load(std::memory_order_relaxed);
+  s.wait_ticks = stats.wait_ticks.load(std::memory_order_relaxed);
+  s.lock_free_requests = stats.lock_free_requests.load(std::memory_order_relaxed);
+  s.tsc = __rdtsc();
+  return s;
+}
+// The summary's line for the period between two snapshots `seconds` apart (the TSC's rate is
+// taken from the same period).
+inline std::string Line(const Snapshot& before, const Snapshot& now, double seconds) {
+  if (seconds <= 0) seconds = 1;
+  const double per_second = 1.0 / seconds;
+  const double ticks_per_ms = double(now.tsc - before.tsc) / (seconds * 1000.0);
+  const double wait_ms = ticks_per_ms > 0 ? double(now.wait_ticks - before.wait_ticks) / ticks_per_ms : 0;
+  char text[320];
+  std::snprintf(text, sizeof(text),
+                "Performance: global lock (GPU thread) %.0f/s taken, %.0f/s contended: %.0f/s won spinning, "
+                "%.0f/s slept, %.1f ms/s waiting; %.0f/s shared-memory requests answered without it",
+                double(now.taken - before.taken) * per_second, double(now.contended - before.contended) * per_second,
+                double(now.won_spinning - before.won_spinning) * per_second, double(now.slept - before.slept) * per_second,
+                wait_ms * per_second, double(now.lock_free_requests - before.lock_free_requests) * per_second);
+  return text;
+}
+
+}  // namespace global_lock
+}  // namespace xbox360ps5
