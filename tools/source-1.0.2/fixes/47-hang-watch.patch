@@ -283,6 +317,11 @@ void InstallCrashReport(const char* path) {
   action.sa_flags = SA_SIGINFO;
   sigemptyset(&action.sa_mask);
   for (int signal : kSignals) sigaction(signal, &action, nullptr);
+  struct sigaction ending{};
