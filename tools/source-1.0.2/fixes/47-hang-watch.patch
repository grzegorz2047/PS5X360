diff --git a/include/xbox360ps5/hang_watch.hpp b/include/xbox360ps5/hang_watch.hpp
new file mode 100644
--- /dev/null
+++ b/include/xbox360ps5/hang_watch.hpp
@@ -0,0 +1,503 @@
+// SPDX-License-Identifier: MIT
+// Fix 47 of the source rebuild (tools/source-1.0.2/fixes/47-hang-watch.patch): a watch for a
+// game whose picture stops and whose process the system ends without a crash report (Ninja
+// Gaiden II, issue #11: no STALL report, no Performance line, the app gone ~30 s later).
+//
+// The STALL report (fix 24) is written by the UI loop, which stops too when it is the one
+// blocked (a GPU that never finishes a submission blocks the presenter's Paint). This header
+// keeps, without locks and without Xenia headers (so tools/check-hang-watch.cpp drives it):
+//   - which host thread is inside which Vulkan call since when (fence waits, queue submits,
+//     swapchain acquires, pipeline creation; gpu_diag::Call and a few direct call sites),
+//     and for a fence wait the submission it waits for;
+//   - heartbeats of the UI loop and of the GPU command thread;
+//   - the last draws and resolves recorded into GPU submissions (shader hashes and objects,
+//     primitive, vertex count) and the last submission handed to the queue.
+// A Watcher, stepped once a second by its own thread, says when the UI loop or a call has
+// stood still for 3 s and returns the report lines. The title writes them, and a heartbeat line
+// every 2 s whatever happens (HeartbeatLine), with a plain write() and fsync() to logs/
+// hang-watch.txt opened when the game starts, to the kernel log, and to the TCP log stream only
+// if its lock is free: no lock is waited for, so even a process the system kills at once leaves
+// its last state. Candidate 1 (Ninja Gaiden II) showed no report at all: the game log and the
+// stream both come from the emulator's one log writer thread, so the heartbeat also counts the
+// lines handed to that writer and the lines it wrote (log_appended, log_written).
+#pragma once
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdarg>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+#include <utility>
+#include <vector>
+#include <pthread.h>
+
+namespace xbox360ps5 {
+namespace hang_watch {
+
+inline uint64_t NowMs() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count());
+}
+
+// One host thread: its role ("ui", "gpu" or none), the call it is in, since when.
+struct Slot {
+  std::atomic<uint64_t> owner{0};  // pthread_t, 0 when free
+  std::atomic<const char*> role{nullptr};
+  std::atomic<const char*> call{nullptr};
+  std::atomic<uint64_t> since_ms{0};
+  std::atomic<uint64_t> detail{0};  // submission awaited + 1, or 0
+  std::atomic<uint64_t> calls{0};
+};
+inline constexpr size_t kSlots = 64;
+inline std::array<Slot, kSlots> slots;
+
+// The calling thread's slot, claimed at its first use and freed when it exits; null when all
+// are taken (the call is then not watched).
+inline Slot* ThisThread() {
+  struct Holder {
+    Slot* slot = nullptr;
+    bool full = false;
+    ~Holder() {
+      if (!slot) return;
+      slot->call.store(nullptr, std::memory_order_relaxed);
+      slot->role.store(nullptr, std::memory_order_relaxed);
+      slot->detail.store(0, std::memory_order_relaxed);
+      slot->owner.store(0, std::memory_order_release);
+    }
+  };
+  static thread_local Holder holder;
+  if (holder.slot || holder.full) return holder.slot;
+  const uint64_t self = uint64_t(pthread_self());
+  for (Slot& slot : slots) {
+    uint64_t expected = 0;
+    if (slot.owner.compare_exchange_strong(expected, self, std::memory_order_acq_rel)) {
+      holder.slot = &slot;
+      return holder.slot;
+    }
+  }
+  holder.full = true;
+  return nullptr;
+}
+
+inline void NameThread(const char* role) {
+  if (Slot* slot = ThisThread()) slot->role.store(role, std::memory_order_release);
+}
+// The submission the next fence wait of this thread is for (cleared when the call ends).
+inline void SetAwaitedSubmission(uint64_t submission) {
+  if (Slot* slot = ThisThread()) slot->detail.store(submission + 1, std::memory_order_relaxed);
+}
+
+// Marks the calling thread as inside `call` (a string literal) for its lifetime. Nested
+// scopes keep the outer call's name and time.
+class InCall {
+ public:
+  explicit InCall(const char* call) : slot_(ThisThread()) {
+    if (!slot_) return;
+    if (slot_->call.load(std::memory_order_relaxed)) {
+      slot_ = nullptr;  // nested: the outer scope reports
+      return;
+    }
+    slot_->since_ms.store(NowMs(), std::memory_order_relaxed);
+    slot_->call.store(call, std::memory_order_release);
+  }
+  ~InCall() {
+    if (!slot_) return;
+    slot_->call.store(nullptr, std::memory_order_release);
+    slot_->detail.store(0, std::memory_order_relaxed);
+    slot_->calls.fetch_add(1, std::memory_order_relaxed);
+  }
+  InCall(const InCall&) = delete;
+  InCall& operator=(const InCall&) = delete;
+
+ private:
+  Slot* slot_;
+};
+
+// A loop that should keep turning: how often it did, and what it was last doing.
+struct Beat {
+  std::atomic<uint64_t> count{0};
+  std::atomic<uint32_t> phase{0};
+  void Mark(uint32_t now_phase) {
+    phase.store(now_phase, std::memory_order_relaxed);
+    count.fetch_add(1, std::memory_order_relaxed);
+  }
+};
+// UI loop phases.
+enum : uint32_t { kUiInput = 1, kUiPaint = 2, kUiSample = 3, kUiMeasure = 4 };
+// A line straight to hang-watch.txt (and the kernel log, and the stream if its lock is free),
+// past the emulator's log: set by the title while a game runs, null otherwise. The core uses it
+// where the process may end right after (a title that terminates itself, exit()).
+using RawSink = void (*)(const char* text, size_t size);
+inline std::atomic<RawSink> raw_sink{nullptr};
+inline void Raw(const std::string& text) {
+  if (RawSink sink = raw_sink.load(std::memory_order_acquire)) sink(text.data(), text.size());
+}
+
+// The emulator's log (xenia/base/logging.cc): lines handed to its writer thread and lines it
+// wrote to its sinks (the game log file and the TCP stream).
+inline std::atomic<uint64_t> log_appended{0}, log_written{0};
+// GPU command thread phases.
+enum : uint32_t { kGpuExecute = 1, kGpuIdle = 2 };
+inline Beat ui_loop, gpu_thread;
+inline const char* UiPhaseName(uint32_t phase) {
+  switch (phase) {
+    case kUiInput: return "input";
+    case kUiPaint: return "paint";
+    case kUiSample: return "sampling";
+    case kUiMeasure: return "measuring";
+    default: return "?";
+  }
+}
+inline const char* GpuPhaseName(uint32_t phase) {
+  switch (phase) {
+    case kGpuExecute: return "executing the ring";
+    case kGpuIdle: return "waiting for the guest";
+    default: return "?";
+  }
+}
+
+// Draws and resolves as they are recorded into submissions.
+enum : uint32_t { kDraw = 1, kResolve = 2 };
+struct Work {
+  std::atomic<uint64_t> serial{0};  // 1-based; 0 never written
+  std::atomic<uint64_t> submission{0};
+  std::atomic<uint64_t> vs{0}, ps{0};                      // ucode hashes (resolve: 0)
+  std::atomic<const void*> vs_object{nullptr}, ps_object{nullptr};
+  std::atomic<uint32_t> kind{0};
+  std::atomic<uint32_t> a{0}, b{0}, c{0};  // draw: primitive, host vertices, flags; resolve: address, bytes, format
+  // Candidate 8, draws: RB_SURFACE_INFO, RB_COLOR_INFO, RB_DEPTH_INFO, the used texture mask and
+  // the first used texture's fetch constant (dwords 0 and 1: format and pitch, base address).
+  std::atomic<uint32_t> surface{0}, color{0}, depth{0}, textures{0}, tex_d0{0}, tex_d1{0};
+};
+// Candidate 8: 128 (a frame of Ninja Gaiden II's menu is ~100 draws), was 32.
+inline constexpr size_t kWork = 128;
+inline std::array<Work, kWork> work;
+inline std::atomic<uint64_t> work_serial{0};
+// Draw flags.
+enum : uint32_t { kIndexed = 1, kMemExport = 2 };
+
+inline Work& NextWork(uint64_t submission, uint32_t kind) {
+  const uint64_t serial = work_serial.fetch_add(1, std::memory_order_relaxed) + 1;
+  Work& entry = work[(serial - 1) % kWork];
+  entry.serial.store(0, std::memory_order_relaxed);
+  entry.submission.store(submission, std::memory_order_relaxed);
+  entry.kind.store(kind, std::memory_order_relaxed);
+  return entry;
+}
+struct DrawState {
+  uint32_t surface = 0, color = 0, depth = 0, textures = 0, tex_d0 = 0, tex_d1 = 0;
+};
+inline void RecordDraw(uint64_t submission, uint64_t vs_hash, const void* vs, uint64_t ps_hash,
+                       const void* ps, uint32_t primitive, uint32_t host_vertices, uint32_t flags,
+                       const DrawState& state = DrawState()) {
+  Work& entry = NextWork(submission, kDraw);
+  entry.surface.store(state.surface, std::memory_order_relaxed);
+  entry.color.store(state.color, std::memory_order_relaxed);
+  entry.depth.store(state.depth, std::memory_order_relaxed);
+  entry.textures.store(state.textures, std::memory_order_relaxed);
+  entry.tex_d0.store(state.tex_d0, std::memory_order_relaxed);
+  entry.tex_d1.store(state.tex_d1, std::memory_order_relaxed);
+  entry.vs.store(vs_hash, std::memory_order_relaxed);
+  entry.ps.store(ps_hash, std::memory_order_relaxed);
+  entry.vs_object.store(vs, std::memory_order_relaxed);
+  entry.ps_object.store(ps, std::memory_order_relaxed);
+  entry.a.store(primitive, std::memory_order_relaxed);
+  entry.b.store(host_vertices, std::memory_order_relaxed);
+  entry.c.store(flags, std::memory_order_relaxed);
+  entry.serial.store(work_serial.load(std::memory_order_relaxed), std::memory_order_release);
+}
+inline void RecordResolve(uint64_t submission, uint32_t address, uint32_t bytes, uint32_t format) {
+  Work& entry = NextWork(submission, kResolve);
+  entry.vs.store(0, std::memory_order_relaxed);
+  entry.ps.store(0, std::memory_order_relaxed);
+  entry.vs_object.store(nullptr, std::memory_order_relaxed);
+  entry.ps_object.store(nullptr, std::memory_order_relaxed);
+  entry.a.store(address, std::memory_order_relaxed);
+  entry.b.store(bytes, std::memory_order_relaxed);
+  entry.c.store(format, std::memory_order_relaxed);
+  entry.serial.store(work_serial.load(std::memory_order_relaxed), std::memory_order_release);
+}
+
+// The GPU command processor's last queue submission and what it knew was complete then.
+struct Queue {
+  std::atomic<uint64_t> submitted{0}, completed{0}, submitted_ms{0}, submissions{0};
+};
+inline Queue queue;
+inline void Submitted(uint64_t submission, uint64_t completed) {
+  queue.submitted.store(submission, std::memory_order_relaxed);
+  queue.completed.store(completed, std::memory_order_relaxed);
+  queue.submitted_ms.store(NowMs(), std::memory_order_relaxed);
+  queue.submissions.fetch_add(1, std::memory_order_relaxed);
+}
+
+// A copy of what the watch reads, so a report is made from one consistent look.
+struct SlotView {
+  uint64_t owner = 0, since_ms = 0, detail = 0, calls = 0;
+  const char* role = nullptr;
+  const char* call = nullptr;
+};
+struct WorkView {
+  uint64_t serial = 0, submission = 0, vs = 0, ps = 0;
+  const void* vs_object = nullptr;
+  const void* ps_object = nullptr;
+  uint32_t kind = 0, a = 0, b = 0, c = 0;
+  uint32_t surface = 0, color = 0, depth = 0, textures = 0, tex_d0 = 0, tex_d1 = 0;
+};
+inline std::vector<SlotView> BusySlots() {
+  std::vector<SlotView> out;
+  for (const Slot& slot : slots) {
+    SlotView view;
+    view.owner = slot.owner.load(std::memory_order_acquire);
+    if (!view.owner) continue;
+    view.call = slot.call.load(std::memory_order_acquire);
+    view.role = slot.role.load(std::memory_order_acquire);
+    if (!view.call && !view.role) continue;
+    view.since_ms = slot.since_ms.load(std::memory_order_relaxed);
+    view.detail = slot.detail.load(std::memory_order_relaxed);
+    view.calls = slot.calls.load(std::memory_order_relaxed);
+    out.push_back(view);
+  }
+  return out;
+}
+// The recorded work, oldest first (entries being rewritten are left out).
+inline std::vector<WorkView> RecentWork() {
+  std::vector<WorkView> out;
+  for (const Work& entry : work) {
+    WorkView view;
+    view.serial = entry.serial.load(std::memory_order_acquire);
+    if (!view.serial) continue;
+    view.submission = entry.submission.load(std::memory_order_relaxed);
+    view.kind = entry.kind.load(std::memory_order_relaxed);
+    view.vs = entry.vs.load(std::memory_order_relaxed);
+    view.ps = entry.ps.load(std::memory_order_relaxed);
+    view.vs_object = entry.vs_object.load(std::memory_order_relaxed);
+    view.ps_object = entry.ps_object.load(std::memory_order_relaxed);
+    view.a = entry.a.load(std::memory_order_relaxed);
+    view.b = entry.b.load(std::memory_order_relaxed);
+    view.c = entry.c.load(std::memory_order_relaxed);
+    view.surface = entry.surface.load(std::memory_order_relaxed);
+    view.color = entry.color.load(std::memory_order_relaxed);
+    view.depth = entry.depth.load(std::memory_order_relaxed);
+    view.textures = entry.textures.load(std::memory_order_relaxed);
+    view.tex_d0 = entry.tex_d0.load(std::memory_order_relaxed);
+    view.tex_d1 = entry.tex_d1.load(std::memory_order_relaxed);
+    if (entry.serial.load(std::memory_order_acquire) != view.serial) continue;
+    out.push_back(view);
+  }
+  for (size_t i = 1; i < out.size(); ++i)
+    for (size_t j = i; j > 0 && out[j - 1].serial > out[j].serial; --j) std::swap(out[j - 1], out[j]);
+  return out;
+}
+
+inline std::string Format(const char* format, ...) __attribute__((format(printf, 1, 2)));
+inline std::string Format(const char* format, ...) {
+  char text[192];
+  va_list args;
+  va_start(args, format);
+  std::vsnprintf(text, sizeof(text), format, args);
+  va_end(args);
+  return text;
+}
+
+// The heartbeat: every counter that moves while a game runs, so the last one written before the
+// process ends tells which of them had stopped.
+struct BeatInput {
+  uint64_t now_ms = 0, start_ms = 0, frames = 0, swaps = 0;
+  uint32_t ring_read = 0, ring_write = 0;
+};
+inline std::string HeartbeatLine(const BeatInput& in) {
+  std::string calls;
+  for (const SlotView& slot : BusySlots()) {
+    if (!slot.call) continue;
+    calls += Format(" %s:%s:%llums", slot.role ? slot.role : "thread", slot.call,
+                    (unsigned long long)(in.now_ms >= slot.since_ms ? in.now_ms - slot.since_ms : 0));
+  }
+  const uint64_t submitted_ms = queue.submitted_ms.load(std::memory_order_relaxed);
+  return Format(
+      "HANG beat +%.1f s: ui %llu (%s) gpu %llu (%s) frames %llu swaps %llu ring %X/%X sub %llu (%llu ms ago) "
+      "log %llu/%llu calls:%s",
+      double(in.now_ms - in.start_ms) / 1000.0, (unsigned long long)ui_loop.count.load(std::memory_order_relaxed),
+      UiPhaseName(ui_loop.phase.load(std::memory_order_relaxed)),
+      (unsigned long long)gpu_thread.count.load(std::memory_order_relaxed),
+      GpuPhaseName(gpu_thread.phase.load(std::memory_order_relaxed)), (unsigned long long)in.frames,
+      (unsigned long long)in.swaps, in.ring_read, in.ring_write,
+      (unsigned long long)queue.submitted.load(std::memory_order_relaxed),
+      (unsigned long long)(submitted_ms && in.now_ms >= submitted_ms ? in.now_ms - submitted_ms : 0),
+      (unsigned long long)log_appended.load(std::memory_order_relaxed),
+      (unsigned long long)log_written.load(std::memory_order_relaxed), calls.empty() ? " none" : calls.c_str());
+}
+
+// What the watch thread does once a second. Not thread-safe: one watch thread.
+class Watcher {
+ public:
+  // A stop of the UI loop for this long, or a fence wait, queue submit, acquire or idle wait
+  // in one call for this long, is reported. Pipeline creation is reported after 20 s.
+  // Candidate 8: Ninja Gaiden II's process ended about a second after its UI thread had waited
+  // 293 ms in vkAcquireNextImageKHR; the report came after 3 s. A GPU call (fence, acquire,
+  // submit, idle, present) lasting 200 ms, or a UI loop standing still for 1 s, is reported now.
+  static constexpr uint64_t kCallStopMs = 200;
+  static constexpr uint64_t kUiStopMs = 1000;
+  static constexpr uint64_t kPipelineMs = 20000;
+  // While stopped: a short line every 5 s (the last one before the system ends the process
+  // dates the end), and the whole report again after 20 s.
+  static constexpr uint64_t kStillEveryMs = 5000;
+  static constexpr uint64_t kSecondReportMs = 20000;
+
+  struct Step {
+    std::vector<std::string> lines;
+    bool probe = false;               // ask the UI and GPU threads where they are
+    std::vector<const void*> dump;    // shader objects to write out (first report only)
+  };
+
+  Step Observe(uint64_t now_ms) {
+    Step step;
+    const uint64_t ui = ui_loop.count.load(std::memory_order_relaxed);
+    const uint64_t gpu = gpu_thread.count.load(std::memory_order_relaxed);
+    if (!started_) {
+      started_ = true;
+      ui_count_ = ui;
+      gpu_count_ = gpu;
+      ui_changed_ms_ = gpu_changed_ms_ = now_ms;
+      return step;
+    }
+    if (ui != ui_count_) { ui_count_ = ui; ui_changed_ms_ = now_ms; }
+    if (gpu != gpu_count_) { gpu_count_ = gpu; gpu_changed_ms_ = now_ms; }
+    const auto busy = BusySlots();
+    const uint32_t ui_phase = ui_loop.phase.load(std::memory_order_relaxed);
+    const bool ui_stopped = now_ms - ui_changed_ms_ >= kUiStopMs && ui_phase != kUiMeasure;
+    bool call_stuck = false;
+    for (const SlotView& slot : busy) {
+      if (!slot.call || now_ms < slot.since_ms) continue;
+      const uint64_t limit = std::string(slot.call) == "pipeline" ? kPipelineMs : kCallStopMs;
+      if (now_ms - slot.since_ms >= limit) call_stuck = true;
+    }
+    const bool stopped = ui_stopped || call_stuck;
+    if (!stopped) {
+      if (hung_) {
+        step.lines.push_back(Format("HANG over after %llu ms: the UI loop turns and no call waits",
+                                    (unsigned long long)(now_ms - hung_since_ms_)));
+        hung_ = false;
+        second_done_ = false;
+      }
+      return step;
+    }
+    if (!hung_) {
+      hung_ = true;
+      hung_since_ms_ = now_ms;
+      next_still_ms_ = now_ms + kStillEveryMs;
+      ++reports_;
+      Report(now_ms, busy, step, true);
+      return step;
+    }
+    if (!second_done_ && now_ms - hung_since_ms_ >= kSecondReportMs) {
+      second_done_ = true;
+      Report(now_ms, busy, step, false);
+      return step;
+    }
+    if (now_ms >= next_still_ms_) {
+      next_still_ms_ = now_ms + kStillEveryMs;
+      std::string calls;
+      for (const SlotView& slot : busy) {
+        if (!slot.call) continue;
+        calls += Format(" %s:%s %llus", slot.role ? slot.role : "thread", slot.call,
+                        (unsigned long long)((now_ms - slot.since_ms) / 1000));
+      }
+      step.lines.push_back(Format("HANG still +%llu s: UI loop unchanged %llu s, GPU thread unchanged %llu s, last submission %llu;%s",
+                                  (unsigned long long)((now_ms - hung_since_ms_) / 1000),
+                                  (unsigned long long)((now_ms - ui_changed_ms_) / 1000),
+                                  (unsigned long long)((now_ms - gpu_changed_ms_) / 1000),
+                                  (unsigned long long)queue.submitted.load(std::memory_order_relaxed),
+                                  calls.empty() ? " no thread in a watched call" : calls.c_str()));
+    }
+    return step;
+  }
+
+  bool hung() const { return hung_; }
+  unsigned reports() const { return reports_; }
+
+ private:
+  void Report(uint64_t now_ms, const std::vector<SlotView>& busy, Step& step, bool first) {
+    step.probe = true;
+    const uint32_t ui_phase = ui_loop.phase.load(std::memory_order_relaxed);
+    const uint32_t gpu_phase = gpu_thread.phase.load(std::memory_order_relaxed);
+    step.lines.push_back(Format("HANG %s: UI loop unchanged for %llu ms (last %s), GPU command thread unchanged for %llu ms (last %s)",
+                                first ? "report" : "report again",
+                                (unsigned long long)(now_ms - ui_changed_ms_), UiPhaseName(ui_phase),
+                                (unsigned long long)(now_ms - gpu_changed_ms_), GpuPhaseName(gpu_phase)));
+    const uint64_t submitted = queue.submitted.load(std::memory_order_relaxed);
+    const uint64_t completed = queue.completed.load(std::memory_order_relaxed);
+    const uint64_t submitted_ms = queue.submitted_ms.load(std::memory_order_relaxed);
+    step.lines.push_back(Format("HANG queue: last GPU submission %llu handed over %llu ms ago (%llu then known complete), %llu submissions",
+                                (unsigned long long)submitted,
+                                (unsigned long long)(submitted_ms && now_ms >= submitted_ms ? now_ms - submitted_ms : 0),
+                                (unsigned long long)completed,
+                                (unsigned long long)queue.submissions.load(std::memory_order_relaxed)));
+    std::string stuck_fence;  // "role submission N for M ms" of a fence wait past kCallStopMs
+    for (const SlotView& slot : busy) {
+      const char* role = slot.role ? slot.role : "thread";
+      if (slot.call) {
+        const uint64_t ms = now_ms >= slot.since_ms ? now_ms - slot.since_ms : 0;
+        if (slot.detail) {
+          const uint64_t awaited = slot.detail - 1;
+          if (ms >= kCallStopMs && stuck_fence.empty())
+            stuck_fence = Format("%s thread's wait for submission %llu (%llu ms)", role,
+                                 (unsigned long long)awaited, (unsigned long long)ms);
+          step.lines.push_back(Format("HANG %s %llx in %s for %llu ms, for submission %llu (%llu calls before)", role,
+                                      (unsigned long long)slot.owner, slot.call, (unsigned long long)ms,
+                                      (unsigned long long)awaited, (unsigned long long)slot.calls));
+        } else {
+          step.lines.push_back(Format("HANG %s %llx in %s for %llu ms (%llu calls before)", role,
+                                      (unsigned long long)slot.owner, slot.call, (unsigned long long)ms,
+                                      (unsigned long long)slot.calls));
+        }
+      } else {
+        step.lines.push_back(Format("HANG %s %llx in no watched call (%llu calls before)", role,
+                                    (unsigned long long)slot.owner, (unsigned long long)slot.calls));
+      }
+    }
+    // The work of the first submission not known complete: what the GPU may be stuck on.
+    const uint64_t first_open = completed + 1;
+    const auto recent = RecentWork();
+    size_t shown = 0;
+    for (const WorkView& entry : recent) {
+      const bool open = entry.submission >= first_open;
+      if (entry.kind == kDraw) {
+        step.lines.push_back(Format("HANG work %llu sub %llu%s draw vs %016llX ps %016llX prim %u vertices %u%s%s "
+                                    "surface %08X color %08X depth %08X tex %X (%08X %08X)",
+                                    (unsigned long long)entry.serial, (unsigned long long)entry.submission,
+                                    open ? " (open)" : "", (unsigned long long)entry.vs, (unsigned long long)entry.ps,
+                                    entry.a, entry.b, (entry.c & kIndexed) ? " indexed" : "",
+                                    (entry.c & kMemExport) ? " memexport" : "", entry.surface, entry.color,
+                                    entry.depth, entry.textures, entry.tex_d0, entry.tex_d1));
+        if (first && (open || entry.submission + 2 >= submitted)) {
+          for (const void* object : {entry.vs_object, entry.ps_object}) {
+            if (!object) continue;
+            bool known = false;
+            for (const void* seen : step.dump) known = known || seen == object;
+            if (!known && step.dump.size() < 24) step.dump.push_back(object);
+          }
+        }
+      } else if (entry.kind == kResolve) {
+        step.lines.push_back(Format("HANG work %llu sub %llu%s resolve to %08X, %u bytes, format %u",
+                                    (unsigned long long)entry.serial, (unsigned long long)entry.submission,
+                                    open ? " (open)" : "", entry.a, entry.b, entry.c));
+      }
+      ++shown;
+    }
+    if (!shown) step.lines.push_back("HANG work: nothing recorded");
+    if (!stuck_fence.empty())
+      step.lines.push_back("HANG verdict: the GPU does not finish a submission (" + stuck_fence + "): a GPU hang");
+    else if (now_ms - ui_changed_ms_ >= kUiStopMs)
+      step.lines.push_back("HANG verdict: the UI loop is stopped outside a GPU wait: see where the threads are (WHERE lines)");
+  }
+
+  bool started_ = false, hung_ = false, second_done_ = false;
+  uint64_t ui_count_ = 0, gpu_count_ = 0, ui_changed_ms_ = 0, gpu_changed_ms_ = 0;
+  uint64_t hung_since_ms_ = 0, next_still_ms_ = 0;
+  unsigned reports_ = 0;
+};
+
+}  // namespace hang_watch
+}  // namespace xbox360ps5
