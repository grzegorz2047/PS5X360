+namespace {
+// Fix 47 (issue #11): a signal that ends the process without a fault leaves one line in the
+// report (Ninja Gaiden II's app ended with nothing written). SIGPIPE, a write to a socket
+// whose other end is closed, would end it silently: it is reported once and then ignored,
+// so the write fails with EPIPE instead. The others end the process as before, after the
+// line. Only system calls and a stack buffer here (a signal handler).
+constexpr int kEndingSignals[] = {SIGHUP, SIGINT, SIGQUIT, SIGTERM, SIGXCPU, SIGXFSZ, SIGPIPE};
+std::atomic<bool> pipe_reported{false};
+void HandleEnding(int number, siginfo_t* info, void*) {
+  if (number == SIGPIPE && pipe_reported.exchange(true)) return;
+  char text[160];
+  size_t size = 0;
+  const auto put = [&](const char* part) { for (; *part && size + 1 < sizeof(text); ++part) text[size++] = *part; };
+  const auto number_text = [&](uint64_t value) {
+    char digits[24]; int count = 0;
+    do { digits[count++] = char('0' + value % 10); value /= 10; } while (value);
+    while (count && size + 1 < sizeof(text)) text[size++] = digits[--count];
+  };
+  put("[X360] SIGNAL "); number_text(uint64_t(number));
+  put(" from pid "); number_text(uint64_t(info ? info->si_pid : 0));
+  put(" code "); number_text(uint64_t(uint32_t(info ? info->si_code : 0)));
+  put(number == SIGPIPE ? ": a write to a closed socket or pipe; ignored from now on\n"
+                        : ": the process ends now\n");
+  text[size] = 0;
+  if (report_file >= 0) { (void)!write(report_file, text, size); fsync(report_file); }
+  sceKernelDebugOutText(0, text);
+  if (number == SIGPIPE) return;
+  struct sigaction standard{};
+  standard.sa_handler = SIG_DFL;
+  sigemptyset(&standard.sa_mask);
+  sigaction(number, &standard, nullptr);
+  raise(number);
+}
+}  // namespace
