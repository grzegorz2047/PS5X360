+static void Ps5TitleEnd(const char* what, const std::string& path, uint32_t flags) {
+  uint32_t lr = 0, r3 = 0, r30 = 0, pc = 0;
+  if (XThread* thread = XThread::GetCurrentThread()) {
+    const auto* context = thread->thread_state()->context();
+    lr = uint32_t(context->lr);
+    r3 = uint32_t(context->r[3]);
+    r30 = uint32_t(context->r[30]);
+    pc = thread->handle();
+  }
+  const std::string text = fmt::format(
+      "GUEST {} by thread {:08X} from {:08X} (r3 {:08X}, r30 {:08X}){}{}, flags {:08X}",
+      what, pc, lr, r3, r30, path.empty() ? "" : ": ", path, flags);
+  XELOGW("{}", text);
+  xbox360ps5::hang_watch::Raw(text);
+}
+#endif
