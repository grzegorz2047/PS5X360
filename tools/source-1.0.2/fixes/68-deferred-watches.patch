+void SharedMemory::FlushDeferredWatches() {
+  if (!deferred_watches_.size()) return;
+  const size_t unit_bytes = size_t(1) << page_size_log2_;
+  const auto stats = deferred_watches_.Flush(
+      [&](uint32_t first, uint32_t last) {
+        if (memory_invalidation_callback_handle_)
+          memory().EnablePhysicalMemoryAccessCallbacks(first << page_size_log2_,
+                                                        (last - first + 1) << page_size_log2_, true, false);
+      },
+      [&](uint32_t unit) {
+        return XXH3_64bits(memory().TranslatePhysical(unit << page_size_log2_), unit_bytes);
+      },
+      // Written by the game since its copy: invalidated as its write fault would have done.
+      [&](uint32_t unit) { MemoryInvalidationCallback(unit << page_size_log2_, uint32_t(unit_bytes), true); });
+  deferred_stats_.Add(stats);
+}
