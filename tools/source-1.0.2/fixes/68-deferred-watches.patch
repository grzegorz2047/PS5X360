--- /dev/null
+++ b/include/xbox360ps5/deferred_watch.hpp
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: MIT
+// Fix 68 (tools/source-1.0.2/fixes/68-deferred-watches.patch): "Deferred memory watches", a
+// per-game setting (off by default; Call of Duty: Modern Warfare 2's preset turns it on).
+//
+// An upload into the GPU's copy of guest memory used to write-protect the units it copied at
+// once (SharedMemory::MakeRangeValid -> Memory::EnablePhysicalMemoryAccessCallbacks), one
+// protection call per uploaded range. On the console such a call costs about 37 us
+// (1.0.4_candidate_23, GPU diagnostics on: 3663 closes in 136 ms a second), and Modern Warfare 2
+// made 5644 of them a second, as many as its uploads: 209 of the 226 ms a second its GPU command
+// thread spent "marking valid" (fix 62's split). Its dynamic buffers are rewritten every frame,
+// so each frame they fault, open, upload and close again.
+//
+// With the setting on, an upload records each unit with a hash of the guest's bytes taken before
+// the copy, and the units are protected at the end of the submission (or when kMax are waiting):
+// sorted, the latest record of a unit kept, each run of consecutive units protected with one
+// call. Then each unit's bytes are compared with its hash: a unit the game wrote between its
+// copy and its protection is invalidated as a write fault would have done (the GPU's copy and
+// what depends on it are refreshed at the next request). Protecting first and comparing after
+// leaves no write unseen: one before the protection changes the hash, one after it faults.
+// A draw later in the same submission can still use a unit's copy after the game rewrote it
+// (before, that write faulted at once): the reason the setting is per game and off by default.
+#pragma once
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace xbox360ps5::deferred_watch {
+
+struct Stats {
+  uint64_t units = 0;    // units protected (after keeping one record per unit)
+  uint64_t records = 0;  // uploads recorded
+  uint64_t runs = 0;     // protection calls made
+  uint64_t changed = 0;  // units the game wrote before their protection
+  uint64_t flushes = 0;
+  void Add(const Stats& other) {
+    units += other.units;
+    records += other.records;
+    runs += other.runs;
+    changed += other.changed;
+    flushes += other.flushes;
+  }
+};
+
+class Pending {
+ public:
+  static constexpr size_t kMax = 4096;
+
+  void Add(uint32_t unit, uint64_t hash) { entries_.push_back({unit, hash, serial_++}); }
+  size_t size() const { return entries_.size(); }
+  bool Full() const { return entries_.size() >= kMax; }
+  void Clear() { entries_.clear(); }
+
+  // arm(first_unit, last_unit) once per run of consecutive units, all runs first;
+  // then hash(unit) for each unit, and changed(unit) where it differs from the recorded hash.
+  template <typename Arm, typename Hash, typename Changed>
+  Stats Flush(Arm&& arm, Hash&& hash, Changed&& changed) {
+    Stats stats;
+    if (entries_.empty()) return stats;
+    stats.records = entries_.size();
+    stats.flushes = 1;
+    std::sort(entries_.begin(), entries_.end(), [](const Entry& a, const Entry& b) {
+      return a.unit != b.unit ? a.unit < b.unit : a.order < b.order;
+    });
+    // One record per unit: the latest upload's hash.
+    size_t kept = 0;
+    for (size_t i = 0; i < entries_.size(); ++i) {
+      if (kept && entries_[kept - 1].unit == entries_[i].unit)
+        entries_[kept - 1] = entries_[i];
+      else
+        entries_[kept++] = entries_[i];
+    }
+    entries_.resize(kept);
+    stats.units = kept;
+    for (size_t i = 0; i < kept;) {
+      size_t j = i + 1;
+      while (j < kept && entries_[j].unit == entries_[j - 1].unit + 1) ++j;
+      arm(entries_[i].unit, entries_[j - 1].unit);
+      ++stats.runs;
+      i = j;
+    }
+    for (const Entry& entry : entries_) {
+      if (hash(entry.unit) != entry.hash) {
+        changed(entry.unit);
+        ++stats.changed;
+      }
+    }
+    entries_.clear();
+    return stats;
+  }
+
+ private:
+  struct Entry {
+    uint32_t unit;
+    uint64_t hash;
+    uint64_t order;
+  };
+  std::vector<Entry> entries_;
+  uint64_t serial_ = 0;
+};
+
+}  // namespace xbox360ps5::deferred_watch
