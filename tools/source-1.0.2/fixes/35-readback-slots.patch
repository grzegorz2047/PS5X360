+/**
+ ******************************************************************************
+ * Xbox360PS5: fix 35, resolve readback slots chosen by submission.           *
+ ******************************************************************************
+ * The fast and automatic resolve readbacks copy a resolve into a host buffer of
+ * its key (address and length) and give the guest the copy an earlier resolve of
+ * that key made. 1.0.2 had two buffers per key, flipped once per frame for every
+ * key, and read from the one it was not writing: a key resolved every other frame
+ * (luminance, HDR adaptation) found the same buffer to write each time and the
+ * other one never written, so the guest never got its picture (dark or white
+ * frames, brightness jumps); and when the GPU ran behind, the other buffer was
+ * always still in flight, which the automatic copy never waits for.
+ *
+ * Now each key has up to kCount slots, each stamped with the submission of its
+ * last copy. The newest one that can be read (completed, holding at least this
+ * length) is kept for the guest. A copy goes to a slot older than that one (its
+ * copy superseded), else to an unused slot, else to the oldest. So a key keeps
+ * two buffers while the GPU keeps up and up to four while it runs two frames
+ * behind, and a copy still in flight is not overwritten while an older one can
+ * take the new copy. The guest gets the newest copy other than the one just
+ * made: completed for the automatic copy, which never waits; the fast mode waits
+ * for it if needed, as before.
+ ******************************************************************************
+ */
+
+#ifndef XENIA_GPU_VULKAN_READBACK_SLOTS_H_
+#define XENIA_GPU_VULKAN_READBACK_SLOTS_H_
+
+#include <cstdint>
+
+namespace xe {
+namespace gpu {
+namespace vulkan {
+namespace readback_slots {
+
+constexpr uint32_t kCount = 4;
+
+// The newest slot other than `exclude` holding a copy of at least `length`
+// bytes (submission 0: never written), completed by `completed` if
+// `completed_only`. -1 if none.
+inline int ChooseRead(const uint64_t* submissions, const uint32_t* valid_sizes,
+                      uint32_t count, int exclude, uint32_t length,
+                      uint64_t completed, bool completed_only) {
+  int best = -1;
+  for (uint32_t i = 0; i < count; ++i) {
+    if (int(i) == exclude || !submissions[i] || valid_sizes[i] < length ||
+        (completed_only && submissions[i] > completed)) {
+      continue;
+    }
+    if (best < 0 || submissions[i] > submissions[best]) {
+      best = int(i);
+    }
+  }
+  return best;
+}
+
+// The slot this copy goes to, never the newest readable one (kept for the
+// guest): one whose copy that one superseded, else an unused one, else the
+// oldest (the lowest submission in each case).
+inline uint32_t ChooseWrite(const uint64_t* submissions,
+                            const uint32_t* valid_sizes, uint32_t count,
+                            uint32_t length, uint64_t completed) {
+  const int keep = ChooseRead(submissions, valid_sizes, count, -1, length,
+                              completed, true);
+  int superseded = -1, unused = -1, oldest = -1;
+  for (uint32_t i = 0; i < count; ++i) {
+    if (int(i) == keep) {
+      continue;
+    }
+    if (!submissions[i]) {
+      if (unused < 0) {
+        unused = int(i);
+      }
+      continue;
+    }
+    if (keep >= 0 && submissions[i] < submissions[keep] &&
+        (superseded < 0 || submissions[i] < submissions[superseded])) {
+      superseded = int(i);
+    }
+    if (oldest < 0 || submissions[i] < submissions[oldest]) {
+      oldest = int(i);
+    }
+  }
+  if (superseded >= 0) {
+    return uint32_t(superseded);
+  }
+  if (unused >= 0) {
+    return uint32_t(unused);
+  }
+  return oldest < 0 ? 0 : uint32_t(oldest);
+}
+
+}  // namespace readback_slots
+}  // namespace vulkan
+}  // namespace gpu
+}  // namespace xe
+
+#endif  // XENIA_GPU_VULKAN_READBACK_SLOTS_H_
