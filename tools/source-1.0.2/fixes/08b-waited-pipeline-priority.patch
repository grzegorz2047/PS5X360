@@ -849,6 +849,22 @@ bool VulkanPipelineCache::ConfigurePipeline(
             bound_rts, pixel_shader->shader().writes_color_targets(),
             pixel_shader->shader().writes_depth());
       }
+      // Binary release patch group 8b: the pipelines the command processor
+      // waits for (VulkanCommandProcessor::IssueDrawInner's selective wait)
+      // are compiled first. The queue is a max-heap on priority and equal
+      // priorities come out in no particular order, so a waited pipeline could
+      // sit behind hundreds of others: Battlefield: Bad Company froze for 15 s
+      // and more on a first run. A pipeline that writes a visible colour target
+      // and has at most 6 indices or a render target at most 256 pixels wide
+      // gets the highest priority.
+      if (priority >= pipeline_util::kPriorityVisibleRT) {
+        const auto& regs = register_file_;
+        const uint32_t pitch = regs.Get<reg::RB_SURFACE_INFO>().surface_pitch;
+        if ((pitch >= 1 && pitch <= 256) ||
+            regs.Get<reg::VGT_DRAW_INITIATOR>().num_indices <= 6) {
+          priority = pipeline_util::kPriorityWaited;
+        }
+      }
 
