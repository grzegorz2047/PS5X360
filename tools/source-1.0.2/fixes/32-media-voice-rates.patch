index 0000000..749c26b
--- /dev/null
+++ b/port/media_voice.hpp
@@ -0,0 +1,97 @@
+// SPDX-License-Identifier: MIT
+// Fix 32: the shape of the frames an audio voice submits, their stereo mix and their rate change
+// to the console's 48 kHz port (platform/ps5/canary_audio.cpp, PacedDriver).
+//
+// Two kinds of voice reach PacedDriver:
+//  * a game's audio client: 5.1 at 48 kHz, 256 samples per channel, in the console's byte order
+//    and channel after channel (converted by xe::apu::conversion);
+//  * an XMP media voice (a game's or the dashboard's playlist music, apu/audio_media_player.cc):
+//    whatever the file has (mono, stereo, 44.1 kHz, ...), native floats, interleaved, always
+//    AudioDriver::kFrameSamplesMax (1536) floats per frame.
+// 1.0.2 opened the port only for 48 kHz voices (44.1 kHz music was silent), took 768 samples
+// per channel from every voice that was not 5.1 (a mono frame of 1536 lost its second half and
+// played at twice the speed) and mixed mono through the 5.1 branch, reading in[1] and in[2]
+// past the frame's end.
+#ifndef XBOX360PS5_MEDIA_VOICE_HPP_
+#define XBOX360PS5_MEDIA_VOICE_HPP_
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace xbox360ps5::media_voice {
+
+constexpr uint32_t kPortRate = 48000;
+// AudioDriver::kFrameSamplesMax: 6 channels x 256 samples.
+constexpr uint32_t kFrameFloats = 6 * 256;
+
+// Samples per channel in one submitted frame: every frame holds kFrameFloats floats.
+inline uint32_t ChannelSamples(uint32_t channels) {
+  return channels ? kFrameFloats / channels : 0;
+}
+
+// An interleaved native-float frame of `channels` channels as interleaved stereo (`samples`
+// pairs). Mono goes to both sides; three channels and more are taken as front left, front
+// right and centre first (the centre in both sides at -3 dB), the others left out.
+inline void InterleavedToStereo(const float* in, uint32_t channels, uint32_t samples,
+                                std::vector<float>& stereo) {
+  stereo.resize(size_t(samples) * 2);
+  for (uint32_t n = 0; n < samples; ++n) {
+    const float* s = in + size_t(n) * channels;
+    float left, right;
+    if (channels == 1) {
+      left = right = s[0];
+    } else if (channels == 2) {
+      left = s[0];
+      right = s[1];
+    } else {
+      left = s[0] + s[2] * 0.7071f;
+      right = s[1] + s[2] * 0.7071f;
+    }
+    stereo[size_t(n) * 2] = left;
+    stereo[size_t(n) * 2 + 1] = right;
+  }
+}
+
+// Interleaved stereo at `rate` to interleaved stereo at 48 kHz, by linear interpolation, carried
+// across frames (no click at frame boundaries). At 48 kHz the samples pass unchanged.
+class Resampler {
+ public:
+  explicit Resampler(uint32_t rate)
+      : rate_(rate ? rate : kPortRate), step_(double(rate_) / kPortRate) {}
+
+  uint32_t rate() const { return rate_; }
+
+  // Appends the 48 kHz samples for `frames` input pairs to `out`.
+  void Process(const float* in, size_t frames, std::vector<float>& out) {
+    if (!frames) return;
+    if (rate_ == kPortRate) {
+      out.insert(out.end(), in, in + frames * 2);
+      return;
+    }
+    // Input positions: -1 is the last pair of the previous frame, 0 .. frames-1 this frame's.
+    const double last = double(frames - 1);
+    while (position_ < last) {
+      const double floor = position_ < 0 ? -1.0 : double(size_t(position_));
+      const float t = float(position_ - floor);
+      const float* a = floor < 0 ? previous_ : in + size_t(floor) * 2;
+      const float* b = in + size_t(floor + 1) * 2;
+      out.push_back(a[0] + (b[0] - a[0]) * t);
+      out.push_back(a[1] + (b[1] - a[1]) * t);
+      position_ += step_;
+    }
+    position_ -= double(frames);
+    previous_[0] = in[(frames - 1) * 2];
+    previous_[1] = in[(frames - 1) * 2 + 1];
+  }
+
+ private:
+  uint32_t rate_;
+  double step_;
+  double position_ = 0.0;
+  float previous_[2] = {0.0f, 0.0f};
+};
+
+}  // namespace xbox360ps5::media_voice
+
+#endif  // XBOX360PS5_MEDIA_VOICE_HPP_
