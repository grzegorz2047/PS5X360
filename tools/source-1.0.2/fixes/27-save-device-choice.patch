@@ -0,0 +1,785 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+// Xbox360PS5 (fix 27): the storage devices a game can keep its saves on.
+//
+// The internal folder (the content root the title gives the emulator,
+// /data/homebrew/PPSA50011/saves) is the hard drive, device 1, as before.
+// Each writable drive mounted at one of the console's mount points
+// (/mnt/ext0.., /mnt/usb0..) is a device of its own, with an ID fixed by
+// its mount point, and keeps its saves in <drive>/PS5X360/saves (or below a
+// writable folder of the drive when its top is not writable), laid out as the
+// internal folder (<xuid>/<title>/<content type>/<name>).
+//
+// Header only and free of the rest of the core, so that
+// tools/check-save-devices.cpp drives the same decisions with a fake
+// filesystem: the scan, the folder of each device, and what the "where to
+// save" window offers.
+
+#ifndef XENIA_KERNEL_XAM_STORAGE_DEVICES_H_
+#define XENIA_KERNEL_XAM_STORAGE_DEVICES_H_
+
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <sys/statvfs.h>
+#include <unistd.h>
+
+#include <cinttypes>
+#include <cstdint>
+#include <cstdio>
+#include <filesystem>
+#include <string>
+#include <string_view>
+#include <system_error>
+#include <utility>
+#include <vector>
+
+namespace xe {
+namespace kernel {
+namespace xam {
+namespace storage {
+
+enum class Kind { kInternal, kExtended, kUsb };
+
+inline constexpr uint32_t kInternalDeviceId = 1;  // DummyDeviceId::HDD
+inline constexpr uint32_t kDiscDeviceId = 2;      // DummyDeviceId::ODD
+
+// A mount point the console may have. The device ID belongs to the mount
+// point, so a drive keeps its ID whatever else is plugged in, and a game that
+// remembers it finds the drive again. The guest name is what
+// XamContentGetDeviceName and XamContentGetDeviceData give (27 characters at
+// most). ext0/ext1 are the PS5's extended storage (the M.2 SSD slot, or a USB
+// drive formatted as extended storage); usb0.. the USB drives it reads as
+// plain storage.
+struct Slot {
+  const char* mount;
+  uint32_t device_id;
+  Kind kind;
+  const char16_t* guest_name;
+};
+
+inline constexpr Slot kSlots[] = {
+    {"ext0", 3, Kind::kExtended, u"Extended Storage (ext0)"},
+    {"ext1", 4, Kind::kExtended, u"Extended Storage (ext1)"},
+    {"ext2", 5, Kind::kExtended, u"Extended Storage (ext2)"},
+    {"ext3", 6, Kind::kExtended, u"Extended Storage (ext3)"},
+    {"usb0", 7, Kind::kUsb, u"USB Storage (usb0)"},
+    {"usb1", 8, Kind::kUsb, u"USB Storage (usb1)"},
+    {"usb2", 9, Kind::kUsb, u"USB Storage (usb2)"},
+    {"usb3", 10, Kind::kUsb, u"USB Storage (usb3)"},
+    {"usb4", 11, Kind::kUsb, u"USB Storage (usb4)"},
+    {"usb5", 12, Kind::kUsb, u"USB Storage (usb5)"},
+    {"usb6", 13, Kind::kUsb, u"USB Storage (usb6)"},
+    {"usb7", 14, Kind::kUsb, u"USB Storage (usb7)"},
+};
+inline constexpr size_t kSlotCount = sizeof(kSlots) / sizeof(kSlots[0]);
+
+inline const Slot* FindSlot(uint32_t device_id) {
+  for (const auto& slot : kSlots) {
+    if (slot.device_id == device_id) return &slot;
+  }
+  return nullptr;
+}
+
+// Where a drive may keep its saves, in order: its top, else a folder of the
+// drive that the app may write while the top is not (the PS5's extended
+// storage: /mnt/ext1 is the system's, its homebrew and xbox360 folders are
+// not). Each is <base>/PS5X360/saves.
+inline constexpr const char* kSaveBases[] = {"", "homebrew", "xbox360"};
+
+inline std::filesystem::path SaveRoot(const std::filesystem::path& mount,
+                                      std::string_view base = "") {
+  const auto folder = base.empty() ? mount : mount / std::string(base);
+  return folder / "PS5X360" / "saves";
+}
+
+// A package's folder below a device's saves root (ContentManager's layout).
+inline std::filesystem::path PackageRoot(const std::filesystem::path& root,
+                                         uint64_t xuid, uint32_t title_id,
+                                         uint32_t content_type) {
+  char xuid_text[17], title_text[9], type_text[9];
+  std::snprintf(xuid_text, sizeof(xuid_text), "%016llX",
+                static_cast<unsigned long long>(xuid));
+  std::snprintf(title_text, sizeof(title_text), "%08X", title_id);
+  std::snprintf(type_text, sizeof(type_text), "%08X", content_type);
+  return root / xuid_text / title_text / type_text;
+}
+
+// What the filesystem says about a path's filesystem. dev: the stat st_dev
+// of the path itself; fsid (statvfs's), source ("/dev/da0s1": the /dev entry
+// whose device number is dev, see PosixFs::Info) and type when known, and the
+// sizes.
+struct FsInfo {
+  bool ok = false;
+  uint64_t dev = 0;
+  std::string fsid;
+  std::string source;
+  std::string type;
+  bool space_ok = false;
+  uint64_t capacity = 0;
+  uint64_t free = 0;
+};
+
+struct Device {
+  uint32_t id = kInternalDeviceId;
+  Kind kind = Kind::kInternal;
+  std::string mount;           // "/mnt/usb0"; empty for the internal folder
+  std::string name;            // "usb0"; empty for the internal folder
+  std::filesystem::path root;  // where its saves are
+  FsInfo fs;                   // its filesystem, as scanned
+  int number = 0;              // USB drives: 1, 2.. by disk (see Scan)
+  bool space_known = false;
+  uint64_t capacity = 0;
+  uint64_t free = 0;
+};
+
+// A mounted drive that is not offered, and why.
+struct Skipped {
+  std::string mount;
+  uint32_t id = 0;
+  enum class Why {
+    kNotWritable,
+    kSameFilesystem,
+    kError,
+    kSameDisk,
+    kSystem
+  } why = Why::kNotWritable;
+  uint32_t same_as = 0;  // kSameFilesystem: the offered device it is
+  std::string detail;    // for the log
+};
+
+// The disk a mount's source names: "/dev/da0s1", "/dev/da0p2" and "/dev/da0"
+// are all on da0. Empty when the source is not a /dev/<letters><number> name.
+inline std::string DiskOf(std::string_view source) {
+  if (source.substr(0, 5) != "/dev/") return std::string();
+  source.remove_prefix(5);
+  size_t i = 0;
+  while (i < source.size() && source[i] >= 'a' && source[i] <= 'z') ++i;
+  const size_t letters = i;
+  while (i < source.size() && source[i] >= '0' && source[i] <= '9') ++i;
+  if (!letters || i == letters) return std::string();
+  return std::string(source.substr(0, i));
+}
+
+// Two scanned paths are one filesystem: the same st_dev (what told the
+// mounts from /mnt's placeholders on the console). statfs's fsid and source
+// are logged but not trusted for this: a sandbox that gives every path the
+// same statfs answer would make every drive one.
+inline bool SameFilesystem(const FsInfo& a, const FsInfo& b) {
+  return a.ok && b.ok && a.dev == b.dev;
+}
+
+// What Scan needs from the filesystem (PosixFs below on the console, a fake
+// in the checks):
+//   bool IsMountPoint(const path&)   a directory that is a filesystem's root
+//   bool IsDirectory(const path&)
+//   bool ProbeWritable(const path&)  a file can be made in this directory
+//                                    (and is removed again)
+//   FsInfo Info(const path&)
+//   std::vector<std::string> ListDirectories(const path&)
+//
+// The internal folder always comes first. A slot counts only when its mount
+// point is a mount point: the console keeps empty, read-only placeholders
+// (/mnt/usb3 with nothing in that port), and writing there would put saves on
+// the system's own filesystem. A mount that is the same filesystem as one
+// already offered (or as the internal folder) is offered once. The saves
+// folder: the first of kSaveBases whose PS5X360/saves folder exists and takes
+// a probe file, else the first whose base takes one (the folder itself is
+// made only when a game creates a save there).
+//
+// Free space: the PS5's app sandbox answered with the same round figures (16
+// GiB free of 64 GiB) for every path. Figures that two different filesystems
+// share exactly are taken as not reported: those devices show no free space
+// and are not left out for lack of it.
+//
+// USB drives are numbered 1, 2.. in slot order; mounts whose sources name the
+// same disk (partitions of one drive) share its number.
+//
+// trace(text) is called before each step that touches the filesystem, so a
+// log written as it goes shows the last one if the process dies there
+// (candidate 24 died inside the scan without a word). A step that throws
+// leaves that slot out (Skipped::Why::kError) instead of the whole scan.
+struct NoTrace {
+  void operator()(const std::string&) const {}
+};
+
+template <class Fs, class Trace = NoTrace>
+std::vector<Device> Scan(Fs& fs, const std::filesystem::path& internal_root,
+                         const std::filesystem::path& mount_root,
+                         std::vector<Skipped>* skipped = nullptr,
+                         Trace trace = Trace()) {
+  std::vector<Device> devices;
+  Device internal;
+  internal.root = internal_root;
+  trace("info " + internal_root.string());
+  try {
+    internal.fs = fs.Info(internal_root);
+  } catch (...) {
+    internal.fs = FsInfo{};
+  }
+  devices.push_back(internal);
+  if (!mount_root.empty()) {
+    for (const auto& slot : kSlots) {
+      const auto mount = mount_root / slot.mount;
+      try {
+      trace("mount point? " + mount.string());
+      if (!fs.IsMountPoint(mount)) continue;
+      Device device;
+      device.id = slot.device_id;
+      device.kind = slot.kind;
+      device.mount = mount.string();
+      device.name = slot.mount;
+      trace("info " + device.mount);
+      device.fs = fs.Info(mount);
+      const Device* same = nullptr;
+      for (const auto& offered : devices) {
+        if (SameFilesystem(offered.fs, device.fs)) {
+          same = &offered;
+          break;
+        }
+      }
+      if (same) {
+        if (skipped) {
+          skipped->push_back({device.mount, device.id,
+                              Skipped::Why::kSameFilesystem, same->id,
+                              same->mount.empty() ? same->root.string()
+                                                  : same->mount});
+        }
+        continue;
+      }
+      // Another partition of a drive already offered (one USB stick seen as
+      // usb1 and usb2): offered once, as the user sees one drive. A memory
+      // disk is the system's, not a drive.
+      const std::string disk = DiskOf(device.fs.source);
+      if (disk.substr(0, 2) == "md") {
+        if (skipped) {
+          skipped->push_back({device.mount, device.id, Skipped::Why::kSystem,
+                              0, "a memory disk (" + device.fs.source + ")"});
+        }
+        continue;
+      }
+      const Device* sibling = nullptr;
+      for (const auto& offered : devices) {
+        // Drives only: never the internal folder's disk (the console's own
+        // SSD may give it a name ext1's shares).
+        if (offered.kind != Kind::kInternal && !disk.empty() &&
+            DiskOf(offered.fs.source) == disk) {
+          sibling = &offered;
+          break;
+        }
+      }
+      if (sibling) {
+        if (skipped) {
+          skipped->push_back(
+              {device.mount, device.id, Skipped::Why::kSameDisk, sibling->id,
+               device.fs.source + ", a partition of the drive of " +
+                   sibling->fs.source + " (" +
+                   (sibling->mount.empty() ? sibling->root.string()
+                                           : sibling->mount) +
+                   ")"});
+        }
+        continue;
+      }
+      bool found = false;
+      for (const char* base : kSaveBases) {  // a saves folder already there
+        const auto root = SaveRoot(mount, base);
+        trace("saves folder? " + root.string());
+        if (fs.IsDirectory(root) && fs.ProbeWritable(root)) {
+          device.root = root;
+          found = true;
+          break;
+        }
+      }
+      std::string tried;
+      for (const char* base : kSaveBases) {  // else the first writable base
+        if (found) break;
+        const auto folder = *base ? mount / base : mount;
+        trace("writable? " + folder.string());
+        if (*base && !fs.IsDirectory(folder)) continue;
+        tried += (tried.empty() ? "" : ", ") + folder.string();
+        if (fs.ProbeWritable(folder)) {
+          device.root = SaveRoot(mount, base);
+          found = true;
+        }
+      }
+      if (!found) {
+        if (skipped) {
+          skipped->push_back({device.mount, device.id,
+                              Skipped::Why::kNotWritable, 0, tried});
+        }
+        continue;
+      }
+      devices.push_back(device);
+      } catch (...) {
+        if (skipped) {
+          skipped->push_back({mount.string(), slot.device_id,
+                              Skipped::Why::kError, 0,
+                              "unreadable (an error while scanning it)"});
+        }
+      }
+    }
+  }
+  // Free space, unless the figures are the sandbox's.
+  for (auto& device : devices) {
+    device.space_known = device.fs.space_ok;
+    device.capacity = device.fs.capacity;
+    device.free = device.fs.free;
+  }
+  for (size_t i = 0; i < devices.size(); ++i) {
+    for (size_t j = i + 1; j < devices.size(); ++j) {
+      const FsInfo& a = devices[i].fs;
+      const FsInfo& b = devices[j].fs;
+      if (a.space_ok && b.space_ok && a.capacity == b.capacity &&
+          a.free == b.free) {
+        devices[i].space_known = devices[j].space_known = false;
+      }
+    }
+  }
+  // USB numbers, by disk; sources are trusted for this only when no two
+  // drives give the same one.
+  bool sources_distinct = true;
+  for (size_t i = 0; i < devices.size(); ++i) {
+    for (size_t j = i + 1; j < devices.size(); ++j) {
+      if (devices[i].fs.source == devices[j].fs.source) {
+        sources_distinct = false;
+      }
+    }
+  }
+  std::vector<std::string> disks;
+  int next = 0;
+  for (auto& device : devices) {
+    if (device.kind != Kind::kUsb) continue;
+    const std::string disk =
+        sources_distinct ? DiskOf(device.fs.source) : std::string();
+    int number = 0;
+    for (size_t k = 0; !disk.empty() && k < disks.size(); ++k) {
+      if (disks[k] == disk) number = static_cast<int>(k) + 1;
+    }
+    if (!number) {
+      disks.push_back(disk.empty() ? "?" + device.name : disk);
+      number = ++next;
+    }
+    device.number = number;
+  }
+  return devices;
+}
+
+inline const Device* Find(const std::vector<Device>& devices, uint32_t id) {
+  for (const auto& device : devices) {
+    if (device.id == id) return &device;
+  }
+  return nullptr;
+}
+
+// The saves root of a package that names device_id: that drive's while it is
+// present, else the internal folder (the only answer before fix 27, for every
+// device: also for 0 and for IDs a game makes up).
+inline std::filesystem::path RootFor(const std::vector<Device>& devices,
+                                     uint32_t device_id) {
+  if (const Device* device = Find(devices, device_id)) return device->root;
+  return devices.empty() ? std::filesystem::path() : devices.front().root;
+}
+
+// The device ID a package found or created for device_id reports back to the
+// game (XCONTENT_DATA.device_id): a present drive's own, else the hard
+// drive's, as before.
+inline uint32_t MetadataId(const std::vector<Device>& devices,
+                           uint32_t device_id) {
+  return Find(devices, device_id) ? device_id : kInternalDeviceId;
+}
+
+// The devices whose content an enumeration of device_id lists: every device
+// for 0, the one asked for while present, none for the disc or a drive that
+// is gone.
+inline std::vector<uint32_t> ListFor(const std::vector<Device>& devices,
+                                     uint32_t device_id) {
+  std::vector<uint32_t> ids;
+  for (const auto& device : devices) {
+    if (!device_id || device.id == device_id) ids.push_back(device.id);
+  }
+  return ids;
+}
+
+inline bool IsHexName(std::string_view name, size_t length) {
+  if (name.size() != length) return false;
+  for (char c : name) {
+    const bool hex = (c >= '0' && c <= '9') || (c >= 'A' && c <= 'F') ||
+                     (c >= 'a' && c <= 'f');
+    if (!hex) return false;
+  }
+  return true;
+}
+
+// Whether a device already keeps something of this title (any profile's, or
+// the common folder's).
+template <class Fs>
+bool HoldsTitle(Fs& fs, const Device& device, uint32_t title_id) {
+  char title_text[9];
+  std::snprintf(title_text, sizeof(title_text), "%08X", title_id);
+  for (const auto& name : fs.ListDirectories(device.root)) {
+    if (!IsHexName(name, 16)) continue;
+    if (fs.IsDirectory(device.root / name / title_text)) return true;
+  }
+  return false;
+}
+
+// What the "where to save" window offers.
+//   shown  the devices offered (indices into the scan), in the scan's order
+//   focus  the button selected first (index into shown): the first device
+//          that already keeps this title's saves, else the first one
+//   list   more than one device: the list of drives; one: the window of
+//          1.0.2 (that device and Cancel)
+// A device with less free space than the game asked for is left out, unless
+// that leaves none: then all are offered, as before, and the game reports the
+// full drive itself. A device whose free space is unknown is offered.
+struct Prompt {
+  std::vector<size_t> shown;
+  size_t focus = 0;
+  bool list = false;
+};
+
+template <class HoldsTitleFn>
+Prompt Decide(const std::vector<Device>& devices, uint64_t requested,
+              HoldsTitleFn holds_title) {
+  Prompt prompt;
+  for (size_t i = 0; i < devices.size(); ++i) {
+    const Device& device = devices[i];
+    if (!requested || !device.space_known || device.free >= requested) {
+      prompt.shown.push_back(i);
+    }
+  }
+  if (prompt.shown.empty()) {
+    for (size_t i = 0; i < devices.size(); ++i) prompt.shown.push_back(i);
+  }
+  for (size_t k = 0; k < prompt.shown.size(); ++k) {
+    if (holds_title(devices[prompt.shown[k]])) {
+      prompt.focus = k;
+      break;
+    }
+  }
+  prompt.list = prompt.shown.size() > 1;
+  return prompt;
+}
+
+// The device a button stands for (index into the scan), or -1 for Cancel and
+// anything past it.
+inline int Chosen(const Prompt& prompt, uint32_t button) {
+  return button < prompt.shown.size() ? static_cast<int>(prompt.shown[button])
+                                      : -1;
+}
+
+// A translated text with its one "%s" replaced. Never a printf format: the
+// text may come from a language file.
+inline std::string Fill(std::string_view text, std::string_view value) {
+  const size_t at = text.find("%s");
+  if (at == std::string_view::npos) {
+    return std::string(text) + " " + std::string(value);
+  }
+  return std::string(text.substr(0, at)) + std::string(value) +
+         std::string(text.substr(at + 2));
+}
+
+// "16.0" for 16 GB, "931" from 100 GB up (decimal gigabytes, as the PS5's
+// own storage screens).
+inline std::string Gigabytes(uint64_t bytes) {
+  char text[32];
+  const double gigabytes = static_cast<double>(bytes) / 1e9;
+  std::snprintf(text, sizeof(text), gigabytes < 100 ? "%.1f" : "%.0f",
+                gigabytes);
+  return text;
+}
+
+// A device's button. tr translates the English text (UiText). One device:
+// "Hard drive" as in 1.0.2, or the drive's name. Several: "Internal
+// storage", "USB 1 (usb0)", "M.2 SSD / extended storage (ext1)", each with
+// its free space when it is known. The mount's name tells the drives apart
+// and is what the save drive setting names.
+template <class Tr>
+std::string Label(const Device& device, bool several, Tr tr) {
+  std::string label;
+  switch (device.kind) {
+    case Kind::kInternal:
+      label = several ? tr("Internal storage") : tr("Hard drive");
+      break;
+    case Kind::kExtended:
+      label = std::string(tr("M.2 SSD / extended storage")) + " (" +
+              device.name + ")";
+      break;
+    case Kind::kUsb:
+      label = Fill(tr("USB %s"), std::to_string(device.number)) + " (" +
+              device.name + ")";
+      break;
+  }
+  if (several && device.space_known) {
+    label += " \xE2\x80\x93 " + Fill(tr("%s GB free"), Gigabytes(device.free));
+  }
+  return label;
+}
+
+// The save drive setting (the title's "save_drive" option, general or per
+// game): its value is the index of a choice, kept in settings.txt and
+// game-settings/<title>.txt. 0 asks every time (the default: 1.0.2 asked each
+// time), 1 is the console's storage, 2 and on the slots in kSlots' order
+// (ext0-ext3, then usb0-usb7): each choice is one mount point, so the setting
+// names the same drive after a restart. The device ID it stands for, 0 for
+// asking (and for a value out of range).
+inline constexpr int kSaveDriveChoices = 2 + static_cast<int>(kSlotCount);
+inline uint32_t SaveDriveDeviceId(int choice) {
+  if (choice == 1) return kInternalDeviceId;
+  if (choice >= 2 && choice < kSaveDriveChoices) {
+    return kSlots[choice - 2].device_id;
+  }
+  return 0;
+}
+
+// The setting's choice for a device ID (-1 for none: the disc, 0, unknown).
+inline int SaveDriveChoiceFor(uint32_t device_id) {
+  if (device_id == kInternalDeviceId) return 1;
+  for (size_t i = 0; i < kSlotCount; ++i) {
+    if (kSlots[i].device_id == device_id) return 2 + static_cast<int>(i);
+  }
+  return -1;
+}
+
+// A drive chosen in the window for a game: whether the game keeps it as its
+// own Save drive value, so that later questions of that game (in this run and
+// the next ones) are answered without the window while the drive is there.
+//   own      the game's own value, -1 when it has none (it follows the
+//            general one; "General" in the game's settings)
+//   general  the general value
+// Returns the game's new own value, or -1 to leave it as it is:
+//   - an own "Ask every time" is the user's: kept, the window comes each time;
+//   - an own drive (the window came because it is missing, read-only or full):
+//     replaced by the drive chosen now;
+//   - no own value, general "Ask every time": the drive chosen is kept;
+//   - no own value, general a drive (missing now): left following the
+//     general one, which is used again once it is back.
+inline int RememberChoice(int own, int general, uint32_t chosen_device) {
+  const int choice = SaveDriveChoiceFor(chosen_device);
+  if (choice < 0 || own == 0) return -1;
+  if (own > 0) return own == choice ? -1 : choice;
+  return general == 0 ? choice : -1;
+}
+
+// What the save drive setting gives when a game asks where to save.
+//   kAsk         no saved drive (or an ID of no device): the window, as before
+//   kUse         the saved drive is mounted, writable and has the room the
+//                game asked for: its device, without the window (index). A
+//                mount that is the same filesystem as an offered one is that
+//                device.
+//   kNotMounted  the saved drive is not mounted (unplugged): the window, with
+//                a notice naming it (mount)
+//   kReadOnly    it is mounted but cannot be written: the window and a notice
+//   kNoSpace     it has less free space than the game asked for: the same
+// A saved drive is never replaced by another one without asking.
+enum class Saved { kAsk, kUse, kNotMounted, kReadOnly, kNoSpace };
+struct SavedDrive {
+  Saved state = Saved::kAsk;
+  size_t index = 0;   // into the scan, for kUse and kNoSpace
+  std::string mount;  // the saved drive's mount point (its folder: internal)
+};
+
+inline SavedDrive CheckSaved(const std::vector<Device>& devices,
+                             const std::vector<Skipped>& skipped,
+                             uint32_t saved_id, uint64_t requested,
+                             const std::filesystem::path& mount_root) {
+  SavedDrive saved;
+  if (!saved_id) return saved;
+  const Slot* slot = FindSlot(saved_id);
+  if (!slot && saved_id != kInternalDeviceId) return saved;
+  uint32_t id = saved_id;
+  for (const auto& skip : skipped) {
+    if (skip.id == saved_id && skip.why == Skipped::Why::kSameFilesystem) {
+      id = skip.same_as;
+    }
+  }
+  for (size_t i = 0; i < devices.size(); ++i) {
+    if (devices[i].id != id) continue;
+    saved.index = i;
+    saved.mount =
+        devices[i].mount.empty() ? devices[i].root.string() : devices[i].mount;
+    const bool room = !requested || !devices[i].space_known ||
+                      devices[i].free >= requested;
+    saved.state = room ? Saved::kUse : Saved::kNoSpace;
+    return saved;
+  }
+  if (!slot) return saved;  // the internal folder is always scanned
+  saved.mount = (mount_root.empty() ? std::filesystem::path("/mnt")
+                                    : mount_root) /
+                slot->mount;
+  saved.state = Saved::kNotMounted;
+  for (const auto& skip : skipped) {
+    if (skip.id == saved_id && skip.why == Skipped::Why::kNotWritable) {
+      saved.state = Saved::kReadOnly;
+    }
+  }
+  return saved;
+}
+
+// The window's notice for a saved drive that cannot be used (empty for the
+// others). tr translates the English text (UiText).
+template <class Tr>
+std::string Notice(const SavedDrive& saved, Tr tr) {
+  switch (saved.state) {
+    case Saved::kNotMounted:
+      return Fill(tr("The saved drive (%s) is not mounted; choose another."),
+                  saved.mount);
+    case Saved::kReadOnly:
+      return Fill(tr("The saved drive (%s) cannot be written; choose another."),
+                  saved.mount);
+    case Saved::kNoSpace:
+      return Fill(
+          tr("The saved drive (%s) does not have enough free space; choose "
+             "another."),
+          saved.mount);
+    default:
+      return std::string();
+  }
+}
+
+// Every text of the window that goes through UiText: the title translates
+// each (CoreUiText in canary_game_main.cpp; the host check finds them there).
+inline constexpr const char* kUiTexts[] = {
+    "Where should the game save?",
+    "The game asks where to keep its saved data.",
+    "Each drive keeps its saves in its own PS5X360/saves folder.",
+    "Hard drive",
+    "Internal storage",
+    "M.2 SSD / extended storage",
+    "USB %s",
+    "%s GB free",
+    "Cancel",
+    "The saved drive (%s) is not mounted; choose another.",
+    "The saved drive (%s) cannot be written; choose another.",
+    "The saved drive (%s) does not have enough free space; choose another.",
+};
+
+// For the log: each device's ID, folder, filesystem and free space.
+inline std::string Describe(const std::vector<Device>& devices) {
+  std::string text;
+  for (const auto& device : devices) {
+    if (!text.empty()) text += ", ";
+    text += std::to_string(device.id) + " " + device.root.string();
+    char dev[40];
+    std::snprintf(dev, sizeof(dev), "dev %llx",
+                  static_cast<unsigned long long>(device.fs.dev));
+    text += std::string(" [") + dev;
+    if (!device.fs.fsid.empty()) text += " fsid " + device.fs.fsid;
+    if (!device.fs.source.empty()) text += " " + device.fs.source;
+    if (!device.fs.type.empty()) text += " " + device.fs.type;
+    text += "]";
+    if (device.space_known) {
+      text += " (" + Gigabytes(device.free) + " GB free)";
+    } else if (device.fs.space_ok) {
+      text += " (free space not reported: " + Gigabytes(device.fs.free) +
+              " of " + Gigabytes(device.fs.capacity) + " GB, as another)";
+    } else {
+      text += " (free space unknown)";
+    }
+  }
+  return text;
+}
+
+// The console's filesystem (also the host's, for the checks).
+struct PosixFs {
+  bool IsMountPoint(const std::filesystem::path& path) {
+    struct stat self {}, parent {};
+    if (::stat(path.c_str(), &self) != 0 || !S_ISDIR(self.st_mode)) {
+      return false;
+    }
+    if (::stat((path / "..").c_str(), &parent) != 0) return false;
+    // Another filesystem than its parent's; or "/", its own parent.
+    return self.st_dev != parent.st_dev || self.st_ino == parent.st_ino;
+  }
+  bool IsDirectory(const std::filesystem::path& path) {
+    std::error_code error;
+    return std::filesystem::is_directory(path, error);
+  }
+  bool ProbeWritable(const std::filesystem::path& directory) {
+    const auto probe = directory / ".ps5x360-write-test";
+    const int file =
+        ::open(probe.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0644);
+    if (file < 0) return false;
+    const char byte = 0;
+    bool written = ::write(file, &byte, 1) == 1;
+    written = ::close(file) == 0 && written;
+    ::unlink(probe.c_str());
+    return written;
+  }
+  FsInfo Info(const std::filesystem::path& path) {
+    FsInfo info;
+    struct stat self {};
+    if (::stat(path.c_str(), &self) != 0) return info;
+    info.ok = true;
+    info.dev = static_cast<uint64_t>(self.st_dev);
+    // libc's statvfs (what std::filesystem::space uses), never the statfs
+    // system call: candidate 24 called statfs (FreeBSD syscall 396) on the
+    // console and the emulator died at the first scan with no crash report,
+    // as a process does on SIGSYS, FreeBSD's answer to a system call the
+    // sandbox does not have. Inside the sandbox statvfs answers 16 GiB free
+    // of 64 GiB for every path; Scan does not believe figures two
+    // filesystems share.
+    struct statvfs fs {};
+    if (::statvfs(path.c_str(), &fs) == 0 && fs.f_frsize) {
+      info.space_ok = true;
+      info.capacity = static_cast<uint64_t>(fs.f_blocks) * fs.f_frsize;
+      info.free = static_cast<uint64_t>(fs.f_bavail) * fs.f_frsize;
+      char fsid[24];
+      std::snprintf(fsid, sizeof(fsid), "%llx",
+                    static_cast<unsigned long long>(fs.f_fsid));
+      info.fsid = fsid;
+    }
+    // The device behind the filesystem: the /dev entry whose device number
+    // is the filesystem's st_dev (stat and a directory listing only, no
+    // statfs). Empty when /dev cannot be read or nothing matches.
+    info.source = DeviceName(info.dev);
+    return info;
+  }
+  std::string DeviceName(uint64_t dev) {
+    if (!dev_listed_) {
+      dev_listed_ = true;
+      std::error_code error;
+      for (std::filesystem::directory_iterator entry(dev_folder_, error), end;
+           !error && entry != end; entry.increment(error)) {
+        struct stat node {};
+        const auto path = entry->path();
+        if (::stat(path.c_str(), &node) != 0) continue;
+        if (!S_ISCHR(node.st_mode) && !S_ISBLK(node.st_mode)) continue;
+        dev_names_.push_back({static_cast<uint64_t>(node.st_rdev),
+                              path.string()});
+      }
+    }
+    for (const auto& [number, name] : dev_names_) {
+      if (number == dev) return name;
+    }
+    return std::string();
+  }
+  std::filesystem::path dev_folder_ = "/dev";
+  bool dev_listed_ = false;
+  std::vector<std::pair<uint64_t, std::string>> dev_names_;
+
+  std::vector<std::string> ListDirectories(const std::filesystem::path& path) {
+    std::vector<std::string> names;
+    std::error_code error;
+    for (std::filesystem::directory_iterator entry(path, error), end;
+         !error && entry != end; entry.increment(error)) {
+      std::error_code type_error;
+      if (entry->is_directory(type_error)) {
+        names.push_back(entry->path().filename().string());
+      }
+    }
+    return names;
+  }
+};
