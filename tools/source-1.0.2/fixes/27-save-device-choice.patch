+void ContentManager::ScanStorageDevicesLocked() const {
+  std::vector<storage::Skipped> skipped;
+  storage::PosixFs fs;
+  // The first scan of a session logs each step before taking it, flushed, so
+  // that a scan the process does not survive names its last step.
+  const bool trace = !storage_scanned_;
+  if (trace) {
+    XELOGW("Storage: looking for drives under {}",
+           external_storage_root ? external_storage_root : "(none)");
+    FlushLog();
+  }
+  std::vector<storage::Device> devices;
+  try {
+    devices = storage::Scan(
+        fs, root_path_,
+        external_storage_root ? std::filesystem::path(external_storage_root)
+                              : std::filesystem::path(),
+        &skipped, [trace](const std::string& step) {
+          if (!trace) return;
+          XELOGW("Storage: scan: {}", step);
+          FlushLog();
+        });
+  } catch (...) {
+    XELOGE("Storage: the drive scan failed; only the internal folder is offered");
+    skipped.clear();
+    storage::Device internal;
+    internal.root = root_path_;
+    devices = {internal};
+  }
+  bool changed =
+      !storage_scanned_ || devices.size() != storage_devices_.size();
+  for (size_t i = 0; !changed && i < devices.size(); ++i) {
+    changed = devices[i].id != storage_devices_[i].id ||
+              devices[i].root != storage_devices_[i].root;
+  }
+  if (changed) {
+    XELOGW("Storage: devices {}", storage::Describe(devices));
+    for (const auto& skip : skipped) {
+      if (skip.why == storage::Skipped::Why::kSameFilesystem) {
+        XELOGW("Storage: {} is the same filesystem as {}; offered once",
+               skip.mount, skip.detail);
+      } else if (skip.why == storage::Skipped::Why::kError ||
+                 skip.why == storage::Skipped::Why::kSameDisk ||
+                 skip.why == storage::Skipped::Why::kSystem) {
+        XELOGW("Storage: {} is {}; not offered", skip.mount, skip.detail);
+      } else {
+        XELOGW("Storage: {} is mounted but not writable (tried {}); not "
+               "offered",
+               skip.mount, skip.detail);
+      }
+    }
+  }
+  storage_devices_ = std::move(devices);
+  skipped_drives_ = std::move(skipped);
+  storage_scanned_ = true;
+}
+
+void ContentManager::RefreshStorageDevices() {
+  std::lock_guard<std::mutex> guard(storage_lock_);
+  ScanStorageDevicesLocked();
+}
+
+std::vector<storage::Device> ContentManager::StorageDevices() const {
+  std::lock_guard<std::mutex> guard(storage_lock_);
+  if (!storage_scanned_) ScanStorageDevicesLocked();
+  return storage_devices_;
+}
+
+std::vector<storage::Skipped> ContentManager::SkippedDrives() const {
+  std::lock_guard<std::mutex> guard(storage_lock_);
+  if (!storage_scanned_) ScanStorageDevicesLocked();
+  return skipped_drives_;
+}
+
+std::filesystem::path ContentManager::DeviceRoot(uint32_t device_id) const {
+  // The hard drive and IDs of no drive slot need no scan (profiles and title
+  // updates are read before any game asks for a drive).
+  if (!storage::FindSlot(device_id)) return root_path_;
+  return storage::RootFor(StorageDevices(), device_id);
+}
+
+uint32_t ContentManager::MetadataDeviceId(uint32_t device_id) const {
+  if (!storage::FindSlot(device_id)) return storage::kInternalDeviceId;
+  return storage::MetadataId(StorageDevices(), device_id);
+}
