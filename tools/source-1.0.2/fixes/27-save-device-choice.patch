+void ContentManager::ScanStorageDevicesLocked() const {
+  std::vector<std::string> skipped;
+  storage::PosixFs fs;
+  auto devices = storage::Scan(
+      fs, root_path_,
+      external_storage_root ? std::filesystem::path(external_storage_root)
+                            : std::filesystem::path(),
+      &skipped);
+  bool changed =
+      !storage_scanned_ || devices.size() != storage_devices_.size();
+  for (size_t i = 0; !changed && i < devices.size(); ++i) {
+    changed = devices[i].id != storage_devices_[i].id ||
+              devices[i].root != storage_devices_[i].root;
+  }
+  if (changed) {
+    XELOGW("Storage: devices {}", storage::Describe(devices));
+    for (const auto& mount : skipped) {
+      XELOGW("Storage: {} is mounted but not writable; not offered", mount);
+    }
+  }
+  storage_devices_ = std::move(devices);
+  storage_scanned_ = true;
+}
+
+void ContentManager::RefreshStorageDevices() {
+  std::lock_guard<std::mutex> guard(storage_lock_);
+  ScanStorageDevicesLocked();
+}
+
+std::vector<storage::Device> ContentManager::StorageDevices() const {
+  std::lock_guard<std::mutex> guard(storage_lock_);
+  if (!storage_scanned_) ScanStorageDevicesLocked();
+  return storage_devices_;
+}
+
+std::filesystem::path ContentManager::DeviceRoot(uint32_t device_id) const {
+  // The hard drive and IDs of no drive slot need no scan (profiles and title
+  // updates are read before any game asks for a drive).
+  if (!storage::FindSlot(device_id)) return root_path_;
+  return storage::RootFor(StorageDevices(), device_id);
+}
+
+uint32_t ContentManager::MetadataDeviceId(uint32_t device_id) const {
+  if (!storage::FindSlot(device_id)) return storage::kInternalDeviceId;
+  return storage::MetadataId(StorageDevices(), device_id);
+}
