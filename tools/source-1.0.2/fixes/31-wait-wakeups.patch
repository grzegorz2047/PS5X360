+// Xbox360PS5 (fix 31): the wait objects of threading_posix.cc (the base, Event,
+// Semaphore and Mutant), moved here unchanged apart from fix 31 so that a host
+// check builds the same code. The includer defines
+// xe::threading::SuspensionDeferred first (threading_posix.cc: it blocks the
+// suspend signal for its lifetime).
+//
+// Fix 31, multi-object waits. 1.0.2 woke them with one global condition
+// variable: every Set, Release or thread exit, of any object, took the global
+// any_mutex_ and broadcast to every thread parked in WaitMultiple, and each of
+// those took any_mutex_ again and polled its objects. Minecraft keeps seven
+// threads parked there and hands guest critical sections between three others
+// thousands of times a frame, so each hand-off paid for that herd. Now a
+// thread in WaitMultiple registers with each object it waits on (under that
+// object's mutex_, where it checked them) and an object's state change wakes
+// only the threads registered with it. The 4 ms bound on each sleep stays, for
+// state that changes without a signal.
+//
+// Also: a semaphore's decrement no longer wakes anybody (it cannot satisfy a
+// wait), and an auto-reset event's signal kept for the threads that were
+// waiting when it was set is released to the others when the last of those
+// leaves without taking it (a timeout, or a wait for several objects that
+// took another one); 1.0.2 kept it from a later waiter until the next Set.
+//
+// XBOX360PS5_LEGACY_WAKES (defined before including) gives 1.0.2's behaviour,
+// for the check's comparison (and util/critical_section.h's 1.0.2 Enter).
+
+#ifndef XENIA_BASE_POSIX_CONDITIONS_H_
+#define XENIA_BASE_POSIX_CONDITIONS_H_
+
+#include <pthread.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cerrno>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <limits>
+#include <mutex>
+#include <thread>
+#include <utility>
+#include <vector>
+
+#include "xenia/base/assert.h"
+#include "xenia/base/threading.h"
+#include "xenia/base/wait_stats.h"
+
+namespace xe {
+namespace threading {
+
+#ifdef XBOX360PS5_LEGACY_WAKES
+inline constexpr bool kTargetedWakes = false;
+#else
+inline constexpr bool kTargetedWakes = true;
+#endif
+
+// Longest sleep of a multi-object wait between two looks at its objects
+// (the check raises it, so that a lost wake-up shows as a hang).
+#ifndef XBOX360PS5_MULTI_WAIT_BOUND_MS
+#define XBOX360PS5_MULTI_WAIT_BOUND_MS 4
+#endif
+inline constexpr std::chrono::milliseconds kMultiWaitBound{
+    XBOX360PS5_MULTI_WAIT_BOUND_MS};
+
+class PosixConditionBase {
+ public:
+  PosixConditionBase() {
+    // Initialize as robust mutex to handle thread termination gracefully
+    pthread_mutexattr_t attr;
+    pthread_mutexattr_init(&attr);
+    pthread_mutexattr_setrobust(&attr, PTHREAD_MUTEX_ROBUST);
+
+    // Get the native handle and set it as robust
+    auto native_mutex = static_cast<pthread_mutex_t*>(mutex_.native_handle());
+    pthread_mutex_destroy(native_mutex);      // Destroy default mutex
+    pthread_mutex_init(native_mutex, &attr);  // Reinit as robust
+    pthread_mutexattr_destroy(&attr);
+  }
+
+  virtual ~PosixConditionBase() = default;
+  virtual bool Signal() = 0;
+
+  WaitResult Wait(std::chrono::milliseconds timeout) {
+    SuspensionDeferred condition_suspend_guard;
+    bool executed;
+    auto predicate = [this] { return this->signaled(); };
+
+    // Handle robust mutex locking
+    auto native_mutex = static_cast<pthread_mutex_t*>(mutex_.native_handle());
+    int lock_result = pthread_mutex_lock(native_mutex);
+    if (lock_result == EOWNERDEAD) {
+      // Recover from dead owner
+      pthread_mutex_consistent(native_mutex);
+    } else if (lock_result != 0) {
+      return WaitResult::kFailed;
+    }
+
+    std::unique_lock<std::mutex> lock(mutex_, std::adopt_lock);
+
+    if (predicate()) {
+      executed = true;
+    } else {
+      // Xbox360PS5: a blocked wait holds a ticket, so that a signal set while
+      // it waits is kept for it (see PosixCondition<Event>).
+      wait_ticket_ = ++ticket_counter_;
+      begin_wait();
+      const uint64_t blocked_at = wait_stats::Ticks();
+      if (timeout == std::chrono::milliseconds::max()) {
+        cond_.wait(lock, predicate);
+        executed = true;  // Did not time out;
+      } else {
+        executed = cond_.wait_for(lock, timeout, predicate);
+      }
+      if (executed) {
+        post_execution();
+      }
+      end_wait();
+      wait_ticket_ = 0;
+      lock.unlock();
+      wait_stats::Add(wait_stats::kSingleBlocked,
+                      wait_stats::Ticks() - blocked_at);
+      return executed ? WaitResult::kSuccess : WaitResult::kTimeout;
+    }
+    if (executed) {
+      post_execution();
+      return WaitResult::kSuccess;
+    }
+    return WaitResult::kTimeout;
+  }
+
+  // Xbox360PS5 (fix 31): a thread blocked in WaitMultiple, registered with
+  // each object it waits on.
+  struct MultiWaiter {
+    std::mutex mutex;
+    std::condition_variable cond;
+    bool notified = false;  // guarded by mutex
+  };
+
+  static std::pair<WaitResult, size_t> WaitMultiple(
+      std::vector<PosixConditionBase*>&& handles, bool wait_all,
+      std::chrono::milliseconds timeout) {
+    SuspensionDeferred condition_suspend_guard;
+    assert_true(!handles.empty());
+
+    // For single handle, just use the normal Wait path
+    if (handles.size() == 1) {
+      auto result = handles[0]->Wait(timeout);
+      return std::make_pair(result, 0);
+    }
+
+    // For multiple handles, we need to poll since we can't wait on multiple
+    // condition variables simultaneously. This is a limitation of the POSIX
+    // condition variable API.
+    auto start_time = std::chrono::steady_clock::now();
+    auto end_time = (timeout == std::chrono::milliseconds::max())
+                        ? std::chrono::steady_clock::time_point::max()
+                        : start_time + timeout;
+
+    // Xbox360PS5: once the first poll fails, this thread counts as a waiter of
+    // every handle (with a ticket, as in Wait), and sleeps until any object
+    // is signaled rather than for a fixed millisecond.
+    bool registered = false;
+    MultiWaiter self;
+    const auto unregister = [&handles, &registered, &self](bool locked) {
+      if (!registered) {
+        return;
+      }
+      for (auto handle : handles) {
+        if (locked) {
+          handle->end_multi_wait(&self);
+        } else {
+          std::lock_guard<std::mutex> handle_lock(handle->mutex_);
+          handle->end_multi_wait(&self);
+        }
+      }
+      registered = false;
+      wait_ticket_ = 0;
+    };
+
+    while (true) {
+      const uint64_t generation = any_generation_.load();
+      // Check all handles to see if any/all are signaled
+      // Use try_lock to avoid deadlocks from lock ordering issues
+      size_t first_signaled = std::numeric_limits<size_t>::max();
+      bool condition_met = false;
+
+      // Try to acquire all locks without blocking
+      std::vector<std::unique_lock<std::mutex>> locks;
+      locks.reserve(handles.size());
+      bool all_locked = true;
+
+      for (size_t i = 0; i < handles.size(); ++i) {
+        // Try to lock, handling robust mutex EOWNERDEAD case
+        auto native_mutex =
+            static_cast<pthread_mutex_t*>(handles[i]->mutex_.native_handle());
+        int result = pthread_mutex_trylock(native_mutex);
+
+        if (result == 0 || result == EOWNERDEAD) {
+          // Successfully acquired lock or recovered from dead owner
+          if (result == EOWNERDEAD) {
+            // Make mutex consistent after previous owner died
+            pthread_mutex_consistent(native_mutex);
+          }
+          locks.emplace_back(handles[i]->mutex_, std::adopt_lock);
+        } else {
+          // Couldn't acquire lock
+          all_locked = false;
+          break;
+        }
+      }
+
+      // If we couldn't acquire all locks, release what we have and retry
+      if (!all_locked) {
+        locks.clear();
+        std::this_thread::yield();
+        continue;
+      }
+
+      // Now we have all locks, check the condition
+      if (wait_all) {
+        // For wait_all, check if ALL are signaled
+        bool all_signaled = true;
+        for (size_t i = 0; i < handles.size(); ++i) {
+          if (!handles[i]->signaled()) {
+            all_signaled = false;
+            break;
+          }
+          if (first_signaled == std::numeric_limits<size_t>::max()) {
+            first_signaled = i;
+          }
+        }
+        condition_met = all_signaled;
+      } else {
+        // For wait_any, check if ANY is signaled
+        for (size_t i = 0; i < handles.size(); ++i) {
+          if (handles[i]->signaled()) {
+            first_signaled = i;
+            condition_met = true;
+            break;
+          }
+        }
+      }
+
+      if (condition_met) {
+        // Execute post_execution for the signaled handle(s)
+        if (wait_all) {
+          for (size_t i = 0; i < handles.size(); ++i) {
+            handles[i]->post_execution();
+          }
+        } else {
+          handles[first_signaled]->post_execution();
+        }
+        unregister(true);
+        return std::make_pair(WaitResult::kSuccess, first_signaled);
+      }
+
+      // Check timeout
+      auto now = std::chrono::steady_clock::now();
+      if (now >= end_time) {
+        unregister(true);
+        return std::make_pair<WaitResult, size_t>(WaitResult::kTimeout, 0);
+      }
+
+      if (!registered) {
+        registered = true;
+        wait_ticket_ = ++ticket_counter_;
+        for (auto handle : handles) {
+          handle->begin_multi_wait(&self);
+        }
+      }
+      if (kTargetedWakes) {
+        // Every handle is locked: a state change after this is made under
+        // one of their locks, after this reset, and finds this thread
+        // registered.
+        std::lock_guard<std::mutex> self_lock(self.mutex);
+        self.notified = false;
+      }
+
+      // Release locks before sleeping
+      locks.clear();
+
+      // Sleep until something is signaled (with a short bound, in case a
+      // state change does not go through a signal).
+      auto remaining =
+          std::chrono::duration_cast<std::chrono::milliseconds>(end_time - now);
+      auto sleep_time = std::min(remaining, kMultiWaitBound);
+      const uint64_t slept_at = wait_stats::Ticks();
+      bool woken;
+      if (kTargetedWakes) {
+        std::unique_lock<std::mutex> self_lock(self.mutex);
+        woken = self.cond.wait_for(self_lock, sleep_time,
+                                   [&self] { return self.notified; });
+      } else {
+        std::unique_lock<std::mutex> any_lock(any_mutex_);
+        ++any_parked_;
+        woken = any_cond_.wait_for(any_lock, sleep_time, [generation] {
+          return any_generation_.load() != generation;
+        });
+        --any_parked_;
+      }
+      wait_stats::Add(wait_stats::kMultiSleep,
+                      wait_stats::Ticks() - slept_at);
+      if (!woken) {
+        wait_stats::Add(wait_stats::kMultiBound);
+      }
+    }
+  }
+
+  [[nodiscard]] virtual void* native_handle() const {
+    return const_cast<std::condition_variable&>(cond_).native_handle();
+  }
+
+  // For the check: the threads in WaitMultiple registered with this object.
+  size_t multi_waiter_count() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return multi_waiters_.size();
+  }
+
+ protected:
+  [[nodiscard]] inline virtual bool signaled() const = 0;
+  inline virtual void post_execution() = 0;
+  // Xbox360PS5: around the blocked part of a wait, with mutex_ held.
+  virtual void begin_wait() {}
+  virtual void end_wait() {}
+
+ public:
+  // Xbox360PS5 (fix 31): with mutex_ held, after a change that can satisfy a
+  // wait: wakes the threads in WaitMultiple registered with this object.
+  void NotifyMultiWaiters() {
+    if (!kTargetedWakes || multi_waiters_.empty()) {
+      return;
+    }
+    for (MultiWaiter* waiter : multi_waiters_) {
+      std::lock_guard<std::mutex> waiter_lock(waiter->mutex);
+      waiter->notified = true;
+      waiter->cond.notify_one();
+    }
+    wait_stats::Add(wait_stats::kTargetedNotify, 0, multi_waiters_.size());
+  }
+  // 1.0.2's wake of every multi-object wait, kept only with
+  // XBOX360PS5_LEGACY_WAKES.
+  static void NotifyAnyLegacy() {
+    if (!kTargetedWakes) {
+      NotifyAny();
+    }
+  }
+
+  // Xbox360PS5: wakes the waits on several objects, after a state change.
+  static void NotifyAny() {
+    const uint64_t started = wait_stats::Ticks();
+    uint64_t parked;
+    {
+      SuspensionDeferred condition_suspend_guard;
+      std::lock_guard<std::mutex> any_lock(any_mutex_);
+      ++any_generation_;
+      parked = any_parked_;
+    }
+    any_cond_.notify_all();
+    wait_stats::Add(wait_stats::kGlobalNotify,
+                    wait_stats::Ticks() - started, parked);
+  }
+
+ protected:
+  void begin_multi_wait(MultiWaiter* waiter) {
+    begin_wait();
+    if (kTargetedWakes) {
+      multi_waiters_.push_back(waiter);
+    }
+  }
+  void end_multi_wait(MultiWaiter* waiter) {
+    if (kTargetedWakes) {
+      auto it = std::find(multi_waiters_.begin(), multi_waiters_.end(), waiter);
+      if (it != multi_waiters_.end()) {
+        multi_waiters_.erase(it);
+      }
+    }
+    end_wait();
+  }
+
+  // The ticket of the wait this thread is blocked in, or zero. Tickets grow
+  // with time: one taken before a signal is not greater than the counter read
+  // when the signal is set.
+  static inline thread_local uint64_t wait_ticket_ = 0;
+  static inline std::atomic<uint64_t> ticket_counter_{0};
+  static inline std::atomic<uint64_t> any_generation_{0};
+  static inline std::mutex any_mutex_;
+  static inline std::condition_variable any_cond_;
+  static inline uint64_t any_parked_ = 0;  // guarded by any_mutex_
+  std::condition_variable cond_;
+  std::mutex mutex_;
+  std::vector<MultiWaiter*> multi_waiters_;  // guarded by mutex_
+};
+
+// There really is no native POSIX handle for a single wait/signal construct
+// pthreads is at a lower level with more handles for such a mechanism.
+// This simple wrapper class functions as our handle and uses conditional
+// variables for waits and signals.
+template <typename T>
+class PosixCondition {};
+
+template <>
+class PosixCondition<Event> : public PosixConditionBase {
+ public:
+  PosixCondition(bool manual_reset, bool initial_state)
+      : signal_(initial_state), manual_reset_(manual_reset) {}
+  ~PosixCondition() override = default;
+
+  bool Signal() override {
+    {
+      SuspensionDeferred condition_suspend_guard;
+      auto lock = std::unique_lock(mutex_);
+      signal_ = true;
+      // Xbox360PS5: with threads already waiting, the signal of an auto-reset
+      // event is theirs (see PosixConditionBase::wait_ticket_).
+      reserved_ = !manual_reset_ && waiters_ > 0;
+      reserved_ticket_ = ticket_counter_.load();
+      // Fix 31: every thread waiting now holds a ticket not above
+      // reserved_ticket_ (tickets are taken under mutex_).
+      eligible_ = reserved_ ? waiters_ : 0;
+      cond_.notify_all();
+      NotifyMultiWaiters();
+    }
+    NotifyAnyLegacy();
+    return true;
+  }
+
+  void Reset() {
+    SuspensionDeferred condition_suspend_guard;
+    auto lock = std::unique_lock(mutex_);
+    signal_ = false;
+    reserved_ = false;
+  }
+
+  EventInfo Query() {
+    SuspensionDeferred condition_suspend_guard;
+    auto lock = std::unique_lock(mutex_);
+    // EVENT_TYPE: NotificationEvent = 0, SynchronizationEvent = 1.
+    return EventInfo{manual_reset_ ? 0u : 1u, signal_ ? 1u : 0u};
+  }
+
+ private:
+  [[nodiscard]] bool signaled() const override {
+    return signal_ && (!reserved_ || (wait_ticket_ != 0 &&
+                                      wait_ticket_ <= reserved_ticket_));
+  }
+  void post_execution() override {
+    if (!manual_reset_) {
+      signal_ = false;
+      reserved_ = false;
+    }
+  }
+  void begin_wait() override { ++waiters_; }
+  void end_wait() override {
+    const bool was_eligible =
+        reserved_ && wait_ticket_ != 0 && wait_ticket_ <= reserved_ticket_;
+    // Nobody left of those the signal was kept for: anyone may take it.
+    if (--waiters_ == 0) {
+      reserved_ = false;
+    } else if (kTargetedWakes && was_eligible && --eligible_ == 0) {
+      // Fix 31: the threads still waiting came after the signal; it is
+      // theirs now, as if it had been set after they started waiting.
+      reserved_ = false;
+      cond_.notify_all();
+      NotifyMultiWaiters();
+    }
+  }
+  uint32_t waiters_ = 0;
+  uint32_t eligible_ = 0;  // waiters that may take the kept signal
+  bool reserved_ = false;
+  uint64_t reserved_ticket_ = 0;
+  bool signal_;
+  const bool manual_reset_;
+};
+
+template <>
+class PosixCondition<Semaphore> final : public PosixConditionBase {
+ public:
+  PosixCondition(uint32_t initial_count, uint32_t maximum_count)
+      : count_(initial_count), maximum_count_(maximum_count) {}
+
+  bool Signal() override { return Release(1, nullptr); }
+
+  bool Release(uint32_t release_count, int* out_previous_count) {
+    SuspensionDeferred condition_suspend_guard;
+    auto lock = std::unique_lock(mutex_);
+    // Validate that releasing would not exceed the maximum count
+    if (count_ + release_count > maximum_count_) {
+      return false;
+    }
+    if (out_previous_count) {
+      *out_previous_count = count_;
+    }
+    count_ += release_count;
+    cond_.notify_all();
+    NotifyMultiWaiters();
+    NotifyAnyLegacy();  // Xbox360PS5: wake waits on several objects.
+    return true;
+  }
+
+ private:
+  [[nodiscard]] bool signaled() const override { return count_ > 0; }
+  void post_execution() override {
+    count_--;
+    // Fix 31: a decrement satisfies no wait; 1.0.2 woke everybody here.
+    if (!kTargetedWakes) {
+      cond_.notify_all();
+      PosixConditionBase::NotifyAny();
+    }
+  }
+  uint32_t count_;
+  const uint32_t maximum_count_;
+};
+
+template <>
+class PosixCondition<Mutant> final : public PosixConditionBase {
+ public:
+  explicit PosixCondition(bool initial_owner) : count_(0) {
+    if (initial_owner) {
+      count_ = 1;
+      owner_ = std::this_thread::get_id();
+    }
+  }
+
+  bool Signal() override { return Release(); }
+
+  bool Release() {
+    if (owner_ == std::this_thread::get_id() && count_ > 0) {
+      SuspensionDeferred condition_suspend_guard;
+      auto lock = std::unique_lock(mutex_);
+      --count_;
+      // Free to be acquired by another thread
+      if (count_ == 0) {
+        cond_.notify_all();
+        NotifyMultiWaiters();
+        NotifyAnyLegacy();  // Xbox360PS5: wake waits on several objects.
+      }
+      return true;
+    }
+    return false;
+  }
+
+  [[nodiscard]] void* native_handle() const override {
+    return const_cast<std::mutex&>(mutex_).native_handle();
+  }
+
+ private:
+  [[nodiscard]] bool signaled() const override {
+    return count_ == 0 || owner_ == std::this_thread::get_id();
+  }
+  void post_execution() override {
+    count_++;
+    owner_ = std::this_thread::get_id();
+  }
+  uint32_t count_;
+  std::thread::id owner_;
+};
+
+}  // namespace threading
+}  // namespace xe
+
+#endif  // XENIA_BASE_POSIX_CONDITIONS_H_
