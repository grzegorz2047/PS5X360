@@ -0,0 +1,133 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+// Xbox360PS5 (fix 31): RtlEnterCriticalSection and RtlLeaveCriticalSection
+// (xboxkrnl_rtl.cc), as templates over the section and the event wait/set so
+// that a host check runs the same code.
+//
+// Xenia's critical section hands the section to the thread it wakes: Leave
+// keeps lock_count at 0 or above and the woken thread becomes the owner, so
+// nobody else can take the section until that thread has been woken. When
+// threads that take one section briefly and often (Minecraft's Main, Chunk
+// update and Server threads) block on it, every Leave becomes a wake-up and
+// every following Enter a wait for one: a convoy whose speed is that of the
+// host's wake-ups. Fix 31 spins before blocking, for a bounded time
+// (kHostSpinTicks), as long as the section is held; a section held briefly is
+// then taken without sleeping, and no hand-off is ever needed for it. A
+// section that stays held longer is waited for as in 1.0.2. Mutual exclusion,
+// recursion and the hand-off to a thread that did block are unchanged.
+
+#ifndef XENIA_KERNEL_UTIL_CRITICAL_SECTION_H_
+#define XENIA_KERNEL_UTIL_CRITICAL_SECTION_H_
+
+#include <cstdint>
+
+#include "xenia/base/atomic.h"
+#include "xenia/base/wait_stats.h"
+
+namespace xe {
+namespace kernel {
+namespace critical_section {
+
+#ifdef XBOX360PS5_LEGACY_WAKES
+inline constexpr uint64_t kHostSpinTicks = 0;
+#else
+// TSC ticks: some 10-25 us at the TSC rates of x86-64 hosts (1.6-4 GHz).
+inline constexpr uint64_t kHostSpinTicks = 40000;
+#endif
+
+enum class Entered {
+  kRecursive,  // already the owner
+  kFree,       // taken at once or by the guest's own spin count
+  kSpun,       // taken by the host spin (fix 31)
+  kBlocked,    // waited on the section's event, then handed the section
+};
+
+inline int32_t LoadLockCount(const int32_t* lock_count) {
+#if defined(__GNUC__) || defined(__clang__)
+  return __atomic_load_n(lock_count, __ATOMIC_RELAXED);
+#else
+  return *static_cast<const volatile int32_t*>(lock_count);
+#endif
+}
+
+// `wait()` blocks on the section's event (KeWaitForSingleObject).
+template <typename Cs, typename Wait>
+Entered Enter(Cs* cs, uint32_t cur_thread, uint32_t spin_count, Wait&& wait) {
+  if (cs->owning_thread == cur_thread) {
+    // We already own the lock.
+    xe::atomic_inc(&cs->lock_count);
+    cs->recursion_count++;
+    return Entered::kRecursive;
+  }
+
+  // Spin loop
+  while (spin_count--) {
+    if (xe::atomic_cas(-1, 0, &cs->lock_count)) {
+      // Acquired.
+      cs->owning_thread = cur_thread;
+      cs->recursion_count = 1;
+      return Entered::kFree;
+    }
+  }
+
+  if (kHostSpinTicks) {
+    // Fix 31: wait for a brief holder without sleeping. Only a free section
+    // (no owner, nobody waiting) is taken, exactly as the guest's spin does.
+    const uint64_t started = xe::wait_stats::Ticks();
+    for (bool first = true;; first = false) {
+      if (LoadLockCount(&cs->lock_count) == -1 &&
+          xe::atomic_cas(-1, 0, &cs->lock_count)) {
+        cs->owning_thread = cur_thread;
+        cs->recursion_count = 1;
+        return first ? Entered::kFree : Entered::kSpun;
+      }
+      if (xe::wait_stats::Ticks() - started >= kHostSpinTicks) {
+        break;
+      }
+      xe::wait_stats::Pause();
+    }
+  }
+
+  Entered entered = Entered::kFree;
+  if (xe::atomic_inc(&cs->lock_count) != 0) {
+    // Create a full waiter.
+    wait();
+    entered = Entered::kBlocked;
+  }
+
+  cs->owning_thread = cur_thread;
+  cs->recursion_count = 1;
+  return entered;
+}
+
+// `signal()` sets the section's event (KeSetEvent) for the next owner. Returns
+// whether it did (the section was handed to a waiting thread).
+template <typename Cs, typename Signal>
+bool Leave(Cs* cs, Signal&& signal) {
+  // Drop recursion count - if it isn't zero we still have the lock.
+  if (--cs->recursion_count != 0) {
+    xe::atomic_dec(&cs->lock_count);
+    return false;
+  }
+
+  // Not owned - unlock!
+  cs->owning_thread = 0;
+  if (xe::atomic_dec(&cs->lock_count) != -1) {
+    // There were waiters - wake one of them.
+    signal();
+    return true;
+  }
+  return false;
+}
+
+}  // namespace critical_section
+}  // namespace kernel
+}  // namespace xe
+
+#endif  // XENIA_KERNEL_UTIL_CRITICAL_SECTION_H_
