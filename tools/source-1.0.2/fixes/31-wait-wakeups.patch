+
+// Xbox360PS5 (fix 31): counts of the guest's waits and hand-offs, for the
+// "Waits:" lines the game loop logs every half minute.
+//
+// Each thread counts into a slot of its own, written by that thread alone and
+// read by the reporter, so counting adds no shared cache line to the fast paths
+// (RtlEnterCriticalSection is called hundreds of thousands of times a second by
+// some games). Time is taken with the TSC, and only on the slow paths. The
+// critical sections that blocked a thread are counted by guest address in a
+// shared table, on the slow path only.
+
+#ifndef XENIA_BASE_WAIT_STATS_H_
+#define XENIA_BASE_WAIT_STATS_H_
+
+// Candidate 32 (diagnostic): 1.0.2's wake-ups and critical sections, counted.
+#ifndef XBOX360PS5_LEGACY_WAKES
+#define XBOX360PS5_LEGACY_WAKES 1
+#endif
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <string_view>
+#include <type_traits>
+#include <vector>
+
+#if defined(__x86_64__) || defined(_M_X64)
+#include <immintrin.h>
+#if defined(_MSC_VER)
+#include <intrin.h>
+#else
+#include <x86intrin.h>
+#endif
+#endif
+#include "xenia/base/platform.h"
+
+#if __has_include(<pthread.h>)
+#include <pthread.h>
+#define XE_WAIT_STATS_HAVE_PTHREAD 1
+#endif
+
+
+namespace xe {
+namespace wait_stats {
+
+enum Counter : unsigned {
+  kCsEnter,         // RtlEnterCriticalSection, not counting recursion
+  kCsSpun,          // contended, then taken by the host spin (fix 31)
+  kCsBlocked,       // contended, waited on its event (ticks: blocked)
+  kCsHandoff,       // RtlLeaveCriticalSection with waiters (ticks: the Set)
+  kSingleBlocked,   // single-object waits that blocked (ticks: blocked)
+  kGlobalNotify,    // 1.0.2's NotifyAny broadcasts (ticks; extra: parked)
+  kTargetedNotify,  // signals that woke multi-object waits (extra: woken)
+  kMultiSleep,      // WaitMultiple sleeps (ticks: slept)
+  kMultiBound,      // of those, ended by the 4 ms bound, not by a signal
+  kSuspendMask,     // SuspensionDeferred signal-mask pairs
+  kPriority,        // host priority changes on a wake (BoostOnWake)
+  kCount
+};
+
+inline uint64_t Ticks() {
+#if defined(__x86_64__) || defined(_M_X64)
+  return __rdtsc();
+#else
+  return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count());
+#endif
+}
+
+inline void Pause() {
+#if defined(__x86_64__) || defined(_M_X64)
+  _mm_pause();
+#endif
+}
+
+struct Slot {
+  std::array<std::atomic<uint64_t>, kCount> count{};
+  std::array<std::atomic<uint64_t>, kCount> ticks{};
+  std::array<std::atomic<uint64_t>, kCount> extra{};
+  std::array<std::atomic<uint64_t>, 3> name{};  // 24 bytes, NUL-padded
+  std::atomic<uint32_t> name_epoch{~0u};
+};
+
+inline constexpr size_t kSlots = 192;
+inline std::array<Slot, kSlots> slots;
+inline std::atomic<size_t> next_slot{0};
+inline std::atomic<uint32_t> epoch{0};  // advanced by each report
+inline thread_local Slot* my_slot = nullptr;
+
+// The last slot is shared by the threads beyond the others: counted with
+// fetch_add, and with no name.
+inline bool IsShared(const Slot& slot) { return &slot == &slots[kSlots - 1]; }
+
+inline Slot& Mine() {
+  if (my_slot) {
+    return *my_slot;
+  }
+  size_t index = next_slot.fetch_add(1, std::memory_order_relaxed);
+  if (index >= kSlots - 1) {
+    index = kSlots - 1;
+  }
+  my_slot = &slots[index];
+  return *my_slot;
+}
+
+inline void Bump(std::atomic<uint64_t>& value, uint64_t by, bool shared) {
+  if (shared) {
+    value.fetch_add(by, std::memory_order_relaxed);
+  } else {
+    value.store(value.load(std::memory_order_relaxed) + by,
+                std::memory_order_relaxed);
+  }
+}
+
+// Thread names as the emulator sets them (threading_posix.cc calls
+// RememberName where it calls pthread_setname_np): the PS5 has no call that
+// reads a thread's name back.
+struct NameEntry {
+  std::atomic<uint64_t> thread{0};
+  std::array<std::atomic<uint64_t>, 3> name{};  // 24 bytes, NUL-padded
+};
+inline constexpr size_t kNames = 512;
+inline std::array<NameEntry, kNames> names;
+
+template <typename T>
+inline uint64_t ThreadKey(T thread) {
+  if constexpr (std::is_pointer_v<T>) {
+    return uint64_t(reinterpret_cast<uintptr_t>(thread));
+  } else {
+    return uint64_t(thread);
+  }
+}
+
+inline NameEntry* FindName(uint64_t key, bool claim) {
+  if (!key) {
+    return nullptr;
+  }
+  const size_t start = size_t((key >> 4) * 0x9E3779B97F4A7C15ull >> 55) % kNames;
+  for (size_t probe = 0; probe < kNames; ++probe) {
+    NameEntry& entry = names[(start + probe) % kNames];
+    uint64_t seen = entry.thread.load(std::memory_order_acquire);
+    if (seen == key) {
+      return &entry;
+    }
+    if (seen == 0) {
+      if (!claim) {
+        return nullptr;
+      }
+      uint64_t expected = 0;
+      if (entry.thread.compare_exchange_strong(expected, key,
+                                               std::memory_order_acq_rel) ||
+          expected == key) {
+        return &entry;
+      }
+    }
+  }
+  return nullptr;
+}
+
+template <typename T>
+inline void RememberName(T thread, std::string_view name) {
+  if (NameEntry* entry = FindName(ThreadKey(thread), true)) {
+    char text[24] = {};
+    std::memcpy(text, name.data(), std::min(name.size(), sizeof(text) - 1));
+    for (size_t i = 0; i < 3; ++i) {
+      uint64_t word = 0;
+      std::memcpy(&word, text + i * 8, 8);
+      entry->name[i].store(word, std::memory_order_relaxed);
+    }
+  }
+}
+
+// The thread's name, read by the thread itself once per report period.
+inline void RefreshName(Slot& slot) {
+  const uint32_t now = epoch.load(std::memory_order_relaxed);
+  if (IsShared(slot) || slot.name_epoch.load(std::memory_order_relaxed) == now) {
+    return;
+  }
+  slot.name_epoch.store(now, std::memory_order_relaxed);
+#if XE_WAIT_STATS_HAVE_PTHREAD
+  if (const NameEntry* entry = FindName(ThreadKey(pthread_self()), false)) {
+    for (size_t i = 0; i < 3; ++i) {
+      slot.name[i].store(entry->name[i].load(std::memory_order_relaxed),
+                         std::memory_order_relaxed);
+    }
+    return;
+  }
+#if !XE_PLATFORM_PS5
+  char name[24] = {};
+  pthread_getname_np(pthread_self(), name, sizeof(name) - 1);
+  for (size_t i = 0; i < 3; ++i) {
+    uint64_t word = 0;
+    std::memcpy(&word, name + i * 8, 8);
+    slot.name[i].store(word, std::memory_order_relaxed);
+  }
+#endif
+#endif
+}
+
+inline void Add(Counter counter, uint64_t ticks = 0, uint64_t extra = 0) {
+  Slot& slot = Mine();
+  const bool shared = IsShared(slot);
+  Bump(slot.count[counter], 1, shared);
+  if (ticks) {
+    Bump(slot.ticks[counter], ticks, shared);
+  }
+  if (extra) {
+    Bump(slot.extra[counter], extra, shared);
+  }
+  if (counter == kCsBlocked || counter == kSingleBlocked) {
+    RefreshName(slot);
+  }
+}
+
+// Critical sections by guest address (slow paths only).
+struct CsEntry {
+  std::atomic<uint32_t> address{0};
+  std::atomic<uint32_t> spin{0};  // the guest's spin count / 256
+  std::atomic<uint64_t> blocked{0}, blocked_ticks{0}, handoffs{0},
+      handoff_ticks{0}, spun{0};
+};
+inline constexpr size_t kCsEntries = 1024;
+inline std::array<CsEntry, kCsEntries> cs_entries;
+
+inline CsEntry* FindCs(uint32_t address) {
+  if (!address) {
+    return nullptr;
+  }
+  size_t index = (uint32_t(address >> 2) * 2654435761u) % kCsEntries;
+  for (size_t probe = 0; probe < 32; ++probe) {
+    CsEntry& entry = cs_entries[(index + probe) % kCsEntries];
+    uint32_t seen = entry.address.load(std::memory_order_acquire);
+    if (seen == address) {
+      return &entry;
+    }
+    if (seen == 0) {
+      uint32_t expected = 0;
+      if (entry.address.compare_exchange_strong(expected, address,
+                                                std::memory_order_acq_rel) ||
+          expected == address) {
+        return &entry;
+      }
+    }
+  }
+  return nullptr;  // table full around there: not counted by address
+}
+
+inline void CsBlocked(uint32_t address, uint32_t spin, uint64_t ticks) {
+  if (CsEntry* entry = FindCs(address)) {
+    entry->spin.store(spin, std::memory_order_relaxed);
+    entry->blocked.fetch_add(1, std::memory_order_relaxed);
+    entry->blocked_ticks.fetch_add(ticks, std::memory_order_relaxed);
+  }
+}
+inline void CsSpun(uint32_t address) {
+  if (CsEntry* entry = FindCs(address)) {
+    entry->spun.fetch_add(1, std::memory_order_relaxed);
+  }
+}
+inline void CsHandoff(uint32_t address, uint64_t ticks) {
+  if (CsEntry* entry = FindCs(address)) {
+    entry->handoffs.fetch_add(1, std::memory_order_relaxed);
+    entry->handoff_ticks.fetch_add(ticks, std::memory_order_relaxed);
+  }
+}
+
+// --- Reporting (one caller, the game loop) -----------------------------------
+
+struct Totals {
+  std::array<uint64_t, kCount> count{}, ticks{}, extra{};
+};
+
+struct Reporter {
+  struct ThreadTotals {
+    uint64_t cs_ticks = 0, single_ticks = 0;
+  };
+  std::chrono::steady_clock::time_point at{};
+  uint64_t at_ticks = 0;
+  Totals totals;
+  std::array<ThreadTotals, kSlots> threads{};
+  std::vector<std::array<uint64_t, 5>> cs;  // address, blocked, ticks, handoffs, spun
+  bool started = false;
+};
+
+inline std::string Micro(double value) {
+  char text[32];
+  std::snprintf(text, sizeof(text), value < 10 ? "%.1f" : "%.0f", value);
+  return text;
+}
+
+// Lines describing what happened since the previous call. `frames` is the
+// number of frames the game submitted meanwhile. The first call only starts
+// the count and returns nothing.
+inline std::vector<std::string> Report(
+    Reporter& reporter, double frames,
+    std::chrono::steady_clock::time_point now =
+        std::chrono::steady_clock::now(),
+    uint64_t now_ticks = Ticks()) {
+  std::vector<std::string> lines;
+  Totals totals;
+  std::array<Reporter::ThreadTotals, kSlots> threads{};
+  const size_t used = std::min(next_slot.load(std::memory_order_acquire), kSlots);
+  for (size_t i = 0; i < used; ++i) {
+    const Slot& slot = slots[i];
+    for (unsigned c = 0; c < kCount; ++c) {
+      totals.count[c] += slot.count[c].load(std::memory_order_relaxed);
+      totals.ticks[c] += slot.ticks[c].load(std::memory_order_relaxed);
+      totals.extra[c] += slot.extra[c].load(std::memory_order_relaxed);
+    }
+    threads[i].cs_ticks = slot.ticks[kCsBlocked].load(std::memory_order_relaxed);
+    threads[i].single_ticks =
+        slot.ticks[kSingleBlocked].load(std::memory_order_relaxed);
+  }
+  std::vector<std::array<uint64_t, 5>> cs;
+  for (const CsEntry& entry : cs_entries) {
+    const uint32_t address = entry.address.load(std::memory_order_acquire);
+    if (address) {
+      cs.push_back({address, entry.blocked.load(std::memory_order_relaxed),
+                    entry.blocked_ticks.load(std::memory_order_relaxed),
+                    entry.handoffs.load(std::memory_order_relaxed),
+                    entry.spun.load(std::memory_order_relaxed)});
+    }
+  }
+  epoch.fetch_add(1, std::memory_order_relaxed);
+  if (!reporter.started) {
+    reporter.started = true;
+    reporter.at = now;
+    reporter.at_ticks = now_ticks;
+    reporter.totals = totals;
+    reporter.threads = threads;
+    reporter.cs = std::move(cs);
+    return lines;
+  }
+  const double seconds =
+      std::chrono::duration<double>(now - reporter.at).count();
+  const uint64_t tick_span = now_ticks - reporter.at_ticks;
+  if (seconds <= 0 || tick_span == 0) {
+    return lines;
+  }
+  const double us_per_tick = seconds * 1e6 / double(tick_span);
+  const auto delta = [&](Counter c) {
+    return double(totals.count[c] - reporter.totals.count[c]);
+  };
+  const auto delta_us = [&](Counter c) {
+    return double(totals.ticks[c] - reporter.totals.ticks[c]) * us_per_tick;
+  };
+  const auto delta_extra = [&](Counter c) {
+    return double(totals.extra[c] - reporter.totals.extra[c]);
+  };
+  const auto average = [&](Counter c) {
+    const double n = delta(c);
+    return n > 0 ? delta_us(c) / n : 0.0;
+  };
+  const double per = frames >= 1 ? frames : seconds;
+  const char* unit = frames >= 1 ? "frame" : "second";
+  char text[1024];
+  std::snprintf(
+      text, sizeof(text),
+      "Waits: %.0f frames in %.0f s; per %s: %.0f critical-section entries, "
+      "%.0f contended ones taken by spinning, %.0f blocked (%s us each, "
+      "%.1f ms in all), %.0f hand-offs (%s us to signal); %.0f other blocked "
+      "waits (%s us each); %.0f global wake-ups of multi-object waits (%s us, "
+      "%.1f threads each), %.0f targeted (%.1f threads each); %.0f "
+      "multi-object sleeps (%.0f ended by the 4 ms bound); %.0f signal-mask "
+      "pairs; %.0f priority changes",
+      frames, seconds, unit, delta(kCsEnter) / per, delta(kCsSpun) / per,
+      delta(kCsBlocked) / per, Micro(average(kCsBlocked)).c_str(),
+      delta_us(kCsBlocked) / per / 1000.0, delta(kCsHandoff) / per,
+      Micro(average(kCsHandoff)).c_str(),
+      (delta(kSingleBlocked) - delta(kCsBlocked)) / per,
+      Micro(delta(kSingleBlocked) > delta(kCsBlocked)
+                ? (delta_us(kSingleBlocked) - delta_us(kCsBlocked)) /
+                      (delta(kSingleBlocked) - delta(kCsBlocked))
+                : 0.0)
+          .c_str(),
+      delta(kGlobalNotify) / per, Micro(average(kGlobalNotify)).c_str(),
+      delta(kGlobalNotify) > 0
+          ? delta_extra(kGlobalNotify) / delta(kGlobalNotify)
+          : 0.0,
+      delta(kTargetedNotify) / per,
+      delta(kTargetedNotify) > 0
+          ? delta_extra(kTargetedNotify) / delta(kTargetedNotify)
+          : 0.0,
+      delta(kMultiSleep) / per, delta(kMultiBound) / per,
+      delta(kSuspendMask) / per, delta(kPriority) / per);
+  lines.push_back(text);
+
+  // The critical sections that blocked threads most in this period.
+  struct CsDelta {
+    uint32_t address;
+    uint64_t blocked, ticks, handoffs, spun;
+  };
+  std::vector<CsDelta> cs_delta;
+  for (const auto& now_entry : cs) {
+    std::array<uint64_t, 5> before{now_entry[0], 0, 0, 0, 0};
+    for (const auto& old : reporter.cs) {
+      if (old[0] == now_entry[0]) {
+        before = old;
+        break;
+      }
+    }
+    CsDelta d{uint32_t(now_entry[0]), now_entry[1] - before[1],
+              now_entry[2] - before[2], now_entry[3] - before[3],
+              now_entry[4] - before[4]};
+    if (d.blocked || d.handoffs || d.spun) {
+      cs_delta.push_back(d);
+    }
+  }
+  std::sort(cs_delta.begin(), cs_delta.end(),
+            [](const CsDelta& a, const CsDelta& b) {
+              return a.ticks != b.ticks ? a.ticks > b.ticks
+                                        : a.address < b.address;
+            });
+  if (!cs_delta.empty()) {
+    std::string line = "Waits: critical sections that blocked most:";
+    for (size_t i = 0; i < std::min<size_t>(cs_delta.size(), 4); ++i) {
+      const CsDelta& d = cs_delta[i];
+      uint32_t spin = 0;
+      for (const CsEntry& entry : cs_entries) {
+        if (entry.address.load(std::memory_order_relaxed) == d.address) {
+          spin = entry.spin.load(std::memory_order_relaxed);
+          break;
+        }
+      }
+      std::snprintf(text, sizeof(text),
+                    "%s %08X (spin %u): %.0f blocked/%s (%s us each), %.0f "
+                    "hand-offs, %.0f spun",
+                    i ? ";" : "", d.address, spin * 256, double(d.blocked) / per,
+                    unit,
+                    Micro(d.blocked ? double(d.ticks) * us_per_tick /
+                                          double(d.blocked)
+                                    : 0.0)
+                        .c_str(),
+                    double(d.handoffs) / per, double(d.spun) / per);
+      line += text;
+    }
+    lines.push_back(line);
+  }
+
+  // The threads that spent most of the period blocked.
+  struct ThreadDelta {
+    size_t index;
+    double cs, single;
+  };
+  std::vector<ThreadDelta> thread_delta;
+  for (size_t i = 0; i < used; ++i) {
+    const double cs_us =
+        double(threads[i].cs_ticks - reporter.threads[i].cs_ticks) * us_per_tick;
+    const double single_us =
+        double(threads[i].single_ticks - reporter.threads[i].single_ticks) *
+        us_per_tick;
+    if (cs_us > 0 || single_us > 0) {
+      thread_delta.push_back({i, cs_us, single_us});
+    }
+  }
+  std::sort(thread_delta.begin(), thread_delta.end(),
+            [](const ThreadDelta& a, const ThreadDelta& b) {
+              return a.cs != b.cs ? a.cs > b.cs : a.index < b.index;
+            });
+  if (!thread_delta.empty() && thread_delta.front().cs > 0) {
+    std::string line =
+        "Waits: share of the period blocked in critical sections (and in all "
+        "single waits):";
+    for (size_t i = 0; i < std::min<size_t>(thread_delta.size(), 5); ++i) {
+      const ThreadDelta& d = thread_delta[i];
+      char name[25] = {};
+      for (size_t w = 0; w < 3; ++w) {
+        const uint64_t word = slots[d.index].name[w].load(std::memory_order_relaxed);
+        std::memcpy(name + w * 8, &word, 8);
+      }
+      if (!name[0]) {
+        std::snprintf(name, sizeof(name), "thread %zu", d.index);
+      }
+      std::snprintf(text, sizeof(text), "%s '%s' %.0f%% (%.0f%%)", i ? "," : "",
+                    name, d.cs / (seconds * 1e4), d.single / (seconds * 1e4));
+      line += text;
+    }
+    lines.push_back(line);
+  }
+
+  reporter.at = now;
+  reporter.at_ticks = now_ticks;
+  reporter.totals = totals;
+  reporter.threads = threads;
+  reporter.cs = std::move(cs);
+  return lines;
+}
+
+}  // namespace wait_stats
+}  // namespace xe
+
+#endif  // XENIA_BASE_WAIT_STATS_H_
