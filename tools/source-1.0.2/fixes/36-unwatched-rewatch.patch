diff --git a/.deps/xenia-canary/src/xenia/gpu/unwatched_policy.h b/.deps/xenia-canary/src/xenia/gpu/unwatched_policy.h
new file mode 100644
index 0000000..ac4d952
--- /dev/null
+++ b/.deps/xenia-canary/src/xenia/gpu/unwatched_policy.h
@@ -0,0 +1,60 @@
+/**
+ ******************************************************************************
+ * Xbox360PS5: fix 36, unwatched units that stop changing are watched again.  *
+ ******************************************************************************
+ * An "unwatched" 4 KiB unit (shared_memory.cc, the dynamic_buffers option) is
+ * one the guest kept writing while it was protected: it is no longer protected,
+ * and every request a draw makes for it hashes the guest's bytes (XXH3 of the
+ * whole unit) to see whether it must be uploaded again. 1.0.2 kept a unit
+ * unwatched until its fault heat cooled down, about 600 frames, however rarely
+ * it changed: a vertex buffer the game wrote three times while loading and never
+ * again was hashed at every draw that used it for ten seconds, on the GPU
+ * command thread.
+ *
+ * Now a unit whose bytes were unchanged at every request for
+ * kFramesUnchangedToWatch frames is watched again: uploaded once more
+ * (MakeRangeValid protects it before the copy, so a write in between is not
+ * lost), then valid and protected like any other until the game writes to it
+ * again. Frames, not requests: a ring buffer refilled every frame and read by
+ * many draws is unchanged at most of its requests, and watching it again would
+ * cost a write fault (~40 us with two protection changes) where a hash of 4 KiB
+ * costs well under a microsecond; it stays unwatched and hashed as before.
+ ******************************************************************************
+ */
+
+#ifndef XENIA_GPU_UNWATCHED_POLICY_H_
+#define XENIA_GPU_UNWATCHED_POLICY_H_
+
+#include <cstdint>
+
+namespace xe {
+namespace gpu {
+namespace unwatched_policy {
+
+constexpr uint32_t kFramesUnchangedToWatch = 30;
+
+struct Decision {
+  bool upload;       // copy the guest's bytes to the GPU now
+  bool watch_again;  // stop leaving the unit unwatched (it is uploaded too)
+};
+
+// An unwatched unit at a request in guest frame `frame`: `seen` says
+// `last_hash` is the hash of what the GPU copy holds; `changed_frame` is the
+// frame of its last upload (set here when it uploads).
+inline Decision OnRequest(bool seen, uint64_t last_hash, uint64_t hash,
+                          uint32_t& changed_frame, uint32_t frame) {
+  if (seen && last_hash == hash) {
+    if (uint32_t(frame - changed_frame) >= kFramesUnchangedToWatch) {
+      return {true, true};
+    }
+    return {false, false};
+  }
+  changed_frame = frame;
+  return {true, false};
+}
+
+}  // namespace unwatched_policy
+}  // namespace gpu
+}  // namespace xe
+
+#endif  // XENIA_GPU_UNWATCHED_POLICY_H_
