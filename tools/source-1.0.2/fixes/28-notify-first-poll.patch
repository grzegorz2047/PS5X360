-  for (auto it = notifications_.begin(); it != notifications_.end(); ++it) {
-    if (it->first != id) {
-      continue;
-    }
-    dequeued = true;
-    *out_data = it->second;
-    notifications_.erase(it);
-    if (!notifications_.size()) {
-      wait_handle_->Reset();
-    }
-    break;
-  }
+  size_t released = 0;
+  const bool dequeued = notifications_.Match(id, out_data, &released);
+  AfterPoll(wait_handle_.get(), notifications_.pending(), released, handle());
   return dequeued;
