@@ -0,0 +1,123 @@
+/**
+ ******************************************************************************
+ * Xbox360PS5 (fix 28): a notification listener's queue                       *
+ ******************************************************************************
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+#ifndef XENIA_KERNEL_NOTIFY_QUEUE_H_
+#define XENIA_KERNEL_NOTIFY_QUEUE_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+namespace xe {
+namespace kernel {
+namespace notify {
+
+// The notifications of one XNotifyListener, in order.
+//
+// Push() makes a notification available to the next XNotifyGetNext at once.
+// PushAfterFirstPoll() holds it until the listener's first XNotifyGetNext has
+// returned: the core posts these itself when the listener is created, and on a
+// console XAM delivers such notifications from its own thread, never into the
+// call that creates the listener. Naruto: The Broken Bond (55530825) creates a
+// System|Live listener in its network start-up and polls it once right away,
+// before it has made the object its sign-in handler uses (the global at
+// 833A3400); a sign-in change in that first poll called 827F9D48 with a null
+// object and crashed (read at 0x10). Its next poll, from its frame loop after
+// start-up, handles the same notification safely.
+//
+// pending() says whether the listener's event should be set: held
+// notifications count, so a title that waits on the listener and polls too
+// early wakes again and gets them on its next poll.
+template <typename Id>
+class Queue {
+ public:
+  using Entry = std::pair<Id, uint32_t>;
+
+  void Push(Id id, uint32_t data) { ready_.emplace_back(id, data); }
+
+  // Returns true when the notification is held (the listener has not been
+  // polled yet), false when it is available at once.
+  bool PushAfterFirstPoll(Id id, uint32_t data) {
+    if (polled_) {
+      ready_.emplace_back(id, data);
+      return false;
+    }
+    held_.emplace_back(id, data);
+    return true;
+  }
+
+  // XNotifyGetNext without an id: the oldest available notification.
+  // released (optional) gets how many held notifications this poll made
+  // available (non-zero only on the first poll).
+  bool Next(Id* out_id, uint32_t* out_data, size_t* released = nullptr) {
+    bool taken = false;
+    if (!ready_.empty()) {
+      *out_id = ready_.front().first;
+      *out_data = ready_.front().second;
+      ready_.erase(ready_.begin());
+      taken = true;
+    }
+    FinishPoll(released);
+    return taken;
+  }
+
+  // XNotifyGetNext with an id: the oldest available notification with it.
+  bool Match(Id id, uint32_t* out_data, size_t* released = nullptr) {
+    bool taken = false;
+    for (auto it = ready_.begin(); it != ready_.end(); ++it) {
+      if (it->first != id) {
+        continue;
+      }
+      *out_data = it->second;
+      ready_.erase(it);
+      taken = true;
+      break;
+    }
+    FinishPoll(released);
+    return taken;
+  }
+
+  bool pending() const { return !ready_.empty() || !held_.empty(); }
+  bool polled() const { return polled_; }
+  size_t held() const { return held_.size(); }
+  size_t available() const { return ready_.size(); }
+
+  // Everything still queued, available first (Save).
+  std::vector<Entry> All() const {
+    std::vector<Entry> all(ready_);
+    all.insert(all.end(), held_.begin(), held_.end());
+    return all;
+  }
+
+ private:
+  void FinishPoll(size_t* released) {
+    if (released) {
+      *released = 0;
+    }
+    if (polled_) {
+      return;
+    }
+    polled_ = true;
+    if (released) {
+      *released = held_.size();
+    }
+    ready_.insert(ready_.end(), held_.begin(), held_.end());
+    held_.clear();
+  }
+
+  std::vector<Entry> ready_;
+  std::vector<Entry> held_;
+  bool polled_ = false;
+};
+
+}  // namespace notify
+}  // namespace kernel
+}  // namespace xe
+
+#endif  // XENIA_KERNEL_NOTIFY_QUEUE_H_
