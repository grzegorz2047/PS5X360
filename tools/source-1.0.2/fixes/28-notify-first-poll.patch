-    *out_data = it->second;
-    notifications_.erase(it);
-    if (!notifications_.size()) {
-      wait_handle_->Reset();
-    }
-  }
+  size_t released = 0;
+  const bool dequeued = notifications_.Next(out_id, out_data, &released);
+  AfterPoll(wait_handle_.get(), notifications_.pending(), released, handle());
   return dequeued;
 }
 
