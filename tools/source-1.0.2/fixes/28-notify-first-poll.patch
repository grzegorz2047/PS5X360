@@ -0,0 +1,71 @@
+/**
+ ******************************************************************************
+ * Xbox360PS5 (fix 28): Winsock-only socket options on a POSIX host           *
+ ******************************************************************************
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+#ifndef XENIA_KERNEL_UTIL_SOCKET_OPTION_POSIX_H_
+#define XENIA_KERNEL_UTIL_SOCKET_OPTION_POSIX_H_
+
+#include <cstdint>
+
+#if !defined(_WIN32)
+#include <sys/socket.h>
+#endif
+
+namespace xe {
+namespace kernel {
+namespace socket_option {
+
+// The guest's SOL_SOCKET level and the two Winsock options written as the
+// complement of another (SO_DONTLINGER = ~SO_LINGER, SO_EXCLUSIVEADDRUSE =
+// ~SO_REUSEADDR). XSocket::SetOption mapped them to ~SO_LINGER and
+// ~SO_REUSEADDR, which only Winsock knows; a POSIX host answers ENOPROTOOPT
+// (WSAENOPROTOOPT 0x273A in the log). Naruto: The Broken Bond sets
+// SO_DONTLINGER on its UDP socket before binding port 1111.
+constexpr uint32_t kGuestSolSocket = 0xFFFF;
+constexpr uint32_t kGuestDontLinger = ~uint32_t(0x0080);
+constexpr uint32_t kGuestExclusiveAddrUse = ~uint32_t(0x0004);
+
+enum class Kind {
+  kPassThrough,       // the usual mapping
+  kDontLinger,        // SO_LINGER with l_onoff = !value, l_linger kept
+  kExclusiveAddrUse,  // nothing to set: a POSIX socket without SO_REUSEADDR
+                      // already refuses a second bind to its address
+};
+
+constexpr Kind Classify(uint32_t level, uint32_t optname) {
+  if (level != kGuestSolSocket) {
+    return Kind::kPassThrough;
+  }
+  if (optname == kGuestDontLinger) {
+    return Kind::kDontLinger;
+  }
+  if (optname == kGuestExclusiveAddrUse) {
+    return Kind::kExclusiveAddrUse;
+  }
+  return Kind::kPassThrough;
+}
+
+#if !defined(_WIN32)
+// SO_DONTLINGER as Winsock does it: a non-zero value turns lingering off, zero
+// turns it on with the timeout the socket had. value is in host order.
+// Returns setsockopt's result (errno set on failure).
+inline int SetDontLinger(int fd, uint32_t value) {
+  linger current{};
+  socklen_t length = sizeof(current);
+  if (getsockopt(fd, SOL_SOCKET, SO_LINGER, &current, &length) != 0) {
+    current = linger{};
+  }
+  current.l_onoff = value ? 0 : 1;
+  return setsockopt(fd, SOL_SOCKET, SO_LINGER, &current, sizeof(current));
+}
+#endif
+
+}  // namespace socket_option
+}  // namespace kernel
+}  // namespace xe
+
+#endif  // XENIA_KERNEL_UTIL_SOCKET_OPTION_POSIX_H_
