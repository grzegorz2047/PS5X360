+bool XNotifyListener::EnqueueNotificationAfterFirstPoll(XNotificationID id,
+                                                        uint32_t data) {
+  auto key = XNotificationKey(id);
+  if ((mask_ & uint64_t(1ULL << key.mask_index)) == 0) {
+    return false;
+  }
+  if (key.version > max_version_) {
+    return false;
+  }
+  auto global_lock = global_critical_region_.Acquire();
+  const bool held = notifications_.PushAfterFirstPoll(id, data);
+  // Set while held too: a title waiting on the listener wakes, and its poll
+  // after the first gets the notification.
+  wait_handle_->Set();
+  return held;
+}
+
+// Xbox360PS5 (fix 28): after a poll, the event follows what is still queued
+// (held notifications included), and the first poll's release is logged.
+static void AfterPoll(xe::threading::Event* wait_handle, bool pending,
+                      size_t released, uint32_t handle) {
+  if (!pending) {
+    wait_handle->Reset();
+  }
+  if (released) {
+    XELOGW(
+        "Notifications: listener {:08X} polled for the first time; {} "
+        "notification(s) it got at creation now available",
+        handle, released);
+  }
+}
+
