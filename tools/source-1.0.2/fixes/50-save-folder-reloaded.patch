+template <class Fs>
+Migration MigrateSaves(Fs& fs, const std::filesystem::path& folder) {
+  Migration migration;
+  migration.from = folder / kLegacySaveFolder / "saves";
+  migration.to = folder / kSaveFolder / "saves";
+  if (!fs.IsDirectory(migration.from)) return migration;
+  if (fs.Exists(migration.to)) {
+    migration.result = Migration::Result::kBothKept;
+    return migration;
+  }
+  int error = 0;
+  if (!fs.MakeDirectory(folder / kSaveFolder, &error)) {
+    migration.result = Migration::Result::kFailed;
+    migration.step = "mkdir";
+    migration.error = error;
+    return migration;
+  }
+  if (!fs.Rename(migration.from, migration.to, &error)) {
+    migration.result = Migration::Result::kFailed;
+    migration.step = "rename";
+    migration.error = error;
+    return migration;
+  }
+  migration.result = Migration::Result::kMoved;
+  migration.old_folder_removed = fs.RemoveDirectory(folder / kLegacySaveFolder);
+  return migration;
