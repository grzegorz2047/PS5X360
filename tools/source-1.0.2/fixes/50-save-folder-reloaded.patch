+template <class Fs>
+void MigrateDrives(Fs& fs, const std::filesystem::path& mount_root,
+                   std::vector<Migration>* out) {
+  if (mount_root.empty()) return;
+  for (const auto& slot : kSlots) {
+    const auto mount = mount_root / slot.mount;
+    try {
+      if (!fs.IsMountPoint(mount)) continue;
+      for (const char* base : kSaveBases) {
+        const auto folder = *base ? mount / base : mount;
+        if (*base && !fs.IsDirectory(folder)) continue;
+        Migration migration = MigrateSaves(fs, folder);
+        if (migration.result != Migration::Result::kNone && out) {
+          out->push_back(std::move(migration));
+        }
+      }
+    } catch (...) {
+      // A drive that cannot be read is left as it is; the scan reports it.
+    }
+  }
 }
 
