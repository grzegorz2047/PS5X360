+//   bool Rename(const path& from, const path& to, int* error)
+//   bool RemoveDirectory(const path&)              rmdir: empty folders only
+struct Migration {
+  enum class Result { kNone, kMoved, kBothKept, kFailed } result = Result::kNone;
+  std::filesystem::path from, to;  // the old and the new saves folder
+  bool old_folder_removed = false;  // kMoved: <base>/PS5X360 was empty and is gone
+  std::string step;                 // kFailed: "mkdir" or "rename"
+  int error = 0;                    // kFailed: errno
