+// Xbox360PS5 (fix 45): see threading.h. As SuspensionDeferred, without its
+// wait statistics (the log takes it for every line).
+SuspensionDeferral::SuspensionDeferral() {
+  sigset_t signals, previous;
+  sigemptyset(&signals);
+  sigaddset(&signals, GetSystemSignal(SignalType::kThreadSuspend));
+  pthread_sigmask(SIG_BLOCK, &signals, &previous);
+  was_deferred_ =
+      sigismember(&previous, GetSystemSignal(SignalType::kThreadSuspend)) == 1;
+}
+
+SuspensionDeferral::~SuspensionDeferral() {
+  if (was_deferred_) {
+    return;
+  }
+  sigset_t signals;
+  sigemptyset(&signals);
+  sigaddset(&signals, GetSystemSignal(SignalType::kThreadSuspend));
+  pthread_sigmask(SIG_UNBLOCK, &signals, nullptr);
+}
