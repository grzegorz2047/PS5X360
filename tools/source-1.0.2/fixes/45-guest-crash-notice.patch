diff --git a/port/guest_crash.hpp b/port/guest_crash.hpp
new file mode 100644
index 0000000..adbae9b
--- /dev/null
+++ b/port/guest_crash.hpp
@@ -0,0 +1,147 @@
+// SPDX-License-Identifier: MIT
+// Fix 45: a guest crash, kept for the screen and the STALL report.
+//
+// When guest code faults, the core's Emulator::ExceptionCallback logs its crash dump, then calls
+// Pause() and only after it shows an "Uh-oh!" dialog (an ImGui modal with the whole dump); and
+// Pause() never returned (Minecraft, 584111F7: XmaDecoder::Pause waited for an idle worker,
+// research/minecraft-online-hang/VERDICT.md). The player saw a picture frozen at 0 FPS and the
+// STALL report began with "no output is not proof of deadlock".
+// Before it builds the dump, the core now calls the weak hook Xbox360PS5GuestCrashed
+// (canary_game_main.cpp), which records the crash here: the overlay shows that the game crashed
+// and how to leave it, and the STALL report's first line names the crash. With the hook the core
+// leaves its modal out, which would cover the game and take the focus of the library overlay and
+// the on-screen keyboard.
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cinttypes>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+namespace xbox360ps5 {
+namespace guest_crash {
+
+// The first guest crash of the run.
+struct Crash {
+  bool recorded = false;
+  uint32_t pc = 0;             // guest address of the faulting instruction
+  uint32_t thread = 0;         // the guest thread's handle (the log lines' prefix, F8000104)
+  uint64_t fault_address = 0;  // host address an access violation touched; 0 for other faults
+  int64_t at_ms = 0;           // NowMs() when it was recorded
+  uint32_t count = 0;          // guest crashes recorded in all (later ones only counted)
+};
+
+inline int64_t NowMs() {
+  return std::chrono::duration_cast<std::chrono::milliseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+// Written by the crashing guest thread from the exception handler: atomics only, no lock, no
+// allocation. Read by the frame loop, the overlay and the STALL report.
+class Recorder {
+ public:
+  // Keeps the first crash and counts the others; true when this one is kept.
+  bool Record(uint32_t pc, uint32_t thread, uint64_t fault_address, int64_t now_ms) {
+    count_.fetch_add(1, std::memory_order_relaxed);
+    bool expected = false;
+    if (!claimed_.compare_exchange_strong(expected, true, std::memory_order_acq_rel)) return false;
+    pc_.store(pc, std::memory_order_relaxed);
+    thread_.store(thread, std::memory_order_relaxed);
+    fault_address_.store(fault_address, std::memory_order_relaxed);
+    at_ms_.store(now_ms, std::memory_order_relaxed);
+    recorded_.store(true, std::memory_order_release);
+    return true;
+  }
+  Crash Get() const {
+    Crash crash;
+    if (!recorded_.load(std::memory_order_acquire)) return crash;
+    crash.recorded = true;
+    crash.pc = pc_.load(std::memory_order_relaxed);
+    crash.thread = thread_.load(std::memory_order_relaxed);
+    crash.fault_address = fault_address_.load(std::memory_order_relaxed);
+    crash.at_ms = at_ms_.load(std::memory_order_relaxed);
+    crash.count = count_.load(std::memory_order_relaxed);
+    return crash;
+  }
+
+ private:
+  std::atomic<bool> claimed_{false}, recorded_{false};
+  std::atomic<uint32_t> pc_{0}, thread_{0}, count_{0};
+  std::atomic<uint64_t> fault_address_{0};
+  std::atomic<int64_t> at_ms_{0};
+};
+
+// Constant-initialized (no guard to take inside the exception handler).
+inline constinit Recorder global_recorder;
+inline Recorder& Global() { return global_recorder; }
+
+// Whole seconds since the crash (0 when the clock reads earlier).
+inline int64_t SecondsAgo(const Crash& crash, int64_t now_ms) {
+  return now_ms > crash.at_ms ? (now_ms - crash.at_ms) / 1000 : 0;
+}
+
+// The STALL report's first line. Without a crash, the line it always was; after one, the crash
+// first, then what the frame watch saw.
+inline std::string StallHeadline(const Crash& crash, int64_t now_ms, uint32_t title_id,
+                                 const std::string& title, double seconds, uint64_t frames,
+                                 uint64_t swaps) {
+  char line[512];
+  if (!crash.recorded) {
+    std::snprintf(line, sizeof(line),
+                  "STALL title %08X '%s' after %.0fs, %" PRIu64 " refreshed outputs, %" PRIu64
+                  " submitted swaps; no output is not proof of deadlock",
+                  title_id, title.c_str(), seconds, frames, swaps);
+    return line;
+  }
+  char others[48] = "";
+  if (crash.count > 1) {
+    std::snprintf(others, sizeof(others), "; %u guest crashes in all", crash.count);
+  }
+  std::snprintf(line, sizeof(line),
+                "STALL after a guest crash on thread %08X at PC %08X, %" PRId64
+                " s ago; the emulator paused itself (title %08X '%s' after %.0fs, %" PRIu64
+                " refreshed outputs, %" PRIu64 " submitted swaps%s)",
+                crash.thread, crash.pc, SecondsAgo(crash, now_ms), title_id, title.c_str(), seconds,
+                frames, swaps, others);
+  return line;
+}
+
+// The STALL report's state of a thread: for the thread that crashed, the crash (it sits in the
+// exception handler, which "not in a wait" would hide); "" for any other thread.
+inline std::string ThreadNote(const Crash& crash, uint32_t thread, int64_t now_ms) {
+  if (!crash.recorded || crash.thread != thread) return "";
+  char note[160];
+  if (crash.fault_address) {
+    std::snprintf(note, sizeof(note),
+                  "crashed at PC %08X (access violation at %016" PRIX64 "), %" PRId64 " s ago",
+                  crash.pc, crash.fault_address, SecondsAgo(crash, now_ms));
+  } else {
+    std::snprintf(note, sizeof(note), "crashed at PC %08X, %" PRId64 " s ago", crash.pc,
+                  SecondsAgo(crash, now_ms));
+  }
+  return note;
+}
+
+// The overlay's notice (English keys, translated by Tr in canary_game_main.cpp's FpsOverlay; the
+// language files of tools/source-1.0.2/english/lang have both). The guide opens with the
+// touchpad, or OPTIONS + touchpad when the touchpad is the game's.
+constexpr const char* kNoticeTouchpad =
+    "The game crashed and the emulator paused it. Touchpad: guide, then Close the game and return "
+    "to the menu";
+constexpr const char* kNoticeOptions =
+    "The game crashed and the emulator paused it. OPTIONS + touchpad: guide, then Close the game "
+    "and return to the menu";
+
+// What follows the translated notice: where the game crashed.
+inline std::string NoticeDetail(const Crash& crash) {
+  if (!crash.recorded) return "";
+  char detail[32];
+  std::snprintf(detail, sizeof(detail), " (PC %08X)", crash.pc);
+  return detail;
+}
+
+}  // namespace guest_crash
+}  // namespace xbox360ps5
