+// Fix 41: the home's cover download (covers.cpp) falls back to Microsoft's own box art when
+// XboxUnity has no cover, as the official 1.0.2 eboot does.
+//
+// The official cover routine (0xd1000-0xd2c00) asks XboxUnity first (CoverInfo.php, then
+// Cover.php for the chosen cover) and, when that gave no picture, the Xbox marketplace image
+// server: http://download.xbox.com/content/images/66acd000-77fe-1000-9115-d802<id>/1033/boxartlg.jpg
+// with the title ID in lower case. A picture is at least 4 bytes and starts FF D8 (JPEG) or 89 'P'
+// (PNG). Its log line names where the cover came from ("XboxUnity cover <cid>" or "Xbox
+// marketplace box art"); a title neither has, or whose server answered with an HTTP error, counts
+// as without a cover; once a request to each server failed for want of a connection the run
+// stops (one down server alone only stops asking it). The shared HTTP GET (0xd3220) adds the
+// address xboxunity.net had in October 2026 to the ones it looked up only for that host.
+// game_art.cpp (the home's background and tile) builds the same image-server paths.
+// No Xenia headers here: the interface texts come in translated (checked on the host by
+// tools/check-cover-fallback.cpp).
+#pragma once
+
+#include <cctype>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace xbox360ps5::cover_fallback {
+
+constexpr const char* kXboxUnityHost = "xboxunity.net";
+constexpr const char* kMarketplaceHost = "download.xbox.com";
+// xboxunity.net's address in October 2026, tried after the looked-up ones.
+constexpr const char* kXboxUnityAddress = "149.56.47.64";
+constexpr const char* kMarketplaceSource = "Xbox marketplace box art";
+
+// The fixed address to try for a host after the looked-up ones: xboxunity.net's only.
+inline const char* FixedAddress(const std::string& host) {
+  return host == kXboxUnityHost ? kXboxUnityAddress : nullptr;
+}
+
+inline std::string LowerTitleId(std::string title_id) {
+  for (auto& ch : title_id) ch = char(std::tolower(static_cast<unsigned char>(ch)));
+  return title_id;
+}
+
+// The path on download.xbox.com of a title's marketplace image `name` (boxartlg.jpg,
+// background.jpg, tile.png), English (1033).
+inline std::string MarketplaceImagePath(const std::string& title_id, const std::string& name) {
+  return "/content/images/66acd000-77fe-1000-9115-d802" + LowerTitleId(title_id) + "/1033/" + name;
+}
+
+inline std::string BoxArtPath(const std::string& title_id) {
+  return MarketplaceImagePath(title_id, "boxartlg.jpg");
+}
+
+// A JPEG or PNG: at least 4 bytes, FF D8 or 89 'P' first.
+inline bool IsCoverImage(const std::vector<uint8_t>& data) {
+  return data.size() >= 4 && ((data[0] == 0xFF && data[1] == 0xD8) || (data[0] == 0x89 && data[1] == 'P'));
+}
+
+inline std::string XboxUnitySource(const std::string& cover_id) { return "XboxUnity cover " + cover_id; }
+
+// The interface texts the decisions compare with, translated by the caller (Tr).
+struct Texts {
+  std::string invalid_image;    // Tr("invalid image")
+  std::string server_returned;  // Tr("server returned "), the start of an HTTP error
+  std::string no_connection;    // Tr("no connection to "), the start of a connection failure
+  std::string no_socket;        // Tr("socket unavailable")
+};
+
+// A failure that the next title would hit as well: no connection, no socket.
+inline bool ConnectionLost(const std::string& error, const Texts& texts) {
+  return (!texts.no_connection.empty() && error.rfind(texts.no_connection, 0) == 0) ||
+         (!error.empty() && error == texts.no_socket);
+}
+
+// Kept over one run of the downloader.
+struct RunState {
+  bool xboxunity_down = false;    // CoverInfo.php could not be reached: XboxUnity is not asked again
+  bool marketplace_down = false;  // download.xbox.com could not be reached: not asked again
+};
+
+struct Result {
+  std::vector<uint8_t> image;  // the picture when `source` is set
+  std::string source;          // "XboxUnity cover <cid>", "Xbox marketplace box art", or empty
+  std::string error;           // why there is none (XboxUnity's reason first), may be empty
+};
+
+enum class Outcome { kFetched, kMissing, kFailed };
+
+// One title's cover. get(host, path, body, error) is an HTTP GET (true and the body on 200, else
+// false and a reason); choose(json) picks the cover ID from CoverInfo.php's answer ("" for none).
+template <typename Get, typename Choose>
+Result Fetch(const std::string& title_id, RunState& state, const Texts& texts, Get&& get, Choose&& choose) {
+  Result result;
+  if (!state.xboxunity_down) {
+    std::vector<uint8_t> info;
+    if (!get(std::string(kXboxUnityHost), "/Resources/Lib/CoverInfo.php?titleid=" + title_id, info,
+             result.error)) {
+      state.xboxunity_down = ConnectionLost(result.error, texts);
+    } else {
+      result.error.clear();
+      const std::string cover = choose(std::string(info.begin(), info.end()));
+      if (!cover.empty()) {
+        if (get(std::string(kXboxUnityHost), "/Resources/Lib/Cover.php?size=large&cid=" + cover,
+                result.image, result.error) &&
+            IsCoverImage(result.image)) {
+          result.source = XboxUnitySource(cover);
+          result.error.clear();
+          return result;
+        }
+        if (result.error.empty()) result.error = texts.invalid_image;
+      }
+    }
+  }
+  if (!state.marketplace_down) {
+    std::vector<uint8_t> art;
+    std::string error;
+    const bool ok = get(std::string(kMarketplaceHost), BoxArtPath(title_id), art, error);
+    state.marketplace_down = !ok && ConnectionLost(error, texts);
+    if (ok && IsCoverImage(art)) {
+      result.image.swap(art);
+      result.source = kMarketplaceSource;
+      result.error.clear();
+      return result;
+    }
+    if (result.error.empty()) result.error = error;
+  }
+  result.image.clear();
+  return result;
+}
+
+// Fetched with a source; without a cover when no server had one or a server answered with an HTTP
+// error (a title the marketplace does not know gives 404); failed otherwise.
+inline Outcome Classify(const Result& result, const Texts& texts) {
+  if (!result.source.empty()) return Outcome::kFetched;
+  if (result.error.empty() ||
+      (!texts.server_returned.empty() && result.error.rfind(texts.server_returned, 0) == 0))
+    return Outcome::kMissing;
+  return Outcome::kFailed;
+}
+
+// The rest of the run would fail the same way: neither server can be reached.
+inline bool Stop(const RunState& state) { return state.xboxunity_down && state.marketplace_down; }
+
+}  // namespace xbox360ps5::cover_fallback
