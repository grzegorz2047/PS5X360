diff --git a/include/xbox360ps5/deferred_watch.hpp b/include/xbox360ps5/deferred_watch.hpp
--- a/include/xbox360ps5/deferred_watch.hpp
+++ b/include/xbox360ps5/deferred_watch.hpp
@@ -19,10 +19,24 @@
 // leaves no write unseen: one before the protection changes the hash, one after it faults.
 // A draw later in the same submission can still use a unit's copy after the game rewrote it
 // (before, that write faulted at once): the reason the setting is per game and off by default.
+//
+// Fix 70 (tools/source-1.0.2/fixes/70-deferred-watch-checks.patch): on 1.0.4_candidate_27
+// Modern Warfare 2 ran faster with the setting (its GPU thread's "marking valid" from 202-275 to
+// 12-18 ms a second) but showed a film-grain flicker over the whole screen now and then: a draw
+// later in a submission used a copy the game had rewritten since its upload. Now only uploads
+// for vertex data (requests that keep nothing for later, RequestRange's allow_unwatched) are
+// deferred, everything else is protected at once as before; and every request first compares
+// the waiting units of its range with their hashes, so a unit the game wrote since its upload is
+// invalidated and uploaded again before the draw uses it, as its write fault would have made it.
+// The summary also names the units changed most often; it no longer needs "Optimized video
+// memory"; Modern Warfare 2's preset leaves the setting off until the console shows it clean.
 #pragma once
 #include <algorithm>
 #include <cstddef>
 #include <cstdint>
+#include <cstdio>
+#include <string>
+#include <unordered_map>
 #include <vector>
 
 namespace xbox360ps5::deferred_watch {
@@ -99,4 +113,20 @@ class Pending {
   uint64_t serial_ = 0;
 };
 
+// Fix 70: the units changed most often, "physical address (count)" by count, at most `most`.
+inline std::string TopChanged(const std::unordered_map<uint32_t, uint32_t>& counts, uint32_t unit_shift,
+                              size_t most) {
+  std::vector<std::pair<uint32_t, uint32_t>> items(counts.begin(), counts.end());
+  std::sort(items.begin(), items.end(), [](const auto& a, const auto& b) {
+    return a.second != b.second ? a.second > b.second : a.first < b.first;
+  });
+  std::string out;
+  for (size_t n = 0; n < items.size() && n < most; ++n) {
+    char item[40];
+    std::snprintf(item, sizeof(item), "%s%08X (%u)", n ? ", " : "", items[n].first << unit_shift, items[n].second);
+    out += item;
+  }
+  return out.empty() ? std::string("none") : out;
+}
+
 }  // namespace xbox360ps5::deferred_watch
