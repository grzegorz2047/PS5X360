+// uploads it again. GPU command thread, without the global critical region held.
+void SharedMemory::CheckDeferredInRange(uint32_t start, uint32_t length) {
+  if (deferred_pending_bits_.empty() || !length) return;
+  const size_t unit_bytes = size_t(1) << page_size_log2_;
+  const uint32_t first = start >> page_size_log2_, last = (start + length - 1) >> page_size_log2_;
+  for (uint32_t unit = first; unit <= last; ++unit) {
+    if (!(deferred_pending_bits_[unit >> 6] >> (unit & 63) & 1)) {
+      // A whole word without waiting units is skipped.
