index 0000000..f45732c
--- /dev/null
+++ b/.deps/xenia-canary/src/xenia/exact_unwatch.h
@@ -0,0 +1,63 @@
+/**
+ ******************************************************************************
+ * Xbox360PS5: fix 37, exact invalidations stay exact on 16 KiB host pages.   *
+ ******************************************************************************
+ * PhysicalHeap::TriggerCallbacks with unwatch_exact_range (Alloc, AllocRange,
+ * Decommit, Release, Protect) still widened the range to whole host pages
+ * before calling the invalidation callbacks, and unprotected and unwatched
+ * those whole pages. On the PS5 a host page is 16 KiB (four guest 4 KiB pages,
+ * and the 0xE0000000 view is offset by 4 KiB), so allocating, freeing or
+ * reprotecting one 4 KiB page cleared the GPU copy of up to three neighbouring
+ * pages (shared_memory.cc dropped their valid and GPU-written bits: a resolve
+ * target next to a new allocation lost the picture the GPU drew there, read back
+ * from guest memory that never had it) and left them unwatched.
+ *
+ * Now the callbacks get the exact physical range, and only host pages lying
+ * wholly inside it are unprotected and unwatched; a page shared with memory
+ * outside the range keeps its protection and watch, so its other pages stay
+ * valid and a write to the range's part of it faults and invalidates as usual.
+ ******************************************************************************
+ */
+
+#ifndef XENIA_EXACT_UNWATCH_H_
+#define XENIA_EXACT_UNWATCH_H_
+
+#include <algorithm>
+#include <cstdint>
+
+namespace xe {
+namespace exact_unwatch {
+
+struct Range {
+  uint32_t physical_start;   // for the invalidation callbacks
+  uint32_t physical_length;
+  bool pages;                // any host page wholly inside
+  uint32_t page_first;       // host pages wholly inside (if `pages`)
+  uint32_t page_last;
+};
+
+// `heap_relative` and `length` as clamped to the heap; host pages of
+// 1 << page_shift bytes start `host_offset` bytes before the heap's address 0;
+// `physical_offset` is the heap base's physical address; `page_count` host
+// pages in the heap.
+inline Range Compute(uint32_t heap_relative, uint32_t length,
+                     uint32_t host_offset, uint32_t page_shift,
+                     uint32_t physical_offset, uint32_t page_count) {
+  Range r;
+  r.physical_start = heap_relative + physical_offset;
+  r.physical_length = length;
+  const uint64_t page = uint64_t(1) << page_shift;
+  const uint64_t host_first = uint64_t(heap_relative) + host_offset;
+  const uint64_t first = (host_first + page - 1) >> page_shift;
+  const uint64_t end = (host_first + length) >> page_shift;  // exclusive
+  r.pages = end > first && first < page_count;
+  r.page_first = uint32_t(first);
+  r.page_last =
+      r.pages ? uint32_t(std::min<uint64_t>(end, page_count) - 1) : 0;
+  return r;
+}
+
+}  // namespace exact_unwatch
+}  // namespace xe
+
+#endif  // XENIA_EXACT_UNWATCH_H_
