@@ -784,8 +784,9 @@ int InstrEmit_ldarx(PPCHIRBuilder& f, const InstrData& i) {
     f.StoreGPR(i.X.RT, f.ByteSwap(f.Load(ea, INT64_TYPE)));
 
   } else {
-    f.MemoryBarrier();
-
+    // Xbox360PS5 (binary release patch group 1): no barrier. x86 does not
+    // reorder loads with older loads, and the matching reserved store is a
+    // locked compare-exchange, a full barrier of its own.
     Value* rt = f.ByteSwap(f.LoadWithReserve(ea, INT64_TYPE));
     f.StoreGPR(i.X.RT, rt);
   }
@@ -815,8 +816,9 @@ int InstrEmit_lwarx(PPCHIRBuilder& f, const InstrData& i) {
                f.ZeroExtend(f.ByteSwap(f.Load(ea, INT32_TYPE)), INT64_TYPE));
 
   } else {
-    f.MemoryBarrier();
-
+    // Xbox360PS5 (binary release patch group 1): no barrier. x86 does not
+    // reorder loads with older loads, and the matching reserved store is a
+    // locked compare-exchange, a full barrier of its own.
     Value* rt =
         f.ZeroExtend(f.ByteSwap(f.LoadWithReserve(ea, INT32_TYPE)), INT64_TYPE);
     f.StoreGPR(i.X.RT, rt);
@@ -857,11 +859,8 @@ int InstrEmit_stdcx(PPCHIRBuilder& f, const InstrData& i) {
   f.StoreContext(offsetof(PPCContext, cr0.cr0_lt), f.LoadZeroInt8());
   f.StoreContext(offsetof(PPCContext, cr0.cr0_gt), f.LoadZeroInt8());
 
