-  if (!cvars::no_reserved_ops) {
-    f.MemoryBarrier();
-  }
+  // Xbox360PS5 (binary release patch group 1): no barrier after the store;
+  // the locked compare-exchange of StoreWithReserve publishes it.
 
   return 0;
 }
