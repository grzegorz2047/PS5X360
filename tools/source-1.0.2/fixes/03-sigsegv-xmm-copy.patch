diff --git a/platform/ps5/exception_handler.cpp b/platform/ps5/exception_handler.cpp
index 3d8fac8..a86cc7a 100644
--- a/platform/ps5/exception_handler.cpp
+++ b/platform/ps5/exception_handler.cpp
@@ -70,7 +70,13 @@ void callback(int number, siginfo_t* info, void* raw_context) {
   const bool have_xmm = mc.mc_fpformat == _MC_FPFMT_XMM;
   auto* xmm = reinterpret_cast<unsigned char*>(mc.mc_fpstate) + 160;
   static_assert(sizeof(mc.mc_fpstate) >= 160 + sizeof(host.xmm_registers));
-  if (have_xmm) std::memcpy(host.xmm_registers, xmm, sizeof(host.xmm_registers));
+  // Binary release patch group 3: access violations (write watches, MMIO, many
+  // thousands a second in some games) skip the 256-byte XMM copy. Their
+  // handlers read and change general registers only; the general registers
+  // above are always copied, because the MMIO handler reads the stored value
+  // from int_registers[value_reg]. Illegal instructions still copy both.
+  const bool xmm_copied = have_xmm && number == SIGILL;
+  if (xmm_copied) std::memcpy(host.xmm_registers, xmm, sizeof(host.xmm_registers));
   Exception fault;
   if (number == SIGILL) fault.InitializeIllegalInstruction(&host);
   else fault.InitializeAccessViolation(&host, uintptr_t(info->si_addr),
@@ -90,7 +96,9 @@ void callback(int number, siginfo_t* info, void* raw_context) {
     void* data = selected->data.load(std::memory_order_acquire);
     if (!handler || selected->order.load(std::memory_order_acquire) != first) continue;
     if (!handler(&fault, data)) continue;
-    if (fault.modified_xmm_registers() && !have_xmm) break;
+    // A handler that changes an XMM register without its state copied in would
+    // write back the rest of it as zeros: let the previous handler see it.
+    if (fault.modified_xmm_registers() && !xmm_copied) break;
     mc.mc_rip = host.rip; mc.mc_rflags = host.eflags;
     for (unsigned n = 0; n < gprs.size(); ++n)
       if (fault.modified_int_registers() & (1u << n)) *gprs[n] = host.int_registers[n];
