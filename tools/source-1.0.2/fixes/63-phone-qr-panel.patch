  private:
+  // Fix 63: the panel's "no phone" view, inside the panel's own box (1550-1900 x 100-640 at
+  // 1080p, scaled for 4K): a title line, the QR code on a white card, the code, how to stand.
+  void DrawPhoneQr(ImDrawList* draw, float scale) {
+    const auto& at = xbox360ps5::motion::kQrPanel;
+    ImFont* font = ImGui::GetFont();
+    draw->AddText(font, at.title_size * scale, ImVec2(at.text_x * scale, at.title_y * scale),
+                  IM_COL32(245, 204, 137, 255), Tr("Motion: no phone connected"));
+    const float module = xbox360ps5::motion::QrModulePixels(phone_qr_.size, at.card, scale);
+    if (module > 0) {
+      const float card = at.card * scale, qx = at.card_x * scale, qy = at.card_y * scale;
+      const float inset = std::floor((card - module * float(phone_qr_.size)) / 2);
+      draw->AddRectFilled(ImVec2(qx, qy), ImVec2(qx + card, qy + card), IM_COL32(255, 255, 255, 255), 6 * scale);
+      for (int my = 0; my < phone_qr_.size; ++my) {
+        for (int mx = 0; mx < phone_qr_.size;) {
+          if (!phone_qr_.At(mx, my)) { ++mx; continue; }
+          int run = 1;
+          while (mx + run < phone_qr_.size && phone_qr_.At(mx + run, my)) ++run;
+          const ImVec2 from(qx + inset + float(mx) * module, qy + inset + float(my) * module);
+          draw->AddRectFilled(from, ImVec2(from.x + float(run) * module, from.y + module), IM_COL32(0, 0, 0, 255));
+          mx += run;
+        }
+      }
+    }
+    const std::string code = std::string(Tr("Code: ")) + phone_key_;
+    draw->AddText(font, at.code_size * scale, ImVec2(at.text_x * scale, at.code_y * scale),
+                  IM_COL32(130, 240, 170, 255), code.c_str());
+    const std::string how = std::string(Tr("Scan with your phone to use it as Kinect.")) + "\n" +
+                            Tr("Same Wi-Fi, stand 2-3 m back, full body visible.");
+    draw->AddText(font, at.text_size * scale, ImVec2(at.text_x * scale, at.text_y * scale),
+                  IM_COL32(230, 230, 230, 255), how.c_str(), nullptr, at.text_width * scale);
+  }
+  std::chrono::steady_clock::time_point phone_checked_{};
+  std::string phone_url_, phone_key_;
+  xbox360ps5::QrCode phone_qr_;
