+/**
+ ******************************************************************************
+ * Xbox360PS5: fix 34, a pipeline the GPU thread needs is created at once.    *
+ ******************************************************************************
+ * The creation workers take requests from a max-heap on priority. A warm start
+ * queues every pipeline of the game's .vk.bin storage (hundreds to thousands,
+ * shadow and depth-only ones at priority 0); a draw that needs one of them before
+ * a worker got to it found no pipeline handle and waited
+ * (VulkanCommandProcessor::IssueDrawInner, AwaitPipelineCompletion(pipeline))
+ * until the workers had worked through everything queued above it: frozen intros
+ * and loading screens of several hundred ms to seconds. The same wait served the
+ * stand-in pipelines a draw must not use (binary release patch group 8).
+ *
+ * Every queued request is also recorded here by pipeline. Whoever takes the
+ * record creates the pipeline: the worker that pops the request, or the GPU
+ * thread that needs it first, which then creates it itself instead of waiting.
+ * A worker that pops a request whose record is gone skips it. All calls are made
+ * with the cache's creation_request_lock_ held.
+ ******************************************************************************
+ */
+
+#ifndef XENIA_GPU_VULKAN_PIPELINE_CLAIM_H_
+#define XENIA_GPU_VULKAN_PIPELINE_CLAIM_H_
+
+#include <cstddef>
+#include <mutex>
+#include <unordered_map>
+
+namespace xe {
+namespace gpu {
+namespace vulkan {
+namespace pipeline_claim {
+
+template <typename Key, typename Args>
+class Queued {
+ public:
+  // A request was pushed to the queue.
+  void Add(Key key, const Args& args) { requests_[key] = args; }
+  // Takes the request of `key` if it is still unclaimed (a copy in `args`).
+  bool Take(Key key, Args* args = nullptr) {
+    auto it = requests_.find(key);
+    if (it == requests_.end()) {
+      return false;
+    }
+    if (args) {
+      *args = it->second;
+    }
+    requests_.erase(it);
+    return true;
+  }
+  size_t size() const { return requests_.size(); }
+
+ private:
+  std::unordered_map<Key, Args> requests_;
+};
+
+// The GPU thread needs a pipeline now (`lock` held on the creation lock). Done:
+// returns. Still queued: takes it, creates it without the lock and wakes the
+// other waiters. Taken by a worker already: waits for it as before. Returns true
+// when it created the pipeline itself.
+template <typename Mutex, typename Cond, typename Ready, typename Take,
+          typename Create>
+bool AwaitOrCreate(std::unique_lock<Mutex>& lock, Cond& cond, Ready&& ready,
+                   Take&& take, Create&& create) {
+  if (ready()) {
+    return false;
+  }
+  if (take()) {
+    lock.unlock();
+    create();
+    lock.lock();
+    cond.notify_all();
+    return true;
+  }
+  cond.wait(lock, ready);
+  return false;
+}
+
+}  // namespace pipeline_claim
+}  // namespace vulkan
+}  // namespace gpu
+}  // namespace xe
+
+#endif  // XENIA_GPU_VULKAN_PIPELINE_CLAIM_H_
