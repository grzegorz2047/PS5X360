+namespace i18n_ui {
+// The language files' folder: the package's (host checks point it at their own files).
+inline std::string& Folder() {
+  static std::string folder = "/app0/assets/lang/";
+  return folder;
+}
+// One language file into a table.
+inline void Read(int id, Table& table) {
+  std::ifstream input(Folder() + UiLanguageCode(id) + ".txt", std::ios::binary);
+  for (std::string line; std::getline(input, line);) {
+    if (!line.empty() && line.back() == '\r') line.pop_back();
+    if (line.empty() || line[0] == '#') continue;
+    const size_t split = line.find(" = ");
+    if (split == std::string::npos) continue;
+    table.text[Unescape(line.substr(0, split))] = Unescape(line.substr(split + 3));
+  }
+}
+}  // namespace i18n_ui
