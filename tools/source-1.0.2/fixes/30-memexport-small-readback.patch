+// Xbox360PS5 (tools/source-1.0.2/fixes/30-memexport-small-readback.patch): which memory
+// exports of a draw the CPU must see, and how they reach guest memory.
+//
+// Battlefield 3 starts its render jobs from the GPU: a vertex shader exports one dword (8888,
+// 0x3F in the affinity byte) into a slot of the job manager's queue, and only then may a
+// worker take the job (research/bf3/ANALYSIS.md, candidate 21). With the readback of memory
+// exports off (the default; it stalls the GPU after each exporting draw), the dword stays in
+// the GPU's copy of guest memory, no worker ever runs the job, and the game deadlocks with its
+// GPU waiting on a command buffer the job would have recorded.
+//
+// So exports of up to `small_limit` bytes per draw are read back even with the option off
+// (large ones are GPU-side buffers such as particles, where the stall costs most and the CPU
+// rarely reads), and only the dwords the draw changed are written to guest memory, each only if
+// the CPU has not changed it meanwhile: the export range is the whole queue, whose other slots
+// the workers change with ldarx/stdcx. while the GPU runs, and copying the GPU's older copy over
+// them would lose jobs.
+//
+// Header-only and free of Xenia headers, so the host check tools/check-memexport-merge.cpp
+// drives it.
+#ifndef XENIA_GPU_MEMEXPORT_MERGE_H_
+#define XENIA_GPU_MEMEXPORT_MERGE_H_
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace xbox360ps5 {
+namespace memexport_merge {
+
+constexpr uint32_t kDefaultSmallBytes = 64 * 1024;
+
+// `setting`: the readback option (cvars::readback_memexport); `total_bytes`: the draw's
+// memexport ranges together; `small_limit`: cvars::readback_memexport_small (0: off).
+inline bool ShouldReadBack(bool setting, uint64_t total_bytes, uint32_t small_limit) {
+  if (!total_bytes) return false;
+  if (setting) return true;
+  return small_limit != 0 && total_bytes <= small_limit;
+}
+
+// A memexport range in physical memory.
+struct Range {
+  uint32_t start, length;
+};
+
+// Before a draw whose exports are read back: guest memory of each range into `before`
+// (concatenated), then each range invalidated exactly in the GPU's copy of guest memory, so
+// the RequestRange that follows uploads all of it from guest memory. Without that the copy can
+// be older than guest memory: the range was marked GPU-written by the previous readback, and
+// CPU writes next to GPU-written data are kept off the copy until a later hash check, so the
+// draw's copy differs from `before` in dwords no shader wrote and Merge wrote them back
+// (Battlefield 3, candidate 25 with the option on: 8 dwords "written" for one export, old
+// dependency links of its job manager restored, a worker calling a cleared callback at
+// 8346D64C). The snapshot comes first: a dword the CPU changes between it and the upload then
+// differs from `before` in the GPU's copy and in guest memory alike, and Merge keeps the CPU's.
+//   shared.MemoryInvalidationCallback(start, length, true)
+//   read_guest(start, destination, length)
+template <typename Shared, typename ReadGuest>
+void PrepareReadback(Shared& shared, ReadGuest read_guest, const std::vector<Range>& ranges,
+                     std::vector<uint8_t>& before) {
+  size_t total = 0;
+  for (const Range& range : ranges) total += range.length;
+  before.resize(total);
+  size_t offset = 0;
+  for (const Range& range : ranges) {
+    read_guest(range.start, before.data() + offset, range.length);
+    offset += range.length;
+  }
+  for (const Range& range : ranges) shared.MemoryInvalidationCallback(range.start, range.length, true);
+}
+
+struct Merged {
+  size_t written = 0;  // dwords (and tail bytes) the draw changed, now in guest memory
+  size_t kept = 0;     // the draw changed them, but so did the CPU since: the CPU's value kept
+};
+
+// Writes to `guest` each dword of `after` (the GPU's copy once the draw is done) that differs
+// from `before` (guest memory just before the draw): what the draw exported. A dword is
+// written only while guest memory still holds its `before` value, by one 32-bit compare and
+// swap where aligned (as a guest stwcx. would), so a slot the CPU changed meanwhile keeps the
+// CPU's value, and a guest ldarx/stdcx. on the same doubleword sees the store or retries.
+// Dwords the draw did not change are never touched. A tail shorter than a dword goes byte by
+// byte.
+inline bool SwapIfUnchanged(uint8_t* guest, uint32_t was, uint32_t now) {
+  if ((reinterpret_cast<uintptr_t>(guest) & 3) == 0) {
+#if defined(__GNUC__) || defined(__clang__)
+    return __atomic_compare_exchange_n(reinterpret_cast<uint32_t*>(guest), &was, now, false,
+                                       __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
+#endif
+  }
+  uint32_t current;
+  std::memcpy(&current, guest, 4);
+  if (current != was) return false;
+  std::memcpy(guest, &now, 4);
+  return true;
+}
+
+// Candidate 31: one dword Merge found changed by the draw, for the log (values as the guest
+// reads them, big-endian; `guest` is guest memory right after the decision).
+struct Change {
+  uint32_t offset = 0;  // from the range's start
+  uint32_t before = 0, after = 0, guest = 0;
+  bool written = false;  // false: the CPU had changed it, its value kept
+};
+inline uint32_t GuestWord(const uint8_t* bytes) {
+  return uint32_t(bytes[0]) << 24 | uint32_t(bytes[1]) << 16 | uint32_t(bytes[2]) << 8 | bytes[3];
+}
+
+// With `changes`, each changed dword is also recorded, up to `limit` of them (the rest only
+// counted).
+inline Merged Merge(uint8_t* guest, const uint8_t* before, const uint8_t* after, size_t size,
+                    std::vector<Change>* changes = nullptr, size_t limit = 0) {
+  Merged merged;
+  size_t at = 0;
+  for (; at + 4 <= size; at += 4) {
+    uint32_t was, now;
+    std::memcpy(&was, before + at, 4);
+    std::memcpy(&now, after + at, 4);
+    if (was == now) continue;
+    const bool written = SwapIfUnchanged(guest + at, was, now);
+    if (written)
+      ++merged.written;
+    else
+      ++merged.kept;
+    if (changes && changes->size() < limit) {
+      Change change;
+      change.offset = uint32_t(at);
+      change.before = GuestWord(before + at);
+      change.after = GuestWord(after + at);
+      change.guest = GuestWord(guest + at);
+      change.written = written;
+      changes->push_back(change);
+    }
+  }
+  for (; at < size; ++at) {
+    if (before[at] == after[at]) continue;
+    if (guest[at] != before[at]) {
+      ++merged.kept;
+      continue;
+    }
+    guest[at] = after[at];
+    ++merged.written;
+  }
+  return merged;
+}
+
+// The log line of a change at physical `start + offset`; `other` is the other dword of its
+// 8-byte doubleword (a job queue slot: the job pointer when the export hit the affinity word).
+inline std::string ChangeLine(uint32_t start, const Change& change, uint32_t other) {
+  char text[200];
+  std::snprintf(text, sizeof(text),
+                "memexport %08X (+%X): %08X -> %08X, guest %08X, %s; other half of the doubleword %08X",
+                start + change.offset, change.offset, change.before, change.after, change.guest,
+                change.written ? "written" : "kept (the CPU changed it)", other);
+  return text;
+}
+
+// The title enables the per-dword lines (Battlefield 3); only ranges with few changes are
+// logged, up to a total.
+constexpr size_t kChangesPerRange = 64;
+constexpr uint32_t kChangeLinesTotal = 800;
+inline std::atomic<bool>& DetailEnabled() {
+  static std::atomic<bool> enabled{false};
+  return enabled;
+}
+inline std::atomic<uint32_t>& DetailLines() {
+  static std::atomic<uint32_t> lines{0};
+  return lines;
+}
+
+}  // namespace memexport_merge
+}  // namespace xbox360ps5
+
+#endif  // XENIA_GPU_MEMEXPORT_MERGE_H_
