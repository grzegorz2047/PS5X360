+// Xbox360PS5 (tools/source-1.0.2/fixes/30-memexport-small-readback.patch): which memory
+// exports of a draw the CPU must see, and how they reach guest memory.
+//
+// Battlefield 3 starts its render jobs from the GPU: a vertex shader exports one dword (8888,
+// 0x3F in the affinity byte) into a slot of the job manager's queue, and only then may a
+// worker take the job (research/bf3/ANALYSIS.md, candidate 21). With the readback of memory
+// exports off (the default; it stalls the GPU after each exporting draw), the dword stays in
+// the GPU's copy of guest memory, no worker ever runs the job, and the game deadlocks with its
+// GPU waiting on a command buffer the job would have recorded.
+//
+// So exports of up to `small_limit` bytes per draw are read back even with the option off
+// (large ones are GPU-side buffers such as particles, where the stall costs most and the CPU
+// rarely reads), and only the dwords the draw changed are written to guest memory, each only if
+// the CPU has not changed it meanwhile: the export range is the whole queue, whose other slots
+// the workers change with ldarx/stdcx. while the GPU runs, and copying the GPU's older copy over
+// them would lose jobs.
+//
+// Header-only and free of Xenia headers, so the host check tools/check-memexport-merge.cpp
+// drives it.
+#ifndef XENIA_GPU_MEMEXPORT_MERGE_H_
+#define XENIA_GPU_MEMEXPORT_MERGE_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace xbox360ps5 {
+namespace memexport_merge {
+
+constexpr uint32_t kDefaultSmallBytes = 64 * 1024;
+
+// `setting`: the readback option (cvars::readback_memexport); `total_bytes`: the draw's
+// memexport ranges together; `small_limit`: cvars::readback_memexport_small (0: off).
+inline bool ShouldReadBack(bool setting, uint64_t total_bytes, uint32_t small_limit) {
+  if (!total_bytes) return false;
+  if (setting) return true;
+  return small_limit != 0 && total_bytes <= small_limit;
+}
+
+struct Merged {
+  size_t written = 0;  // dwords (and tail bytes) the draw changed, now in guest memory
+  size_t kept = 0;     // the draw changed them, but so did the CPU since: the CPU's value kept
+};
+
+// Writes to `guest` each dword of `after` (the GPU's copy once the draw is done) that differs
+// from `before` (guest memory just before the draw): what the draw exported. A dword is
+// written only while guest memory still holds its `before` value, by one 32-bit compare and
+// swap where aligned (as a guest stwcx. would), so a slot the CPU changed meanwhile keeps the
+// CPU's value, and a guest ldarx/stdcx. on the same doubleword sees the store or retries.
+// Dwords the draw did not change are never touched. A tail shorter than a dword goes byte by
+// byte.
+inline bool SwapIfUnchanged(uint8_t* guest, uint32_t was, uint32_t now) {
+  if ((reinterpret_cast<uintptr_t>(guest) & 3) == 0) {
+#if defined(__GNUC__) || defined(__clang__)
+    return __atomic_compare_exchange_n(reinterpret_cast<uint32_t*>(guest), &was, now, false,
+                                       __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
+#endif
+  }
+  uint32_t current;
+  std::memcpy(&current, guest, 4);
+  if (current != was) return false;
+  std::memcpy(guest, &now, 4);
+  return true;
+}
+
+inline Merged Merge(uint8_t* guest, const uint8_t* before, const uint8_t* after, size_t size) {
+  Merged merged;
+  size_t at = 0;
+  for (; at + 4 <= size; at += 4) {
+    uint32_t was, now;
+    std::memcpy(&was, before + at, 4);
+    std::memcpy(&now, after + at, 4);
+    if (was == now) continue;
+    if (SwapIfUnchanged(guest + at, was, now))
+      ++merged.written;
+    else
+      ++merged.kept;
+  }
+  for (; at < size; ++at) {
+    if (before[at] == after[at]) continue;
+    if (guest[at] != before[at]) {
+      ++merged.kept;
+      continue;
+    }
+    guest[at] = after[at];
+    ++merged.written;
+  }
+  return merged;
+}
+
+}  // namespace memexport_merge
+}  // namespace xbox360ps5
+
+#endif  // XENIA_GPU_MEMEXPORT_MERGE_H_
