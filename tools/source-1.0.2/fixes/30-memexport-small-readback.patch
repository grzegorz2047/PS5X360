+// Xbox360PS5 (tools/source-1.0.2/fixes/30-memexport-small-readback.patch): which memory
+// exports of a draw the CPU must see, and how they reach guest memory.
+//
+// Battlefield 3 starts its render jobs from the GPU: a vertex shader exports one dword (8888,
+// 0x3F in the affinity byte) into a slot of the job manager's queue, and only then may a
+// worker take the job (research/bf3/ANALYSIS.md, candidate 21). With the readback of memory
+// exports off (the default; it stalls the GPU after each exporting draw), the dword stays in
+// the GPU's copy of guest memory, no worker ever runs the job, and the game deadlocks with its
+// GPU waiting on a command buffer the job would have recorded.
+//
+// So exports of up to `small_limit` bytes per draw are read back even with the option off
+// (large ones are GPU-side buffers such as particles, where the stall costs most and the CPU
+// rarely reads), and only what the shader wrote reaches guest memory. The export range is the
+// whole job arena (384 KiB), which the workers change all the time; what the shader wrote is
+// found by comparing the GPU's own copy of the ranges just before the draw with the copy just
+// after it (both read back), not with guest memory: guest memory differs from the GPU's copy
+// in whatever the CPU wrote meanwhile, and a CPU write undone before the readback (a link's
+// next pointer set and cleared again) looked like an export and was written back (candidate 31:
+// a detached link restored, run twice, the crash at 8346D64C). Each dword the shader wrote is
+// stored into guest memory as the GPU stores it, one 32-bit store; every other dword is left to
+// the CPU.
+//
+// Header-only and free of Xenia headers, so the host check tools/check-memexport-merge.cpp
+// drives it.
+#ifndef XENIA_GPU_MEMEXPORT_MERGE_H_
+#define XENIA_GPU_MEMEXPORT_MERGE_H_
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace xbox360ps5 {
+namespace memexport_merge {
+
+constexpr uint32_t kDefaultSmallBytes = 64 * 1024;
+
+// `setting`: the readback option (cvars::readback_memexport); `total_bytes`: the draw's
+// memexport ranges together; `small_limit`: cvars::readback_memexport_small (0: off).
+inline bool ShouldReadBack(bool setting, uint64_t total_bytes, uint32_t small_limit) {
+  if (!total_bytes) return false;
+  if (setting) return true;
+  return small_limit != 0 && total_bytes <= small_limit;
+}
+
+// A memexport range in physical memory.
+struct Range {
+  uint32_t start, length;
+};
+
+// Before a draw whose exports are read back: each range invalidated exactly in the GPU's copy
+// of guest memory, so the RequestRange that follows uploads it from guest memory and the shader
+// reads current data (the previous readback marked the range GPU-written, and CPU writes next to
+// GPU-written data are otherwise kept off the copy until a later hash check).
+//   shared.MemoryInvalidationCallback(start, length, true)
+template <typename Shared>
+void RefreshRanges(Shared& shared, const std::vector<Range>& ranges) {
+  for (const Range& range : ranges) shared.MemoryInvalidationCallback(range.start, range.length, true);
+}
+
+// Where the copy from before the draw goes in the readback buffer: after the copy from after
+// it (which starts at 0), aligned.
+inline uint32_t BeforeOffset(uint64_t total_bytes) {
+  return uint32_t((total_bytes + 255) & ~uint64_t(255));
+}
+
+struct Merged {
+  size_t written = 0;   // dwords (and tail bytes) the shader wrote, now in guest memory
+  size_t differed = 0;  // of those, guest memory held another value than the GPU's copy before
+};
+
+// One dword the shader wrote, for the log (values as the guest reads them, big-endian).
+struct Change {
+  uint32_t offset = 0;  // from the range's start
+  uint32_t before = 0, after = 0;  // the GPU's copy before and after the draw
+  uint32_t guest = 0;              // guest memory just before the store
+};
+inline uint32_t GuestWord(const uint8_t* bytes) {
+  return uint32_t(bytes[0]) << 24 | uint32_t(bytes[1]) << 16 | uint32_t(bytes[2]) << 8 | bytes[3];
+}
+
+// One 32-bit store, as the GPU's (atomic where aligned, so a guest ldarx/stdcx. on the same
+// doubleword sees it or retries).
+inline void StoreWord(uint8_t* guest, uint32_t value) {
+  if ((reinterpret_cast<uintptr_t>(guest) & 3) == 0) {
+#if defined(__GNUC__) || defined(__clang__)
+    __atomic_store_n(reinterpret_cast<uint32_t*>(guest), value, __ATOMIC_SEQ_CST);
+    return;
+#endif
+  }
+  std::memcpy(guest, &value, 4);
+}
+
+// Stores into `guest` each dword in which `after` (the GPU's copy once the draw is done)
+// differs from `before` (the GPU's copy just before it): what the shader wrote. Every other
+// dword of guest memory is left as the CPU has it. A tail shorter than a dword goes byte by
+// byte. With `changes`, the first `limit` stores are also recorded.
+inline Merged ApplyExports(uint8_t* guest, const uint8_t* before, const uint8_t* after, size_t size,
+                           std::vector<Change>* changes = nullptr, size_t limit = 0) {
+  Merged merged;
+  size_t at = 0;
+  for (; at + 4 <= size; at += 4) {
+    uint32_t was, now;
+    std::memcpy(&was, before + at, 4);
+    std::memcpy(&now, after + at, 4);
+    if (was == now) continue;
+    const uint32_t guest_word = GuestWord(guest + at);
+    uint32_t guest_raw;
+    std::memcpy(&guest_raw, guest + at, 4);
+    if (guest_raw != was) ++merged.differed;
+    StoreWord(guest + at, now);
+    ++merged.written;
+    if (changes && changes->size() < limit) {
+      Change change;
+      change.offset = uint32_t(at);
+      change.before = GuestWord(before + at);
+      change.after = GuestWord(after + at);
+      change.guest = guest_word;
+      changes->push_back(change);
+    }
+  }
+  for (; at < size; ++at) {
+    if (before[at] == after[at]) continue;
+    if (guest[at] != before[at]) ++merged.differed;
+    guest[at] = after[at];
+    ++merged.written;
+  }
+  return merged;
+}
+
+// The log line of a store at physical `start + offset`; `other` is the other dword of its
+// 8-byte doubleword (a job queue slot: the job pointer when the export hit the affinity word).
+inline std::string ChangeLine(uint32_t start, const Change& change, uint32_t other) {
+  char text[200];
+  std::snprintf(text, sizeof(text),
+                "memexport %08X (+%X): %08X -> %08X, guest was %08X; other half of the doubleword %08X",
+                start + change.offset, change.offset, change.before, change.after, change.guest, other);
+  return text;
+}
+
+// The title enables the per-dword lines and the exporting shader's dump (Battlefield 3); only
+// ranges with few stores are logged, up to a total.
+constexpr size_t kChangesPerRange = 64;
+constexpr uint32_t kChangeLinesTotal = 800;
+constexpr uint32_t kShaderDumps = 3;        // distinct exporting vertex shaders
+constexpr uint32_t kShaderDumpRangeBytes = 512 * 1024;  // only draws exporting at most this
+inline std::atomic<bool>& DetailEnabled() {
+  static std::atomic<bool> enabled{false};
+  return enabled;
+}
+inline std::atomic<uint32_t>& DetailLines() {
+  static std::atomic<uint32_t> lines{0};
+  return lines;
+}
+
+// The dump of an exporting draw: its first time per vertex shader (by ucode hash), the first
+// kShaderDumps shaders. Called on the GPU thread only.
+inline bool FirstDumpOf(uint64_t ucode_hash) {
+  static uint64_t seen[kShaderDumps];
+  static uint32_t count = 0;
+  for (uint32_t n = 0; n < count; ++n)
+    if (seen[n] == ucode_hash) return false;
+  if (count >= kShaderDumps) return false;
+  seen[count++] = ucode_hash;
+  return true;
+}
+
+}  // namespace memexport_merge
+}  // namespace xbox360ps5
+
+#endif  // XENIA_GPU_MEMEXPORT_MERGE_H_
