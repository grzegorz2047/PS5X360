diff --git a/include/xbox360ps5/launcher.hpp b/include/xbox360ps5/launcher.hpp
--- a/include/xbox360ps5/launcher.hpp
+++ b/include/xbox360ps5/launcher.hpp
@@ -28,6 +28,7 @@ struct GameEntry {
   std::string size;
   uint64_t hash = 0;           // Executable hash, known after the first launch.
   int cover = -1;              // Index into the launcher's textures.
+  unsigned disc = 0;           // Fix 52: the disc number in the image's name, 0 for none.
 };
 // Options kept in /download0/xbox360ps5/settings.txt. Every choice is a small
