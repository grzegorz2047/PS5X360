+#if XE_PLATFORM_PS5
+// Fix 49: the timestamps of the completed submissions, oldest first (the busy
+// time is the union of their intervals).
+void VulkanCommandProcessor::FrameCostReadCompleted() {
+  if (frame_cost_query_pool_ == VK_NULL_HANDLE) {
+    return;
+  }
+  const uint64_t completed = GetCompletedSubmission();
+  uint32_t ready[kFrameCostSlots];
+  uint32_t ready_count = 0;
+  for (uint32_t slot = 0; slot < kFrameCostSlots; ++slot) {
+    const uint64_t submission = frame_cost_slot_submission_[slot];
+    if (!submission || submission > completed) {
+      continue;
+    }
+    uint32_t at = ready_count++;
+    while (at && frame_cost_slot_submission_[ready[at - 1]] > submission) {
+      ready[at] = ready[at - 1];
+      --at;
+    }
+    ready[at] = slot;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  for (uint32_t i = 0; i < ready_count; ++i) {
+    const uint32_t slot = ready[i];
+    uint64_t ticks[2] = {};
+    if (dfn.vkGetQueryPoolResults(vulkan_device->device(),
+                                  frame_cost_query_pool_, 2 * slot, 2,
+                                  sizeof(ticks), ticks, sizeof(uint64_t),
+                                  VK_QUERY_RESULT_64_BIT) == VK_SUCCESS) {
+      frame_cost_gpu_busy_.Add(ticks[0], ticks[1]);
+    }
+    frame_cost_slot_submission_[slot] = 0;
+  }
+}
+#endif
