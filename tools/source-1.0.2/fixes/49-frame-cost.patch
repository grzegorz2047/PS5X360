--- /dev/null
+++ b/include/xbox360ps5/frame_cost.hpp
@@ -0,0 +1,213 @@
+// SPDX-License-Identifier: MIT
+// Fix 49 of the source rebuild (tools/source-1.0.2/fixes/49-frame-cost.patch): where a frame's
+// time goes, for Call of Duty (MW2, Black Ops: about 20 FPS) and Battlefield 3 (25-30 FPS),
+// which -O3, ThinLTO and the JIT backports did not speed up. Every 30 s the summary gets one
+// "Frame time:" line, made from counters that are always on (a clock read around waits and
+// around each pass over the ring, two GPU timestamps per submission):
+//   - GPU busy: the union of each GPU-thread submission's start and end timestamps, ms per s;
+//   - the GPU command thread: executing the ring (its waits taken out), idle until the guest
+//     writes more, waiting for the GPU by cause (frames in flight, memory export readback,
+//     resolve readback, queries, other) and waiting for pipelines to compile;
+//   - other threads' waits for the GPU (the UI thread's presenter);
+// and a reading: GPU-bound, waiting for readbacks or queries (synchronisation), the guest's own
+// CPU time (game code, JIT, the kernel), or the command thread's own work.
+// No Xenia headers: tools/check-frame-cost.cpp drives it.
+#pragma once
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+namespace xbox360ps5 {
+namespace frame_cost {
+
+enum Cause : uint32_t { kOther = 0, kThrottle, kMemexport, kResolve, kQuery, kPipeline, kCauses };
+inline const char* CauseName(uint32_t cause) {
+  static const char* const names[] = {"other", "frames in flight", "memexport readback", "resolve readback",
+                                      "queries", "pipelines"};
+  return cause < kCauses ? names[cause] : "?";
+}
+
+inline uint64_t NowNs() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count());
+}
+
+struct Totals {
+  std::array<std::atomic<uint64_t>, kCauses> wait_ns{}, waits{};
+  std::atomic<uint64_t> execute_ns{0}, idle_ns{0};       // GPU command thread
+  std::atomic<uint64_t> other_wait_ns{0}, other_waits{0};  // other threads' fence waits
+  std::atomic<uint64_t> gpu_busy_ns{0}, gpu_samples{0}, submissions{0};
+};
+inline Totals totals;
+// Whether the GPU's busy time is measured (timestamps on the GPU thread's queue).
+inline std::atomic<bool> timestamps{false};
+
+// The GPU command thread, and the reason its next GPU wait has (set by CauseScope).
+inline thread_local bool gpu_thread = false;
+inline thread_local uint32_t cause = kOther;
+inline void MarkGpuThread() { gpu_thread = true; }
+class CauseScope {
+ public:
+  explicit CauseScope(uint32_t now) : previous_(cause) { cause = now; }
+  ~CauseScope() { cause = previous_; }
+  CauseScope(const CauseScope&) = delete;
+  CauseScope& operator=(const CauseScope&) = delete;
+
+ private:
+  uint32_t previous_;
+};
+
+// A fence wait that took `ns`: the GPU thread's by its cause, other threads' apart.
+inline void AddFenceWait(uint64_t ns) {
+  if (gpu_thread) {
+    totals.wait_ns[cause].fetch_add(ns, std::memory_order_relaxed);
+    totals.waits[cause].fetch_add(1, std::memory_order_relaxed);
+  } else {
+    totals.other_wait_ns.fetch_add(ns, std::memory_order_relaxed);
+    totals.other_waits.fetch_add(1, std::memory_order_relaxed);
+  }
+}
+// A wait of the GPU thread that is not a fence (pipeline compilation).
+inline void AddWait(uint32_t of, uint64_t ns) {
+  totals.wait_ns[of].fetch_add(ns, std::memory_order_relaxed);
+  totals.waits[of].fetch_add(1, std::memory_order_relaxed);
+}
+
+// A wait of the GPU thread for the time this object lives (pipeline compilation).
+class WaitTimer {
+ public:
+  explicit WaitTimer(uint32_t of) : of_(of), start_(gpu_thread ? NowNs() : 0) {}
+  ~WaitTimer() {
+    if (start_) AddWait(of_, NowNs() - start_);
+  }
+  WaitTimer(const WaitTimer&) = delete;
+  WaitTimer& operator=(const WaitTimer&) = delete;
+
+ private:
+  uint32_t of_;
+  uint64_t start_;
+};
+
+// GPU busy time from submissions' start and end timestamps, in completion order: the union of
+// the intervals (a submission that starts before the previous one ended counts from its end).
+class GpuBusy {
+ public:
+  void SetPeriod(double ns_per_tick, uint32_t valid_bits) {
+    period_ = ns_per_tick;
+    mask_ = valid_bits >= 64 ? UINT64_MAX : ((uint64_t(1) << valid_bits) - 1);
+  }
+  // Ticks as read from the query pool. Returns the nanoseconds added.
+  uint64_t Add(uint64_t start, uint64_t end) {
+    start &= mask_;
+    end &= mask_;
+    totals.submissions.fetch_add(1, std::memory_order_relaxed);
+    if (end < start) return 0;  // wrapped: skip one sample
+    if (last_end_ && start < last_end_) start = std::min(last_end_, end);
+    if (end > last_end_) last_end_ = end;
+    const uint64_t ns = uint64_t(double(end - start) * period_);
+    totals.gpu_busy_ns.fetch_add(ns, std::memory_order_relaxed);
+    totals.gpu_samples.fetch_add(1, std::memory_order_relaxed);
+    return ns;
+  }
+
+ private:
+  double period_ = 1.0;
+  uint64_t mask_ = UINT64_MAX, last_end_ = 0;
+};
+
+// The summary's line for the time since the last call.
+class Reporter {
+ public:
+  std::string Line(double seconds, bool timestamps) {
+    Snapshot now = Take();
+    const Snapshot d = now.Minus(last_);
+    last_ = now;
+    const double s = seconds > 0 ? seconds : 1;
+    const auto ms = [s](uint64_t ns) { return double(ns) / 1e6 / s; };
+    uint64_t gpu_wait_ns = 0;
+    for (uint32_t c = 0; c < kCauses; ++c)
+      if (c != kPipeline) gpu_wait_ns += d.wait_ns[c];
+    const uint64_t waits_in_execute = gpu_wait_ns + d.wait_ns[kPipeline];
+    const uint64_t own = d.execute_ns > waits_in_execute ? d.execute_ns - waits_in_execute : 0;
+    std::string causes;
+    for (uint32_t c = 0; c < kCauses; ++c) {
+      if (c == kPipeline || !d.waits[c]) continue;
+      char item[96];
+      std::snprintf(item, sizeof(item), "%s%s %.0f in %.0f/s", causes.empty() ? "" : ", ", CauseName(c),
+                    ms(d.wait_ns[c]), double(d.waits[c]) / s);
+      causes += item;
+    }
+    char gpu[96];
+    if (timestamps && d.gpu_samples)
+      std::snprintf(gpu, sizeof(gpu), "GPU busy %.0f ms/s over %.0f submissions/s", ms(d.gpu_busy_ns),
+                    double(d.submissions) / s);
+    else
+      std::snprintf(gpu, sizeof(gpu), "GPU busy not measured (no timestamps)");
+    char text[700];
+    std::snprintf(text, sizeof(text),
+                  "Frame time: %s; GPU thread executing %.0f ms/s (waits taken out), idle for the guest %.0f ms/s, "
+                  "waiting for the GPU %.0f ms/s (%s), for pipelines %.0f ms/s in %.0f/s; other threads waiting for the GPU "
+                  "%.0f ms/s; %s",
+                  gpu, ms(own), ms(d.idle_ns), ms(gpu_wait_ns), causes.empty() ? "no waits" : causes.c_str(),
+                  ms(d.wait_ns[kPipeline]), double(d.waits[kPipeline]) / s, ms(d.other_wait_ns),
+                  Reading(timestamps && d.gpu_samples ? ms(d.gpu_busy_ns) : -1, ms(own), ms(d.idle_ns),
+                          ms(d.wait_ns[kMemexport] + d.wait_ns[kResolve] + d.wait_ns[kQuery]),
+                          ms(d.wait_ns[kThrottle]), ms(d.wait_ns[kPipeline])));
+    return text;
+  }
+
+  // What limits the frame rate, from ms per second of each.
+  static const char* Reading(double gpu_busy, double own, double idle, double sync, double throttle,
+                             double pipelines) {
+    if (gpu_busy >= 850) return "reading: GPU-bound (the GPU is busy nearly all the time)";
+    if (sync >= 250) return "reading: synchronisation (the GPU thread waits for readbacks or queries, the GPU idles meanwhile)";
+    if (pipelines >= 250) return "reading: shader compilation (the GPU thread waits for pipelines)";
+    if (own >= 600) return "reading: the GPU command thread's own work (draw recording, uploads, memory watches)";
+    if (idle >= 500) return "reading: the guest's CPU time (game code, JIT, kernel calls): the GPU thread waits for commands";
+    if (throttle >= 400) return "reading: GPU-bound (the GPU thread waits for frames in flight)";
+    return "reading: no single limit";
+  }
+
+ private:
+  struct Snapshot {
+    std::array<uint64_t, kCauses> wait_ns{}, waits{};
+    uint64_t execute_ns = 0, idle_ns = 0, other_wait_ns = 0, gpu_busy_ns = 0, gpu_samples = 0, submissions = 0;
+    Snapshot Minus(const Snapshot& o) const {
+      Snapshot d;
+      for (uint32_t c = 0; c < kCauses; ++c) {
+        d.wait_ns[c] = wait_ns[c] - o.wait_ns[c];
+        d.waits[c] = waits[c] - o.waits[c];
+      }
+      d.execute_ns = execute_ns - o.execute_ns;
+      d.idle_ns = idle_ns - o.idle_ns;
+      d.other_wait_ns = other_wait_ns - o.other_wait_ns;
+      d.gpu_busy_ns = gpu_busy_ns - o.gpu_busy_ns;
+      d.gpu_samples = gpu_samples - o.gpu_samples;
+      d.submissions = submissions - o.submissions;
+      return d;
+    }
+  };
+  static Snapshot Take() {
+    Snapshot s;
+    for (uint32_t c = 0; c < kCauses; ++c) {
+      s.wait_ns[c] = totals.wait_ns[c].load(std::memory_order_relaxed);
+      s.waits[c] = totals.waits[c].load(std::memory_order_relaxed);
+    }
+    s.execute_ns = totals.execute_ns.load(std::memory_order_relaxed);
+    s.idle_ns = totals.idle_ns.load(std::memory_order_relaxed);
+    s.other_wait_ns = totals.other_wait_ns.load(std::memory_order_relaxed);
+    s.gpu_busy_ns = totals.gpu_busy_ns.load(std::memory_order_relaxed);
+    s.gpu_samples = totals.gpu_samples.load(std::memory_order_relaxed);
+    s.submissions = totals.submissions.load(std::memory_order_relaxed);
+    return s;
+  }
+  Snapshot last_{};  // the first line covers the time since the game started
+};
+
+}  // namespace frame_cost
+}  // namespace xbox360ps5
