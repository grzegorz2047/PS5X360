--- /dev/null
+++ b/include/xbox360ps5/web_key.hpp
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: MIT
+// Fix 46 (tools/source-1.0.2/fixes/46-ps5x360reloaded-identity.patch): which key the web
+// settings server (platform/ps5/web_settings.cpp) lets in.
+//
+// The page and its API need the title's own key (web-settings.key in its folder, shown on the
+// television), as before; an empty key while the server starts lets an empty key in, as before.
+// The official PS5X360's Kinect tracker (kinect-tracker.elf, started by the Kinect helper) talks
+// to this server with the key it reads from the official app's folder
+// (app_identity::kOfficialDataRoot + "/web-settings.key", its motion_sender.h), which is not
+// PS5X360Reloaded's key now that the two have folders of their own. It makes two requests: GET
+// /api/motion/status (is camera motion on for the running game?) and, only when that answers 200
+// with "enabled":true, POST /api/motion/frame. That key is accepted too, for those two requests
+// only and only from this console itself (127.0.0.0/8), and only when the official folder holds
+// one (the official app, or an earlier build, ran once). The file is read, never written.
+// Header only, checked on the host by tools/check-app-identity.cpp.
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <string>
+
+namespace xbox360ps5::web_key {
+// A key as web-settings.key holds it: six lower-case hexadecimal digits.
+inline bool Valid(const std::string& key) {
+  return key.size() == 6 && std::all_of(key.begin(), key.end(), [](unsigned char c) {
+           return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+         });
+}
+// The key of a web-settings.key file, or empty (no file, or not a key). Only reads the file.
+inline std::string Read(const std::filesystem::path& file) {
+  std::ifstream saved(file);
+  std::string line;
+  if (!saved || !std::getline(saved, line)) return {};
+  if (!line.empty() && line.back() == '\r') line.pop_back();
+  return Valid(line) ? line : std::string();
+}
+// An IPv4 address (host byte order) of this console itself.
+inline bool Loopback(uint32_t address) { return (address >> 24) == 127u; }
+// Whether a request may go on. given: the request's key (X-Key, else ?k=); own: the title's key;
+// official: the official app's key (empty when it has none).
+inline bool Accept(const std::string& given, const std::string& own, const std::string& official,
+                   const std::string& method, const std::string& target, bool loopback) {
+  if (given == own) return true;
+  if (!loopback || !Valid(official) || given != official) return false;
+  return (method == "GET" && target == "/api/motion/status") ||
+         (method == "POST" && target == "/api/motion/frame");
+}
+}  // namespace xbox360ps5::web_key
