diff --git a/include/xbox360ps5/official_import.hpp b/include/xbox360ps5/official_import.hpp
new file mode 100644
index 0000000..3787576
--- /dev/null
+++ b/include/xbox360ps5/official_import.hpp
@@ -0,0 +1,400 @@
+// SPDX-License-Identifier: MIT
+// Fix 46 (tools/source-1.0.2/fixes/46-ps5x360reloaded-identity.patch): the first start of
+// PS5X360Reloaded copies the official PS5X360's saves and small settings files from its folder
+// (app_identity::kOfficialDataRoot) into its own (kDataRoot), once.
+//
+//   * saves/ (profiles, achievements, game saves, installed DLC and title updates): copied into
+//     <target>/.saves-import, then renamed to <target>/saves, only when the title has no saves
+//     folder of its own (never merged into saves it has); a start interrupted while copying
+//     leaves the staging folder, which the next start removes and copies again;
+//   * kFiles and the files of kFolders: each copied only when the title has no file of that name
+//     (never overwritten);
+//   * only when the folder holding <target> has room for all of it plus kMargin; otherwise
+//     nothing is copied;
+//   * each entry that cannot be read, a link, or anything else than a file or folder is left out
+//     and counted (the log names the first ones); copies are copies, never links, since saves
+//     are rewritten in place.
+// The marker <target>/.official-import records the outcome, so this runs once: after an import,
+// when the official folder is absent, and when the room is short (the start then makes empty
+// saves, and the notice says so; the files can still be copied by FTP).
+// Nothing is ever written, created, renamed or removed in the official folder: it is only
+// opened for reading and listed, and every path written to is checked to be inside <target>
+// and outside <source> first. Not copied: cache/ (shaders and modules, made again), logs/ (with
+// web-settings.key and phone-camera/: this title makes its own key and its own camera
+// certificate) and the official app's own files.
+// Header only and free of the rest of the title, so that tools/check-official-import.cpp
+// drives the same code on a temporary folder.
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <functional>
+#include <string>
+#include <system_error>
+#include <vector>
+
+namespace xbox360ps5::official_import {
+namespace fs = std::filesystem;
+
+inline constexpr char kMarker[] = ".official-import";
+inline constexpr char kStaging[] = ".saves-import";
+inline constexpr char kSaves[] = "saves";
+// Settings files of the folder's top (network.conf: the network mode and server; the others are
+// switches the home or a test reads).
+inline constexpr const char* kFiles[] = {"network.conf", "vibration.conf", "framegen.conf",
+                                         "ui-dark.on",   "ui-classic.on",  "dashboard.off"};
+// Small folders: the user's home pictures, downloaded game art, the original dashboard the user
+// copied (dash.xex), the achievement icons the notifications show.
+inline constexpr const char* kFolders[] = {"skin", "game-art", "dashboard", "cache/achievements"};
+// Room kept free beyond what is copied.
+inline constexpr uint64_t kMargin = 64ull << 20;
+// At most this many folder levels are walked (saves are a few levels deep).
+inline constexpr int kMaxDepth = 32;
+// Lines naming left-out entries, at most.
+inline constexpr size_t kMaxNamed = 32;
+
+// What the decision needs to know, gathered by Gather (or made up by the check).
+struct Facts {
+  bool marker = false;        // <target>/.official-import exists: decided at an earlier start
+  bool unsafe = false;        // the two folders are one, or inside each other, or <target> is a link
+  bool source = false;        // the official folder is a folder (not a link)
+  bool source_saves = false;  // <source>/saves is a folder (not a link)
+  bool target_saves = false;  // <target>/saves exists, whatever it is
+  uint64_t saves_bytes = 0;   // the files of <source>/saves
+  uint64_t small_bytes = 0;   // kFiles and kFolders' files the title does not have yet
+  bool space_known = false;
+  uint64_t free = 0;          // room where <target> is
+};
+
+enum class Decision {
+  kAlreadyDone,      // the marker: nothing at all
+  kUnsafe,           // nothing at all, no marker
+  kNothingToImport,  // no official folder: the marker only
+  kNoSpace,          // not enough room (or not known): the marker only
+  kImport,           // copy (saves when copy_saves), then the marker
+};
+
+struct Plan {
+  Decision decision = Decision::kAlreadyDone;
+  bool copy_saves = false;
+  bool copy_small = false;
+  bool write_marker = false;
+  uint64_t needed = 0;  // bytes copied plus kMargin (kImport and kNoSpace)
+};
+
+// The decision, from the facts alone.
+inline Plan Decide(const Facts& facts) {
+  Plan plan;
+  if (facts.marker) return plan;
+  if (facts.unsafe) {
+    plan.decision = Decision::kUnsafe;
+    return plan;
+  }
+  plan.write_marker = true;
+  if (!facts.source) {
+    plan.decision = Decision::kNothingToImport;
+    return plan;
+  }
+  const bool saves = facts.source_saves && !facts.target_saves;
+  plan.needed = (saves ? facts.saves_bytes : 0) + facts.small_bytes + kMargin;
+  if (!facts.space_known || facts.free < plan.needed) {
+    plan.decision = Decision::kNoSpace;
+    return plan;
+  }
+  plan.decision = Decision::kImport;
+  plan.copy_saves = saves;
+  plan.copy_small = true;
+  return plan;
+}
+
+inline const char* DecisionName(Decision decision) {
+  switch (decision) {
+    case Decision::kAlreadyDone: return "already done";
+    case Decision::kUnsafe: return "refused (the folders overlap or the title's folder is a link)";
+    case Decision::kNothingToImport: return "nothing to import (no official folder)";
+    case Decision::kNoSpace: return "not enough free space";
+    case Decision::kImport: return "imported";
+  }
+  return "?";
+}
+
+struct Result {
+  Plan plan;
+  bool saves_copied = false;
+  uint64_t files = 0;    // files copied
+  uint64_t bytes = 0;    // their bytes
+  uint64_t kept = 0;     // small files the title already had (left as they are)
+  uint64_t skipped = 0;  // entries left out: unreadable, links, other types, failed copies
+  uint64_t free = 0;
+  bool marker_written = false;
+  std::string error;               // why the saves were not put in place, when they were not
+  std::vector<std::string> lines;  // what was left out (kMaxNamed at most), for the log
+};
+
+// The room in the folder holding `path` (test hook: the check gives its own).
+using FreeSpace = std::function<bool(const fs::path& path, uint64_t* free)>;
+inline bool RealFreeSpace(const fs::path& path, uint64_t* free) {
+  std::error_code error;
+  const auto info = fs::space(path, error);
+  if (error) return false;
+  *free = info.available;
+  return true;
+}
+
+namespace detail {
+inline bool IsFolder(const fs::path& path) {
+  std::error_code error;
+  return fs::symlink_status(path, error).type() == fs::file_type::directory;
+}
+inline bool IsFile(const fs::path& path) {
+  std::error_code error;
+  return fs::symlink_status(path, error).type() == fs::file_type::regular;
+}
+inline bool Exists(const fs::path& path) {
+  std::error_code error;
+  const auto type = fs::symlink_status(path, error).type();
+  return type != fs::file_type::not_found && type != fs::file_type::none;
+}
+// Whether `inner` is `outer` or inside it, by path components (both made absolute and normal).
+inline bool Within(const fs::path& inner, const fs::path& outer) {
+  std::vector<fs::path> a, b;
+  for (const auto& part : inner)
+    if (!part.empty()) a.push_back(part);  // empty: a trailing separator
+  for (const auto& part : outer)
+    if (!part.empty()) b.push_back(part);
+  return !b.empty() && b.size() <= a.size() && std::equal(b.begin(), b.end(), a.begin());
+}
+inline fs::path Normal(const fs::path& path) {
+  std::error_code error;
+  fs::path full = fs::weakly_canonical(path, error);
+  if (error) full = fs::absolute(path, error).lexically_normal();
+  return full;
+}
+
+class Copier {
+ public:
+  Copier(const fs::path& source, const fs::path& target, Result& result)
+      : source_(Normal(source)), target_(Normal(target)), result_(result) {}
+
+  // The only gate to writing: inside the title's folder, never inside the official one.
+  bool MayWrite(const fs::path& path) const {
+    const fs::path full = Normal(path);
+    return Within(full, target_) && !Within(full, source_);
+  }
+  void LeaveOut(const fs::path& path, const std::string& why) {
+    ++result_.skipped;
+    if (result_.lines.size() < kMaxNamed) result_.lines.push_back(path.string() + ": " + why);
+  }
+  // One file, never over an existing one (copy_options::none fails when `to` exists).
+  bool CopyFile(const fs::path& from, const fs::path& to) {
+    if (!MayWrite(to)) {
+      LeaveOut(from, "not copied (destination outside the title's folder)");
+      return false;
+    }
+    std::error_code error;
+    const uint64_t size = fs::file_size(from, error);
+    if (error) {
+      LeaveOut(from, error.message());
+      return false;
+    }
+    if (!fs::copy_file(from, to, fs::copy_options::none, error) || error) {
+      LeaveOut(from, error ? error.message() : "not copied");
+      std::error_code remove_error;
+      if (error && error != std::errc::file_exists) fs::remove(to, remove_error);  // a partial copy
+      return false;
+    }
+    ++result_.files;
+    result_.bytes += size;
+    return true;
+  }
+  bool MakeFolder(const fs::path& path) {
+    if (!MayWrite(path)) return false;
+    std::error_code error;
+    fs::create_directories(path, error);
+    return !error && IsFolder(path);
+  }
+  // Every file under `from` into `to`. only_missing: kept when `to` has one of that name
+  // (small folders); otherwise `to` is a fresh staging folder.
+  void Tree(const fs::path& from, const fs::path& to, bool only_missing, int depth = 0) {
+    if (depth > kMaxDepth) {
+      LeaveOut(from, "too deep");
+      return;
+    }
+    std::error_code error;
+    fs::directory_iterator it(from, error), end;
+    if (error) {
+      LeaveOut(from, error.message());
+      return;
+    }
+    for (; !error && it != end; it.increment(error)) {
+      const fs::path entry = it->path();
+      const fs::path dest = to / entry.filename();
+      std::error_code type_error;
+      const auto type = fs::symlink_status(entry, type_error).type();
+      if (type == fs::file_type::directory) {
+        if (!MakeFolder(dest)) {
+          LeaveOut(entry, "folder not made");
+          continue;
+        }
+        Tree(entry, dest, only_missing, depth + 1);
+      } else if (type == fs::file_type::regular) {
+        if (only_missing && Exists(dest)) {
+          ++result_.kept;
+          continue;
+        }
+        CopyFile(entry, dest);
+      } else {
+        LeaveOut(entry, type == fs::file_type::symlink ? "a link (not followed)" : "not a file or folder");
+      }
+    }
+    if (error) LeaveOut(from, "listing stopped: " + error.message());
+  }
+
+ private:
+  fs::path source_, target_;
+  Result& result_;
+};
+
+// Whether the title's folder is the official one, inside it or holds it, or is a link.
+inline bool Overlap(const fs::path& source, const fs::path& target) {
+  std::error_code error;
+  if (fs::symlink_status(target, error).type() == fs::file_type::symlink) return true;
+  const fs::path s = Normal(source), t = Normal(target);
+  return Within(s, t) || Within(t, s);
+}
+// Bytes of the files under a folder (links not followed; what cannot be read counts nothing).
+inline uint64_t Bytes(const fs::path& folder, int depth = 0) {
+  uint64_t total = 0;
+  if (depth > kMaxDepth) return total;
+  std::error_code error;
+  fs::directory_iterator it(folder, error), end;
+  for (; !error && it != end; it.increment(error)) {
+    std::error_code entry_error;
+    const auto type = it->symlink_status(entry_error).type();
+    if (type == fs::file_type::directory) {
+      total += Bytes(it->path(), depth + 1);
+    } else if (type == fs::file_type::regular) {
+      const uint64_t size = it->file_size(entry_error);
+      if (!entry_error) total += size;
+    }
+  }
+  return total;
+}
+// Bytes of the files under `from` that `to` lacks.
+inline uint64_t MissingBytes(const fs::path& from, const fs::path& to, int depth = 0) {
+  uint64_t total = 0;
+  if (depth > kMaxDepth) return total;
+  std::error_code error;
+  fs::directory_iterator it(from, error), end;
+  for (; !error && it != end; it.increment(error)) {
+    std::error_code entry_error;
+    const auto type = it->symlink_status(entry_error).type();
+    const fs::path dest = to / it->path().filename();
+    if (type == fs::file_type::directory) {
+      total += MissingBytes(it->path(), dest, depth + 1);
+    } else if (type == fs::file_type::regular && !Exists(dest)) {
+      const uint64_t size = it->file_size(entry_error);
+      if (!entry_error) total += size;
+    }
+  }
+  return total;
+}
+}  // namespace detail
+
+// The facts, read from the two folders (the official one is only listed and its sizes read).
+inline Facts Gather(const fs::path& source, const fs::path& target, const FreeSpace& free_space) {
+  Facts facts;
+  facts.marker = detail::Exists(target / kMarker);
+  facts.unsafe = detail::Overlap(source, target);
+  facts.source = detail::IsFolder(source);
+  facts.source_saves = facts.source && detail::IsFolder(source / kSaves);
+  facts.target_saves = detail::Exists(target / kSaves);
+  if (facts.source && !facts.marker && !facts.unsafe) {
+    if (facts.source_saves && !facts.target_saves) facts.saves_bytes = detail::Bytes(source / kSaves);
+    for (const char* name : kFiles) {
+      std::error_code error;
+      if (detail::IsFile(source / name) && !detail::Exists(target / name)) {
+        const uint64_t size = fs::file_size(source / name, error);
+        if (!error) facts.small_bytes += size;
+      }
+    }
+    for (const char* name : kFolders)
+      if (detail::IsFolder(source / name)) facts.small_bytes += detail::MissingBytes(source / name, target / name);
+    facts.space_known = free_space && free_space(target, &facts.free);
+  }
+  return facts;
+}
+
+// Decides and, when the plan says so, copies and writes the marker. `target` is made when it is
+// missing (it is the title's own folder), unless the two folders overlap: then nothing is done.
+inline Result Run(const fs::path& source, const fs::path& target, const FreeSpace& free_space = RealFreeSpace) {
+  Result result;
+  if (detail::Overlap(source, target)) {
+    result.plan.decision = Decision::kUnsafe;
+    return result;
+  }
+  {
+    std::error_code error;
+    if (!detail::Exists(target)) fs::create_directories(target, error);
+  }
+  const Facts facts = Gather(source, target, free_space);
+  result.plan = Decide(facts);
+  result.free = facts.free;
+  if (result.plan.decision == Decision::kAlreadyDone || result.plan.decision == Decision::kUnsafe) return result;
+  detail::Copier copier(source, target, result);
+  if (result.plan.copy_saves) {
+    const fs::path staging = target / kStaging, saves = target / kSaves;
+    std::error_code error;
+    if (copier.MayWrite(staging)) fs::remove_all(staging, error);  // an interrupted start's
+    error.clear();
+    if (!copier.MakeFolder(staging)) {
+      result.error = "the staging folder could not be made";
+    } else {
+      copier.Tree(source / kSaves, staging, false);
+      if (detail::Exists(saves)) {
+        result.error = "the title has saves now";
+      } else if (copier.MayWrite(saves)) {
+        fs::rename(staging, saves, error);
+        if (error) result.error = error.message();
+        else result.saves_copied = true;
+      }
+      if (!result.saves_copied) fs::remove_all(staging, error);
+    }
+  }
+  if (result.plan.copy_small) {
+    for (const char* name : kFiles) {
+      const fs::path from = source / name, to = target / name;
+      if (!detail::Exists(from)) continue;
+      if (!detail::IsFile(from)) {
+        copier.LeaveOut(from, "not a file");
+      } else if (detail::Exists(to)) {
+        ++result.kept;
+      } else {
+        copier.CopyFile(from, to);
+      }
+    }
+    for (const char* name : kFolders) {
+      const fs::path from = source / name;
+      if (!detail::Exists(from)) continue;
+      if (!detail::IsFolder(from)) {
+        copier.LeaveOut(from, "not a folder");
+      } else if (copier.MakeFolder(target / name)) {
+        copier.Tree(from, target / name, true);
+      } else {
+        copier.LeaveOut(from, "folder not made");
+      }
+    }
+  }
+  if (result.plan.write_marker && copier.MayWrite(target / kMarker)) {
+    std::ofstream marker(target / kMarker, std::ios::trunc);
+    marker << "from " << source.string() << "\n" << DecisionName(result.plan.decision) << "\n"
+           << "saves " << (result.saves_copied ? "copied" : result.plan.copy_saves ? "not copied: " + result.error : "not copied")
+           << "\nfiles " << result.files << " (" << result.bytes << " bytes), kept " << result.kept << ", left out "
+           << result.skipped << "\nneeded " << result.plan.needed << " bytes, free " << result.free << "\n";
+    marker.flush();
+    result.marker_written = bool(marker);
+  }
+  return result;
+}
+}  // namespace xbox360ps5::official_import
