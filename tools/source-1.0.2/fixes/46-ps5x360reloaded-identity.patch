diff --git a/include/xbox360ps5/official_import.hpp b/include/xbox360ps5/official_import.hpp
new file mode 100644
index 0000000..b8b6f3a
--- /dev/null
+++ b/include/xbox360ps5/official_import.hpp
@@ -0,0 +1,827 @@
+// SPDX-License-Identifier: MIT
+// Fix 46 (tools/source-1.0.2/fixes/46-ps5x360reloaded-identity.patch): the first start of
+// PS5X360Reloaded copies the official PS5X360's saves and small settings files from its folder
+// (app_identity::kOfficialDataRoot) into its own (kDataRoot), once.
+//
+//   * saves/ (profiles, achievements, game saves, installed DLC and title updates): copied into
+//     <target>/.saves-import, then renamed to <target>/saves, only when the title has no saves
+//     folder of its own (never merged into saves it has); a start interrupted while copying
+//     leaves the staging folder, which the next start removes and copies again;
+//   * kFiles and the files of kFolders: each copied only when the title has no file of that name
+//     (never overwritten);
+//   * only when the folder holding <target> has room for all of it plus kMargin; otherwise
+//     nothing is copied;
+//   * each entry that cannot be read, a link, or anything else than a file or folder is left out
+//     and counted (the log names the first ones, with the reason); copies are copies, never
+//     links, since saves are rewritten in place.
+// The marker <target>/.official-import records the outcome, so this runs once: after an import,
+// when the official folder is absent, and when the room is short (the start then makes empty
+// saves, and the notice says so; the files can still be copied by FTP). No marker, so that the
+// next start tries again, when the folders overlap or when a path the decision rests on (the
+// marker, the official folder, its saves, the title's saves) could not be looked at for another
+// reason than "not found"; the log and the notice say so, the log with the error.
+// Nothing is ever written, created, renamed or removed in the official folder: it is only
+// opened for reading and listed, and every path written to is checked to be inside <target>
+// and outside <source> first. Not copied: cache/ (shaders and modules, made again), logs/ (with
+// web-settings.key and phone-camera/: this title makes its own key and its own camera
+// certificate) and the official app's own files.
+//
+// How paths are looked at. Candidate 53 on the console found no official folder although it was
+// there (drwxrwxrwx) and wrote no marker: every check went through lstat
+// (std::filesystem::symlink_status) and the write gate through realpath (weakly_canonical, which
+// turns a realpath failure into an empty path without an error), neither of which the title had
+// used on the console before. What the title's working code uses there is stat and directory
+// listings (fix 27's PosixFs: ::stat of a folder and of its "..", std::filesystem::is_directory,
+// statvfs, directory_iterator; ::open to probe a drive). So here:
+//   * a path's type comes from stat (std::filesystem::status); lstat is asked too, and when it
+//     answers a link is a link (never followed); when it fails only stat counts (Look);
+//   * whether an entry of a listing is a link comes from the listing (directory_entry::is_symlink,
+//     which libc++ answers from the listing's d_type without lstat; its symlink_status member
+//     would ask lstat), its type then from Look (LookEntry); a link the listing names is left out;
+//   * a folder of the official side is gone into only when stat finds its ".." to be the folder
+//     it was listed in (InPlace): a link to a folder elsewhere, or to a folder above it (a loop),
+//     that neither lstat nor the listing could show is left out; a link to a file that neither
+//     could show is read like a file (reading changes nothing);
+//   * an interrupted start's staging folder is removed with listings, unlink and rmdir
+//     (RemoveTree), never through a link, not with the standard library's recursive removal (its
+//     lstat or openat were never used on the console);
+//   * the write gate compares the paths lexically (both are absolute) and, with stat alone, that
+//     each existing folder on the way has the one above it as its ".." (Copier::Contained), so a
+//     link in the title's folder that leads elsewhere is not written through; the folders overlap
+//     also when stat finds one inside the other by walking ".." (InsideByStat);
+//   * files are copied with open(O_CREAT | O_EXCL), which never replaces a file and never writes
+//     through a link, a dangling one included, without asking lstat;
+//   * an error other than "not found" is kept with its message and errno for the log.
+// Header only and free of the rest of the title, so that tools/check-official-import.cpp
+// drives the same code on a temporary folder, with lstat, stat and realpath made to fail as the
+// console's did.
+#pragma once
+#include <fcntl.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <cerrno>
+#include <cstdint>
+#include <cstdio>
+#include <filesystem>
+#include <functional>
+#include <set>
+#include <string>
+#include <system_error>
+#include <vector>
+
+namespace xbox360ps5::official_import {
+namespace fs = std::filesystem;
+
+inline constexpr char kMarker[] = ".official-import";
+inline constexpr char kStaging[] = ".saves-import";
+inline constexpr char kSaves[] = "saves";
+// Settings files of the folder's top (network.conf: the network mode and server; the others are
+// switches the home or a test reads).
+inline constexpr const char* kFiles[] = {"network.conf", "vibration.conf", "framegen.conf",
+                                         "ui-dark.on",   "ui-classic.on",  "dashboard.off"};
+// Small folders: the user's home pictures, downloaded game art, the original dashboard the user
+// copied (dash.xex), the achievement icons the notifications show.
+inline constexpr const char* kFolders[] = {"skin", "game-art", "dashboard", "cache/achievements"};
+// Room kept free beyond what is copied.
+inline constexpr uint64_t kMargin = 64ull << 20;
+// At most this many folder levels are walked (saves are a few levels deep).
+inline constexpr int kMaxDepth = 32;
+// Lines naming left-out entries, at most.
+inline constexpr size_t kMaxNamed = 32;
+
+// How a path is looked at (test hook: the check makes these fail as the console's did).
+struct Probe {
+  // Follows links (stat): what the title's working code on the console uses.
+  std::function<fs::file_status(const fs::path&, std::error_code&)> status;
+  // Does not follow links (lstat): asked only to see a link as a link; its failure is ignored.
+  std::function<fs::file_status(const fs::path&, std::error_code&)> link_status;
+  // Whether a listed entry is a link, as the listing says (an error: the listing does not say).
+  std::function<bool(const fs::directory_entry&, std::error_code&)> listed_link;
+};
+inline Probe RealProbe() {
+  Probe probe;
+  probe.status = [](const fs::path& path, std::error_code& error) { return fs::status(path, error); };
+  probe.link_status = [](const fs::path& path, std::error_code& error) { return fs::symlink_status(path, error); };
+  probe.listed_link = [](const fs::directory_entry& entry, std::error_code& error) { return entry.is_symlink(error); };
+  return probe;
+}
+
+// What the decision needs to know, gathered by Gather (or made up by the check).
+struct Facts {
+  bool marker = false;        // <target>/.official-import exists: decided at an earlier start
+  bool unsafe = false;        // the two folders are one, or inside each other, or <target> is a link
+  bool source = false;        // the official folder is a folder (not a link)
+  bool source_saves = false;  // <source>/saves is a folder (not a link)
+  bool target_saves = false;  // <target>/saves exists, whatever it is
+  fs::file_type source_type = fs::file_type::none;  // what the official folder is (not_found: absent)
+  std::string error;      // "<path> could not be checked: <reason>": a path the decision rests on
+  std::string link_note;  // lstat's error on the official folder, when stat answered alone
+  uint64_t saves_bytes = 0;  // the files of <source>/saves
+  uint64_t small_bytes = 0;  // kFiles and kFolders' files the title does not have yet
+  bool space_known = false;
+  uint64_t free = 0;  // room where <target> is
+};
+
+enum class Decision {
+  kAlreadyDone,      // the marker: nothing at all
+  kUnsafe,           // nothing at all, no marker
+  kCannotCheck,      // a path could not be looked at: nothing at all, no marker (the next start tries again)
+  kNothingToImport,  // no official folder: the marker only
+  kNoSpace,          // not enough room (or not known): the marker only
+  kImport,           // copy (saves when copy_saves), then the marker
+};
+
+struct Plan {
+  Decision decision = Decision::kAlreadyDone;
+  bool copy_saves = false;
+  bool copy_small = false;
+  bool write_marker = false;
+  uint64_t needed = 0;  // bytes copied plus kMargin (kImport and kNoSpace)
+};
+
+// The decision, from the facts alone.
+inline Plan Decide(const Facts& facts) {
+  Plan plan;
+  if (facts.marker) return plan;
+  if (facts.unsafe) {
+    plan.decision = Decision::kUnsafe;
+    return plan;
+  }
+  if (!facts.error.empty()) {
+    plan.decision = Decision::kCannotCheck;
+    return plan;
+  }
+  plan.write_marker = true;
+  if (!facts.source) {
+    plan.decision = Decision::kNothingToImport;
+    return plan;
+  }
+  const bool saves = facts.source_saves && !facts.target_saves;
+  plan.needed = (saves ? facts.saves_bytes : 0) + facts.small_bytes + kMargin;
+  if (!facts.space_known || facts.free < plan.needed) {
+    plan.decision = Decision::kNoSpace;
+    return plan;
+  }
+  plan.decision = Decision::kImport;
+  plan.copy_saves = saves;
+  plan.copy_small = true;
+  return plan;
+}
+
+inline const char* DecisionName(Decision decision) {
+  switch (decision) {
+    case Decision::kAlreadyDone: return "already done";
+    case Decision::kUnsafe: return "refused (the folders overlap or the title's folder is a link)";
+    case Decision::kCannotCheck: return "not imported yet (a folder could not be checked)";
+    case Decision::kNothingToImport: return "nothing to import (no official folder)";
+    case Decision::kNoSpace: return "not enough free space";
+    case Decision::kImport: return "imported";
+  }
+  return "?";
+}
+
+struct Result {
+  Plan plan;
+  Facts facts;
+  std::string source, target;  // the two folders, for the summary
+  bool saves_copied = false;
+  uint64_t files = 0;    // files copied
+  uint64_t bytes = 0;    // their bytes
+  uint64_t kept = 0;     // small files the title already had (left as they are)
+  uint64_t skipped = 0;  // entries left out: unreadable, links, other types, failed copies
+  uint64_t free = 0;
+  bool marker_written = false;
+  std::string marker_error;        // why the marker was not written, when it was not
+  std::string error;               // why the saves were not put in place, when they were not
+  std::vector<std::string> lines;  // what was left out (kMaxNamed at most), for the log
+};
+
+// The room in the folder holding `path` (test hook: the check gives its own).
+using FreeSpace = std::function<bool(const fs::path& path, uint64_t* free)>;
+inline bool RealFreeSpace(const fs::path& path, uint64_t* free) {
+  std::error_code error;
+  const auto info = fs::space(path, error);  // libc's statvfs, as fix 27 on the console
+  if (error) return false;
+  *free = info.available;
+  return true;
+}
+
+namespace detail {
+inline std::string Errno(int number) {
+  return std::generic_category().message(number) + " (errno " + std::to_string(number) + ")";
+}
+inline std::string Reason(const std::error_code& error) {
+  return error.message() + " (errno " + std::to_string(error.value()) + ")";
+}
+inline bool NotFound(const std::error_code& error) {
+  return error == std::errc::no_such_file_or_directory || error == std::errc::not_a_directory;
+}
+
+// What a path is: its type (not_found when absent), or why it could not be told.
+struct Kind {
+  fs::file_type type = fs::file_type::none;
+  std::string error;       // set only when the type could not be told
+  std::string link_error;  // lstat's error when it did not answer (stat was used alone)
+  bool Absent() const { return type == fs::file_type::not_found; }
+  bool Failed() const { return !error.empty(); }
+  bool Present() const { return !Absent() && !Failed(); }
+  bool Folder() const { return type == fs::file_type::directory; }
+  bool File() const { return type == fs::file_type::regular; }
+};
+inline Kind Look(const Probe& probe, const fs::path& path) {
+  Kind kind;
+  std::error_code link_error;
+  const fs::file_status link = probe.link_status(path, link_error);
+  if (!link_error && link.type() == fs::file_type::symlink) {
+    kind.type = fs::file_type::symlink;
+    return kind;
+  }
+  std::error_code error;
+  const fs::file_status status = probe.status(path, error);
+  if (status.type() == fs::file_type::not_found || (error && NotFound(error))) {
+    kind.type = fs::file_type::not_found;
+  } else if (error || status.type() == fs::file_type::none) {
+    kind.error = error ? Reason(error) : std::string("its type could not be read");
+  } else {
+    kind.type = status.type();
+  }
+  // lstat's failure is named: any error but "not found", and "not found" too when stat finds it.
+  if (link_error && (!NotFound(link_error) || kind.Present())) kind.link_error = Reason(link_error);
+  return kind;
+}
+// An entry of a listing: a link when the listing says so, else Look (stat).
+inline Kind LookEntry(const Probe& probe, const fs::directory_entry& entry) {
+  std::error_code error;
+  if (probe.listed_link(entry, error) && !error) {
+    Kind kind;
+    kind.type = fs::file_type::symlink;
+    return kind;
+  }
+  return Look(probe, entry.path());
+}
+// Whether stat finds the ".." of the folder `path` to be `parent`, the folder it is named in. Not
+// so for a link to a folder elsewhere (or above); a mount point's ".." is the folder it is
+// mounted in. False when stat cannot tell.
+inline bool InPlace(const fs::path& path, const fs::path& parent) {
+  std::error_code error;
+  return fs::equivalent(path / "..", parent, error) && !error;
+}
+// Whether `inner` is `outer` or inside it, by path components (both made absolute and normal).
+inline bool Within(const fs::path& inner, const fs::path& outer) {
+  std::vector<fs::path> a, b;
+  for (const auto& part : inner)
+    if (!part.empty()) a.push_back(part);  // empty: a trailing separator
+  for (const auto& part : outer)
+    if (!part.empty()) b.push_back(part);
+  return !b.empty() && b.size() <= a.size() && std::equal(b.begin(), b.end(), a.begin());
+}
+// Absolute and normal, lexically (no realpath: see the top).
+inline fs::path Lexical(const fs::path& path) {
+  if (path.is_absolute()) return path.lexically_normal();
+  std::error_code error;
+  return fs::absolute(path, error).lexically_normal();
+}
+// Whether `inner` is `outer` or inside it as stat sees the folders: `outer` is `inner` or one of
+// the folders its ".." chain reaches. Finds a link that lstat could not show. False when stat
+// cannot tell (a folder missing, or not to be looked at).
+inline bool InsideByStat(const fs::path& inner, const fs::path& outer) {
+  fs::path at = inner;
+  for (int level = 0; level < 4 * kMaxDepth; ++level) {
+    std::error_code error;
+    if (fs::equivalent(at, outer, error) && !error) return true;
+    if (error) return false;
+    const fs::path up = at / "..";
+    std::error_code up_error;
+    if (fs::equivalent(up, at, up_error) || up_error) return false;  // the root (its own parent)
+    at = up;
+  }
+  return false;
+}
+// `path`, or its nearest folder above that exists (where it would be made).
+inline fs::path Existing(const Probe& probe, const fs::path& path) {
+  fs::path at = path;
+  for (int level = 0; level < 4 * kMaxDepth && Look(probe, at).Absent() && at.has_relative_path(); ++level)
+    at = at.parent_path();
+  return at;
+}
+// Whether the title's folder is the official one, inside it or holds it, or is a link. A title's
+// folder still to be made counts where it would be made (a link above it is followed by stat).
+inline bool Overlap(const Probe& probe, const fs::path& source, const fs::path& target) {
+  if (Look(probe, target).type == fs::file_type::symlink) return true;
+  const fs::path s = Lexical(source), t = Lexical(target);
+  if (Within(s, t) || Within(t, s)) return true;
+  return InsideByStat(Existing(probe, t), s) || InsideByStat(s, t);
+}
+
+enum class Copied { kYes, kThere, kFailed };
+// One file's bytes into a new file: open(O_CREAT | O_EXCL) fails on anything of that name, a
+// link (dangling or not) included, so nothing is replaced and nothing is written through a link.
+inline Copied CopyBytes(const fs::path& from, const fs::path& to, uint64_t* size, std::string* why) {
+  const int in = ::open(from.c_str(), O_RDONLY);
+  if (in < 0) {
+    *why = "not readable: " + Errno(errno);
+    return Copied::kFailed;
+  }
+  const int out = ::open(to.c_str(), O_WRONLY | O_CREAT | O_EXCL, 0666);
+  if (out < 0) {
+    const int number = errno;
+    ::close(in);
+    if (number == EEXIST) return Copied::kThere;
+    *why = "its copy could not be made: " + Errno(number);
+    return Copied::kFailed;
+  }
+  std::vector<char> buffer(size_t(1) << 16);
+  uint64_t total = 0;
+  std::string error;
+  for (;;) {
+    const ssize_t got = ::read(in, buffer.data(), buffer.size());
+    if (got < 0) {
+      if (errno == EINTR) continue;
+      error = "not read: " + Errno(errno);
+      break;
+    }
+    if (got == 0) break;
+    for (ssize_t done = 0; done < got && error.empty();) {
+      const ssize_t put = ::write(out, buffer.data() + done, size_t(got - done));
+      if (put < 0) {
+        if (errno != EINTR) error = "not written: " + Errno(errno);
+        continue;
+      }
+      done += put;
+    }
+    if (!error.empty()) break;
+    total += uint64_t(got);
+  }
+  ::close(in);
+  if (::close(out) != 0 && error.empty()) error = "not written: " + Errno(errno);
+  if (!error.empty()) {
+    ::unlink(to.c_str());  // the partial copy this call made
+    *why = error;
+    return Copied::kFailed;
+  }
+  *size = total;
+  return Copied::kYes;
+}
+
+class Copier {
+ public:
+  Copier(const fs::path& source, const fs::path& target, const Probe& probe, Result& result)
+      : source_(Lexical(source)), target_(Lexical(target)), probe_(probe), result_(result) {}
+
+  // The only gate to writing: inside the title's folder, never inside the official one.
+  bool MayWrite(const fs::path& path) const {
+    const fs::path full = Lexical(path);
+    return Within(full, target_) && !Within(full, source_) && Contained(full);
+  }
+  void LeaveOut(const fs::path& path, const std::string& why) {
+    ++result_.skipped;
+    if (result_.lines.size() < kMaxNamed) result_.lines.push_back(path.string() + ": " + why);
+  }
+  // One file, never over an existing one (then counted as kept).
+  bool CopyFile(const fs::path& from, const fs::path& to) {
+    if (!MayWrite(to)) {
+      LeaveOut(from, "not copied (its copy would not be inside the title's folder)");
+      return false;
+    }
+    uint64_t size = 0;
+    std::string why;
+    switch (CopyBytes(from, to, &size, &why)) {
+      case Copied::kYes:
+        ++result_.files;
+        result_.bytes += size;
+        return true;
+      case Copied::kThere:
+        ++result_.kept;
+        return false;
+      case Copied::kFailed:
+        LeaveOut(from, why);
+        return false;
+    }
+    return false;
+  }
+  bool MakeFolder(const fs::path& path, std::string* why = nullptr) {
+    std::string reason;
+    if (!MayWrite(path)) {
+      reason = "not inside the title's folder";
+    } else {
+      std::error_code error;
+      fs::create_directories(path, error);
+      const Kind kind = Look(probe_, path);
+      if (kind.Folder() && MayWrite(path)) return true;  // made, and not a link that leads elsewhere
+      reason = error ? Reason(error) : kind.Failed() ? kind.error : "not a folder of the title's";
+    }
+    if (why) *why = reason;
+    return false;
+  }
+  // Every file under `from` into `to`. only_missing: kept when `to` has one of that name
+  // (small folders); otherwise `to` is a fresh staging folder.
+  void Tree(const fs::path& from, const fs::path& to, bool only_missing, int depth = 0) {
+    if (depth > kMaxDepth) {
+      LeaveOut(from, "too deep");
+      return;
+    }
+    std::error_code error;
+    fs::directory_iterator it(from, error), end;
+    if (error) {
+      LeaveOut(from, "not listed: " + Reason(error));
+      return;
+    }
+    for (; !error && it != end; it.increment(error)) {
+      const fs::path entry = it->path();
+      const fs::path dest = to / entry.filename();
+      const Kind kind = LookEntry(probe_, *it);
+      if (kind.Failed()) {
+        LeaveOut(entry, kind.error);
+      } else if (kind.Folder() && !InPlace(entry, from)) {
+        LeaveOut(entry, "a link (not followed): its \"..\" is not the folder it is listed in");
+      } else if (kind.Folder()) {
+        std::string why;
+        if (!MakeFolder(dest, &why)) {
+          LeaveOut(entry, "its folder not made: " + why);
+          continue;
+        }
+        Tree(entry, dest, only_missing, depth + 1);
+      } else if (kind.File()) {
+        if (only_missing) {
+          const Kind there = Look(probe_, dest);
+          if (there.Failed()) {
+            LeaveOut(entry, "its copy's place could not be checked: " + there.error);
+            continue;
+          }
+          if (!there.Absent()) {
+            ++result_.kept;
+            continue;
+          }
+        }
+        CopyFile(entry, dest);
+      } else {
+        LeaveOut(entry, kind.type == fs::file_type::symlink ? "a link (not followed)" : "not a file or folder");
+      }
+    }
+    if (error) LeaveOut(from, "listing stopped: " + Reason(error));
+  }
+
+ private:
+  // stat's view of the way from the title's folder to `path`: each folder on it that exists has
+  // the one above it as its "..", so none of them is a link that leads elsewhere (no lstat). A
+  // missing part ends the walk (nothing below it exists yet); a file ends it too (the last part,
+  // which open(O_EXCL) never replaces, or a part nothing can be made under).
+  bool Contained(const fs::path& full) const {
+    const fs::path rel = full.lexically_relative(target_);
+    fs::path above = target_, here = target_;
+    for (const auto& part : rel) {
+      if (part.empty() || part == ".") continue;
+      if (part == "..") return false;
+      here /= part;
+      if (verified_.count(here.string())) {
+        above = here;
+        continue;
+      }
+      const Kind kind = Look(probe_, here);
+      if (kind.Absent()) return true;
+      if (kind.Failed() || kind.type == fs::file_type::symlink) return false;
+      if (!kind.Folder()) return true;
+      std::error_code error;
+      if (!fs::equivalent(here / "..", above, error) || error) return false;
+      verified_.insert(here.string());
+      above = here;
+    }
+    return true;
+  }
+
+  fs::path source_, target_;
+  const Probe& probe_;
+  Result& result_;
+  mutable std::set<std::string> verified_;  // folders found inside the title's folder
+};
+
+// Bytes of the files under a folder (links not followed; what cannot be read counts nothing).
+inline uint64_t Bytes(const Probe& probe, const fs::path& folder, int depth = 0) {
+  uint64_t total = 0;
+  if (depth > kMaxDepth) return total;
+  std::error_code error;
+  fs::directory_iterator it(folder, error), end;
+  for (; !error && it != end; it.increment(error)) {
+    const Kind kind = LookEntry(probe, *it);
+    if (kind.Folder()) {
+      if (InPlace(it->path(), folder)) total += Bytes(probe, it->path(), depth + 1);
+    } else if (kind.File()) {
+      std::error_code size_error;
+      const uint64_t size = fs::file_size(it->path(), size_error);
+      if (!size_error) total += size;
+    }
+  }
+  return total;
+}
+// Bytes of the files under `from` that `to` lacks.
+inline uint64_t MissingBytes(const Probe& probe, const fs::path& from, const fs::path& to, int depth = 0) {
+  uint64_t total = 0;
+  if (depth > kMaxDepth) return total;
+  std::error_code error;
+  fs::directory_iterator it(from, error), end;
+  for (; !error && it != end; it.increment(error)) {
+    const Kind kind = LookEntry(probe, *it);
+    const fs::path dest = to / it->path().filename();
+    if (kind.Folder()) {
+      if (InPlace(it->path(), from)) total += MissingBytes(probe, it->path(), dest, depth + 1);
+    } else if (kind.File() && Look(probe, dest).Absent()) {
+      std::error_code size_error;
+      const uint64_t size = fs::file_size(it->path(), size_error);
+      if (!size_error) total += size;
+    }
+  }
+  return total;
+}
+
+// Removes `path` (a file, a link or a folder this code made: the staging folder) with listings,
+// stat, unlink and rmdir. A link is removed itself, never followed; a folder is gone into only in
+// place. False, with why, at the first entry that could not be removed.
+inline bool RemoveTree(const Probe& probe, const fs::path& path, std::string* why, int depth = 0) {
+  const Kind kind = Look(probe, path);
+  if (kind.Absent()) return true;
+  if (!kind.Folder()) {
+    if (::unlink(path.c_str()) == 0) return true;
+    *why = path.string() + ": " + Errno(errno);
+    return false;
+  }
+  if (depth > kMaxDepth) {
+    *why = path.string() + ": too deep";
+    return false;
+  }
+  std::error_code error;
+  for (fs::directory_iterator it(path, error), end; !error && it != end; it.increment(error)) {
+    const Kind entry = LookEntry(probe, *it);
+    if (entry.Folder() && InPlace(it->path(), path)) {
+      if (!RemoveTree(probe, it->path(), why, depth + 1)) return false;
+    } else if (::unlink(it->path().c_str()) != 0) {
+      *why = it->path().string() + ": " + Errno(errno);
+      return false;
+    }
+  }
+  if (error) {
+    *why = path.string() + ": not listed: " + Reason(error);
+    return false;
+  }
+  if (::rmdir(path.c_str()) == 0) return true;
+  *why = path.string() + ": " + Errno(errno);
+  return false;
+}
+
+// "1.5 MiB" and the like.
+inline std::string Size(uint64_t bytes) {
+  char text[48];
+  if (bytes < 1024) {
+    std::snprintf(text, sizeof(text), "%llu bytes", static_cast<unsigned long long>(bytes));
+  } else {
+    const char* unit = "KiB";
+    double value = double(bytes) / 1024;
+    if (value >= 1024) value /= 1024, unit = "MiB";
+    if (value >= 1024) value /= 1024, unit = "GiB";
+    std::snprintf(text, sizeof(text), "%.1f %s", value, unit);
+  }
+  return text;
+}
+// What the import did, in words (the marker's and the log's), without the marker's own outcome.
+inline std::string Outcome(const Result& result) {
+  const Plan& plan = result.plan;
+  std::string text;
+  switch (plan.decision) {
+    case Decision::kAlreadyDone:
+      return "already done at an earlier start (" + (fs::path(result.target) / kMarker).string() + ")";
+    case Decision::kUnsafe:
+      return "not imported: " + result.source + " and " + result.target +
+             " are the same folder, one is inside the other, or the second is a link; nothing was written";
+    case Decision::kCannotCheck:
+      return "not imported yet: " + result.facts.error + "; nothing was copied";
+    case Decision::kNothingToImport: {
+      const fs::file_type type = result.facts.source_type;
+      return "nothing to import: PS5X360's folder " + result.source +
+             (type == fs::file_type::not_found || type == fs::file_type::none ? " does not exist"
+              : type == fs::file_type::symlink                                ? " is a link (not followed)"
+                                                                              : " is not a folder");
+    }
+    case Decision::kNoSpace:
+      return "not imported: not enough free space in " + result.target + " (" + Size(plan.needed) + " needed, " +
+             (result.facts.space_known ? Size(result.free) + " free" : std::string("the free space could not be read")) +
+             "); nothing was copied";
+    case Decision::kImport:
+      text = "imported from " + result.source + " to " + result.target + ": ";
+      if (result.saves_copied) {
+        text += "saves copied";
+      } else if (plan.copy_saves) {
+        text += "saves not copied (" + result.error + ")";
+      } else if (result.facts.source_saves) {
+        text += "saves not copied (this title has saves of its own, which are never merged)";
+      } else {
+        text += "PS5X360 has no saves";
+      }
+      text += "; " + std::to_string(result.files) + " files (" + Size(result.bytes) + ") copied, " +
+              std::to_string(result.kept) + " already here and kept, " + std::to_string(result.skipped) +
+              " left out" + (result.skipped ? " (listed below)" : "");
+      return text;
+  }
+  return text;
+}
+}  // namespace detail
+
+// The import's summary for the log: what it did, and whether the marker was written and why not.
+inline std::string Summary(const Result& result) {
+  std::string text = detail::Outcome(result);
+  if (result.plan.decision == Decision::kAlreadyDone) return text;
+  if (!result.facts.link_note.empty())
+    text += "; lstat did not answer for " + result.source + " (" + result.facts.link_note + "), stat was used";
+  if (result.marker_written) return text + "; marker written";
+  return text + "; marker not written: " + result.marker_error + " (the next start tries again)";
+}
+
+// The launcher's notice after the import, if any (the log has the details).
+enum class Notice {
+  kNone,
+  kCopied,       // "Saves and settings were copied from PS5X360. ..."
+  kSomeLeftOut,  // "Some saves or settings could not be copied from PS5X360 (the log lists them). ..."
+  kOwnSaves,     // "Saves were not copied from PS5X360: this app already has saves of its own."
+  kNoSpace,      // "Saves and settings were not copied from PS5X360: not enough free space."
+  kCannotCheck,  // "Saves and settings were not copied from PS5X360: a folder could not be checked ..."
+};
+inline Notice NoticeFor(const Result& result) {
+  switch (result.plan.decision) {
+    case Decision::kCannotCheck: return Notice::kCannotCheck;
+    case Decision::kNoSpace: return Notice::kNoSpace;
+    case Decision::kImport:
+      if (result.skipped || !result.error.empty()) return Notice::kSomeLeftOut;
+      if (!result.plan.copy_saves && result.facts.source_saves && result.facts.target_saves) return Notice::kOwnSaves;
+      return result.files ? Notice::kCopied : Notice::kNone;
+    default: return Notice::kNone;
+  }
+}
+
+// The facts, read from the two folders (the official one is only listed and its sizes read).
+inline Facts Gather(const fs::path& source, const fs::path& target, const FreeSpace& free_space,
+                    const Probe& probe = RealProbe()) {
+  Facts facts;
+  const auto look = [&](const fs::path& path) {
+    detail::Kind kind = detail::Look(probe, path);
+    if (kind.Failed() && facts.error.empty()) facts.error = path.string() + " could not be checked: " + kind.error;
+    return kind;
+  };
+  facts.marker = look(target / kMarker).Present();
+  facts.unsafe = detail::Overlap(probe, source, target);
+  const detail::Kind folder = look(source);
+  facts.source_type = folder.type;
+  facts.source = folder.Folder();
+  facts.link_note = folder.link_error;
+  if (folder.Absent()) {
+    // stat says there is no official folder: a listing of it must fail too. When it opens, the
+    // answer is not trusted (no marker, the next start tries again) and the log says so.
+    std::error_code error;
+    fs::directory_iterator listing(source, error);
+    if (!error && facts.error.empty())
+      facts.error = source.string() + " could not be checked: stat says it does not exist, yet it can be listed";
+  }
+  facts.source_saves = facts.source && look(source / kSaves).Folder();
+  facts.target_saves = look(target / kSaves).Present();
+  if (facts.source && !facts.marker && !facts.unsafe && facts.error.empty()) {
+    if (facts.source_saves && !facts.target_saves && detail::InPlace(source / kSaves, source))
+      facts.saves_bytes = detail::Bytes(probe, source / kSaves);
+    for (const char* name : kFiles) {
+      std::error_code error;
+      if (detail::Look(probe, source / name).File() && detail::Look(probe, target / name).Absent()) {
+        const uint64_t size = fs::file_size(source / name, error);
+        if (!error) facts.small_bytes += size;
+      }
+    }
+    for (const char* name : kFolders)
+      if (detail::Look(probe, source / name).Folder() && detail::InPlace(source / name, (source / name).parent_path()))
+        facts.small_bytes += detail::MissingBytes(probe, source / name, target / name);
+    facts.space_known = free_space && free_space(target, &facts.free);
+  }
+  return facts;
+}
+
+// Decides and, when the plan says so, copies and writes the marker. `target` is made when it is
+// missing (it is the title's own folder), unless the two folders overlap: then nothing is done.
+inline Result Run(const fs::path& source, const fs::path& target, const FreeSpace& free_space = RealFreeSpace,
+                  const Probe& probe = RealProbe()) {
+  Result result;
+  result.source = source.string();
+  result.target = target.string();
+  if (detail::Overlap(probe, source, target)) {
+    result.plan.decision = Decision::kUnsafe;
+    result.facts.unsafe = true;
+    result.marker_error = "the folders overlap";
+    return result;
+  }
+  if (detail::Look(probe, target).Absent()) {
+    std::error_code error;
+    fs::create_directories(target, error);
+  }
+  result.facts = Gather(source, target, free_space, probe);
+  result.plan = Decide(result.facts);
+  result.free = result.facts.free;
+  switch (result.plan.decision) {
+    case Decision::kAlreadyDone: return result;
+    case Decision::kUnsafe: result.marker_error = "the folders overlap"; return result;
+    case Decision::kCannotCheck: result.marker_error = "a folder could not be checked"; return result;
+    default: break;
+  }
+  detail::Copier copier(source, target, probe, result);
+  if (result.plan.copy_saves) {
+    const fs::path staging = target / kStaging, saves = target / kSaves;
+    std::error_code error;
+    std::string why, removed;
+    // An interrupted start's staging folder (only then: nothing is removed when there is none).
+    if (!detail::Look(probe, staging).Absent()) {
+      if (!copier.MayWrite(staging)) removed = "it is not a folder of the title's";
+      else detail::RemoveTree(probe, staging, &removed);
+    }
+    const detail::Kind left = detail::Look(probe, staging);
+    if (!detail::InPlace(source / kSaves, source)) {
+      result.error = "PS5X360's saves folder is a link (not followed) or its \"..\" could not be checked";
+    } else if (!left.Absent()) {
+      result.error = "the staging folder of an earlier start could not be removed: " +
+                     (!removed.empty() ? removed : left.Failed() ? left.error : std::string("it is still there"));
+    } else if (!copier.MakeFolder(staging, &why)) {
+      result.error = "the staging folder could not be made: " + why;
+    } else {
+      copier.Tree(source / kSaves, staging, false);
+      const detail::Kind own = detail::Look(probe, saves);
+      if (!own.Absent()) {
+        result.error = own.Failed() ? "the title's saves could not be checked: " + own.error : "the title has saves now";
+      } else if (!copier.MayWrite(saves)) {
+        result.error = "the saves folder would not be inside the title's folder";
+      } else {
+        error.clear();
+        fs::rename(staging, saves, error);
+        if (error) result.error = "the copy was not put in place: " + detail::Reason(error);
+        else result.saves_copied = true;
+      }
+      std::string ignored;
+      if (!result.saves_copied) detail::RemoveTree(probe, staging, &ignored);
+    }
+  }
+  if (result.plan.copy_small) {
+    for (const char* name : kFiles) {
+      const fs::path from = source / name, to = target / name;
+      const detail::Kind kind = detail::Look(probe, from);
+      if (kind.Absent()) continue;
+      if (kind.Failed()) {
+        copier.LeaveOut(from, kind.error);
+      } else if (!kind.File()) {
+        copier.LeaveOut(from, kind.type == fs::file_type::symlink ? "a link (not followed)" : "not a file");
+      } else {
+        const detail::Kind there = detail::Look(probe, to);
+        if (there.Failed()) copier.LeaveOut(from, "its copy's place could not be checked: " + there.error);
+        else if (!there.Absent()) ++result.kept;
+        else copier.CopyFile(from, to);
+      }
+    }
+    for (const char* name : kFolders) {
+      const fs::path from = source / name;
+      const detail::Kind kind = detail::Look(probe, from);
+      if (kind.Absent()) continue;
+      std::string why;
+      if (kind.Failed()) {
+        copier.LeaveOut(from, kind.error);
+      } else if (!kind.Folder()) {
+        copier.LeaveOut(from, kind.type == fs::file_type::symlink ? "a link (not followed)" : "not a folder");
+      } else if (!detail::InPlace(from, from.parent_path())) {
+        copier.LeaveOut(from, "a link (not followed): its \"..\" is not the folder above it");
+      } else if (copier.MakeFolder(target / name, &why)) {
+        copier.Tree(from, target / name, true);
+      } else {
+        copier.LeaveOut(from, "its folder not made: " + why);
+      }
+    }
+  }
+  // The marker: a new file (O_EXCL: the check above found none, and nothing is written through a link).
+  const fs::path marker = target / kMarker;
+  if (!copier.MayWrite(marker)) {
+    result.marker_error = "its path is not inside the title's folder";
+  } else {
+    const std::string text = "from " + result.source + "\n" + DecisionName(result.plan.decision) + "\n" +
+                             detail::Outcome(result) + "\n";
+    const int file = ::open(marker.c_str(), O_WRONLY | O_CREAT | O_EXCL, 0666);
+    if (file < 0) {
+      result.marker_error = "it could not be made: " + detail::Errno(errno);
+    } else {
+      size_t done = 0;
+      while (done < text.size()) {
+        const ssize_t put = ::write(file, text.data() + done, text.size() - done);
+        if (put < 0 && errno == EINTR) continue;
+        if (put <= 0) {
+          result.marker_error = "it could not be written: " + detail::Errno(errno);
+          break;
+        }
+        done += size_t(put);
+      }
+      if (::close(file) != 0 && result.marker_error.empty())
+        result.marker_error = "it could not be written: " + detail::Errno(errno);
+      if (!result.marker_error.empty()) ::unlink(marker.c_str());
+    }
+  }
+  result.marker_written = result.marker_error.empty();
+  return result;
+}
+}  // namespace xbox360ps5::official_import
