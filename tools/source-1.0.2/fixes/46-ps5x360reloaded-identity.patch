+// SPDX-License-Identifier: MIT
+// Fix 46 (tools/source-1.0.2/fixes/46-ps5x360reloaded-identity.patch): who this title is.
+// PS5X360Reloaded, the fork of BrinooTk's PS5X360 rebuilt from its published sources, has a title
+// ID of its own, PPSA83600, so it installs beside the official PS5X360 instead of
+// replacing it, and keeps its data in a folder of its own: everything the title and the core
+// read or write under /data/homebrew goes through XBOX360PS5_DATA_ROOT. The official app's
+// folder is named once, here (kOfficialDataRoot), for the two places that only read it: the
+// first start's copy of its saves and settings (official_import.hpp) and the official Kinect
+// tracker's key (web_settings.cpp). Nothing writes there.
+// Macros, so that paths are string literals ("..." XBOX360PS5_DATA_ROOT "/x" "..."), also in the
+// core's C++ (the core sees include/, canary/CMakeLists.txt).
+#pragma once
+
+#define XBOX360PS5_PRODUCT_NAME "PS5X360Reloaded"
+#define XBOX360PS5_TITLE_ID "PPSA83600"
+#define XBOX360PS5_DATA_ROOT "/data/homebrew/" XBOX360PS5_TITLE_ID
+// The official PS5X360's title ID: the only place the title and the core name it.
+#define XBOX360PS5_OFFICIAL_TITLE_ID "PPSA50011"
+
+namespace xbox360ps5::app_identity {
+// The name the title shows (window, version label, guide, notifications, web pages).
+inline constexpr char kProductName[] = XBOX360PS5_PRODUCT_NAME;
+inline constexpr char kTitleId[] = XBOX360PS5_TITLE_ID;
+// The title's own folder on the internal disk: saves, logs, caches, network.conf and the rest.
+inline constexpr char kDataRoot[] = XBOX360PS5_DATA_ROOT;
+// The official PS5X360 (BrinooTk/PS5X360 v1.0.2) and its folder: read, never written.
+inline constexpr char kOfficialProductName[] = "PS5X360";
+inline constexpr char kOfficialTitleId[] = XBOX360PS5_OFFICIAL_TITLE_ID;
+inline constexpr char kOfficialDataRoot[] = "/data/homebrew/" XBOX360PS5_OFFICIAL_TITLE_ID;
+}  // namespace xbox360ps5::app_identity
