diff --git a/include/xbox360ps5/memexport_loss.hpp b/include/xbox360ps5/memexport_loss.hpp
new file mode 100644
--- /dev/null
+++ b/include/xbox360ps5/memexport_loss.hpp
@@ -0,0 +1,259 @@
+// SPDX-License-Identifier: MIT
+// Fix 48 of the source rebuild (tools/source-1.0.2/fixes/48-memexport-loss.patch): data a
+// vertex shader exports to memory (memexport) and that is not read back lives only in the GPU's
+// copy of guest memory. When the GPU's copy of that 4 KiB unit is later uploaded again from
+// guest memory (the CPU wrote elsewhere in the unit, or an unwatched unit's bytes changed), the
+// exported data is replaced by what guest memory holds: stale or never-written bytes. Call of
+// Duty: Black Ops skins its characters with such exports; without fix 30's readback of small
+// exports the official 1.0.2 drew their skin black and patterned (issue #10), and the hair,
+// wrong in every build, is drawn from exports this records too.
+//
+// The shared memory keeps a bit per unit for "holds exported data guest memory lacks" and one
+// for "such data was lost here". An upload over a unit of the first kind is a loss; the unit is
+// then marked, and every later export into a marked unit is read back like a small one (learned
+// readback), so guest memory has the data before the next upload. Counters and the first losses
+// go to the 30-second summary ("Memexport: ..."). Bit helpers and counters only, no Xenia
+// headers: tools/check-memexport-loss.cpp drives them.
+#pragma once
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <bit>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+#include <vector>
+
+namespace xbox360ps5 {
+namespace memexport_loss {
+
+// Why a draw's exports are read back.
+enum class Reason : uint32_t { kNone = 0, kOption, kSmall, kLearned };
+inline const char* ReasonName(Reason reason) {
+  switch (reason) {
+    case Reason::kOption: return "read back (option)";
+    case Reason::kSmall: return "read back (small export)";
+    case Reason::kLearned: return "read back (exported data was lost here, or this shader's, before)";
+    default: return "not read back";
+  }
+}
+// The decision of fix 30 (option, or at most `small_limit` bytes), then the learned one.
+inline Reason Decide(bool option, uint64_t total_bytes, uint32_t small_limit, bool lossy) {
+  if (!total_bytes) return Reason::kNone;
+  if (option) return Reason::kOption;
+  if (small_limit != 0 && total_bytes <= small_limit) return Reason::kSmall;
+  if (lossy) return Reason::kLearned;
+  return Reason::kNone;
+}
+
+// Bits over a range of units [first, last] of a bitmap of 64-bit words (atomic operations: the
+// GPU thread writes them, a summary may read them).
+inline uint64_t WordMask(uint32_t word, uint32_t first, uint32_t last) {
+  uint64_t mask = UINT64_MAX;
+  if (word == first >> 6) mask &= ~((uint64_t(1) << (first & 63)) - 1);
+  if (word == last >> 6 && (last & 63) != 63) mask &= (uint64_t(1) << ((last & 63) + 1)) - 1;
+  return mask;
+}
+inline void SetUnits(std::vector<uint64_t>& bits, uint32_t first, uint32_t last) {
+  for (uint32_t word = first >> 6; word <= (last >> 6) && word < bits.size(); ++word)
+    __atomic_fetch_or(&bits[word], WordMask(word, first, last), __ATOMIC_RELAXED);
+}
+inline void ClearUnits(std::vector<uint64_t>& bits, uint32_t first, uint32_t last) {
+  for (uint32_t word = first >> 6; word <= (last >> 6) && word < bits.size(); ++word)
+    __atomic_fetch_and(&bits[word], ~WordMask(word, first, last), __ATOMIC_RELAXED);
+}
+inline bool AnyUnits(const std::vector<uint64_t>& bits, uint32_t first, uint32_t last) {
+  for (uint32_t word = first >> 6; word <= (last >> 6) && word < bits.size(); ++word)
+    if (__atomic_load_n(&bits[word], __ATOMIC_RELAXED) & WordMask(word, first, last)) return true;
+  return false;
+}
+
+// Counters since the start, read as differences by the summary.
+struct Counters {
+  std::atomic<uint64_t> draws{0}, bytes{0};
+  std::atomic<uint64_t> read_option{0}, read_small{0}, read_learned{0}, not_read{0};
+  std::atomic<uint64_t> bytes_not_read{0}, largest_not_read{0}, largest_not_read_vs{0};
+  std::atomic<uint64_t> lost_units{0}, lost_uploads{0}, learned_units{0};
+};
+inline Counters counters;
+
+// A draw's exports and what was decided for them.
+inline void NoteExport(uint64_t total_bytes, Reason reason, uint64_t vs_hash) {
+  counters.draws.fetch_add(1, std::memory_order_relaxed);
+  counters.bytes.fetch_add(total_bytes, std::memory_order_relaxed);
+  switch (reason) {
+    case Reason::kOption: counters.read_option.fetch_add(1, std::memory_order_relaxed); break;
+    case Reason::kSmall: counters.read_small.fetch_add(1, std::memory_order_relaxed); break;
+    case Reason::kLearned: counters.read_learned.fetch_add(1, std::memory_order_relaxed); break;
+    default: {
+      counters.not_read.fetch_add(1, std::memory_order_relaxed);
+      counters.bytes_not_read.fetch_add(total_bytes, std::memory_order_relaxed);
+      uint64_t largest = counters.largest_not_read.load(std::memory_order_relaxed);
+      while (total_bytes > largest &&
+             !counters.largest_not_read.compare_exchange_weak(largest, total_bytes, std::memory_order_relaxed)) {
+      }
+      if (total_bytes >= largest) counters.largest_not_read_vs.store(vs_hash, std::memory_order_relaxed);
+    }
+  }
+}
+
+// The first losses (address of the first unit and how many), for the summary to print.
+struct Loss {
+  uint32_t address = 0, units = 0;
+};
+inline constexpr size_t kLosses = 16;
+inline std::array<std::atomic<uint64_t>, kLosses> losses{};  // address << 32 | units, 0 = none
+inline std::atomic<uint32_t> losses_recorded{0};
+// Shaders learned, for the summary: hash and the address of the loss that taught it.
+inline std::array<std::atomic<uint64_t>, 8> shader_events{};
+inline std::array<std::atomic<uint32_t>, 8> shader_event_addresses{};
+inline std::atomic<uint32_t> shader_events_recorded{0};
+inline void RecordShader(uint64_t hash, uint32_t address) {
+  const uint32_t index = shader_events_recorded.fetch_add(1, std::memory_order_relaxed);
+  if (index >= shader_events.size()) return;
+  shader_event_addresses[index].store(address, std::memory_order_relaxed);
+  shader_events[index].store(hash, std::memory_order_release);
+}
+inline void RecordLoss(uint32_t address, uint32_t units) {
+  const uint32_t index = losses_recorded.fetch_add(1, std::memory_order_relaxed);
+  if (index < kLosses) losses[index].store((uint64_t(address) << 32) | units, std::memory_order_release);
+}
+
+// 1.0.4_candidate_7: exporting vertex shaders whose exported data was lost somewhere. Black Ops'
+// skinning exports move through a ring of tens of megabytes (candidate 5: every loss at a unit never
+// seen before, 87-114 exports a second still not read back, the hair wrong again outside the bar),
+// so learning by address never catches up; every export of a learned shader is read back.
+inline constexpr size_t kLearnedShaders = 32;
+inline std::array<std::atomic<uint64_t>, kLearnedShaders> learned_shaders{};
+inline std::atomic<uint32_t> learned_shader_count{0};
+inline bool ShaderLearned(uint64_t hash) {
+  if (!hash) return false;
+  const uint32_t known = std::min<uint32_t>(learned_shader_count.load(std::memory_order_acquire), uint32_t(kLearnedShaders));
+  for (uint32_t n = 0; n < known; ++n)
+    if (learned_shaders[n].load(std::memory_order_relaxed) == hash) return true;
+  return false;
+}
+// Returns true when `hash` is new to the list (GPU thread only writes it).
+inline bool LearnShader(uint64_t hash) {
+  if (!hash || ShaderLearned(hash)) return false;
+  const uint32_t index = learned_shader_count.load(std::memory_order_relaxed);
+  if (index >= kLearnedShaders) return false;
+  learned_shaders[index].store(hash, std::memory_order_relaxed);
+  learned_shader_count.store(index + 1, std::memory_order_release);
+  return true;
+}
+// The shader that last exported to each unit not read back (MarkGpuOnly), by unit.
+inline void SetExporter(std::vector<uint64_t>& exporters, uint32_t first, uint32_t last, uint64_t hash) {
+  for (uint32_t unit = first; unit <= last && unit < exporters.size(); ++unit) exporters[unit] = hash;
+}
+
+// An upload of units [first, first + count) over the GPU's copy: the units holding exported data
+// guest memory lacks lose it. They are marked lossy and no longer GPU-only, and the shaders that
+// exported to them (from `exporters`, when given) are learned. Returns the units lost.
+inline uint32_t NoteUpload(std::vector<uint64_t>& gpu_only, std::vector<uint64_t>& lossy, uint32_t first,
+                           uint32_t count, uint32_t unit_log2, const std::vector<uint64_t>* exporters = nullptr) {
+  if (!count) return 0;
+  const uint32_t last = first + count - 1;
+  uint32_t lost = 0, run_first = UINT32_MAX, run_units = 0, learned = 0;
+  for (uint32_t word = first >> 6; word <= (last >> 6) && word < gpu_only.size(); ++word) {
+    const uint64_t hit = __atomic_load_n(&gpu_only[word], __ATOMIC_RELAXED) & WordMask(word, first, last);
+    if (!hit) continue;
+    __atomic_fetch_and(&gpu_only[word], ~hit, __ATOMIC_RELAXED);
+    const uint64_t was = __atomic_fetch_or(&lossy[word], hit, __ATOMIC_RELAXED);
+    learned += uint32_t(std::popcount(hit & ~was));
+    lost += uint32_t(std::popcount(hit));
+    if (exporters) {
+      for (uint64_t bits = hit; bits; bits &= bits - 1) {
+        const uint32_t unit = word * 64 + uint32_t(std::countr_zero(bits));
+        if (unit < exporters->size() && LearnShader((*exporters)[unit])) RecordShader((*exporters)[unit], unit << unit_log2);
+      }
+    }
+    if (run_first == UINT32_MAX) run_first = word * 64 + uint32_t(std::countr_zero(hit));
+    run_units += uint32_t(std::popcount(hit));
+  }
+  if (lost) {
+    counters.lost_units.fetch_add(lost, std::memory_order_relaxed);
+    counters.lost_uploads.fetch_add(1, std::memory_order_relaxed);
+    counters.learned_units.fetch_add(learned, std::memory_order_relaxed);
+    RecordLoss(run_first << unit_log2, run_units);
+  }
+  return lost;
+}
+
+// The summary's lines for the time since the last call (none when nothing was exported).
+class Reporter {
+ public:
+  std::vector<std::string> Lines(double seconds) {
+    std::vector<std::string> lines;
+    const uint64_t draws = counters.draws.load(), bytes = counters.bytes.load();
+    const uint64_t option = counters.read_option.load(), small = counters.read_small.load(),
+                   learned = counters.read_learned.load(), not_read = counters.not_read.load();
+    const uint64_t not_read_bytes = counters.bytes_not_read.load(), lost = counters.lost_units.load(),
+                   lost_uploads = counters.lost_uploads.load(), learned_units = counters.learned_units.load();
+    if (draws != draws_ || lost != lost_) {
+      char text[400];
+      const double s = seconds > 0 ? seconds : 1;
+      std::snprintf(text, sizeof(text),
+                    "Memexport: %.1f exporting draws/s (%.0f KiB/s); read back %.1f/s small, %.1f/s learned, %.1f/s option; "
+                    "%.1f/s not read back (%.0f KiB/s, largest %llu bytes, shader %016llX); %llu units of exported data lost "
+                    "to uploads (%llu uploads), %llu units newly learned (%llu in all)",
+                    double(draws - draws_) / s, double(bytes - bytes_) / 1024 / s, double(small - small_) / s,
+                    double(learned - learned_) / s, double(option - option_) / s, double(not_read - not_read_) / s,
+                    double(not_read_bytes - not_read_bytes_) / 1024 / s,
+                    (unsigned long long)counters.largest_not_read.exchange(0),
+                    (unsigned long long)counters.largest_not_read_vs.load(), (unsigned long long)(lost - lost_),
+                    (unsigned long long)(lost_uploads - lost_uploads_), (unsigned long long)(learned_units - learned_units_),
+                    (unsigned long long)learned_units);
+      lines.push_back(text);
+    }
+    const uint32_t recorded = std::min<uint32_t>(losses_recorded.load(), uint32_t(kLosses));
+    for (uint32_t n = losses_shown_; n < recorded; ++n) {
+      const uint64_t loss = losses[n].load(std::memory_order_acquire);
+      if (!loss) break;
+      char text[160];
+      std::snprintf(text, sizeof(text),
+                    "Memexport: exported data lost at physical %08X (%u units of 4 KiB uploaded again from guest memory); "
+                    "exports there are read back from now on",
+                    uint32_t(loss >> 32), uint32_t(loss));
+      lines.push_back(text);
+      losses_shown_ = n + 1;
+    }
+    const uint32_t shaders = std::min<uint32_t>(shader_events_recorded.load(), uint32_t(shader_events.size()));
+    for (uint32_t n = shaders_shown_; n < shaders; ++n) {
+      const uint64_t hash = shader_events[n].load(std::memory_order_acquire);
+      if (!hash) break;
+      char text[200];
+      std::snprintf(text, sizeof(text),
+                    "Memexport: shader %016llX learned (its exported data was lost at physical %08X): every export "
+                    "it makes is read back from now on",
+                    (unsigned long long)hash, shader_event_addresses[n].load(std::memory_order_relaxed));
+      lines.push_back(text);
+      shaders_shown_ = n + 1;
+    }
+    draws_ = draws; bytes_ = bytes; option_ = option; small_ = small; learned_ = learned; not_read_ = not_read;
+    not_read_bytes_ = not_read_bytes; lost_ = lost; lost_uploads_ = lost_uploads; learned_units_ = learned_units;
+    return lines;
+  }
+
+ private:
+  uint64_t draws_ = 0, bytes_ = 0, option_ = 0, small_ = 0, learned_ = 0, not_read_ = 0, not_read_bytes_ = 0;
+  uint64_t lost_ = 0, lost_uploads_ = 0, learned_units_ = 0;
+  uint32_t losses_shown_ = 0, shaders_shown_ = 0;
+};
+
+// Exporting vertex shaders seen, logged once each (the first 32) with their decision.
+inline bool FirstSighting(uint64_t vs_hash, Reason reason) {
+  static std::array<std::atomic<uint64_t>, 64> seen{};
+  static std::atomic<uint32_t> count{0};
+  const uint64_t key = vs_hash ^ (uint64_t(reason) << 60);
+  const uint32_t known = std::min<uint32_t>(count.load(std::memory_order_acquire), uint32_t(seen.size()));
+  for (uint32_t n = 0; n < known; ++n)
+    if (seen[n].load(std::memory_order_relaxed) == key) return false;
+  const uint32_t index = count.fetch_add(1, std::memory_order_acq_rel);
+  if (index >= 32) return false;
+  seen[index].store(key, std::memory_order_relaxed);
+  return true;
+}
+
+}  // namespace memexport_loss
+}  // namespace xbox360ps5
