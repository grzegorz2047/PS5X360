diff --git a/port/guide_network.hpp b/port/guide_network.hpp
new file mode 100644
index 0000000..bb98a33
--- /dev/null
+++ b/port/guide_network.hpp
@@ -0,0 +1,175 @@
+// SPDX-License-Identifier: MIT
+// Fix 22 of the source rebuild (tools/source-1.0.2/fixes): the network mode changed from the
+// guide while a game runs, so a game that asks for an Xbox Live sign-in (Black Ops III) can
+// be given one without starting the emulator again.
+//
+// The guide's "Rede" row cycles Offline, System Link, Online. A change runs on a thread of its
+// own (reaching the Xenia server can take up to 20 s):
+//   - Online: the server from network.conf (as ApplyNetworkConf at start), libcurl's set-up;
+//   - XLiveAPI::SelectNetworkMode, the netplay core's own live switch (the desktop build's
+//     network dialog): the server asked for this console's address, or the local network's
+//     heartbeat, and the Live connection and link-state notifications broadcast;
+//   - Online: each signed-in profile that is not Live-enabled converted as at sign-in
+//     (ProfileManager::ConvertToXboxLiveEnabledProfile signs it out and in again, with the
+//     sign-in notifications), and the first player registered on the server;
+//   - a sign-in change notification, so the game reads its players' sign-in state again (it
+//     follows network_mode: Live only in the Online mode);
+//   - network.conf's mode, so the home's Online channel and the next start agree.
+// UPnP stays as the emulator started (the router's ports are opened only at start).
+#pragma once
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <ctime>
+#include <fstream>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+#include "third_party/libcurl/include/curl/curl.h"
+#include "xenia/base/cvar.h"
+#include "xenia/base/logging.h"
+#include "xenia/emulator.h"
+#include "xenia/kernel/XLiveAPI.h"
+#include "xenia/kernel/kernel_state.h"
+#include "xenia/kernel/xam/profile_manager.h"
+#include "xenia/kernel/xam/user_profile.h"
+#include "xenia/kernel/xam/xam_state.h"
+#include "xenia/xbox.h"
+#include "network_switch.hpp"
+
+DECLARE_int32(network_mode);
+DECLARE_string(api_address);
+
+namespace xbox360ps5 {
+// launcher.cpp: writes network.conf's mode as the home's Online channel does, and has that
+// channel read it again.
+bool LauncherSetNetworkMode(const std::string& mode);
+
+namespace guide_network {
+// The modes in the guide's order, as cvars::network_mode counts them.
+using network_switch::kModeNames;
+inline const char* const kModeLabels[] = {"Desligada", "System Link", "Online"};  // Tr() keys.
+
+inline network_switch::Queue& SwitchQueue() {
+  static network_switch::Queue queue;
+  return queue;
+}
+// How the last switch ended (network_switch::Outcome), shown until the next one.
+inline std::atomic<int>& LastOutcome() {
+  static std::atomic<int> outcome{int(network_switch::Outcome::kNone)};
+  return outcome;
+}
+inline bool Busy() { return SwitchQueue().Busy(); }
+
+// The mode a press moves on from: the one being switched to, or the mode in effect.
+inline int Shown() {
+  return Busy() ? SwitchQueue().Target() : network_switch::ClampMode(int(cvars::network_mode));
+}
+// The row's value, a Tr() key: the mode being switched to (the caller adds " ..."), how the
+// last switch ended, or the mode in effect.
+inline const char* RowKey() {
+  if (Busy()) return kModeLabels[SwitchQueue().Target()];
+  const auto outcome = network_switch::Outcome(LastOutcome().load());
+  if (outcome != network_switch::Outcome::kNone) return network_switch::OutcomeLabel(outcome);
+  return kModeLabels[network_switch::ClampMode(int(cvars::network_mode))];
+}
+
+// The Xenia server: network.conf's server= line, else the public server (as ApplyNetworkConf).
+// Not the core's default 192.168.0.1:36000, an address on no one's network, where a System
+// Link heartbeat waited for the system's connection time-out (more than a minute on the PS5).
+inline std::string ConfiguredServer() {
+  std::string server;
+  std::ifstream conf("/data/homebrew/PPSA50011/network.conf");
+  for (std::string line; std::getline(conf, line);) {
+    while (!line.empty() && (line.back() == '\r' || line.back() == ' ')) line.pop_back();
+    if (line.rfind("server=", 0) == 0) server = line.substr(7);
+  }
+  return server.empty() ? "https://xenia-netplay-2a0298c0e3f4.herokuapp.com/" : server;
+}
+
+// Waits for the switches (up to `limit`): the emulator they use must outlive them.
+inline void WaitIdle(std::chrono::seconds limit) {
+  const auto until = std::chrono::steady_clock::now() + limit;
+  while (Busy() && std::chrono::steady_clock::now() < until)
+    std::this_thread::sleep_for(std::chrono::milliseconds(20));
+}
+
+inline std::string UtcNow() {
+  const std::time_t now = std::time(nullptr);
+  std::tm parts{};
+  gmtime_r(&now, &parts);
+  char text[16];
+  std::snprintf(text, sizeof(text), "%02d:%02d:%02d", parts.tm_hour, parts.tm_min, parts.tm_sec);
+  return text;
+}
+inline long long MillisecondsSince(std::chrono::steady_clock::time_point start) {
+  return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - start).count();
+}
+
+// The emulator's side of network_switch::Run.
+struct EmulatorBackend {
+  xe::Emulator* emulator;
+  xe::kernel::KernelState* kernel() { return emulator->kernel_state(); }
+  xe::kernel::xam::ProfileManager* profiles() { return kernel()->xam_state()->profile_manager(); }
+
+  int Mode() { return int(cvars::network_mode); }
+  void PrepareServer() {
+    cvars::api_address = ConfiguredServer();
+    // Reference-counted: only the first call does the set-up.
+    curl_global_init(CURL_GLOBAL_DEFAULT);
+  }
+  bool Select(int mode) {
+    const auto start = std::chrono::steady_clock::now();
+    const bool selected = emulator->GetXboxLiveAPI()->SelectNetworkMode(uint32_t(mode));
+    XELOGW("Network: XLiveAPI::SelectNetworkMode({}) {} in {} ms (server {})", kModeNames[mode],
+           selected ? "reached the mode" : "did not reach it", MillisecondsSince(start), cvars::api_address);
+    return selected;
+  }
+  std::vector<network_switch::Player> Players() {
+    std::vector<network_switch::Player> players;
+    for (uint8_t slot = 0; slot < 4; ++slot) {
+      auto* profile = kernel()->xam_state()->GetUserProfile(uint32_t(slot));
+      if (profile) players.push_back({slot, profile->xuid(), profile->IsLiveEnabled(), profile->name()});
+    }
+    return players;
+  }
+  bool Convert(uint64_t xuid) { return profiles()->ConvertToXboxLiveEnabledProfile(xuid); }
+  bool Connected() { return emulator->GetXboxLiveAPI()->IsConnectedToServer(); }
+  void Register(uint64_t xuid) { emulator->GetXboxLiveAPI()->RegisterPlayer(xuid); }
+  uint32_t UsedSlots() { return uint32_t(profiles()->GetUsedUserSlots().to_ulong()); }
+  void Broadcast(uint32_t id, uint32_t data) { kernel()->BroadcastNotification(id, data); }
+  bool Save(const char* mode) { return LauncherSetNetworkMode(mode); }
+};
+
+// A press asking for `mode` (0 offline, 1 System Link, 2 online). Never waits: while a switch
+// runs, the mode is only remembered and runs when that switch ends.
+inline void Switch(xe::Emulator* emulator, int mode, const std::string& title) {
+  if (mode < 0 || mode > 2) return;
+  if (!SwitchQueue().Ask(mode)) {
+    XELOGW("Network: {} asked at {} UTC while a switch runs; it follows", kModeNames[mode], UtcNow());
+    return;
+  }
+  std::thread([emulator, mode, title] {
+    EmulatorBackend backend{emulator};
+    auto start = std::chrono::steady_clock::now();
+    network_switch::Drain(
+        backend, SwitchQueue(), mode,
+        [&](int asked) {
+          start = std::chrono::steady_clock::now();
+          XELOGW("Network: switching to {} while running {} (at {} UTC, from {})", kModeNames[asked], title,
+                 UtcNow(), kModeNames[network_switch::ClampMode(int(cvars::network_mode))]);
+        },
+        [&](const network_switch::Result& result) {
+          LastOutcome().store(int(network_switch::OutcomeOf(result)));
+          XELOGW("Network: switched to {} while running {} in {} ms (asked for {}, was {}{}{}{}){}",
+                 kModeNames[result.now], title, MillisecondsSince(start), kModeNames[result.asked],
+                 kModeNames[result.from], result.selected ? "" : "; the Xenia server was not reached",
+                 result.profiles.empty() ? "" : "; ", result.profiles,
+                 result.saved ? "" : "; network.conf not written");
+        });
+  }).detach();
+}
+}  // namespace guide_network
+}  // namespace xbox360ps5
diff --git a/port/network_switch.hpp b/port/network_switch.hpp
new file mode 100644
index 0000000..899ea0a
--- /dev/null
+++ b/port/network_switch.hpp
@@ -0,0 +1,159 @@
+// SPDX-License-Identifier: MIT
+// Fix 22 of the source rebuild (tools/source-1.0.2/fixes/22-guide-network-mode.patch): the
+// network mode changed while a game runs, as a template over the emulator operations it
+// needs, so the host check tools/check-guide-network.cpp drives the same code with a fake
+// emulator (guide_network.hpp is the emulator's side). No Xenia headers here.
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace xbox360ps5 {
+namespace network_switch {
+// cvars::network_mode: 0 offline, 1 System Link, 2 Xbox Live (online).
+inline const char* const kModeNames[] = {"offline", "systemlink", "online"};
+// Notification ids (xenia/xbox.h).
+constexpr uint32_t kSignInChanged = 0x0000000A;          // XN_SYS_SIGNINCHANGED
+constexpr uint32_t kLiveConnectionChanged = 0x02000001;  // XN_LIVE_CONNECTIONCHANGED
+constexpr uint32_t kLiveLinkStateChanged = 0x02000003;   // XN_LIVE_LINK_STATE_CHANGED
+
+// A signed-in player is signed in to Xbox Live only with a Live-enabled profile in the online
+// mode (UserProfile::signin_state uses this).
+inline bool SignedInToLive(bool live_enabled, int network_mode) {
+  return live_enabled && network_mode == 2;
+}
+
+inline int ClampMode(int mode) { return std::clamp(mode, 0, 2); }
+
+struct Player {
+  uint8_t slot = 0;
+  uint64_t xuid = 0;
+  bool live_enabled = false;
+  std::string name;
+};
+
+struct Result {
+  int asked = 0, from = 0, now = 0;
+  bool selected = false;   // the core reached the mode asked for
+  bool saved = false;      // network.conf written
+  std::string profiles;    // what the conversion did, for the log line
+};
+
+// Backend:
+//   int Mode();                        cvars::network_mode
+//   void PrepareServer();              the server from network.conf (else the public one) and
+//                                      libcurl's set-up, for System Link and online
+//   bool Select(int mode);             XLiveAPI::SelectNetworkMode: the mode, the server, the
+//                                      Live connection and link-state notifications
+//   std::vector<Player> Players();     the signed-in profiles
+//   bool Convert(uint64_t xuid);       ProfileManager::ConvertToXboxLiveEnabledProfile (signs
+//                                      the profile out and in again, with notifications)
+//   bool Connected();                  XLiveAPI::IsConnectedToServer
+//   void Register(uint64_t xuid);      XLiveAPI::RegisterPlayer
+//   uint32_t UsedSlots();              ProfileManager::GetUsedUserSlots
+//   void Broadcast(uint32_t id, uint32_t data);
+//   bool Save(const char* mode);       network.conf's mode, read again by the home's channel
+template <typename B>
+Result Run(B& backend, int mode) {
+  Result result;
+  result.asked = ClampMode(mode);
+  result.from = ClampMode(backend.Mode());
+  // System Link's heartbeat and the online mode both talk to the Xenia server.
+  if (result.asked != 0) backend.PrepareServer();
+  result.selected = backend.Select(result.asked);
+  result.now = ClampMode(backend.Mode());
+  if (result.now == 2) {
+    // Each signed-in profile that is not Live-enabled converted as at sign-in.
+    bool first_converted = false;
+    for (const Player& player : backend.Players()) {
+      if (player.live_enabled) continue;
+      const bool converted = backend.Convert(player.xuid);
+      first_converted = first_converted || player.slot == 0;
+      result.profiles += (result.profiles.empty() ? "" : ", ") + player.name +
+                         (converted ? " now uses Xbox Live" : " not converted");
+    }
+    // A converted profile registered itself as it signed in again; the first player is
+    // registered as XLiveAPI::Init does at start.
+    if (!first_converted && backend.Connected()) {
+      for (const Player& player : backend.Players())
+        if (player.slot == 0) backend.Register(player.xuid);
+    }
+  }
+  // The game reads its players' sign-in state again (it follows the mode).
+  backend.Broadcast(kSignInChanged, backend.UsedSlots());
+  result.saved = backend.Save(kModeNames[result.now]);
+  return result;
+}
+
+// What the guide's row says after a switch. Portuguese keys for Tr() (the built-in table has
+// their English and Spanish).
+enum class Outcome : uint8_t { kNone, kOffline, kSystemLink, kOnlineConnected, kOnlineNotReached };
+inline Outcome OutcomeOf(const Result& result) {
+  if (result.now == 2) return Outcome::kOnlineConnected;
+  if (result.now == 1) return result.asked == 2 ? Outcome::kOnlineNotReached : Outcome::kSystemLink;
+  return Outcome::kOffline;
+}
+inline const char* OutcomeLabel(Outcome outcome) {
+  switch (outcome) {
+    case Outcome::kOffline: return "Desligada";
+    case Outcome::kSystemLink: return "System Link";
+    case Outcome::kOnlineConnected: return "Online – conectado";
+    case Outcome::kOnlineNotReached: return "Online – servidor não alcançado";
+    default: return "";
+  }
+}
+
+// The row never waits for a switch: a press while one runs only changes the mode wanted next,
+// and when the switch ends the last mode wanted runs (the ones pressed past are skipped; none
+// runs when the last one is the mode just reached).
+class Queue {
+ public:
+  // A press asking for `mode`. True: nothing was running, the caller starts a worker for it.
+  bool Ask(int mode) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (running_ < 0) {
+      running_ = mode;
+      return true;
+    }
+    wanted_ = mode;
+    return false;
+  }
+  // The worker finished `running_`, which ended in `reached`. The next mode to run, or -1
+  // (then the worker ends and the row is free).
+  int Finished(int reached) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    const int next = wanted_ >= 0 && wanted_ != reached ? wanted_ : -1;
+    wanted_ = -1;
+    running_ = next;
+    return next;
+  }
+  bool Busy() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return running_ >= 0;
+  }
+  // The mode the row shows while busy: the last one asked for.
+  int Target() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return wanted_ >= 0 ? wanted_ : running_;
+  }
+
+ private:
+  mutable std::mutex mutex_;
+  int running_ = -1, wanted_ = -1;
+};
+
+// The worker: runs the asked mode and then whatever was asked meanwhile. `start` sees each mode
+// before it runs, `done` each result (logging, the row's outcome).
+template <typename B, typename Start, typename Done>
+void Drain(B& backend, Queue& queue, int first, Start start, Done done) {
+  for (int mode = first; mode >= 0;) {
+    start(mode);
+    const Result result = Run(backend, mode);
+    done(result);
+    mode = queue.Finished(result.now);
+  }
+}
+}  // namespace network_switch
+}  // namespace xbox360ps5
