+// SPDX-License-Identifier: MIT
+// Fix 22 of the source rebuild (tools/source-1.0.2/fixes): the network mode changed from the
+// guide while a game runs, so a game that asks for an Xbox Live sign-in (Black Ops III) can
+// be given one without starting the emulator again.
+//
+// The guide's "Rede" row cycles Offline, System Link, Online. A change runs on a thread of its
+// own (reaching the Xenia server can take up to 20 s):
+//   - Online: the server from network.conf (as ApplyNetworkConf at start), libcurl's set-up;
+//   - XLiveAPI::SelectNetworkMode, the netplay core's own live switch (the desktop build's
+//     network dialog): the server asked for this console's address, or the local network's
+//     heartbeat, and the Live connection and link-state notifications broadcast;
+//   - Online: each signed-in profile that is not Live-enabled converted as at sign-in
+//     (ProfileManager::ConvertToXboxLiveEnabledProfile signs it out and in again, with the
+//     sign-in notifications), and the first player registered on the server;
+//   - a sign-in change notification, so the game reads its players' sign-in state again (it
+//     follows network_mode: Live only in the Online mode);
+//   - network.conf's mode, so the home's Online channel and the next start agree.
+// UPnP stays as the emulator started (the router's ports are opened only at start).
+#pragma once
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <fstream>
+#include <mutex>
+#include <string>
+#include <thread>
+#include "third_party/libcurl/include/curl/curl.h"
+#include "xenia/base/cvar.h"
+#include "xenia/base/logging.h"
+#include "xenia/emulator.h"
+#include "xenia/kernel/XLiveAPI.h"
+#include "xenia/kernel/kernel_state.h"
+#include "xenia/kernel/xam/profile_manager.h"
+#include "xenia/kernel/xam/user_profile.h"
+#include "xenia/kernel/xam/xam_state.h"
+#include "xenia/xbox.h"
+
+DECLARE_int32(network_mode);
+DECLARE_string(api_address);
+
+namespace xbox360ps5 {
+// launcher.cpp: writes network.conf's mode as the home's Online channel does, and has that
+// channel read it again.
+bool LauncherSetNetworkMode(const std::string& mode);
+
+namespace guide_network {
+// The modes in the guide's order, as cvars::network_mode counts them.
+inline const char* const kModeNames[] = {"offline", "systemlink", "online"};
+inline const char* const kModeLabels[] = {"Desligada", "System Link", "Online"};  // Tr() keys.
+
+// The mode being switched to, or -1 when no switch is running.
+inline std::atomic<int>& Pending() {
+  static std::atomic<int> pending{-1};
+  return pending;
+}
+
+// What the guide shows: the mode in effect, or the one being switched to.
+inline int Shown() {
+  const int pending = Pending().load();
+  if (pending >= 0) return pending;
+  return std::clamp(int(cvars::network_mode), 0, 2);
+}
+
+// network.conf's server, as ApplyNetworkConf reads it (the public server when left out).
+inline std::string ConfiguredServer() {
+  std::string server;
+  std::ifstream conf("/data/homebrew/PPSA50011/network.conf");
+  for (std::string line; std::getline(conf, line);) {
+    while (!line.empty() && (line.back() == '\r' || line.back() == ' ')) line.pop_back();
+    if (line.rfind("server=", 0) == 0) server = line.substr(7);
+  }
+  return server.empty() ? "https://xenia-netplay-2a0298c0e3f4.herokuapp.com/" : server;
+}
+
+// Waits for a running switch (up to `limit`): the emulator it uses must outlive it.
+inline void WaitIdle(std::chrono::seconds limit) {
+  const auto until = std::chrono::steady_clock::now() + limit;
+  while (Pending().load() >= 0 && std::chrono::steady_clock::now() < until)
+    std::this_thread::sleep_for(std::chrono::milliseconds(20));
+}
+
+// Starts a switch to `mode` (0 offline, 1 System Link, 2 online). False while one is running.
+inline bool Switch(xe::Emulator* emulator, int mode, const std::string& title) {
+  int idle = -1;
+  if (mode < 0 || mode > 2 || !Pending().compare_exchange_strong(idle, mode)) return false;
+  const int from = std::clamp(int(cvars::network_mode), 0, 2);
+  std::thread([emulator, mode, from, title] {
+    auto* kernel = emulator->kernel_state();
+    auto* live = emulator->GetXboxLiveAPI();
+    if (mode == 2) {
+      cvars::api_address = ConfiguredServer();
+      // Reference-counted: only the first call does the set-up (done at start when online).
+      curl_global_init(CURL_GLOBAL_DEFAULT);
+    }
+    const bool selected = live->SelectNetworkMode(uint32_t(mode));
+    const int now = std::clamp(int(cvars::network_mode), 0, 2);
+    std::string profiles;
+    if (now == 2) {
+      auto* manager = kernel->xam_state()->profile_manager();
+      bool slot0_converted = false;
+      for (uint8_t slot = 0; slot < 4; ++slot) {
+        auto* profile = kernel->xam_state()->GetUserProfile(uint32_t(slot));
+        if (!profile || profile->IsLiveEnabled()) continue;
+        const uint64_t xuid = profile->xuid();
+        const std::string name = profile->name();
+        // Signs the profile out and in again (the profile object is replaced).
+        const bool converted = manager->ConvertToXboxLiveEnabledProfile(xuid);
+        slot0_converted = slot0_converted || slot == 0;
+        profiles += (profiles.empty() ? "" : ", ") + name + (converted ? " now uses Xbox Live" : " not converted");
+      }
+      // A converted profile registered itself as it signed in again.
+      if (!slot0_converted && live->IsConnectedToServer()) {
+        if (auto* first = kernel->xam_state()->GetUserProfile(uint32_t(0))) live->RegisterPlayer(first->xuid());
+      }
+    }
+    kernel->BroadcastNotification(xe::kXNotificationSystemSignInChanged,
+                                  uint32_t(kernel->xam_state()->profile_manager()->GetUsedUserSlots().to_ulong()));
+    const bool saved = LauncherSetNetworkMode(kModeNames[now]);
+    XELOGW("Network: switched to {} while running {} (asked for {}, was {}{}{}{}){}", kModeNames[now], title,
+           kModeNames[mode], kModeNames[from], selected ? "" : "; the Xenia server was not reached",
+           profiles.empty() ? "" : "; ", profiles, saved ? "" : "; network.conf not written");
+    Pending().store(-1);
+  }).detach();
+  return true;
+}
+}  // namespace guide_network
+}  // namespace xbox360ps5
