+// Fix 22: the guide over a running game changed the network mode. network.conf's mode as the
+// home's Online channel writes it, and that channel reads it again.
+bool LauncherSetNetworkMode(const std::string& mode) {
+  const bool saved = KinectSetNetMode(mode);
+  ++KinectNetRevisionRef();
+  return saved;
+}
