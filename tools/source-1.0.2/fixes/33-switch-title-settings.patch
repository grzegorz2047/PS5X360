+// SPDX-License-Identifier: MIT
+// Fix 33: a title switch keeps the game's own options.
+//
+// A game that starts another executable (a collection's menu: The Orange Box, State of Decay's
+// launcher) or goes back to the dashboard calls XamLoaderLaunchTitle; the core saves what to run
+// next in launch_data.bin (XamModule::SaveLoaderData: a uint16 length and the next game's host
+// path first) and the title restarts (XamModule::restart_hook). 1.0.2's next start read only
+// launch-once.txt for the game's id, so it started with the general options; the switch branch
+// then took the id with ReadXexTitleId, which is empty for an ISO or a package, and left out the
+// FSI and start-option restarts, so The Orange Box lost readback=2 and State of Decay zero_page=1.
+// Now the start reads the next game from launch_data.bin (without consuming it: the core does,
+// later) and uses its id as launch-once.txt's; a switched start may still restart into options
+// read only at start (FSI), once per title, with launch_data.bin written back byte for byte.
+#ifndef XBOX360PS5_SWITCH_TITLE_HPP_
+#define XBOX360PS5_SWITCH_TITLE_HPP_
+
+#include <algorithm>
+#include <cctype>
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <string>
+#include <system_error>
+
+namespace xbox360ps5::switch_title {
+
+// launch_data.bin as the core left it for this start.
+struct Pending {
+  std::string bytes;      // the whole file, to write back for a restart
+  std::string host_path;  // the next game's file (an .xex, an .iso or a package)
+};
+
+inline Pending ReadPending(const std::filesystem::path& file) {
+  Pending pending;
+  std::ifstream in(file, std::ios::binary);
+  if (!in) return pending;
+  pending.bytes.assign(std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>());
+  if (pending.bytes.size() < 2) return pending;
+  const auto* b = reinterpret_cast<const unsigned char*>(pending.bytes.data());
+  const size_t length = size_t(b[0]) | (size_t(b[1]) << 8);  // written little-endian by the core
+  if (length == 0 || pending.bytes.size() < 2 + length) return pending;
+  pending.host_path = pending.bytes.substr(2, length);
+  return pending;
+}
+
+// Writes launch_data.bin back as it was, so the restart is still the switch.
+inline bool RestorePending(const std::filesystem::path& file, const Pending& pending) {
+  if (pending.bytes.empty()) return false;
+  std::ofstream out(file, std::ios::binary | std::ios::trunc);
+  out.write(pending.bytes.data(), std::streamsize(pending.bytes.size()));
+  return bool(out);
+}
+
+enum class Kind { xex, iso, package };
+
+inline Kind KindOf(const std::filesystem::path& path) {
+  std::string extension = path.extension().string();
+  for (char& c : extension) c = char(std::tolower(static_cast<unsigned char>(c)));
+  if (extension == ".xex") return Kind::xex;
+  if (extension == ".iso") return Kind::iso;
+  return Kind::package;  // GOD and STFS packages have no extension of their own
+}
+
+// The game's title id by the reader its kind needs (as the dashboard's library list does).
+template <typename Xex, typename Iso, typename Package>
+std::string TitleIdOf(const std::filesystem::path& path, Xex&& xex, Iso&& iso, Package&& package) {
+  if (path.empty()) return {};
+  switch (KindOf(path)) {
+    case Kind::xex: return xex(path);
+    case Kind::iso: return iso(path);
+    default: return package(path);
+  }
+}
+
+// The title a switched start last restarted into its own options (read once, then removed).
+inline std::string TakeRestartGuard(const std::filesystem::path& file) {
+  std::string title;
+  {
+    std::ifstream in(file);
+    std::getline(in, title);
+  }
+  std::error_code error;
+  std::filesystem::remove(file, error);
+  return title;
+}
+
+inline bool SetRestartGuard(const std::filesystem::path& file, const std::string& title) {
+  std::ofstream out(file, std::ios::trunc);
+  out << title << "\n";
+  return bool(out);
+}
+
+// A start that differs from the game's options restarts into them: a start the user made
+// always (launch-once.txt), a switched one once per title (a title whose options still differ
+// after its restart does not loop) and never for a game whose id is unknown.
+inline bool MayRestart(bool switched, const std::string& guard, const std::string& title) {
+  if (!switched) return true;
+  return !title.empty() && guard != title;
+}
+
+}  // namespace xbox360ps5::switch_title
+
+#endif  // XBOX360PS5_SWITCH_TITLE_HPP_
