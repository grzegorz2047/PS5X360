+// Xbox360PS5 (fix 26): a guest path that failed, reported once per distinct name
+// (util::GuestPathFailures): the raw bytes the game passed, what they became, and the game's
+// return address with two callers above it (saved LR words along the stack's back chain).
+static void ReportGuestPath(const char* call, X_STATUS status, uint32_t root,
+                            const X_ANSI_STRING* name,
+                            const std::string& path) {
+  const std::string_view raw = util::TranslateAnsiString(kernel_memory(), name);
+  uint32_t callers[3] = {};
+  if (auto* thread_state = cpu::ThreadState::Get()) {
+    const auto* context = thread_state->context();
+    callers[0] = uint32_t(context->lr);
+    uint32_t sp = uint32_t(context->r[1]);
+    for (int i = 1; i < 3 && sp; ++i) {
+      const uint32_t back = xe::load_and_swap<uint32_t>(
+          kernel_memory()->TranslateVirtual(sp));
+      if (back <= sp || back - sp > 0x100000) break;
+      callers[i] = xe::load_and_swap<uint32_t>(
+          kernel_memory()->TranslateVirtual(back - 8));
+      sp = back;
+    }
+  }
+  const std::string line = util::GuestPathFailures::Get().Report(
+      call, uint32_t(status), root, callers, raw, path);
+  if (!line.empty()) {
+    XELOGW("{}", line);
+  }
+}
