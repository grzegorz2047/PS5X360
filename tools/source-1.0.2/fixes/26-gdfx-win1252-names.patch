diff --git a/.deps/xenia-canary/src/xenia/kernel/xam/call_trace.h b/.deps/xenia-canary/src/xenia/kernel/xam/call_trace.h
new file mode 100644
index 0000000..3991631
--- /dev/null
+++ b/.deps/xenia-canary/src/xenia/kernel/xam/call_trace.h
@@ -0,0 +1,144 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+#ifndef XENIA_KERNEL_XAM_CALL_TRACE_H_
+#define XENIA_KERNEL_XAM_CALL_TRACE_H_
+
+// Xbox360PS5 (fix 26, diagnostic for Handball 16, 573607E4): after the storage prompt the game
+// shows its screen at 60 frames a second and ignores START. What the game asks of input,
+// sign-in, content and notifications is logged here, each call and argument (the "key") when
+// its answer first appears and whenever it changes, not on every poll: "Calls: <call>[<key>]
+// <answer> (+<ms> after the storage prompt)". Lines are capped per key and in all. The storage
+// prompt's answer sets the time; canary_game_main.cpp dumps the threads at +20 s and +45 s.
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <map>
+#include <mutex>
+#include <string>
+#include <string_view>
+#include <utility>
+
+namespace xe {
+namespace kernel {
+namespace xam {
+namespace call_trace {
+
+inline uint64_t NowMs() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count());
+}
+
+// When the storage prompt was last answered (NowMs), 0 before.
+inline std::atomic<uint64_t>& PromptMs() {
+  static std::atomic<uint64_t> at{0};
+  return at;
+}
+inline void MarkPrompt(uint64_t now = NowMs()) { PromptMs().store(now ? now : 1); }
+
+// "(+1234 ms after the storage prompt)", or "(before the storage prompt)".
+inline std::string When(uint64_t now, uint64_t prompt) {
+  if (!prompt) return "(before the storage prompt)";
+  char text[64];
+  std::snprintf(text, sizeof(text), "(+%llu ms after the storage prompt)",
+                static_cast<unsigned long long>(now >= prompt ? now - prompt : 0));
+  return text;
+}
+
+class Changes {
+ public:
+  static constexpr uint32_t kPerKey = 24;   // lines for one call and key
+  static constexpr uint32_t kTotal = 600;   // lines in all
+
+  explicit Changes(uint32_t per_key = kPerKey, uint32_t total = kTotal)
+      : per_key_(per_key), total_cap_(total) {}
+
+  static Changes& Get() {
+    static Changes changes;
+    return changes;
+  }
+
+  // The line to log for this answer, or "" when it is the same as the key's last one, or the
+  // key or the whole trace has used its lines (the first line past a key's cap says so).
+  std::string Note(std::string_view call, uint32_t key, std::string_view answer,
+                   uint64_t now = NowMs()) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto& entry = last_[{std::string(call), key}];
+    if (entry.seen && entry.answer == answer) return {};
+    entry.seen = true;
+    entry.answer = std::string(answer);
+    if (total_ >= total_cap_) return {};
+    if (entry.lines >= per_key_) return {};
+    ++total_;
+    ++entry.lines;
+    char head[96];
+    std::snprintf(head, sizeof(head), "Calls: %.*s[%08X] ", int(call.size()), call.data(), key);
+    std::string line = head;
+    line += answer;
+    line += ' ';
+    line += When(now, PromptMs().load());
+    if (entry.lines == per_key_) line += "; no more changes of this one are logged";
+    if (total_ == total_cap_) line += "; the trace has used its lines";
+    return line;
+  }
+
+ private:
+  const uint32_t per_key_, total_cap_;
+  struct Entry {
+    bool seen = false;
+    std::string answer;
+    uint32_t lines = 0;
+  };
+  std::mutex mutex_;
+  std::map<std::pair<std::string, uint32_t>, Entry> last_;
+  uint32_t total_ = 0;
+};
+
+// The minute after the storage prompt (candidate_20): the input and file calls are logged with
+// far more room there, so the presses after the prompt are not lost to the caps above.
+constexpr uint64_t kWindowMs = 60000;
+inline bool InWindow(uint64_t now = NowMs()) {
+  const uint64_t prompt = PromptMs().load();
+  return prompt && now >= prompt && now - prompt < kWindowMs;
+}
+inline Changes& AfterPrompt() {
+  static Changes changes(400, 3000);
+  return changes;
+}
+// The change log for a call made now: AfterPrompt() in the window, else Get().
+inline Changes& For(uint64_t now = NowMs()) {
+  return InWindow(now) ? AfterPrompt() : Changes::Get();
+}
+
+// The answer to XInputGetState as text: result, buttons (START 0010, BACK 0020, A 1000, ...),
+// and what could have blanked them: who held the system interface up (SystemUiFlag owners: 1 a
+// XAM dialog, 2 the guide), the controller keyboard.
+inline std::string InputAnswer(uint32_t result, uint16_t buttons, uint32_t ui_owners,
+                               bool keyboard_suppressed) {
+  static const char* const owners_text[] = {"", "XAM dialog", "guide", "XAM dialog and guide"};
+  char text[160];
+  char ui[96] = "";
+  if (ui_owners) {
+    std::snprintf(ui, sizeof(ui), ", system UI active (%s) (state discarded)",
+                  owners_text[ui_owners & 3u][0] ? owners_text[ui_owners & 3u] : "?");
+  }
+  std::snprintf(text, sizeof(text), "result %08X buttons %04X%s%s%s", result, buttons,
+                (buttons & 0x0010) ? " START" : "", ui,
+                keyboard_suppressed ? ", controller keyboard suppressing" : "");
+  return text;
+}
+
+}  // namespace call_trace
+}  // namespace xam
+}  // namespace kernel
+}  // namespace xe
+
+#endif  // XENIA_KERNEL_XAM_CALL_TRACE_H_
