+      callers[i] = xe::load_and_swap<uint32_t>(
+          kernel_memory()->TranslateVirtual(back - 8));
+      sp = back;
+    }
+  }
+  const std::string line = util::GuestPathFailures::Get().Report(
+      call, uint32_t(status), root, callers, raw, path);
+  if (!line.empty()) {
+    XELOGW("{}", line);
+  }
