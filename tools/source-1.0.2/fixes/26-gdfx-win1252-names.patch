diff --git a/.deps/xenia-canary/src/xenia/kernel/util/guest_path.h b/.deps/xenia-canary/src/xenia/kernel/util/guest_path.h
new file mode 100644
index 0000000..ffa1318
--- /dev/null
+++ b/.deps/xenia-canary/src/xenia/kernel/util/guest_path.h
@@ -0,0 +1,200 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+#ifndef XENIA_KERNEL_UTIL_GUEST_PATH_H_
+#define XENIA_KERNEL_UTIL_GUEST_PATH_H_
+
+// Xbox360PS5 (fix 26): guest paths. A game names files in Windows-1252, the code page of the
+// names on its disc; the devices hold those names as UTF-8 (xe::win1252_to_utf8), so a guest
+// path is converted the same way before it is resolved. Up to 1.0.2 a path was kept as its
+// raw bytes, and IsValidPath (a signed char compared with 31 and 127) refused any byte from
+// 0x80 up with OBJECT_NAME_INVALID before anything was logged. Here a converted path may hold
+// UTF-8, and every failed path is reported once with its raw bytes (Handball 16, 573607E4).
+
+#include <cstdint>
+#include <cstdio>
+#include <mutex>
+#include <string>
+#include <string_view>
+#include <unordered_set>
+
+#include "xenia/base/string.h"
+
+namespace xe {
+namespace kernel {
+namespace util {
+
+// The guest's Windows-1252 path as UTF-8, without the ASCII white space around it (as
+// string_util::trim removed it). Empty only when the guest's name is empty or white space.
+inline std::string GuestAnsiPathToUtf8(std::string_view raw) {
+  auto space = [](char c) {
+    return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f' ||
+           c == '\v';
+  };
+  size_t begin = 0, end = raw.size();
+  while (begin < end && space(raw[begin])) ++begin;
+  while (end > begin && space(raw[end - 1])) --end;
+  return xe::win1252_to_utf8(raw.substr(begin, end - begin));
+}
+
+// True when `s` is complete, shortest-form UTF-8 (what the UTF-8 path code needs not to throw).
+inline bool IsUtf8(std::string_view s) {
+  for (size_t i = 0; i < s.size();) {
+    const uint8_t lead = uint8_t(s[i]);
+    size_t length;
+    uint32_t cp;
+    if (lead < 0x80) {
+      ++i;
+      continue;
+    } else if (lead >= 0xC2 && lead <= 0xDF) {
+      length = 2, cp = lead & 0x1F;
+    } else if (lead >= 0xE0 && lead <= 0xEF) {
+      length = 3, cp = lead & 0x0F;
+    } else if (lead >= 0xF0 && lead <= 0xF4) {
+      length = 4, cp = lead & 0x07;
+    } else {
+      return false;
+    }
+    if (s.size() - i < length) return false;
+    for (size_t k = 1; k < length; ++k) {
+      const uint8_t trail = uint8_t(s[i + k]);
+      if ((trail & 0xC0) != 0x80) return false;
+      cp = (cp << 6) | (trail & 0x3F);
+    }
+    if ((length == 3 && (cp < 0x800 || (cp >= 0xD800 && cp <= 0xDFFF))) ||
+        (length == 4 && (cp < 0x10000 || cp > 0x10FFFF))) {
+      return false;
+    }
+    i += length;
+  }
+  return true;
+}
+
+// xfile.h IsValidPath: a converted guest path. Control characters (below 32, and 127) and
+// "+,<>|" are refused, '*' and '?' only in a pattern, '*' only before '.'. Characters from
+// U+0080 up are accepted as UTF-8 (1.0.2 refused every byte from 0x80 up).
+inline bool IsValidGuestPath(std::string_view s, bool is_pattern) {
+  if (!IsUtf8(s)) return false;
+  bool got_asterisk = false;
+  for (const char ch : s) {
+    const uint8_t c = uint8_t(ch);
+    if (c <= 31 || c == 127) return false;
+    if (got_asterisk) {
+      // * must be followed by a . (*.)
+      // 4D530819 has a bug in its game code where it attempts to FindFirstFile() with filters
+      // of "Game:\\*_X3.rkv", "Game:\\m*_X3.rkv", and "Game:\\w*_X3.rkv" and will infinite
+      // loop if the path filter is allowed.
+      if (c != '.') return false;
+      got_asterisk = false;
+    }
+    switch (c) {
+      case '"':
+      case '+':
+      case ',':
+      case '<':
+      case '>':
+      case '|':
+        return false;
+      case '*':
+        if (!is_pattern) return false;
+        got_asterisk = true;
+        break;
+      case '?':
+        if (!is_pattern) return false;
+        break;
+      default:
+        break;
+    }
+  }
+  return true;
+}
+
+// Failed guest paths, each distinct one (call, root, raw bytes) reported once and at most
+// kMaxReports in all: what the game passed, byte for byte, what it became, and where from.
+class GuestPathFailures {
+ public:
+  static constexpr size_t kMaxReports = 256;
+
+  static GuestPathFailures& Get() {
+    static GuestPathFailures failures;
+    return failures;
+  }
+
+  // The line to log, or empty when this one was reported already or the cap is reached.
+  // `callers`: the game's return address, then up to two callers above it (0 = unknown).
+  std::string Report(std::string_view call, uint32_t status, uint32_t root,
+                     const uint32_t (&callers)[3], std::string_view raw,
+                     std::string_view path) {
+    std::string key(call);
+    key += '\0';
+    key += std::to_string(root);
+    key += '\0';
+    key += raw;
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (seen_.size() >= kMaxReports || !seen_.insert(key).second) {
+        return {};
+      }
+    }
+    return Describe(call, status, root, callers, raw, path);
+  }
+
+  static std::string Describe(std::string_view call, uint32_t status,
+                              uint32_t root, const uint32_t (&callers)[3],
+                              std::string_view raw, std::string_view path) {
+    char head[160];
+    std::snprintf(head, sizeof(head),
+                  "Guest path: %.*s %08X, root %08X, caller %08X < %08X < %08X, %zu bytes ",
+                  int(call.size()), call.data(), status, root, callers[0],
+                  callers[1], callers[2], raw.size());
+    std::string line = head;
+    line += '"';
+    bool high = false;
+    for (const char ch : raw) {
+      const uint8_t c = uint8_t(ch);
+      if (c >= 0x20 && c < 0x7F && c != '"' && c != '\\') {
+        line += char(c);
+      } else if (c == '\\') {
+        line += "\\\\";
+      } else {
+        char escaped[8];
+        std::snprintf(escaped, sizeof(escaped), "\\x%02X", c);
+        line += escaped;
+        high = high || c >= 0x80;
+      }
+    }
+    line += '"';
+    if (raw.empty()) {
+      line += " (empty name)";
+    } else if (high) {
+      line += " [";
+      for (size_t i = 0; i < raw.size() && i < 64; ++i) {
+        char hex[4];
+        std::snprintf(hex, sizeof(hex), i ? " %02X" : "%02X", uint8_t(raw[i]));
+        line += hex;
+      }
+      if (raw.size() > 64) line += " ...";
+      line += ']';
+    }
+    line += " -> \"";
+    line += path;
+    line += '"';
+    if (path.empty() && !raw.empty()) line += " (empty after conversion)";
+    return line;
+  }
+
+ private:
+  std::mutex mutex_;
+  std::unordered_set<std::string> seen_;
+};
+
+}  // namespace util
+}  // namespace kernel
+}  // namespace xe
+
+#endif  // XENIA_KERNEL_UTIL_GUEST_PATH_H_
