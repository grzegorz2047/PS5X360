+++ b/.deps/xenia-canary/src/xenia/kernel/xam/system_ui.h
@@ -0,0 +1,74 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+#ifndef XENIA_KERNEL_XAM_SYSTEM_UI_H_
+#define XENIA_KERNEL_XAM_SYSTEM_UI_H_
+
+// Xbox360PS5 (fix 26): who has the system interface up. XamInputGetState gives the game a pad
+// at rest while it is (XamState::IsUIActive). In 1.0.2 one bool held it, written by the XAM
+// dialogs (true when shown, false when closed) and by the PS5X360 guide (true when opened,
+// false when closed): the guide closing cleared a dialog's state and the other way round, and a
+// dialog the UI thread could not show (xeXamDispatchDialog's failure path) left it set, so the
+// game got no buttons from then on. Here each owner has its own bit, the interface is up while
+// any is set, and every change goes to a hook (logged by XamState). store()/load() keep the
+// 1.0.2 calls working: store() is the XAM dialog's.
+
+#include <atomic>
+#include <cstdint>
+
+namespace xe {
+namespace kernel {
+namespace xam {
+
+class SystemUiFlag {
+ public:
+  enum Owner : uint32_t {
+    kXamDialog = 1u,  // a XAM dialog (message box, device selector, sign-in, keyboard, ...)
+    kGuide = 2u,      // the PS5X360 guide or the library over the game
+  };
+  using Hook = void (*)(uint32_t before, uint32_t after);
+
+  SystemUiFlag() = default;
+  SystemUiFlag(const SystemUiFlag&) = delete;
+  SystemUiFlag& operator=(const SystemUiFlag&) = delete;
+
+  // 1.0.2's interface: the system interface is up; a XAM dialog is shown or closed.
+  bool load() const { return owners_.load() != 0; }
+  void store(bool open) { Set(kXamDialog, open); }
+
+  uint32_t owners() const { return owners_.load(); }
+  void Set(Owner owner, bool open) {
+    const uint32_t bit = uint32_t(owner);
+    const uint32_t before = open ? owners_.fetch_or(bit) : owners_.fetch_and(~bit);
+    const uint32_t after = open ? (before | bit) : (before & ~bit);
+    if (before != after) {
+      if (Hook hook = hook_.load()) hook(before, after);
+    }
+  }
+  void set_hook(Hook hook) { hook_.store(hook); }
+
+  // "XAM dialog", "guide", "XAM dialog and guide" or "none".
+  static const char* OwnersText(uint32_t owners) {
+    switch (owners & 3u) {
+      case 1u: return "XAM dialog";
+      case 2u: return "guide";
+      case 3u: return "XAM dialog and guide";
+      default: return "none";
+    }
+  }
+
+ private:
+  std::atomic<uint32_t> owners_{0};
+  std::atomic<Hook> hook_{nullptr};
+};
+
+}  // namespace xam
+}  // namespace kernel
+}  // namespace xe
+
+#endif  // XENIA_KERNEL_XAM_SYSTEM_UI_H_
