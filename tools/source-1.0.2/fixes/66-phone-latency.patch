diff --git a/port/phone_camera_tls.cpp b/port/phone_camera_tls.cpp
--- a/port/phone_camera_tls.cpp
+++ b/port/phone_camera_tls.cpp
@@ -7,6 +7,8 @@
 
 #include "xbox360ps5/motion_input.hpp"
 #include "phone_camera_page.hpp"  // fix 56: the camera page and its pairing state
+#include "xbox360ps5/phone_latency.hpp"  // fix 66: the page's delay by stage
+#include "xenia/base/logging.h"        // fix 66: its line in the game log
 #include "xbox360ps5/app_identity.hpp"  // fix 46: the certificates' names
 
 #include "mbedtls/ctr_drbg.h"
@@ -288,6 +290,8 @@ std::string Route(const std::string& method, std::string target, const std::stri
   }
   if (method == "GET" && target == "/pairing.mjs")  // fix 56
     return Response("200 OK", "text/javascript; charset=utf-8", phone_camera::kPairingModule);
+  if (method == "GET" && target == "/latency.mjs")  // fix 66
+    return Response("200 OK", "text/javascript; charset=utf-8", phone_camera::kLatencyModule);
   if (method == "GET" && (target == "/pose.mjs" || target == "/kinect_tracker.mjs" || target == "/demo_body.mjs")) {
     const std::string code = ReadFile(std::string(kAssets) + target.substr(1));
     return code.empty() ? Response("404 Not Found", "text/plain", "missing")
@@ -300,6 +304,12 @@ std::string Route(const std::string& method, std::string target, const std::stri
   for (char& c : given) c = char(std::tolower(static_cast<unsigned char>(c)));
   if (given != key) return Response("403 Forbidden", "application/json", "{\"error\":\"key\"}");
   if (method == "GET" && target == "/api/motion/status") return Response("200 OK", "application/json", motion::Status());
+  if (method == "POST" && target == "/api/motion/latency") {
+    // Fix 66: the page's delay by stage, every 2 s while paired; one game log line at most every 1.5 s.
+    if (phone_latency::Due(phone_latency::NowMs()))
+      if (const auto line = phone_latency::Line(body)) XELOGW("{}", *line);
+    return Response("204 No Content", "text/plain", "");
+  }
   if (method == "POST" && target == "/api/motion/frame") {
     const auto result = motion::Receive(body);
     if (result == motion::Result::accepted) return Response("200 OK", "application/json", "{\"ok\":true}");
