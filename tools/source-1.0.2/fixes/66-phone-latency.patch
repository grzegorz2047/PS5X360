+// SPDX-License-Identifier: MIT
+// Fix 66 (tools/source-1.0.2/fixes/66-phone-latency.patch): the phone camera page's delay by
+// stage, for the end-to-end Kinect latency. The page (port/phone_camera_page.hpp, latency.mjs)
+// posts every 2 s, to /api/motion/latency on the console's camera server, the medians and 95th
+// percentiles of each frame's stages: the camera frame to the start of detection, the detection,
+// tracking and smoothing up to the send, half the round trip of a sent frame (network), and the
+// hand joints' One Euro smoothing lag; with its frame rate and send queue. This turns that small
+// JSON into the game log's line ("Motion: phone stages ..."), at most one every 1.5 s. XMP1 frames
+// are unchanged: they have no room for a capture time.
+#pragma once
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <optional>
+#include <string>
+
+namespace xbox360ps5::phone_latency {
+
+inline constexpr size_t kMaxBody = 2048;
+inline constexpr const char* kStages[] = {"camera", "detect", "track", "network", "smoothing"};
+
+// The number after `"name":` (or the first `count` numbers of the array after it); false when
+// absent or not a number in [-1, 100000].
+inline bool Numbers(const std::string& json, const std::string& name, double* out, int count) {
+  const std::string key = "\"" + name + "\":";
+  const size_t at = json.find(key);
+  if (at == std::string::npos) return false;
+  size_t p = at + key.size();
+  const bool array = count > 1 || (p < json.size() && json[p] == '[');
+  if (array) {
+    if (p >= json.size() || json[p] != '[') return false;
+    ++p;
+  }
+  for (int n = 0; n < count; ++n) {
+    while (p < json.size() && (json[p] == ' ' || json[p] == ',')) ++p;
+    const char* start = json.c_str() + p;
+    char* end = nullptr;
+    const double value = std::strtod(start, &end);
+    if (end == start || !(value >= -1 && value <= 100000)) return false;
+    out[n] = value;
+    p += size_t(end - start);
+  }
+  return true;
+}
+
+// "Motion: phone stages camera 12 ms (p95 20), detection 25 ms (p95 31), ...; 29.8 fps, queue 0"
+// from the page's report; nothing when it is not one.
+inline std::optional<std::string> Line(const std::string& json) {
+  if (json.empty() || json.size() > kMaxBody || json.front() != '{') return std::nullopt;
+  static const char* const labels[] = {"camera", "detection", "tracking to send", "network (half the round trip)",
+                                       "hand smoothing lag"};
+  std::string line = "Motion: phone stages";
+  bool any = false;
+  for (size_t n = 0; n < 5; ++n) {
+    double v[3];
+    if (!Numbers(json, kStages[n], v, 3)) return std::nullopt;
+    char part[96];
+    if (v[0] < 0 || v[2] <= 0)
+      std::snprintf(part, sizeof(part), "%s %s none", n ? "," : "", labels[n]);
+    else
+      std::snprintf(part, sizeof(part), "%s %s %.0f ms (p95 %.0f)", n ? "," : "", labels[n], v[0], v[1]);
+    line += part;
+    any = any || v[2] > 0;
+  }
+  double fps = 0, queue = 0;
+  if (!Numbers(json, "fps", &fps, 1) || !Numbers(json, "queue", &queue, 1)) return std::nullopt;
+  char tail[64];
+  std::snprintf(tail, sizeof(tail), "; %.1f fps, queue %.0f", fps, queue);
+  line += tail;
+  if (!any) return std::nullopt;
+  return line;
+}
+
+// At most one line every 1.5 s, whatever the phone sends (now_ms: a steady clock).
+inline bool Due(uint64_t now_ms) {
+  static std::atomic<uint64_t> last{0};
+  uint64_t before = last.load(std::memory_order_relaxed);
+  if (before && now_ms - before < 1500) return false;
+  return last.compare_exchange_strong(before, now_ms ? now_ms : 1, std::memory_order_relaxed);
+}
+inline uint64_t NowMs() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count());
+}
+
+}  // namespace xbox360ps5::phone_latency
