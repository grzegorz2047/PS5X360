+inline constexpr char kLatencyModule[] = R"LATENCYJS(// SPDX-License-Identifier: MIT
+// PS5X360Reloaded fix 66: the phone page's delay by stage, for the end-to-end Kinect latency
+// (the console logs the rest: receive to the guest's frame). The page measures each processed
+// frame: the camera frame to the start of detection (requestVideoFrameCallback's capture or
+// presentation time), the detection itself, tracking and smoothing up to the send, half the
+// HTTP round trip of a sent frame, and the hand joints' One Euro smoothing lag (it cannot be
+// timed: it is 1 / (2 pi cutoff) for the filter's current cutoff, minCutoff + beta * |speed|).
+// Every REPORT_MS the page shows the medians and posts the window to /api/motion/latency.
+export const REPORT_MS = 2000;
+export const STAGES = ['camera', 'detect', 'track', 'network', 'smoothing'];
+export const HAND_JOINTS = [7, 11];  // the bridge skeleton's left and right hand
+const KEEP = 600;                     // samples kept per stage between two reports
+
+// The p-th percentile (0-100) of the values, by nearest rank; NaN for none.
+export function percentile(values, p) {
+  if (!values.length) return NaN;
+  const sorted = [...values].sort((a, b) => a - b);
+  const rank = Math.min(sorted.length - 1, Math.max(0, Math.ceil(p / 100 * sorted.length) - 1));
+  return sorted[rank];
+}
+
+// The lag in milliseconds of the slowest-following hand filter (x and y axes) of a
+// KinectTracker's filters (a Map of OneEuro by joint index + axis), NaN when there are none yet.
+export function smoothingLagMs(filters, joints = HAND_JOINTS) {
+  let lag = NaN;
+  for (const n of joints) {
+    for (const axis of ['x', 'y']) {
+      const filter = filters?.get?.(n + axis);
+      if (!filter || !(filter.minCutoff > 0)) continue;
+      const cutoff = filter.minCutoff + (filter.beta || 0) * Math.abs(filter.dx || 0);
+      const ms = 1000 / (2 * Math.PI * cutoff);
+      if (!(lag >= ms)) lag = ms;
+    }
+  }
+  return lag;
+}
+
+export class StageWindow {
+  constructor() { this.reset(NaN); }
+  reset(now) {
+    this.samples = Object.fromEntries(STAGES.map(name => [name, []]));
+    this.frames = 0;
+    this.since = now;
+  }
+  add(stage, ms) {
+    const list = this.samples[stage];
+    if (!list || !Number.isFinite(ms) || ms < 0 || ms > 10000) return;
+    list.push(ms);
+    if (list.length > KEEP) list.shift();
+  }
+  frame(now) {
+    this.frames++;
+    if (!Number.isFinite(this.since)) this.since = now;
+  }
+  // {fps, frames, queue, stages: {name: [median, p95, count]}}; starts the next window.
+  report(now, queue = 0) {
+    const seconds = Number.isFinite(this.since) && now > this.since ? (now - this.since) / 1000 : 0;
+    const round = v => Number.isFinite(v) ? Math.round(v * 10) / 10 : -1;
+    const stages = {};
+    for (const name of STAGES) {
+      const list = this.samples[name];
+      stages[name] = [round(percentile(list, 50)), round(percentile(list, 95)), list.length];
+    }
+    const out = {fps: seconds ? round(this.frames / seconds) : 0, frames: this.frames, queue, stages};
+    this.reset(now);
+    return out;
+  }
+}
+
+// The page's line: the medians, '–' for a stage without samples.
+export function summaryValues(report) {
+  return STAGES.map(name => {
+    const median = report.stages[name]?.[0];
+    return median >= 0 ? String(Math.round(median)) : '–';
+  });
+}
+)LATENCYJS";
