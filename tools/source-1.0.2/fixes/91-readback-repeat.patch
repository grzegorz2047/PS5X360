+    if (readback_mode == ReadbackResolveMode::kFast && !auto_readback && newest_copy >= 0 &&
+        readback_slots::RepeatedInFrame(rb.frames[newest_copy], frame_current_)) {
+      read_cache_miss = true;
+      static uint32_t repeated_shown = 0;
+      if (repeated_shown < 8 || (repeated_shown % 500) == 0) {
+        XELOGW(
+            "Readback: resolve to {:08X} of {} bytes again in the same frame: the fast mode "
+            "gives this copy, not the previous one ({} so far, fix 91)",
+            written_address, readback_length, repeated_shown + 1);
+      }
+      ++repeated_shown;
+    }
 
     if (is_scaled) {
