+// Fix 91: the fast mode hands a resolve's copy over at the next resolve of its key, which is the
+// previous frame's picture for a key resolved every frame, but for a key resolved a few times and
+// then left, the last copy is never handed over. Tekken Tag Tournament 2 builds its costume
+// colours as a match loads by resolving one 240 KiB key (0FE7C000) three times over a few
+// frames and reads them: with the fast mode it got each one's predecessor (zeros first), so King
+// and Bob came out cyan and blue (issue 14), right with the full mode. So every resolve of a key
+// in the kFreshFrames frames from its first resolve after a pause (none for more than
+// kIdleFrames frames, or a key never resolved) gets its own copy, waited for; then the key is
+// fast. A key resolved every frame pays for kFreshFrames frames of waits when it starts (a
+// fight's first third of a second). Frame 0 means "never" (frames count from 1).
+// Tried on the console: "again in the same frame" (1.0.5-work-fix91) missed Tekken's resolves,
+// which are frames apart, and fired all through its fights (keys resolved twice a frame: slow
+// motion); "the first 4 resolves after a pause" (1.0.5-work-fix91b) fixed the third logged
+// costume copy (175,476 bytes, as in the full mode) and still left the colours wrong: the log
+// shows only 3 resolves of a length, the costumes take more.
+constexpr uint64_t kIdleFrames = 30;
+constexpr uint64_t kFreshFrames = 20;
+struct FreshRun {
+  uint64_t start = 0;     // the frame of the run's first resolve
+  uint32_t own = 0;       // resolves given their own copy in this run
+  bool reported = true;   // the run's count was handed to the log
+};
+// Whether this resolve gets its own copy. *ended (if given) receives the count of own copies of
+// a run that has just ended (its window passed, or a new run started after a pause), else 0.
+inline bool OwnCopyAfterPause(uint64_t previous_use_frame, uint64_t frame, FreshRun& run,
+                              uint32_t* ended = nullptr) {
+  if (ended) *ended = 0;
+  if (!previous_use_frame || frame - previous_use_frame > kIdleFrames) {
+    if (ended && !run.reported) *ended = run.own;
+    run = FreshRun{frame, 0, false};
+  }
+  if (frame - run.start <= kFreshFrames) {
+    ++run.own;
+    return true;
+  }
+  if (ended && !run.reported) *ended = run.own;
+  run.reported = true;
+  return false;
+}
+
 }  // namespace readback_slots
 }  // namespace vulkan
 }  // namespace gpu
