   return oldest < 0 ? 0 : uint32_t(oldest);
 }
 
+// Fix 91: the fast mode's copy "one resolve late" is the previous frame's picture only when the
+// key is resolved once a frame. Tekken Tag Tournament 2 builds its costume colours as a match
+// loads by resolving the same 240 KiB (0FE7C000) three times in a row, one draw each, and reads
+// the last: the fast mode gave it the second step's copy (zeros), so King and Bob came out
+// cyan and blue (issue 14), right with the full mode. A key resolved again in the frame of its
+// newest copy gets this resolve's own copy (waited for, as on a key's first resolve). Frame 0:
+// no copy (the command processor counts frames from 1).
+inline bool RepeatedInFrame(uint64_t newest_copy_frame, uint64_t frame) {
+  return newest_copy_frame != 0 && newest_copy_frame == frame;
+}
+
 }  // namespace readback_slots
 }  // namespace vulkan
 }  // namespace gpu
