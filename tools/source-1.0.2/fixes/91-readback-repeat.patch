+// Fix 91 diagnostic (issue 14): the readback mode per key from readback-keys.txt
+// (xbox360ps5/readback_keys.hpp), read again when it changes (checked once a second), and the
+// keys in the log: each new one when first seen, and every 30 s the keys of the last 30 s with
+// their counts and the mode they got. Called on the GPU command thread only.
+void ReadbackKeysDiagnostic(uint32_t address, uint32_t length, uint32_t format, uint32_t endian,
+                            bool automatic, ReadbackResolveMode& mode) {
+  namespace rk = xbox360ps5::readback_keys;
+  static rk::Rules rules;
+  static std::string loaded_from;
+  static long long loaded_stamp = -1;
+  static auto checked = std::chrono::steady_clock::time_point();
+  const auto now = std::chrono::steady_clock::now();
+  if (now - checked >= std::chrono::seconds(1)) {
+    checked = now;
+    std::string found;
+    long long stamp = -1;
+    for (const char* path : {XBOX360PS5_DATA_ROOT "/readback-keys.txt",
+                             "/download0/xbox360ps5/readback-keys.txt"}) {
+      struct stat info;
+      if (::stat(path, &info) == 0) {
+        found = path;
+        stamp = (long long)info.st_mtime * 1000003LL + (long long)info.st_size;
+        break;
+      }
+    }
+    if (found != loaded_from || stamp != loaded_stamp) {
+      loaded_from = found;
+      loaded_stamp = stamp;
+      std::string text;
+      if (!found.empty()) {
+        if (FILE* file = std::fopen(found.c_str(), "rb")) {
+          char chunk[4096];
+          size_t got;
+          while ((got = std::fread(chunk, 1, sizeof(chunk), file)) > 0) text.append(chunk, got);
+          std::fclose(file);
+        }
+      }
+      rules = rk::Parse(text);
+      XELOGW(
+          "Readback keys: {}: default {}, {} keys listed, {} lines not understood (fix 91 "
+          "diagnostic)",
+          found.empty() ? std::string("no readback-keys.txt") : found, rk::Name(rules.default_mode),
+          rules.keys.size(), rules.not_understood);
+      for (const rk::Rule& rule : rules.keys) {
+        XELOGW("Readback keys:   {:08X}/{} {}", rule.address,
+               rule.length ? std::to_string(rule.length) : std::string("any"), rk::Name(rule.mode));
+      }
+    }
+  }
+  if (!automatic && length &&
+      (mode == ReadbackResolveMode::kFast || mode == ReadbackResolveMode::kFull)) {
+    const rk::Mode chosen = rk::Lookup(rules, address, length);
+    if (chosen == rk::Mode::kFull) mode = ReadbackResolveMode::kFull;
+    else if (chosen == rk::Mode::kFast) mode = ReadbackResolveMode::kFast;
+  }
+  struct Seen {
+    uint32_t format = 0, endian = 0;
+    uint64_t total = 0, window = 0;
+    ReadbackResolveMode mode = ReadbackResolveMode::kDisabled;
+    bool automatic = false;
+  };
+  static std::map<uint64_t, Seen> seen;
+  static uint32_t new_shown = 0;
+  static auto window_start = now;
+  const uint64_t key = (uint64_t(address) << 32) | length;
+  auto found_key = seen.find(key);
+  if (found_key == seen.end()) {
+    found_key = seen.emplace(key, Seen{}).first;
+    if (new_shown < 400) {
+      ++new_shown;
+      XELOGW(
+          "Readback key: {:08X}/{} bytes, format {}, endian {}, mode {}: first seen (fix 91 "
+          "diagnostic)",
+          address, length, format, endian,
+          automatic                                 ? "automatic"
+          : mode == ReadbackResolveMode::kFull     ? "full"
+          : mode == ReadbackResolveMode::kFast     ? "fast"
+                                                   : "off");
+    }
+  }
+  Seen& s = found_key->second;
+  s.format = format;
+  s.endian = endian;
+  ++s.total;
+  ++s.window;
+  s.mode = mode;
+  s.automatic = automatic;
+  if (now - window_start >= std::chrono::seconds(30)) {
+    window_start = now;
+    std::vector<std::pair<uint64_t, uint64_t>> order;
+    for (const auto& [k, v] : seen)
+      if (v.window) order.emplace_back(v.window, k);
+    std::sort(order.begin(), order.end(), [](const auto& a, const auto& b) { return a.first > b.first; });
+    std::string line;
+    int listed = 0;
+    for (const auto& [count, k] : order) {
+      if (listed == 48) break;
+      const Seen& v = seen[k];
+      char text[96];
+      std::snprintf(text, sizeof(text), "%s%08X/%u f%u e%u x%llu %s", listed % 6 ? "; " : "",
+                    uint32_t(k >> 32), uint32_t(k), v.format, v.endian, (unsigned long long)count,
+                    v.automatic ? "auto"
+                    : v.mode == ReadbackResolveMode::kFull ? "full"
+                    : v.mode == ReadbackResolveMode::kFast ? "fast"
+                                                           : "off");
+      line += text;
+      if (++listed % 6 == 0) {
+        XELOGW("Readback keys, last 30 s: {}", line);
+        line.clear();
+      }
+    }
+    if (!line.empty()) XELOGW("Readback keys, last 30 s: {}", line);
+    for (auto& [k, v] : seen) v.window = 0;
+  }
+}
