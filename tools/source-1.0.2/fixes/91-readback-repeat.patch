+// Fix 91: the fast mode hands a resolve's copy over at the next resolve of its key, which is the
+// previous frame's picture for a key resolved every frame, but for a key resolved a few times and
+// then left, the last copy is never handed over. Tekken Tag Tournament 2 builds its costume
+// colours as a match loads by resolving one 240 KiB key (0FE7C000) three times over a few
+// frames and reads the last: with the fast mode it got the second one's copy (zeros), so King
+// and Bob came out cyan and blue (issue 14), right with the full mode. So the first
+// kFreshResolves resolves of a key after a pause (none for more than kIdleFrames frames, or a
+// key never resolved) get their own copy, waited for; then the key is fast. A key resolved every
+// frame pays for 3 waits when it starts. Frame 0 means "never" (frames count from 1).
+// (1.0.5-work-fix91 tried "again in the same frame": it missed Tekken's frames apart and fired
+// all through its fights, where keys are resolved twice a frame.)
+constexpr uint32_t kFreshResolves = 4;
+constexpr uint64_t kIdleFrames = 30;
+// Whether this resolve gets its own copy; `run` counts the key's resolves since its pause.
+inline bool OwnCopyAfterPause(uint64_t previous_use_frame, uint64_t frame, uint32_t& run) {
+  if (!previous_use_frame || frame - previous_use_frame > kIdleFrames) run = 0;
+  if (run >= kFreshResolves) return false;
+  ++run;
+  return true;
+}
+
 }  // namespace readback_slots
 }  // namespace vulkan
 }  // namespace gpu
