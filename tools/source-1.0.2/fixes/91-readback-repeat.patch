+// Fix 91: the fast mode gives a resolve the copy one resolve late, which is the previous frame's
+// picture only for a key resolved once a frame. Tekken Tag Tournament 2 resolves several keys
+// twice a frame through its fights (two passes drawn into the same place: 10020000 and
+// 0FD7C000 of 4096 bytes, 0D0F0000 of 3 MiB, 0E338000 and 0E740000 of 4 MiB, ...), so each pass
+// got the other pass's picture, and King's yellow and purple and Bob's clothes came out cyan and
+// blue (issue 14); the full mode, which gives every resolve its own copy, was right and about
+// 10 fps slower. Each copy now carries its pass (the n-th resolve of the key in its frame, from
+// 1) and frame, and a resolve gets the newest copy of its own pass from an earlier frame: still
+// one frame late, never another pass's. A key resolved once a frame gets exactly what it got
+// before. A pass with no earlier copy yet (a key's first frame) gets its own copy, waited for as
+// on a key's first resolve.
+// (Tried on the console before: giving the same frame's repeats their own copy (1.0.5-work-
+// fix91: the first pass still got the other one's; waits all through the fights), and every
+// resolve of a key in its first frames after a pause (1.0.5-work-fix91b/c: the costume key
+// 0FE7C000 got byte-for-byte the full mode's copies, and the colours stayed wrong).)
+
+// The newest slot other than `exclude` holding a copy of pass `pass`, of at least `length`
+// bytes, made in a frame before `frame`, completed by `completed` if `completed_only`. -1 if none.
+inline int ChooseRead(const uint64_t* submissions, const uint32_t* valid_sizes,
+                      const uint32_t* passes, const uint64_t* frames, uint32_t count,
+                      int exclude, uint32_t length, uint32_t pass, uint64_t frame,
+                      uint64_t completed, bool completed_only) {
+  int best = -1;
+  for (uint32_t i = 0; i < count; ++i) {
+    if (int(i) == exclude || !submissions[i] || valid_sizes[i] < length || passes[i] != pass ||
+        frames[i] >= frame || (completed_only && submissions[i] > completed)) {
+      continue;
+    }
+    if (best < 0 || submissions[i] > submissions[best]) {
+      best = int(i);
+    }
+  }
+  return best;
+}
+
+// The slot this copy goes to: never the newest copy of any pass (each is kept for its pass's
+// next resolve): an unused slot, else the oldest copy not kept; when every slot is some pass's
+// newest (more passes than slots), the oldest.
+inline uint32_t ChooseWrite(const uint64_t* submissions, const uint32_t* valid_sizes,
+                            const uint32_t* passes, uint32_t count, uint32_t length) {
+  bool kept[16] = {};
+  for (uint32_t i = 0; i < count && i < 16; ++i) {
+    if (!submissions[i] || valid_sizes[i] < length) {
+      continue;
+    }
+    bool newest_of_pass = true;
+    for (uint32_t j = 0; j < count; ++j) {
+      if (j != i && submissions[j] && valid_sizes[j] >= length && passes[j] == passes[i] &&
+          submissions[j] > submissions[i]) {
+        newest_of_pass = false;
+        break;
+      }
+    }
+    kept[i] = newest_of_pass;
+  }
+  int unused = -1, oldest_free = -1, oldest = -1;
+  for (uint32_t i = 0; i < count && i < 16; ++i) {
+    if (!submissions[i]) {
+      if (unused < 0) unused = int(i);
+      continue;
+    }
+    if (oldest < 0 || submissions[i] < submissions[oldest]) oldest = int(i);
+    if (!kept[i] && (oldest_free < 0 || submissions[i] < submissions[oldest_free])) {
+      oldest_free = int(i);
+    }
+  }
+  if (unused >= 0) return uint32_t(unused);
+  if (oldest_free >= 0) return uint32_t(oldest_free);
+  return oldest < 0 ? 0 : uint32_t(oldest);
+}
+
+// Fix 91, 1.0.5-work-fix91f: the resolves the CPU reads as data. The per-key readback file of
+// 1.0.5-work-fix91e found Tekken Tag Tournament 2's colours on the console: the 4 MiB key
+// 0F05C000, which the game draws a costume part into about every 25 frames (3 draws) and
+// reads back on the CPU to build a 256x256 DXT texture, one part after another. The fast mode
+// handed each part the previous one's picture; with that key alone in the full mode the colours
+// were right. The shape, for any game: a resolve whose copy the CPU reads (a one-shot read watch
+// on its range after the copy, re-armed now and then while nothing reads it) and that is not
+// resolved every frame or so (its frames between resolves average kOccasionalFrames or more):
+// such a key gets its own copy, waited for. A key resolved every frame stays one frame late even
+// when the CPU reads it (an HDR luminance), as the fast mode means to.
+constexpr float kOccasionalFrames = 4.0f;
+// The key's average frames between resolves (`average`, 0 for a new key) after one at `frame`,
+// its previous at `previous_frame` (0: none); true when it is occasional.
+inline bool Occasional(uint64_t previous_frame, uint64_t frame, float& average) {
+  if (!previous_frame) {
+    average = kOccasionalFrames;  // unknown yet: as occasional
+    return true;
+  }
+  const float gap = float(frame - previous_frame);
+  average = average * 0.75f + gap * 0.25f;
+  return average >= kOccasionalFrames;
+}
+inline bool Overlaps(uint32_t a, uint32_t a_length, uint32_t b, uint32_t b_length) {
+  return a_length && b_length && a < b + b_length && b < a + a_length;
+}
+// The CPU's reads of armed ranges, written in the fault handler (no locks, never blocks) and
+// taken on the GPU command thread. Up to kReads are kept between two takes; more are dropped.
+struct ReadRing {
+  static constexpr uint32_t kReads = 64;
+  struct Read {
+    std::atomic<uint32_t> address{0}, length{0};
+  };
+  Read reads[kReads];
+  std::atomic<uint32_t> written{0};
+  std::atomic<uint32_t> taken{0};  // advanced by the GPU command thread
+  // Called under the global critical region (the fault handler), so one writer at a time.
+  void Push(uint32_t address, uint32_t length) {
+    const uint32_t n = written.load(std::memory_order_relaxed);
+    if (n - taken.load(std::memory_order_acquire) >= kReads) return;  // full: the reader is behind
+    reads[n % kReads].address.store(address, std::memory_order_relaxed);
+    reads[n % kReads].length.store(length, std::memory_order_relaxed);
+    written.store(n + 1, std::memory_order_release);
+  }
+  template <typename Each>
+  void Take(Each each) {
+    const uint32_t n = written.load(std::memory_order_acquire);
+    uint32_t t = taken.load(std::memory_order_relaxed);
+    for (; t != n; ++t) {
+      each(reads[t % kReads].address.load(std::memory_order_relaxed),
+           reads[t % kReads].length.load(std::memory_order_relaxed));
+    }
+    taken.store(t, std::memory_order_release);
+  }
+};
+
 }  // namespace readback_slots
 }  // namespace vulkan
