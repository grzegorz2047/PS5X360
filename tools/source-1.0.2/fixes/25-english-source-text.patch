diff --git a/include/xbox360ps5/frame_watch.hpp b/include/xbox360ps5/frame_watch.hpp
index 42ea656..cb963d9 100644
--- a/include/xbox360ps5/frame_watch.hpp
+++ b/include/xbox360ps5/frame_watch.hpp
@@ -23,8 +23,8 @@ class FrameWatch {
   }
   // Binary release patch group 9: the "no new frames" banner after 2 s, not
   // 45 s: on a first run the picture mostly stops while shaders compile, and
-  // the banner says so (its text gains "compiling shaders or loading" through
-  // the package's assets/lang files). Observe's diagnostics keep their times.
+  // the banner says so (its English key says "compiling shaders or
+  // loading", and so do the language files). Observe's diagnostics keep their times.
   bool Notice(double now) const {return now-last_progress_>=2;}
  private:
   uint64_t frames_;
