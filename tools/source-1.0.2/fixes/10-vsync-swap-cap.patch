+#if XBOX360PS5_SWAP_CAP
+// Xbox360PS5 (binary release patch group 10): VSync on means at most about 60
+// frames a second. On the PS5 the guest gets 60 vblanks a second whatever the
+// VSync option says, so the option only changed the host presentation, and a
+// game unlocked by a 60 FPS patch with a fixed 1/60 s step (Battlefield: Bad
+// Company) ran at 80 frames and more, too fast. Swaps are paced on a 16.60 ms
+// grid (about 60.2 Hz, a little faster than the 60 Hz vblank, so vblank-paced
+// games never wait here) while VSync is on and no game patch asked for it off.
+// An early swap sleeps until its deadline. A swap late by less than one period
+// keeps the grid (the next frames may catch up, so a fixed-step game keeps its
+// average speed); one further behind, or the first, restarts the grid.
+static void PaceSwap() {
+  if (!xbox360ps5::EffectiveVsync(cvars::vsync)) {
+    return;
+  }
+  constexpr int64_t kPeriodNs = 16600000;
+  static std::atomic<int64_t> deadline_ns{0};
+  const int64_t now = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                          std::chrono::steady_clock::now().time_since_epoch())
+                          .count();
+  const int64_t deadline = deadline_ns.load(std::memory_order_relaxed);
+  const bool on_grid = deadline != 0 && now < deadline + kPeriodNs;
+  deadline_ns.store(on_grid ? deadline + kPeriodNs : now + kPeriodNs,
+                    std::memory_order_relaxed);
+  if (on_grid) {
+    xe::threading::NanoSleep(deadline - now);  // Returns at once if late.
+  }
+}
+#endif
