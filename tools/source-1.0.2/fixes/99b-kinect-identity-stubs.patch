+// Xbox360PS5 fix 99b (issue 15): the Kinect ID (NUI Identity) calls Kinect Sports makes as the
+// player is picked, until now undefined externs (an undefined extern returns without setting r3:
+// the game took its own first argument for the result), and the system calls around them. As
+// a Kinect ID that works with nothing stored: no biometric data to read (ERROR_NOT_FOUND, size
+// 0), writing it succeeds (and is dropped), the camera's elevation is accepted, the title cache
+// and the Live upload queue are not there. Each is logged (the first 32 calls).
+dword_result_t XamReadBiometricData_entry(dword_t user, lpdword_t version_ptr, dword_t buffer_ptr,
+                                          lpdword_t size_ptr, dword_t overlapped_ptr) {
+  if (size_ptr) *size_ptr = 0;
+  KinectIdentityLog("XamReadBiometricData", uint32_t(user), buffer_ptr, X_ERROR_NOT_FOUND);
+  return X_ERROR_NOT_FOUND;
+}
+DECLARE_XAM_EXPORT1(XamReadBiometricData, kNone, kStub);
+
+dword_result_t XamWriteBiometricData_entry(dword_t user, lpdword_t version_ptr, dword_t buffer_ptr,
+                                           lpdword_t size_ptr, dword_t overlapped_ptr) {
+  KinectIdentityLog("XamWriteBiometricData", uint32_t(user), size_ptr ? uint32_t(*size_ptr) : 0,
+                    X_ERROR_SUCCESS);
+  return X_ERROR_SUCCESS;
+}
+DECLARE_XAM_EXPORT1(XamWriteBiometricData, kNone, kStub);
+
